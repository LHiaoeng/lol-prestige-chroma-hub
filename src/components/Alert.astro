---
import CheckCircleFilled from './icons/CheckCircleFilled.astro';
import CloseCircleFilled from './icons/CloseCircleFilled.astro';
import CloseOutlined from './icons/CloseOutlined.astro';
import ExclamationCircleFilled from './icons/ExclamationCircleFilled.astro';
import InfoCircleFilled from './icons/InfoCircleFilled.astro';
interface Props {
  id?: string;
  type?: 'success' | 'info' | 'warning' | 'error';
  title?: string;
  message?: string;
  description?: string;
  showIcon?: boolean;
  closable?: boolean;
  closeLabel?: string;
  banner?: boolean;
  role?: 'alert' | 'note';
}

const {
  id,
  banner = false,
  type = banner ? 'warning' : 'info',
  title,
  message,
  description,
  showIcon = banner,
  closable = false,
  closeLabel = 'Close alert',
  role = 'alert',
} = Astro.props;
const alertTitle = title ?? message;
const hasTitle = Boolean(alertTitle || Astro.slots.has('title'));
const hasDescription = Boolean(description || Astro.slots.has('description'));
---

<div id={id} class:list={['alert', `alert--${type}`, { 'alert--banner': banner, 'alert--with-description': hasDescription, 'alert--description-only': hasDescription && !hasTitle }]} role={role} data-alert>
  {showIcon && (
    <span class="alert__icon" aria-hidden="true">
      <slot name="icon">
        {type === 'success' ? (
          <CheckCircleFilled />
        ) : type === 'warning' ? (
          <ExclamationCircleFilled />
        ) : type === 'error' ? (
          <CloseCircleFilled />
        ) : (
          <InfoCircleFilled />
        )}
      </slot>
    </span>
  )}
  <div class="alert__content">
    {(alertTitle || Astro.slots.has('title')) && <div class="alert__title"><slot name="title">{alertTitle}</slot></div>}
    {(description || Astro.slots.has('description')) && (
      <div class="alert__description">
        {Astro.slots.has('description') ? <slot name="description" /> : description}
      </div>
    )}
  </div>
  {Astro.slots.has('action') && <div class="alert__action"><slot name="action" /></div>}
  {closable && (
    <button class="alert__close" type="button" aria-label={closeLabel} data-alert-close>
      <slot name="closeIcon"><CloseOutlined /></slot>
    </button>
  )}
</div>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('[data-alert-close]');
    const alert = button?.closest<HTMLElement>('[data-alert]');
    if (!button || !alert) return;
    alert.dispatchEvent(new CustomEvent('alert-close', { bubbles: true }));
    alert.remove();
  });
</script>

<style>
  .alert { --alert-color: var(--info); --alert-bg: var(--info-bg); --alert-border: var(--info-border); display: flex; align-items: center; gap: var(--space-2); padding: 12px; border: 1px solid var(--alert-border); border-radius: var(--radius-card); background: var(--alert-bg); color: var(--text); }
  .alert--success { --alert-color: var(--success); --alert-bg: var(--success-bg); --alert-border: var(--success-border); }
  .alert--warning { --alert-color: var(--warning); --alert-bg: var(--warning-bg); --alert-border: var(--warning-border); }
  .alert--error { --alert-color: var(--danger); --alert-bg: var(--danger-bg); --alert-border: var(--danger-border); }
  .alert--banner { border-inline: 0; border-radius: 0; }
  .alert__icon { display: inline-flex; flex: none; color: var(--alert-color); line-height: 0; }
  .alert__icon :global(svg) { display: block; width: 16px; height: 16px; }
  .alert--with-description { align-items: flex-start; }
  .alert--with-description .alert__icon { margin-inline-end: var(--space-1); }
  .alert--with-description .alert__icon :global(svg) { width: 24px; height: 24px; }
  .alert--description-only { align-items: center; }
  .alert--description-only .alert__description { margin-top: 0; }
  .alert--description-only .alert__icon :global(svg) { width: 16px; height: 16px; }
  .alert__content { min-width: 0; flex: 1; }
  .alert__title { font-size: var(--font-size-body); line-height: var(--line-height-body); }
  .alert--with-description .alert__title { font-size: var(--font-size-title); line-height: var(--line-height-title); }
  .alert__description { margin-top: var(--space-1); color: var(--muted); }
  .alert__action { flex: none; margin-inline-start: var(--space-1); }
  .alert__close { display: inline-flex; min-width: var(--control-height); min-height: var(--control-height); flex: none; align-items: center; justify-content: center; margin: -8px; padding: 0; border: 0; background: transparent; color: var(--muted); }
  .alert__close:hover { color: var(--text); }
  .alert__close svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
  @media (max-width: 767px) { .alert { gap: var(--space-2); } }
</style>
