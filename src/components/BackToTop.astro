---
import { resolveLocale } from '../i18n/config';
const isZh = resolveLocale(Astro.currentLocale) === 'zh-cn';
---
<button
  class="back-to-top"
  type="button"
  data-back-to-top
  aria-label={isZh ? '返回顶部' : 'Back to top'}
  aria-hidden="true"
  tabindex="-1"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="m6 14 6-6 6 6" />
  </svg>
</button>

<script>
  import { bindBackToTop } from '../client/back-to-top';
  bindBackToTop();
</script>

<style>
  .back-to-top {
    position: fixed;
    z-index: 9;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    display: grid;
    width: 46px;
    height: 46px;
    padding: 0;
    place-items: center;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 8px 24px #0009;
    color: #121019;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .back-to-top[data-visible] { opacity: 1; pointer-events: auto; transform: none; }
  .back-to-top:hover, .back-to-top:focus-visible { box-shadow: 0 8px 28px #000b, 0 0 0 3px #d7b56d38; }
  .back-to-top svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 767px) {
    .back-to-top { right: max(14px, env(safe-area-inset-right)); bottom: max(14px, env(safe-area-inset-bottom)); width: 44px; height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) { .back-to-top { transition: none; } }
</style>
