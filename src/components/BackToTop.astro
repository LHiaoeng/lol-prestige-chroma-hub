---
import Icon from './icons/Icon.astro';
import { resolveLocale } from '../i18n/config';
const isZh = resolveLocale(Astro.currentLocale) === 'zh-cn';
---
<button
  class="ant-btn ant-btn-lg ant-btn-icon-only ant-float-btn"
  type="button"
  data-back-to-top
  aria-label={isZh ? '返回顶部' : 'Back to top'}
  inert
>
  <span class="ant-float-btn-icon"><Icon name="VerticalAlignTopOutlined" /></span>
</button>

<script>
  import { bindBackToTop } from './back-to-top';
  bindBackToTop();
</script>

<style>
  .ant-float-btn {
    position: fixed;
    z-index: 9;
    inset-inline-end: max(var(--space-4), env(safe-area-inset-right));
    bottom: var(--float-button-bottom);
    border-radius: 50%;
    box-shadow: var(--shadow-popup);
    touch-action: manipulation;
    transition: opacity var(--motion-mid) linear, visibility var(--motion-mid), color var(--motion-mid) ease, border-color var(--motion-mid) ease;
  }
  .ant-float-btn[inert] {
    opacity: 0;
    visibility: hidden;
  }
  .ant-float-btn:hover { border-color: var(--gold-hover); color: var(--gold-hover); }
  .ant-float-btn:active { border-color: var(--gold-active); color: var(--gold-active); }
  .ant-float-btn-icon { font-size: calc(var(--font-size-small) * 1.5); line-height: 1; }
</style>
