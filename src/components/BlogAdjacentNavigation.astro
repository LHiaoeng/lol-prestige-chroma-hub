---
import { adjacentBlogArticles, articleHref, formatBlogDate } from '../blog/articles';
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';

interface Props {
  currentSlug: string;
  locale?: Locale;
}

const { currentSlug } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const { newer, older } = adjacentBlogArticles(currentSlug);
const navigationClass = `blog-adjacent${newer && !older ? ' only-newer' : ''}${older && !newer ? ' only-older' : ''}`;
---
<div class="blog-adjacent-shell">
  {(newer || older) && (
    <nav class={navigationClass} aria-label={isZh ? '更多博客文章' : 'More blog articles'}>
      <div class="adjacent-grid">
        {older && <a class="adjacent-card older chroma-card" href={articleHref(older, locale)} aria-label={isZh ? `上一篇：${older.titleZh}` : `Previous article: ${older.titleEn}`}><span class="direction">{isZh ? '← 上一篇' : '← Previous article'}</span><strong>{isZh ? older.titleZh : older.titleEn}</strong><time datetime={older.publishedAt}>{formatBlogDate(older.publishedAt, isZh ? 'zh' : 'en')}</time></a>}
        {newer && <a class="adjacent-card newer chroma-card" href={articleHref(newer, locale)} aria-label={isZh ? `下一篇：${newer.titleZh}` : `Next article: ${newer.titleEn}`}><span class="direction">{isZh ? '下一篇 →' : 'Next article →'}</span><strong>{isZh ? newer.titleZh : newer.titleEn}</strong><time datetime={newer.publishedAt}>{formatBlogDate(newer.publishedAt, isZh ? 'zh' : 'en')}</time></a>}
      </div>
    </nav>
  )}
  <aside class="editorial-trust">
    <p>{isZh ? '想了解本站如何核验资料、维护图鉴和处理纠错？' : 'Want to know how we verify sources, maintain the archive, and handle corrections?'}</p>
    <a href={localizedPath(locale, '/about/')}>{isZh ? '查看关于页面 →' : 'Read our about page →'}</a>
  </aside>
</div>

<style>
  .blog-adjacent-shell { width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2))); margin:0 auto clamp(76px,9vw,120px); }
  .blog-adjacent { width:auto; margin:0; }
  .adjacent-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-4); }
  .only-newer .newer { grid-column:2; }
  .adjacent-card { display:flex; min-height:170px; flex-direction:column; justify-content:center; gap:var(--space-2); padding:var(--space-4); transition:transform var(--motion-mid) ease,background-color var(--motion-mid) ease; }
  .adjacent-card.newer { text-align:right; }
  .direction { color:var(--gold); font-size:var(--font-size-small); line-height:var(--line-height-small); font-weight:600; }
  .adjacent-card strong { color:var(--text); font-size:var(--font-size-title); font-weight:600; line-height:var(--line-height-title); overflow-wrap:anywhere; }
  .adjacent-card time { color:var(--muted); font-size:var(--font-size-small); line-height:var(--line-height-small); }
  .adjacent-card:focus-visible { outline:2px solid var(--gold); outline-offset:4px; }
  .editorial-trust { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:var(--space-2) var(--space-4); margin-top:24px; padding:var(--space-3) var(--space-4); border:1px solid var(--line); border-radius:var(--radius-card); background:var(--panel); }
  .editorial-trust p { color:var(--muted); font-size:var(--font-size-body); line-height:var(--line-height-body); margin:0; }
  .editorial-trust a { display:inline-flex; align-items:center; min-height:var(--touch-target); padding:0 8px; color:var(--gold); font-size:var(--font-size-body); line-height:var(--line-height-body); font-weight:600; text-decoration:underline; text-underline-offset:3px; transition:color var(--motion-fast) ease; }
  .editorial-trust a:hover { color:var(--gold-hover); }
  .editorial-trust a:active { color:var(--gold-active); }
  .editorial-trust a:focus-visible { outline:2px solid var(--gold); outline-offset:4px; }
  .adjacent-card:active { border-color:var(--gold-active); background:var(--fill); transform:translateY(0); }
  @media (hover:hover) and (pointer:fine) { .adjacent-card:hover { background:var(--panel2); transform:translateY(-3px); } }
  @media (max-width:767px) { .adjacent-grid { grid-template-columns:1fr; gap:var(--space-2); } .only-newer .newer { grid-column:auto; } .adjacent-card { min-height:0; } .editorial-trust { display:block; padding:var(--space-3); } .editorial-trust a { display:inline-flex; margin-top:var(--space-2); } }
  @media (prefers-reduced-motion:reduce) { .adjacent-card { transition:none; } }
</style>
