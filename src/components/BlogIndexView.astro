---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveHeroBackdrop from './ResponsiveHeroBackdrop.astro';
import Pagination from './pagination/Pagination.astro';
import Breadcrumb from './Breadcrumb.astro';
import { articleHref, blogArticlesNewestFirst, blogCategoryLabels, blogPageHref, formatBlogDate } from '../blog/articles';
import { catalog } from '../data/catalog';
import { imageUrl, sourceImageUrl } from '../domain/chroma';
import { SITE } from '../seo/site';
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';

interface Props {
  /** 当前页码（从 1 起）。 */
  page: number;
  /** 每页文章数。 */
  pageSize: number;
  /** 区域设置；省略时由 Astro.currentLocale 推断。 */
  locale?: Locale;
  /** 广告位标识；仅在第 1 页传入 'editorial-article'，分页页不投放。 */
  adPlacement?: 'editorial-article';
}

const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const { page, pageSize, adPlacement } = Astro.props;

const totalPages = Math.ceil(blogArticlesNewestFirst.length / pageSize);
const safePage = Math.min(Math.max(page, 1), totalPages);
const startIndex = (safePage - 1) * pageSize;
const visibleArticles = blogArticlesNewestFirst.slice(startIndex, startIndex + pageSize);

const article = blogArticlesNewestFirst[0];
const backgroundChroma = catalog.find((item) => item.rank === 1);
if (!backgroundChroma) throw new Error('The blog background requires a rank-one chroma');
const baseTitle = isZh ? '臻彩资讯与指南' : 'Prestige Chroma News & Guides';
const title = safePage <= 1 ? `${baseTitle} | ${SITE.name}` : `${baseTitle} — ${isZh ? `第 ${safePage} 页` : `Page ${safePage}`} | ${SITE.name}`;
const description = isZh ? '臻彩活动资讯、版本更新追踪、数据分析与获取指南。' : 'Prestige chroma event news, patch updates, data analysis, and collection guides.';
const canonicalPath = blogPageHref(safePage, locale);
const canonical = new URL(canonicalPath, SITE.origin).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonical,
  inLanguage: isZh ? 'zh-CN' : 'en',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: new URL(localizedPath(locale, '/'), SITE.origin).toString() },
};

const coverFallbacks: Record<string, string> = {};
for (const entry of blogArticlesNewestFirst) {
  if (entry.coverUrl.startsWith('http')) {
    const match = catalog.find((c) => imageUrl(c.images.large) === entry.coverUrl || imageUrl(c.images.medium) === entry.coverUrl);
    if (match) coverFallbacks[entry.slug] = sourceImageUrl('large', match.instanceId);
  }
}

const prevText = isZh ? '上一页' : 'Previous';
const nextText = isZh ? '下一页' : 'Next';
const ariaLabel = isZh ? '博客分页' : 'Blog pagination';
---

<BaseLayout {title} {description} {canonical} image={article.coverUrl} {jsonLd} {locale} {adPlacement}>
  <div class="blog-page">
    <section class="blog-hero" data-backdrop-scope>
      <div class="page-backdrop page-backdrop--behind blog-backdrop">
        <ResponsiveHeroBackdrop
          largeSrc={imageUrl(backgroundChroma.images.large)}
          mediumSrc={imageUrl(backgroundChroma.images.medium)}
          largeFallback={sourceImageUrl('large', backgroundChroma.instanceId)}
          mediumFallback={sourceImageUrl('medium', backgroundChroma.instanceId)}
          opacity={.7}
          mobileOpacity={.85}
        />
      </div>
      <header class="blog-heading">
        <Breadcrumb article {locale} items={[
          { title: isZh ? '首页' : 'Home', href: localizedPath(locale, '/') },
          { title: isZh ? '博客' : 'Blog' },
        ]} />
        {isZh ? <div>
          <p class="kicker">LoL CHROMA ART 博客</p>
          <h1>臻彩资讯与活动追踪</h1>
          <p>活动公告、版本更新、数据分析与臻彩获取指南，记录峡谷内外的故事。</p>
        </div> : <div>
          <p class="kicker">LoL CHROMA ART BLOG</p>
          <h1>Prestige Chroma News & Guides</h1>
          <p>Event announcements, patch updates, data analysis, and everything about prestige chroma collection.</p>
        </div>}
      </header>
      <section class="blog-index">
        <div class="post-list">
        {visibleArticles.map((entry, index) => {
          return (
        <article class="featured-post chroma-card">
          <a class="featured-post-link" href={articleHref(entry, locale)}>
            <div class="featured-post-art">
              <img src={entry.coverUrl} alt={isZh ? entry.coverAltZh : entry.coverAltEn} data-fallback={coverFallbacks[entry.slug] ?? '/placeholder.svg'} data-placeholder="/placeholder.svg" width={800} height={450} loading={index === 0 && safePage === 1 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            <div class="featured-post-copy">
              <p class="eyebrow">{isZh ? blogCategoryLabels[entry.category].zh : blogCategoryLabels[entry.category].en}</p>
              <h2>{isZh ? entry.titleZh : entry.titleEn}</h2>
              <p class="post-summary">{isZh ? entry.summaryZh : entry.summaryEn}</p>
              <p class="post-meta">
                <time datetime={entry.publishedAt}>{formatBlogDate(entry.publishedAt, isZh ? 'zh' : 'en')}</time>
                <span aria-hidden="true">·</span>
                <span>{isZh ? `阅读约 ${entry.readingMinutes} 分钟` : `${entry.readingMinutes} min read`}</span>
              </p>
              <span class="read-more">{isZh ? '阅读全文 →' : 'Read the story →'}</span>
            </div>
          </a>
        </article>
        );
        })}
        </div>
        {totalPages > 1 && (
          <Pagination current={safePage} total={totalPages} href={(p) => blogPageHref(p, locale)} prevText={prevText} nextText={nextText} ariaLabel={ariaLabel} iconsOnly indicator={isZh ? `第 ${safePage} / ${totalPages} 页` : `Page ${safePage} of ${totalPages}`} />
        )}
      </section>
    </section>
  </div>

  <style>
    .blog-page { background:var(--bg); }
    .blog-hero { position:relative; isolation:isolate; margin-top:calc(-1 * var(--site-header-height)); min-height:100svh; padding:calc(clamp(58px,7vw,88px) + var(--site-header-height)) 0 110px; }
    .blog-heading { position:relative; z-index:1; width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2))); margin-inline:auto; }
    .blog-heading > :global(.cn-breadcrumb) { width:100%; margin:calc(-1 * clamp(58px,7vw,88px)) 0 var(--space-3); }
    .blog-index { position:relative; z-index:1; width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2))); margin-inline:auto; padding-top:clamp(32px,4vw,48px); }
    .blog-heading h1 { font-size:var(--font-size-headline-lg); line-height:var(--line-height-headline-lg); margin:.28em 0 .32em; font-weight:600; overflow-wrap:anywhere; text-shadow:0 5px 30px #000b; }
    .blog-heading>div>p:last-child { color:var(--muted); font-size:var(--font-size-body); line-height:var(--line-height-body); margin:0; text-shadow:0 2px 18px #000; }
    .post-list { display:grid; gap:24px; }
    .featured-post-link { display:grid; grid-template-columns:minmax(0,1fr) minmax(320px,1fr); min-height:360px; }
    .featured-post-art { min-width:0; overflow:hidden; background:var(--fill); }
    .featured-post-art img { display:block; width:100%; height:100%; object-fit:cover; transition:transform var(--motion-slow) ease; }
    .featured-post-copy { display:flex; min-width:0; flex-direction:column; justify-content:center; padding:var(--space-4); }
    .featured-post-copy h2 { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:3; font-size:var(--font-size-headline-md); font-weight:600; line-height:var(--line-height-headline-md); margin:.45em 0 .38em; overflow-wrap:anywhere; }
    .post-summary { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:3; color:var(--text); font-size:var(--font-size-body); line-height:var(--line-height-body); margin:0; }
    .post-meta { display:flex; flex-wrap:wrap; gap:var(--space-2); color:var(--muted); font-size:var(--font-size-small); line-height:var(--line-height-small); margin:var(--space-4) 0; }
    .read-more { color:var(--gold); font-weight:600; text-decoration:underline; text-underline-offset:3px; }
    .featured-post-link:focus-visible { outline:2px solid var(--gold); outline-offset:-4px; }
    .featured-post-link:active { background:var(--fill); }
    @media (hover:hover) and (pointer:fine) { .featured-post:hover { background:var(--panel2); } }
    .blog-index > :global(.cn-pagination) { margin-top:48px; }
    .featured-post-link:active .featured-post-art img { transform:scale(1.01); }
    .featured-post-link:active .read-more { color:var(--gold-active); }
    @media (hover:hover) and (pointer:fine) { .featured-post-link:hover .featured-post-art img { transform:scale(1.025); } .featured-post-link:hover .read-more { color:var(--gold-hover); } }
    @media (min-width: 1280px) { .featured-post-link { grid-template-columns:minmax(0,1.3fr) minmax(320px,1fr); } }
    @media (max-width: 1023px) { .featured-post-link { grid-template-columns:minmax(0,1fr) minmax(280px,1fr); min-height:340px; } }
    @media (max-width: 767px) {
      .blog-hero { padding:calc(44px + var(--site-header-height)) 0 76px; }
      .blog-heading > :global(.cn-breadcrumb) { margin-top:-44px; }
      .blog-index { padding-top:32px; }
      .blog-heading h1 { font-size:var(--font-size-headline-lg); }
      .featured-post-link { grid-template-columns:1fr; height:auto; min-height:0; }
      .featured-post-art img { height:auto; max-height:70svh; object-fit:contain; }
      .featured-post-copy { padding:var(--space-4); }
    }
    @media (prefers-reduced-motion:reduce) { .featured-post-art img { transition:none; } }
  </style>
</BaseLayout>
