---
import ChromaColorCircle from './ChromaColorCircle.astro';
import type { Chroma } from '../domain/chroma';
import { imageUrl, sourceImageUrl } from '../domain/chroma';
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';

interface Props {
  chroma?: Chroma;
  labelEn?: string;
  labelZh?: string;
  locale?: Locale;
}

const { chroma, labelEn, labelZh } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const nameEn = labelEn ?? chroma?.nameEn;
const nameZh = labelZh ?? chroma?.nameZh;
if (!nameEn || !nameZh) throw new Error('BlogPrestigeChromaCard requires chroma or both labelEn and labelZh');
const isZh = locale === 'zh-cn';
const name = isZh ? nameZh : nameEn;
const image = chroma ? imageUrl(chroma.images.medium) : '/placeholder.svg';
const fallback = chroma ? sourceImageUrl('medium', chroma.instanceId) : undefined;
---

<li class:list={['blog-chroma-card', chroma && 'chroma-card', { 'blog-chroma-card--placeholder': !chroma }]}>
  {chroma ? (
    <a class="blog-chroma-card-link" href={localizedPath(locale, `/chromas/${chroma.slug}/`)}>
      <div class="blog-chroma-card-img-wrap">
        <img src={image} data-fallback={fallback} data-placeholder="/placeholder.svg" data-alt-en={`${nameEn} prestige chroma splash art`} data-alt-zh={`${nameZh}臻彩原画`} alt={isZh ? `${nameZh}臻彩原画` : `${nameEn} prestige chroma splash art`} width="960" height="540" loading="lazy" decoding="async" />
        <div class="blog-chroma-card-color"><ChromaColorCircle colors={chroma.colors} /></div>
      </div>
      <span class="blog-chroma-card-name">{name}</span>
    </a>
  ) : (
    <div class="blog-chroma-card-placeholder">
      <div class="blog-chroma-card-img-wrap">
        <img src={image} data-placeholder="/placeholder.svg" data-alt-en={`${nameEn} prestige chroma splash art`} data-alt-zh={`${nameZh}臻彩原画`} alt={isZh ? `${nameZh}臻彩原画` : `${nameEn} prestige chroma splash art`} width="960" height="540" loading="lazy" decoding="async" />
      </div>
      <span class="blog-chroma-card-name">{name}</span>
    </div>
  )}
</li>

<style is:global>
  .blog-chroma-grid .blog-chroma-card.chroma-card{transition:transform var(--motion-fast) ease,background-color var(--motion-fast) ease}
  .blog-chroma-grid .blog-chroma-card--placeholder{min-width:0;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-card);overflow:hidden}
  .blog-chroma-grid .blog-chroma-card.chroma-card:hover{background:var(--panel2);transform:translateY(-2px)}
  .blog-chroma-grid .blog-chroma-card.chroma-card:active{border-color:var(--gold-active);transform:translateY(0)}
  .blog-chroma-grid .blog-chroma-card-link,.blog-chroma-grid .blog-chroma-card-placeholder{display:flex;min-height:100%;flex-direction:column;text-decoration:none;color:inherit}
  .blog-chroma-grid .blog-chroma-card-link:focus-visible{outline:2px solid var(--gold);outline-offset:-3px}
  .blog-chroma-grid .blog-chroma-card-img-wrap{position:relative;width:100%;padding:8px;overflow:hidden;background:var(--fill) url('/img/backgrounds/chroma-card-background.jpg') center/cover no-repeat}
  .blog-chroma-grid .blog-chroma-card-img-wrap img{display:block;width:100%;height:auto}
  .blog-chroma-grid .blog-chroma-card-color{position:absolute;left:50%;bottom:7px;transform:translateX(-50%);display:inline-flex;line-height:0;padding:3px;border:1px solid var(--line);border-radius:50%;background:var(--panel)}
  .blog-chroma-grid .blog-chroma-card-name{display:flex;align-items:center;justify-content:center;text-align:center;min-height:48px;padding:var(--space-2);font-size:var(--font-size-small);font-weight:600;line-height:var(--line-height-small);color:var(--text);overflow-wrap:anywhere}
</style>
