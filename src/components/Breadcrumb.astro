---
import DownOutlined from './icons/DownOutlined.astro';
import HomeOutlined from './icons/HomeOutlined.astro';
import { resolveLocale, type Locale } from '../i18n/config';
import { buildBreadcrumbEntries, type BreadcrumbItem } from './breadcrumb';
import DomainIcon from './DomainIcon.astro';

interface Props {
  items: BreadcrumbItem[];
  separator?: string;
  params?: Record<string, string | number>;
  ariaLabel?: string;
  locale?: Locale;
  article?: boolean;
}

const { items, article = false } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const ariaLabel = Astro.props.ariaLabel ?? (locale === 'zh-cn' ? '面包屑' : 'Breadcrumb');
const entries = buildBreadcrumbEntries(items, Astro.props.separator ?? '/', Astro.props.params);
const lastRouteIndex = entries.reduce((last, entry, index) => entry.type === 'route' ? index : last, -1);
const firstRouteIndex = entries.findIndex((entry) => entry.type === 'route');
const menuHref = (base: string | undefined, path: string | undefined) => path === undefined ? base : `${base ?? ''}${path.startsWith('/') ? path : `/${path}`}`;
---

<nav class:list={['ant-breadcrumb', 'cn-breadcrumb', { 'cn-breadcrumb--article': article }]} aria-label={ariaLabel}>
  <ol class="cn-breadcrumb-list ant-breadcrumb-list">
    {entries.map((entry, index) => entry.type === 'separator' ? (
      <li class="cn-breadcrumb-separator ant-breadcrumb-separator" role="presentation" aria-hidden="true">{entry.separator}</li>
    ) : (
      <li class:list={['cn-breadcrumb-item', 'ant-breadcrumb-item', entry.class]} {...entry.attributes}>
        {entry.menu ? (
          <details class="cn-breadcrumb-menu">
            <summary>
              {entry.href && <a class="cn-breadcrumb-link ant-breadcrumb-link" href={entry.href}>{entry.icon && <DomainIcon name={entry.icon} class="cn-breadcrumb-icon" />}{index === firstRouteIndex && <HomeOutlined class="cn-breadcrumb-home-icon" />}{entry.title}</a>}
              {!entry.href && <span class="cn-breadcrumb-link ant-breadcrumb-link" aria-current={index === lastRouteIndex ? 'page' : undefined}>{entry.icon && <DomainIcon name={entry.icon} class="cn-breadcrumb-icon" />}{index === firstRouteIndex && <HomeOutlined class="cn-breadcrumb-home-icon" />}{entry.title}</span>}
              <DownOutlined class="cn-breadcrumb-menu-icon" />
            </summary>
            <ul class="cn-breadcrumb-menu-list">
              {entry.menu.items.map((menuItem) => {
                const label = menuItem.label ?? menuItem.title;
                const href = menuItem.href ?? (menuItem.path !== undefined ? menuHref(entry.href, menuItem.path) : undefined);
                return <li>{href ? <a href={href}>{label}</a> : <span>{label}</span>}</li>;
              })}
            </ul>
          </details>
        ) : entry.href ? (
          <a class="cn-breadcrumb-link ant-breadcrumb-link" href={entry.href}>{entry.icon && <DomainIcon name={entry.icon} class="cn-breadcrumb-icon" />}{index === firstRouteIndex && <HomeOutlined class="cn-breadcrumb-home-icon" />}{entry.title}</a>
        ) : (
          <span class="cn-breadcrumb-page ant-breadcrumb-link" aria-current={index === lastRouteIndex ? 'page' : undefined}>{entry.icon && <DomainIcon name={entry.icon} class="cn-breadcrumb-icon" />}{index === firstRouteIndex && <HomeOutlined class="cn-breadcrumb-home-icon" />}{entry.title}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
