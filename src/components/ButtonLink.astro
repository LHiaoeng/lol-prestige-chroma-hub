---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  iconOnly?: boolean;
  variant?: 'default' | 'link';
}

const { iconOnly = false, variant = 'link', class: className, ...attributes } = Astro.props;
---

<a {...attributes} class:list={['ant-btn', { 'ant-btn-variant-link': variant === 'link', 'ant-btn-icon-only': iconOnly }, className]}><slot /></a>
