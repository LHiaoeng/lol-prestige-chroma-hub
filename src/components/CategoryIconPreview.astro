---
interface Props { src: string }
import { resolveLocale } from '../i18n/config';
const { src } = Astro.props;
const isZh = resolveLocale(Astro.currentLocale) === 'zh-cn';
---
<span class="category-icon-wrap" tabindex="0" aria-label={isZh ? '预览分类图标' : 'Preview category icon'}>
  <img class="category-icon-thumb" {src} alt="" aria-hidden="true" />
  <span class="category-icon-tooltip" role="tooltip" aria-hidden="true"><img {src} alt="" /></span>
</span>
<style>
  .category-icon-wrap{display:inline-flex;position:relative;align-items:center;justify-content:center;flex:none;min-width:36px;min-height:36px;outline:none}.category-icon-thumb{display:block;width:36px;height:36px;object-fit:contain;cursor:zoom-in}.category-icon-tooltip{display:none;position:absolute;z-index:30;bottom:calc(100% + 8px);left:50%;padding:var(--space-2);border:1px solid var(--line);border-radius:var(--radius-card);background:var(--panel2);transform:translateX(-50%);box-shadow:var(--shadow-popup);pointer-events:none}.category-icon-tooltip img{display:block;width:auto;height:auto;max-width:none;max-height:none;object-fit:initial}.category-icon-wrap:hover .category-icon-tooltip,.category-icon-wrap:focus .category-icon-tooltip{display:block}.category-icon-wrap:focus-visible{outline:2px solid var(--gold);outline-offset:1px;border-radius:var(--radius-control)}
  @media(max-width:767px){.category-icon-wrap{min-width:var(--touch-target);min-height:var(--touch-target)}}
</style>
