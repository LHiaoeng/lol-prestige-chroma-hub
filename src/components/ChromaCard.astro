---
import type { Chroma } from '../domain/chroma';
import { imageUrl, sourceImageUrl } from '../domain/chroma';
import { categoryName } from '../i18n';
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';
import { chromaImageAlt } from '../seo/chroma-seo';
interface Props { chroma: Chroma; eager?: boolean; locale?: Locale }
const { chroma, eager = false } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const name = isZh ? chroma.nameZh : chroma.nameEn;
---
<article class="chroma-card">
  <a href={localizedPath(locale, `/chromas/${chroma.slug}/`)} aria-label={isZh ? `查看 ${chroma.nameZh} 详情` : `View ${chroma.nameEn} details`}>
    <div class="card-image">
      <img
        src={imageUrl(chroma.images.medium)}
        data-fallback={sourceImageUrl('medium', chroma.instanceId)}
        data-placeholder="/placeholder.svg"
        alt={chromaImageAlt(name, locale)}
        width="960" height="540" loading={eager ? 'eager' : 'lazy'} decoding="async"
      />
      {chroma.isNew && <span class="new-badge">{isZh ? '新增' : 'NEW'}</span>}
      <img class="category-icon" src={sourceImageUrl('tag', chroma.tagId)} alt="" aria-hidden="true" />
    </div>
    <div class="card-body">
      <h2>{name}</h2>
      <div class="card-tags">
        <span class="category">{categoryName(chroma.categoryId, isZh ? 'zh' : 'en')}</span>
        <span class="version-tag">{chroma.gameVer}</span>
      </div>
    </div>
  </a>
</article>
<style is:global>
  .card-image { aspect-ratio: 1; }
  .card-image img { object-position: center top; }
  .card-image .category-icon { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%) scale(.6); transform-origin: center bottom; width: auto; height: auto; max-width: none; max-height: none; object-fit: initial; }
  .card-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .version-tag { display: inline-flex; color: var(--gold); border: 1px solid var(--line); border-radius: 999px; padding: 4px 8px; font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
</style>
