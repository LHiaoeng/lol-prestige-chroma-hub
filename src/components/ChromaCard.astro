---
import type { Chroma } from '../domain/chroma';
import { imageUrl, sourceImageUrl } from '../domain/chroma';
import { categoryName } from '../i18n';
import ChromaColorCircle from './ChromaColorCircle.astro';
interface Props { chroma: Chroma; eager?: boolean }
const { chroma, eager = false } = Astro.props;
---
<article class="chroma-card">
  <a href={`/chromas/${chroma.slug}/`} aria-label={`View ${chroma.nameEn} details`} data-aria-en={`View ${chroma.nameEn} details`} data-aria-zh={`查看 ${chroma.nameZh} 详情`}>
    <div class="card-image">
      <img
        src={imageUrl(chroma.images.medium)}
        data-fallback={sourceImageUrl('medium', chroma.instanceId)}
        data-placeholder="/placeholder.svg"
        alt={`${chroma.heroNameEn} ${chroma.nameEn} chroma splash art`}
        data-alt-en={`${chroma.heroNameEn} ${chroma.nameEn} chroma splash art`}
        data-alt-zh={`${chroma.heroNameZh} ${chroma.nameZh} 臻彩皮肤`}
        width="960" height="540" loading={eager ? 'eager' : 'lazy'} decoding="async"
      />
      {chroma.isNew && <span class="new-badge" data-en="NEW" data-zh="新增">NEW</span>}
      <span class="card-colors"><ChromaColorCircle colors={chroma.colors} /></span>
    </div>
    <div class="card-body">
      <p class="eyebrow" data-en={`${chroma.heroNameEn} · ${chroma.gameVer}`} data-zh={`${chroma.heroNameZh} · ${chroma.gameVer}`}>{chroma.heroNameEn} · {chroma.gameVer}</p>
      <h2 data-en={chroma.nameEn} data-zh={chroma.nameZh}>{chroma.nameEn}</h2>
      <span class="category" data-en={categoryName(chroma.categoryId, 'en')} data-zh={categoryName(chroma.categoryId, 'zh')}>{categoryName(chroma.categoryId, 'en')}</span>
    </div>
  </a>
</article>
<style is:global>
  .card-image { aspect-ratio: 1; }
  .card-image img { object-position: center top; }
  .card-colors { position: absolute; right: 12px; bottom: 12px; }
</style>
