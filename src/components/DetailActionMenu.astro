---
export interface DetailAction {
  labelEn: string;
  labelZh: string;
  href: string;
}

interface Props {
  actions: DetailAction[];
  locale?: import('../i18n/config').Locale;
}

const { actions } = Astro.props;
import { resolveLocale } from '../i18n/config';
const isZh = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) === 'zh-cn';
const label = (action: DetailAction) => isZh ? action.labelZh : action.labelEn;
---
{actions.length === 1 ? (
  <a class="detail-action-link" href={actions[0].href} target="_blank" rel="noopener noreferrer" aria-label={label(actions[0])} title={label(actions[0])}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M14 4h6v6M20 4l-9 9M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" />
    </svg>
  </a>
) : actions.length > 1 && (
  <details class="detail-action-menu">
    <summary aria-label={isZh ? '外部操作' : 'External actions'} title={isZh ? '外部操作' : 'External actions'}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14 4h6v6M20 4l-9 9M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" />
      </svg>
    </summary>
    <nav class="detail-action-list" aria-label={isZh ? '外部操作' : 'External actions'}>
      {actions.map((action) => (
        <a href={action.href} target="_blank" rel="noopener noreferrer" aria-label={label(action)}>
          {label(action)}
        </a>
      ))}
    </nav>
  </details>
)}

<style>
  .detail-action-menu { position: relative; flex: 0 0 auto; }
  .detail-action-link, summary { display: grid; place-items: center; width: var(--control-height); height: var(--control-height); cursor: pointer; color: var(--gold); border: 1px solid var(--line); border-radius: var(--radius-control); background:var(--panel); list-style: none; transition:color var(--motion-fast) ease,border-color var(--motion-fast) ease,background-color var(--motion-fast) ease; }
  summary::-webkit-details-marker { display: none; }
  .detail-action-link:hover, summary:hover { border-color: var(--gold-hover); color: var(--gold-hover); background: var(--hover-bg); }
  .detail-action-link:active, summary:active { border-color: var(--gold-active); color: var(--gold-active); }
  .detail-action-link:focus-visible, summary:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  [open] summary { border-color: var(--gold); background: var(--hover-bg); }
  .detail-action-link svg, summary svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .detail-action-menu > .detail-action-list { position: absolute; z-index: 5; right: 0; top: calc(100% + 8px); width: min(250px, calc(100vw - 28px)); display: grid; grid-template-columns: 1fr; padding: 6px; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--panel2); box-shadow: var(--shadow-popup); }
  .detail-action-list > a { display: flex; width: 100%; min-height: var(--control-height); align-items: center; padding: 4px 11px; border-radius: var(--radius-control); color: var(--text); font-size: var(--font-size-body); line-height:var(--line-height-body); overflow-wrap: anywhere; transition: color var(--motion-fast) ease, background-color var(--motion-fast) ease; }
  .detail-action-list > a:hover { color: var(--gold-hover); background: var(--hover-bg); }
  .detail-action-list > a:active { color: var(--gold-active); }
  .detail-action-list > a:focus-visible { outline: 2px solid var(--gold); outline-offset: -2px; }
  @media(max-width:767px){.detail-action-link,summary{width:var(--touch-target);height:var(--touch-target)}.detail-action-list>a{min-height:var(--touch-target)}}
</style>

<script>
  const closeMenusOutside = (target?: Node | null) => {
    document.querySelectorAll<HTMLDetailsElement>('.detail-action-menu[open]').forEach((menu) => {
      if (!target || !menu.contains(target)) menu.removeAttribute('open');
    });
  };

  document.addEventListener('pointerdown', (event) => closeMenusOutside(event.target as Node));
</script>
