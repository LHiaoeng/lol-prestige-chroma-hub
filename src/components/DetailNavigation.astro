---
import LeftOutlined from './icons/LeftOutlined.astro';
import RightOutlined from './icons/RightOutlined.astro';
import type { Locale } from '../i18n/config';

interface Target { readonly href: string; readonly name: string }
interface Props {
  readonly locale: Locale;
  readonly targets?: { readonly previous: Target; readonly next: Target };
}

const { locale, targets } = Astro.props;
const isZh = locale === 'zh-cn';
const groupLabel = targets ? (isZh ? '切换臻彩' : 'Prestige chroma navigation') : (isZh ? '切换皮肤' : 'Skin navigation');
const Control = targets ? 'a' : 'button';
---

<div class="runtime-skin-navigation" data-runtime-skin-navigation role="group" aria-label={groupLabel} hidden={!targets}>
  {(['previous', 'next'] as const).map((direction) => {
    const previous = direction === 'previous';
    const target = targets?.[direction];
    const label = targets
      ? (previous ? (isZh ? '上一款臻彩' : 'Previous prestige chroma') : (isZh ? '下一款臻彩' : 'Next prestige chroma'))
      : (previous ? (isZh ? '上一款皮肤' : 'Previous skin') : (isZh ? '下一款皮肤' : 'Next skin'));
    return <div class:list={['runtime-skin-navigation-side', 'runtime-skin-navigation-side--' + direction]}>
      <Control
        class="ant-btn ant-btn-text runtime-skin-navigation-button"
        data-happy-wave
        {...(target ? { href: target.href, rel: previous ? 'prev' : 'next' } : { type: 'button', disabled: true })}
        data-runtime-skin-navigation-previous={previous ? '' : undefined}
        data-runtime-skin-navigation-next={previous ? undefined : ''}
        aria-label={target ? label + (isZh ? '：' : ': ') + target.name : label}
      >
        {previous && <LeftOutlined />}
        <span class="runtime-skin-navigation-name" data-runtime-skin-navigation-previous-name={previous ? '' : undefined} data-runtime-skin-navigation-next-name={previous ? undefined : ''} hidden={!target} title={target?.name}>{target?.name}</span>
        {!previous && <RightOutlined />}
      </Control>
    </div>;
  })}
</div>

<script>
  const skinNavigation = document.querySelector<HTMLElement>('[data-runtime-skin-navigation]');
  const footer = document.querySelector<HTMLElement>('footer');
  if (skinNavigation && footer) {
    const pageShell = skinNavigation.closest<HTMLElement>('[data-runtime-page-shell], main');
    const pageSpacing = getComputedStyle(document.documentElement);
    const footerGap = Number.parseFloat(pageSpacing.getPropertyValue('--space-3'));
    const contentGap = Number.parseFloat(pageSpacing.getPropertyValue('--space-4'));
    const updatePosition = () => {
      const height = skinNavigation.offsetHeight;
      if (skinNavigation.hidden) pageShell?.style.removeProperty('--runtime-skin-navigation-page-padding');
      else pageShell?.style.setProperty('--runtime-skin-navigation-page-padding', `${height + footerGap + contentGap}px`);
      const footerTop = footer.getBoundingClientRect().top;
      skinNavigation.style.setProperty('--runtime-skin-navigation-footer-offset', `${window.innerHeight - footerTop + footerGap}px`);
      const headerHeight = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--site-header-height')) || 0;
      skinNavigation.toggleAttribute('data-footer-occluded', footerTop <= height + headerHeight + footerGap);
    };
    window.addEventListener('scroll', updatePosition, { passive: true });
    window.addEventListener('resize', updatePosition);
    if ('ResizeObserver' in window) new ResizeObserver(updatePosition).observe(skinNavigation);
    updatePosition();
  }
  const previous = skinNavigation?.querySelector<HTMLAnchorElement>('a[data-runtime-skin-navigation-previous]');
  const next = skinNavigation?.querySelector<HTMLAnchorElement>('a[data-runtime-skin-navigation-next]');
  if (previous && next) {
    document.addEventListener('keydown', (event) => {
      const target = event.key === 'ArrowLeft' ? previous : event.key === 'ArrowRight' ? next : undefined;
      if (!target || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (document.querySelector('dialog[open]')) return;
      if (event.target instanceof Element && event.target.closest('input, select, textarea, button, a, [contenteditable], [role="button"], [role="radio"], [role="menuitem"], [role="menuitemradio"]')) return;
      event.preventDefault();
      target.click();
    });
  }
</script>

<style is:global>
  .runtime-skin-navigation { position: fixed; z-index: 9; inset: 0; pointer-events: none; }
  .runtime-skin-navigation[hidden] { display: none; }
  .runtime-skin-navigation-side { position: absolute; top: 50%; display: flex; align-items: center; gap: var(--space-2); max-width: calc(50vw - var(--page-gutter)); transform: translateY(-50%); }
  .runtime-skin-navigation-side--previous { left: var(--page-gutter); }
  .runtime-skin-navigation-side--next { right: var(--page-gutter); }
  .runtime-skin-navigation-button.ant-btn-text { display: inline-flex; align-items: center; width: max-content; min-width: var(--control-height); min-height: var(--control-height); max-width: 100%; gap: var(--space-2); padding: 8px 12px; border-color: transparent; background: transparent; color: var(--text); font-size: var(--font-size-body); font-weight: 600; line-height: var(--line-height-body); box-shadow: none; pointer-events: auto; }
  .runtime-skin-navigation-button.ant-btn-text:hover:not(:disabled) { border-color: transparent; background: color-mix(in srgb, var(--gold) 10%, transparent); color: var(--gold-text); }
  .runtime-skin-navigation-button:not(:disabled) svg { color: var(--gold-text); }
  .runtime-skin-navigation-button svg { width: 20px; height: 20px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .runtime-skin-navigation-name { display: block; min-width: 0; max-width: min(10rem, calc(50vw - var(--page-gutter) - var(--control-height) - var(--space-2) - 26px)); overflow: hidden; color: inherit; font-size: inherit; font-weight: inherit; line-height: inherit; text-align: left; text-overflow: ellipsis; white-space: nowrap; }
  .runtime-skin-navigation-side--next .runtime-skin-navigation-name { text-align: right; }
  .runtime-skin-navigation-name[hidden] { display: none; }
  @media (min-width: 1600px) {
    .runtime-skin-navigation-side--previous { left: calc((100vw - var(--content-width)) / 4); transform: translate(-50%, -50%); }
    .runtime-skin-navigation-side--next { right: calc((100vw - var(--content-width)) / 4); transform: translate(50%, -50%); }
    .runtime-skin-navigation-name { max-width: min(10rem, calc((100vw - var(--content-width)) / 2 - var(--control-height) - var(--space-2) - 26px)); }
  }
  @media (max-width: 1599px) {
    .runtime-page:has([data-runtime-skin-navigation]:not([hidden])),
    main:has(> [data-runtime-skin-navigation]:not([hidden])) {
      --runtime-skin-navigation-page-padding: calc(var(--space-5) * 3);
      padding-bottom: var(--runtime-skin-navigation-page-padding);
    }
    .runtime-skin-navigation { --runtime-skin-navigation-footer-offset: 0px; inset: auto auto max(calc(var(--float-button-bottom) + var(--control-height-lg) + var(--space-3)), var(--runtime-skin-navigation-footer-offset)) 50%; width: min(560px, calc(100vw - (var(--page-gutter) * 2))); display: flex; align-items: center; gap: var(--space-2); padding: 4px 8px; border: 1px solid var(--line); border-radius: var(--radius-control); background: color-mix(in srgb, var(--panel) 94%, transparent); box-shadow: var(--shadow-popup); backdrop-filter: blur(12px); transform: translateX(-50%); }
    .runtime-skin-navigation[data-footer-occluded] { visibility: hidden; }
    .runtime-skin-navigation-side { position: static; top: auto; left: auto; right: auto; width: calc((100% - var(--space-2)) / 2); max-width: none; min-width: 0; transform: none; }
    .runtime-skin-navigation-side--previous { justify-content: flex-start; }
    .runtime-skin-navigation-side--next { justify-content: flex-end; }
    .runtime-skin-navigation-button.ant-btn-text { width: 100%; min-width: 0; justify-content: flex-start; padding-inline: 4px; }
    .runtime-skin-navigation-side--next .runtime-skin-navigation-button { justify-content: flex-end; }
    .runtime-skin-navigation-name { display: -webkit-box; flex: 1 1 auto; max-width: none; overflow: hidden; line-height: 1.35; white-space: normal; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .runtime-skin-navigation-side--next .runtime-skin-navigation-name { text-align: right; }
  }
  @media (min-width: 768px) and (max-width: 1599px) {
    .runtime-skin-navigation { width: min(var(--content-width), calc(100vw - (var(--page-gutter) * 2))); }
    .runtime-skin-navigation-button.ant-btn-text { padding-inline: 12px; }
  }
</style>
