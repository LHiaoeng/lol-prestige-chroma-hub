---
import type { DomainIconName } from './domain-icons';
import type { Locale } from '../i18n/config';
import Icon from './icons/Icon.astro';

interface Props {
  readonly name: DomainIconName;
  readonly class?: string;
  readonly tooltipDetail?: string;
  readonly locale?: Locale;
}

const { name, class: className, tooltipDetail, locale } = Astro.props;
---

<Icon name={name} class={['domain-icon', `domain-icon--${name}`, className].filter(Boolean).join(' ')} data-domain-icon-name={name} data-domain-icon-tooltip-detail={tooltipDetail} data-domain-icon-tooltip-locale={locale} />

<script>
  import { setDomainIconTooltip } from './domain-icons';

  document.querySelectorAll<SVGSVGElement>('[data-domain-icon-tooltip-detail]').forEach((icon) => {
    const name = icon.dataset.domainIconName;
    if (!name) return;
    setDomainIconTooltip(
      icon,
      name as Parameters<typeof setDomainIconTooltip>[1],
      icon.dataset.domainIconTooltipDetail ?? '',
      icon.dataset.domainIconTooltipLocale ?? 'en',
    );
    icon.removeAttribute('data-domain-icon-tooltip-detail');
  });
</script>
