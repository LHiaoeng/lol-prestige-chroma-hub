---
import type { Chroma } from '../domain/chroma';
import { categoryName } from '../i18n';
import { resolveLocale, type Locale } from '../i18n/config';
import Input from './Input.astro';
import Select from './Select.astro';
interface Props { catalog: Chroma[]; locale?: Locale }
const { catalog } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const heroes = [...new Map(catalog.map((item) => [item.heroId, { en: item.heroNameEn, zh: item.heroNameZh }])).entries()].sort((a, b) => a[1].en.localeCompare(b[1].en));
const versions = [...new Set(catalog.map((item) => item.gameVer))].sort((a, b) => b.localeCompare(a, undefined, { numeric: true }));
const categories = [...new Map(catalog.map((item) => [item.categoryId, item.categoryName])).entries()];
---
<details class="filter-disclosure" open>
<summary><span class="filter-disclosure-label">{isZh ? '筛选与排序' : 'Filter & sort'}</span><span class="filter-disclosure-icon" aria-hidden="true">＋</span></summary>
<form class="filters" data-filters role="search">
  <label class="search-field"><span>{isZh ? '搜索名称' : 'Search'}</span><Input name="q" type="search" maxlength={64} placeholder={isZh ? '搜索臻彩中英文名称' : 'Search prestige chroma names'} /></label>
  <label><span>{isZh ? '英雄' : 'Champion'}</span><Select name="hero" options={[{ value: '', label: isZh ? '全部英雄' : 'All champions' }, ...heroes.map(([id, name]) => ({ value: String(id), label: isZh ? name.zh : name.en }))]} /></label>
  <label><span>{isZh ? '版本' : 'Patch'}</span><Select name="version" options={[{ value: '', label: isZh ? '全部版本' : 'All patches' }, ...versions.map((version) => ({ value: version, label: version }))]} /></label>
  <label><span>{isZh ? '分类' : 'Category'}</span><Select name="category" options={[{ value: '', label: isZh ? '全部分类' : 'All categories' }, ...categories.map(([id]) => ({ value: String(id), label: categoryName(id, isZh ? 'zh' : 'en') }))]} /></label>
  <label><span>{isZh ? '新增状态' : 'Status'}</span><Select name="isNew" options={[{ value: '', label: isZh ? '全部' : 'All' }, { value: 'true', label: isZh ? '本期新增' : 'New' }, { value: 'false', label: isZh ? '非新增' : 'Archived' }]} /></label>
  <label><span>{isZh ? '排序' : 'Sort'}</span><Select name="sort" options={[{ value: 'rank_desc', label: isZh ? '推荐优先' : 'Recommended' }, { value: 'rank_asc', label: isZh ? '推荐倒序' : 'Recommended (reverse)' }, { value: 'skin_desc', label: isZh ? '皮肤 ID 降序' : 'Skin ID descending' }, { value: 'skin_asc', label: isZh ? '皮肤 ID 升序' : 'Skin ID ascending' }, { value: 'version_desc', label: isZh ? '版本降序' : 'Patch descending' }]} /></label>
  <button type="submit">{isZh ? '应用筛选' : 'Apply'}</button>
  <button type="reset" class="ghost">{isZh ? '清除' : 'Clear'}</button>
</form>
</details>
<script>
  const filterDisclosure = document.querySelector<HTMLDetailsElement>('.filter-disclosure');
  const desktop = matchMedia('(min-width: 768px)');
  const syncFilterDisclosure = () => filterDisclosure?.toggleAttribute('open', desktop.matches);
  syncFilterDisclosure();
  desktop.addEventListener('change', syncFilterDisclosure);
</script>
