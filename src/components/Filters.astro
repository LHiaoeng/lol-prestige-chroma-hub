---
import type { Chroma } from '../domain/chroma';
import { categoryName } from '../i18n';
import { resolveLocale, type Locale } from '../i18n/config';
import '../styles/catalog-filter-drawer.css';
import Button from './Button.astro';
import Input from './Input.astro';
import Select from './Select.astro';
import CloseOutlined from './icons/CloseOutlined.astro';
interface Props { catalog: Chroma[]; locale?: Locale }
const { catalog } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const heroes = [...new Map(catalog.map((item) => [item.heroId, { en: item.heroNameEn, zh: item.heroNameZh }])).entries()].sort((a, b) => a[1].en.localeCompare(b[1].en));
const versions = [...new Set(catalog.map((item) => item.gameVer))].sort((a, b) => b.localeCompare(a, undefined, { numeric: true }));
const categories = [...new Map(catalog.map((item) => [item.categoryId, item.categoryName])).entries()];
---
<form class="filters" data-filters role="search">
  <div class="catalog-filter-search-row">
    <label class="search-field"><span class="sr-only">{isZh ? '搜索名称' : 'Search'}</span><Input name="q" type="search" maxlength={64} ariaLabel={isZh ? '搜索臻彩名称' : 'Search prestige chroma names'} placeholder={isZh ? '搜索臻彩' : 'Search'} /></label>
    <div class="catalog-filter-actions" data-filter-actions>
      <Button htmlType="reset">{isZh ? '清除' : 'Clear'}</Button>
    </div>
  </div>
  <label data-filter-category><span>{isZh ? '分类' : 'Category'}</span><Select allowClear name="category" showSearch ariaLabel={isZh ? '分类' : 'Category'} options={[{ value: '', label: isZh ? '全部分类' : 'All categories' }, ...categories.map(([id]) => ({ value: String(id), label: categoryName(id, isZh ? 'zh' : 'en') }))]} /></label>
  <div class="catalog-filter-fields" data-filter-fields>
    <label><span>{isZh ? '英雄' : 'Champion'}</span><Select allowClear name="hero" showSearch options={[{ value: '', label: isZh ? '全部英雄' : 'All champions' }, ...heroes.map(([id, name]) => ({ value: String(id), label: isZh ? name.zh : name.en }))]} /></label>
    <label><span>{isZh ? '版本' : 'Patch'}</span><Select allowClear name="version" showSearch options={[{ value: '', label: isZh ? '全部版本' : 'All patches' }, ...versions.map((version) => ({ value: version, label: version }))]} /></label>
    <label><span>{isZh ? '排序' : 'Sort'}</span><Select name="sort" allowClear={false} ariaLabel={isZh ? '排序' : 'Sort'} options={[{ value: 'rank_desc', label: isZh ? '推荐优先' : 'Recommended' }, { value: 'rank_asc', label: isZh ? '推荐倒序' : 'Recommended (reverse)' }, { value: 'skin_desc', label: isZh ? '皮肤 ID 降序' : 'Skin ID descending' }, { value: 'skin_asc', label: isZh ? '皮肤 ID 升序' : 'Skin ID ascending' }, { value: 'version_desc', label: isZh ? '版本降序' : 'Patch descending' }]} /></label>
    <label><span>{isZh ? '新增状态' : 'Status'}</span><Select allowClear name="isNew" options={[{ value: '', label: isZh ? '全部' : 'All' }, { value: 'true', label: isZh ? '本期新增' : 'New' }, { value: 'false', label: isZh ? '非新增' : 'Archived' }]} /></label>
  </div>
  <Button class="catalog-filter-trigger" data-filter-open aria-haspopup="dialog" aria-controls="catalog-filter-drawer">
    {isZh ? '筛选' : 'Filter'}<span data-filter-active hidden></span>
  </Button>
  <p data-result-count>{isZh ? `共 ${catalog.length} 款臻彩` : `${catalog.length} prestige chromas`}</p>
  <dialog id="catalog-filter-drawer" class="catalog-filter-drawer" aria-labelledby="catalog-filter-title" data-select-blur-on-pick>
    <div class="catalog-filter-drawer-header">
      <Button class="catalog-filter-drawer-close" data-filter-close aria-label={isZh ? '关闭筛选' : 'Close filters'}><CloseOutlined /></Button>
      <div>
        <h2 id="catalog-filter-title">{isZh ? '筛选' : 'Filters'}</h2>
        <p data-drawer-result-count aria-live="polite">{isZh ? `共 ${catalog.length} 款臻彩` : `${catalog.length} prestige chromas`}</p>
      </div>
    </div>
    <div class="catalog-filter-drawer-body" data-filter-drawer-body></div>
    <div class="catalog-filter-drawer-footer" data-filter-drawer-footer>
      <Button data-filter-close data-filter-view>{isZh ? `查看 ${catalog.length} 款` : `View ${catalog.length} results`}</Button>
    </div>
  </dialog>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const drawer = form?.querySelector<HTMLDialogElement>('#catalog-filter-drawer');
  const trigger = form?.querySelector<HTMLButtonElement>('[data-filter-open]');
  const fields = form?.querySelector<HTMLElement>('[data-filter-fields]');
  const actions = form?.querySelector<HTMLElement>('[data-filter-actions]');
  const body = drawer?.querySelector<HTMLElement>('[data-filter-drawer-body]');
  const footer = drawer?.querySelector<HTMLElement>('[data-filter-drawer-footer]');
  if (drawer && trigger && fields && actions && body && footer) {
    const desktop = window.matchMedia('(min-width: 768px)');
    const fieldsHome = document.createComment('filter fields');
    const actionsHome = document.createComment('filter actions');
    fields.before(fieldsHome);
    actions.before(actionsHome);
    trigger.addEventListener('click', () => {
      body.append(fields);
      footer.prepend(actions);
      drawer.showModal();
    });
    drawer.addEventListener('close', () => {
      if (drawer.open) return;
      fieldsHome.after(fields);
      actionsHome.after(actions);
    });
    drawer.querySelectorAll('[data-filter-close]').forEach((button) => {
      button.addEventListener('click', () => drawer.close());
    });
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) drawer.close();
    });
    desktop.addEventListener('change', () => {
      if (desktop.matches && drawer.open) drawer.close();
    });
  }
</script>

<style>
  .catalog-filter-search-row > .search-field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }
  @media (max-width: 767px) {
    .catalog-filter-search-row { display: contents; }
    .catalog-filter-search-row > .catalog-filter-actions { display: none; }
  }
  @media (min-width: 768px) {
    .filters[data-filters] {
      position: sticky;
      top: var(--site-header-height);
      z-index: 5;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-2) var(--space-3);
      padding-block: var(--space-2) var(--space-3);
      margin-bottom: var(--space-3);
      border-bottom: var(--line-width) solid var(--line-subtle);
      background: var(--bg);
    }
    .catalog-filter-search-row {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2);
    }
    .filters > [data-result-count] { text-align: center; }
  }
</style>
