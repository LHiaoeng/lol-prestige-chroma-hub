---
import PrestigeChromaCard from './PrestigeChromaCard.astro';
import Filters from './Filters.astro';
import { toBrowserCatalog } from '../catalog/browser-catalog';
import { catalog } from '../data/catalog';
import { safeJsonLd } from '../domain/chroma';
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const browserCatalogJson = safeJsonLd(toBrowserCatalog(catalog));
---

<section class="catalog-section home-catalog" aria-labelledby="catalog-title">
  <div class="section-heading"><div class="catalog-title-group"><h2 id="catalog-title">{isZh ? '臻彩原画' : 'Prestige chroma splash arts'}</h2><a class="catalog-help-link" href={localizedPath(locale, '/blog/what-are-prestige-chromas/')} aria-label={isZh ? '什么是臻彩？' : 'What are Prestige Chromas?'}><svg aria-hidden="true" viewBox="2 2 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M9.6 9a2.5 2.5 0 1 1 4.3 1.7c-1 .9-1.9 1.3-1.9 2.8"></path><path d="M12 17h.01"></path></svg></a></div></div>
  <Filters {catalog} {locale} />
  <div class="status" data-status aria-live="polite" hidden></div>
  <div class="chroma-grid" data-chroma-list>
    {catalog.slice(0, 24).map((chroma, index) => <PrestigeChromaCard {chroma} eager={index < 4} {locale} />)}
  </div>
  <template data-chroma-card-template>
    <article class="chroma-card">
      <a href="/">
        <div class="card-image">
          <img src="/placeholder.svg" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" alt="" width="960" height="540" loading="lazy" decoding="async" />
          <img class="category-icon" src="/placeholder.svg" alt="" aria-hidden="true" />
          <span class="new-badge">{isZh ? '新增' : 'NEW'}</span>
        </div>
        <div class="card-body">
          <h2></h2>
          <div class="card-tags"><span class="version-tag"></span></div>
        </div>
      </a>
    </article>
  </template>
  {catalog.length === 0 && <div class="empty" data-initial-empty><h3>{isZh ? '资料库等待导入' : 'The archive is waiting for data'}</h3><p>{isZh ? '运行数据导入命令后，臻彩原画会在这里出现。' : 'Chroma splash arts will appear here after the data import runs.'}</p></div>}
  <nav class="cn-pagination" data-pagination aria-label={isZh ? '分页' : 'Pagination'}></nav>
</section>
<script is:inline id="catalog-data" type="application/json" set:html={browserCatalogJson}></script>
<script>
  import '../catalog/browser-app';
</script>

<style is:global>
  .home-catalog .catalog-title-group { display: flex; min-width: 0; align-items: center; gap: var(--space-2); }
  .home-catalog .catalog-help-link { display: inline-flex; width: var(--touch-target); height: var(--touch-target); flex: none; align-items: center; justify-content: center; border-radius: 50%; color: var(--gold); font-size: var(--font-size-headline-md); transition: color var(--motion-fast) ease; }
  .home-catalog .catalog-help-link svg { width: 1em; height: 1em; }
  .home-catalog .catalog-help-link:hover { color: var(--gold-hover); }
  .home-catalog .catalog-help-link:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .home-catalog .catalog-help-link { transition: none; } }
  .home-catalog .status:not([hidden]):not(.error) { padding: 8px 12px; margin: 12px 0; border: 0; }
  .home-catalog .chroma-grid { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .home-catalog .card-body { padding: 12px; }
  .home-catalog .card-body h2 { margin: 0 0 8px; font-size: var(--font-size-body); line-height: var(--line-height-body); min-height: calc(var(--line-height-body) * 2); }
  @media (max-width: 767px) {
    .home-catalog .chroma-grid { grid-template-columns: 1fr; gap: 8px; }
    .home-catalog .chroma-card > a { display: grid; grid-template-columns: 96px minmax(0, 1fr); min-height: 96px; }
    .home-catalog .card-image { width: 96px; height: 96px; aspect-ratio: 1; }
    .home-catalog .card-image .category-icon { bottom: 2px; transform: translateX(-50%) scale(.35); }
    .home-catalog .new-badge { top: 4px; right: 4px; }
    .home-catalog .card-body { display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 8px 12px; }
    .home-catalog .card-body h2 { margin: 0; min-height: 0; }
  }
</style>
