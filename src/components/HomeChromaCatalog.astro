---
import PrestigeChromaCard from './PrestigeChromaCard.astro';
import ButtonLink from './ButtonLink.astro';
import { catalog } from '../data/catalog';
import { selectNewChromas } from '../domain/featured-chroma';
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const additions = selectNewChromas(catalog);
---

<section class="catalog-section home-catalog" aria-label={isZh ? '新增臻彩' : 'New Prestige Chromas'}>
  <p class="catalog-all-action"><ButtonLink variant="default" class="ant-btn-lg" data-happy-wave href={localizedPath(locale, '/prestige-chromas/')}>{isZh ? '查看全部臻彩' : 'View all Prestige Chromas'}</ButtonLink></p>
  {additions.length === 0 && <p>{isZh ? '本期暂无新增臻彩' : 'No new Prestige Chromas this release.'}</p>}
  <div class="chroma-grid">
    {additions.map((chroma, index) => <PrestigeChromaCard {chroma} eager={index < 4} {locale} />)}
  </div>
</section>

<style is:global>
  .catalog-section.home-catalog { width: auto; margin: 0; padding-bottom: 0; }
  .home-catalog .catalog-all-action { display: flex; justify-content: center; margin: 0 0 var(--space-3); }
  .home-catalog .chroma-grid { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .home-catalog .card-body { padding: 12px; }
  .home-catalog .card-body h2 { margin: 0 0 8px; font-size: var(--font-size-body); line-height: var(--line-height-body); min-height: calc(var(--line-height-body) * 2); }
  @media (max-width: 767px) {
    .home-catalog .chroma-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  }
</style>
