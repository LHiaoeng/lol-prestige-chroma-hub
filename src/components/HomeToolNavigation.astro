---
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';
import Card from './Card.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const links = [
  { key: 'prestige-chromas', href: '/', label: isZh ? '臻彩原画' : 'Prestige chromas' },
  { key: 'pbe-additions', href: '/pbe-additions/', label: isZh ? 'PBE 新增' : 'PBE additions' },
  { key: 'champions', href: '/champions/', label: isZh ? '英雄' : 'Champions' },
  { key: 'skinlines', href: '/skinlines/', label: isZh ? '皮肤系列' : 'Skinlines' },
  { key: 'universes', href: '/universes/', label: isZh ? '皮肤宇宙' : 'Universes' },
];
const items = links.map((link) => ({ ...link, href: localizedPath(locale, link.href) }));
---

<section class="home-tool-navigation" aria-labelledby="home-tools-title">
  <div class="section-heading"><h2 id="home-tools-title">{isZh ? '英雄联盟' : 'League of Legends'}</h2></div>
  <Card
    tabList={items}
    activeTabKey="prestige-chromas"
    tabsLabel={isZh ? '游戏资料导航' : 'Game reference navigation'}
    size="medium"
  >
    <slot />
  </Card>
</section>

<style>
  .home-tool-navigation { width: min(var(--content-width), calc(100% - (var(--page-gutter) * 2))); margin: 0 auto; padding-bottom: 40px; }
  .home-tool-navigation :global(.card__tabs) { flex-wrap: wrap; overflow: visible; }
  .home-tool-navigation :global(.card__tab) { font-weight: 600; }
  @media (max-width: 767px) {
    .home-tool-navigation :global(.card__tabs) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-1); overflow: visible; }
    .home-tool-navigation :global(.card__tab:first-child) { grid-column: span 2; }
    .home-tool-navigation :global(.card__tab) { min-width: 0; padding-inline: var(--space-1); white-space: normal; }
    .home-tool-navigation :global(.card__tab::after) { right: 20%; left: 20%; }
  }
</style>
