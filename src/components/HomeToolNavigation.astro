---
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';
import Card from './Card.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const links = [
  { key: 'prestige-chromas', href: '/', label: isZh ? '臻彩原画' : 'Prestige chromas', icon: true },
  { key: 'pbe-additions', href: '/pbe-additions/', label: isZh ? 'PBE 新增' : 'PBE additions', icon: true },
  { key: 'champions', href: '/champions/', label: isZh ? '英雄' : 'Champions', icon: true },
  { key: 'skinlines', href: '/skinlines/', label: isZh ? '皮肤系列' : 'Skinlines', icon: true },
  { key: 'universes', href: '/universes/', label: isZh ? '皮肤宇宙' : 'Universes', icon: true },
];
const items = links.map((link) => ({ ...link, href: localizedPath(locale, link.href) }));
---

<section class="home-tool-navigation" aria-labelledby="home-tools-title">
  <div class="section-heading"><h2 id="home-tools-title">{isZh ? '英雄联盟' : 'League of Legends'}</h2></div>
  <Card
    tabList={items}
    activeTabKey="prestige-chromas"
    tabsLabel={isZh ? '游戏资料导航' : 'Game reference navigation'}
    size="medium"
  >
    <svg slot="tabIcon-prestige-chromas" aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>
    <svg slot="tabIcon-pbe-additions" aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></svg>
    <svg slot="tabIcon-champions" aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
    <svg slot="tabIcon-skinlines" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M12 3a9 9 0 1 0 0 18h1a2 2 0 0 0 1-3.7 1.8 1.8 0 0 1 1-3.3H17a4 4 0 0 0 4-4c0-4-4-7-9-7Z" /><circle cx="7.5" cy="10" r=".7" /><circle cx="11" cy="7" r=".7" /><circle cx="16" cy="8" r=".7" /></svg>
    <svg slot="tabIcon-universes" aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
    <slot />
  </Card>
</section>

<style>
  .home-tool-navigation { width: min(var(--content-width), calc(100% - (var(--page-gutter) * 2))); margin: 0 auto; padding-bottom: 40px; }
  .home-tool-navigation :global(.card) { overflow: clip; }
  .home-tool-navigation :global(.card__header) { position: sticky; top: var(--site-header-height); z-index: 9; background: var(--panel); }
  .home-tool-navigation h2 { scroll-margin-top: calc(var(--site-header-height) + var(--space-4)); }
  .home-tool-navigation :global(.card__tabs) { flex-wrap: wrap; overflow: visible; }
  .home-tool-navigation :global(.card__tab) { font-weight: 600; }
  @media (max-width: 767px) {
    .home-tool-navigation :global(.card__tabs) { flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; }
  }
</style>
