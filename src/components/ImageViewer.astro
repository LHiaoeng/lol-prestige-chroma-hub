---
interface Props {
  src: string;
  fallback?: string;
  mobileSrc?: string;
  mobileFallback?: string;
  placeholder?: string;
  altEn: string;
  altZh: string;
  locale?: import('../i18n/config').Locale;
}
const { src, fallback, mobileSrc, mobileFallback, placeholder = '/placeholder.svg', altEn, altZh } = Astro.props;
import { resolveLocale } from '../i18n/config';
const isZh = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) === 'zh-cn';
const alt = isZh ? altZh : altEn;
---
<div class="image-viewer" data-image-viewer>
  <button class="viewer-trigger" type="button" data-image-viewer-open aria-label={isZh ? '查看大图' : 'Open full-size image'}>
    <picture>
      {mobileSrc && <source media="(max-width: 767px)" srcset={mobileSrc} data-fallback={mobileFallback} />}
      <img class="viewer-image" src={src} data-fallback={fallback} data-placeholder={placeholder} alt={alt} width="1920" height="1080" />
    </picture>
  </button>
  <dialog class="viewer-dialog" data-image-viewer-dialog aria-label={isZh ? '大图预览' : 'Full-size image preview'}>
    <div class="viewer-controls">
      <button class="viewer-control" type="button" data-image-viewer-zoom-out aria-label={isZh ? '缩小' : 'Zoom out'}>−</button>
      <button class="viewer-control" type="button" data-image-viewer-zoom-in aria-label={isZh ? '放大' : 'Zoom in'}>+</button>
      <button class="viewer-control viewer-close" type="button" data-image-viewer-close aria-label={isZh ? '关闭图片预览' : 'Close image preview'}>×</button>
    </div>
    <img class="viewer-full" src={src} data-fallback={fallback} data-placeholder={placeholder} alt={alt} draggable="false" />
  </dialog>
</div>
<script>
  import { bindImageViewers } from '../client/image-viewer';
  bindImageViewers();
</script>
<style>
  .image-viewer,.viewer-trigger,.viewer-trigger picture{display:block;width:100%;height:100%}
  .viewer-trigger{padding:0;border:0;background:none;cursor:zoom-in}
  .viewer-image{display:block;width:100%;height:100%;object-fit:cover}
  .viewer-dialog{box-sizing:border-box;width:100vw;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;border-radius:0;background:#030409d9;color:#fff;overflow:hidden}
  .viewer-dialog[open]{display:flex;align-items:center;justify-content:center}
  .viewer-dialog::backdrop{background:#0009;backdrop-filter:blur(3px)}
  .viewer-controls{position:fixed;z-index:2;top:max(12px,env(safe-area-inset-top));right:max(12px,env(safe-area-inset-right));display:flex;gap:8px}
  .viewer-control{display:grid;width:44px;height:44px;padding:0;place-items:center;border:0;border-radius:50%;background:#090b15b8;color:#fff;font-size:1.65rem;font-weight:300;line-height:1;cursor:pointer;backdrop-filter:blur(8px)}
  .viewer-control:hover,.viewer-control:focus-visible{background:#d7b56d;color:#090b15}
  .viewer-control:disabled{opacity:.35;cursor:default}
  .viewer-dialog .viewer-full{--viewer-x:0px;--viewer-y:0px;--viewer-scale:1;display:block;width:auto;height:auto;max-width:100vw;max-height:100dvh;margin:auto;object-fit:contain;transform:translate3d(var(--viewer-x),var(--viewer-y),0) scale(var(--viewer-scale));transition:transform .15s ease;will-change:transform;cursor:grab;touch-action:none;user-select:none}
  .viewer-dialog .viewer-full[data-dragging="true"]{cursor:grabbing;transition:none}
  .viewer-dialog .viewer-full[data-pinching="true"]{cursor:grabbing;transition:none}
</style>
