---
interface Props {
  src: string;
  fallback?: string;
  mobileSrc?: string;
  mobileFallback?: string;
  placeholder?: string;
  altEn: string;
  altZh: string;
  downloadFilename?: string;
  locale?: import('../i18n/config').Locale;
}
const { src, fallback, mobileSrc, mobileFallback, placeholder = '/placeholder.svg', altEn, altZh, downloadFilename } = Astro.props;
import { resolveLocale } from '../i18n/config';
const isZh = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) === 'zh-cn';
const alt = isZh ? altZh : altEn;
---
<div class="image-viewer">
  <button class="viewer-trigger" type="button" data-media-preview-trigger data-preview-kind="image" data-preview-src={src} data-preview-fallback={fallback} data-preview-filename={downloadFilename ?? alt} aria-label={isZh ? '查看大图' : 'Open full-size image'}>
    <picture>
      {mobileSrc && <source media="(max-width: 767px)" srcset={mobileSrc} data-fallback={mobileFallback} />}
      <img class="viewer-image" src={src} data-fallback={fallback} data-placeholder={placeholder} alt={alt} width="1920" height="1080" />
    </picture>
    <span class="viewer-cover" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12s3.2-6 9-6 9 6 9 6-3.2 6-9 6-9-6-9-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></span>
  </button>
</div>
<style>
  .image-viewer,.viewer-trigger,.viewer-trigger picture{display:block;width:100%;height:100%}
  .viewer-trigger{position:relative;padding:0;border:0;background:none;cursor:zoom-in}
  .viewer-trigger:focus-visible{outline:2px solid var(--gold);outline-offset:-2px}
  .viewer-image{display:block;width:100%;height:100%;object-fit:cover}
  .viewer-cover{position:absolute;inset:0;display:grid;place-items:center;background:rgb(0 0 0 / 30%);color:#fff;opacity:0;transition:opacity var(--motion-slow) ease}
  .viewer-cover svg{width:32px;height:32px}
  .viewer-trigger:hover .viewer-cover,.viewer-trigger:focus-visible .viewer-cover{opacity:1}
</style>
