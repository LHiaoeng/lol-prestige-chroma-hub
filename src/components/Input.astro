---
/**
 * 文本输入组件（尺寸参考 Antdv Next Input，保留原生 <input>）。
 *
 * 样式类 `cn-input` 统一定义在 `src/styles/global.css`，
 * 颜色与尺寸变量取自 :root 定义，focus ring、hover 边框与
 * placeholder 样式与 `Select.astro` / `cn-pagination-*` 保持一致。
 *
 * 用法：
 * ```astro
 * <Input name="q" type="search" placeholder="搜索臻彩" maxlength={64} />
 * ```
 */
interface Props {
  name: string;
  type?: 'search' | 'text' | 'url';
  placeholder?: string;
  maxlength?: number;
  value?: string;
  ariaLabel?: string;
  size?: 'small' | 'medium' | 'large';
  class?: string;
}

const { name, type = 'text', placeholder, maxlength, value, ariaLabel, size = 'medium' } = Astro.props;
---

<input class:list={['cn-input', { 'cn-input--sm': size === 'small', 'cn-input--lg': size === 'large' }, Astro.props.class]} {name} {type} {placeholder} {maxlength} {value} aria-label={ariaLabel} />
