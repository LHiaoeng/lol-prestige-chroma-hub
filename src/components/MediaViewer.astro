---
import CaretRightOutlined from './icons/CaretRightOutlined.astro';
import CloseOutlined from './icons/CloseOutlined.astro';
import DownloadOutlined from './icons/DownloadOutlined.astro';
import LeftOutlined from './icons/LeftOutlined.astro';
import MutedOutlined from './icons/MutedOutlined.astro';
import PauseOutlined from './icons/PauseOutlined.astro';
import ReloadOutlined from './icons/ReloadOutlined.astro';
import RightOutlined from './icons/RightOutlined.astro';
import RotateLeftOutlined from './icons/RotateLeftOutlined.astro';
import RotateRightOutlined from './icons/RotateRightOutlined.astro';
import SoundOutlined from './icons/SoundOutlined.astro';
import SwapOutlined from './icons/SwapOutlined.astro';
import ZoomInOutlined from './icons/ZoomInOutlined.astro';
import ZoomOutOutlined from './icons/ZoomOutOutlined.astro';
interface Props {
  locale?: import('../i18n/config').Locale;
}

const isZh = (Astro.props.locale ?? (Astro.currentLocale === 'zh-cn' ? 'zh-cn' : 'en')) === 'zh-cn';
---

<dialog class="ant-image-preview-root" data-media-viewer aria-label={isZh ? '媒体预览' : 'Media preview'}>
  <div class="ant-image-preview-content" data-media-viewer-content></div>
  <div class="ant-image-preview-status" data-media-viewer-status role="status" hidden data-loading={isZh ? '正在加载媒体…' : 'Loading media…'} data-error={isZh ? '媒体加载失败' : 'Unable to load media'}>
    <span data-media-viewer-message></span>
    <button type="button" data-media-viewer-retry hidden>{isZh ? '重试' : 'Retry'}</button>
  </div>
  <button class="ant-image-preview-close" data-media-viewer-close type="button" aria-label={isZh ? '关闭预览' : 'Close preview'}>
    <CloseOutlined />
  </button>
  <button class="ant-image-preview-switch ant-image-preview-switch-left" data-media-viewer-prev type="button" aria-label={isZh ? '上一项' : 'Previous'} hidden>
    <LeftOutlined />
  </button>
  <button class="ant-image-preview-switch ant-image-preview-switch-right" data-media-viewer-next type="button" aria-label={isZh ? '下一项' : 'Next'} hidden>
    <RightOutlined />
  </button>
  <div class="ant-image-preview-footer">
    <div class="ant-image-preview-player" data-media-viewer-player role="group" aria-label={isZh ? '视频播放控制' : 'Video playback controls'} hidden>
      <button type="button" data-media-viewer-play data-play={isZh ? '播放' : 'Play'} data-pause={isZh ? '暂停' : 'Pause'} aria-label={isZh ? '播放' : 'Play'}>
        <CaretRightOutlined class="ant-image-preview-play-icon" />
        <PauseOutlined class="ant-image-preview-pause-icon" />
      </button>
      <input class="ant-image-preview-seek" data-media-viewer-seek type="range" min="0" max="0" step="0.1" value="0" aria-label={isZh ? '播放进度' : 'Playback position'} disabled />
      <span class="ant-image-preview-time" data-media-viewer-time>0:00 / 0:00</span>
      <button type="button" data-media-viewer-mute data-mute={isZh ? '静音' : 'Mute'} data-unmute={isZh ? '取消静音' : 'Unmute'} aria-label={isZh ? '静音' : 'Mute'}>
        <SoundOutlined class="ant-image-preview-sound-icon" /><MutedOutlined class="ant-image-preview-muted-icon" />
      </button>
      <input class="ant-image-preview-volume" data-media-viewer-volume type="range" min="0" max="1" step="0.05" value="1" aria-label={isZh ? '音量' : 'Volume'} />
    </div>
    <span class="ant-image-preview-count" data-media-viewer-count aria-live="polite" hidden></span>
    <div class="ant-image-preview-actions" role="toolbar" aria-label={isZh ? '预览工具栏' : 'Preview toolbar'}>
      <button type="button" data-media-viewer-zoom-out aria-label={isZh ? '缩小' : 'Zoom out'} title={isZh ? '缩小' : 'Zoom out'}>
        <ZoomOutOutlined />
      </button>
      <button type="button" data-media-viewer-zoom-in aria-label={isZh ? '放大' : 'Zoom in'} title={isZh ? '放大' : 'Zoom in'}>
        <ZoomInOutlined />
      </button>
      <button type="button" data-media-viewer-rotate-left aria-label={isZh ? '向左旋转' : 'Rotate left'} title={isZh ? '向左旋转' : 'Rotate left'}>
        <RotateLeftOutlined />
      </button>
      <button type="button" data-media-viewer-rotate-right aria-label={isZh ? '向右旋转' : 'Rotate right'} title={isZh ? '向右旋转' : 'Rotate right'}>
        <RotateRightOutlined />
      </button>
      <button type="button" data-media-viewer-flip-x aria-label={isZh ? '水平翻转' : 'Flip horizontally'} title={isZh ? '水平翻转' : 'Flip horizontally'}>
        <SwapOutlined />
      </button>
      <button type="button" data-media-viewer-flip-y aria-label={isZh ? '垂直翻转' : 'Flip vertically'} title={isZh ? '垂直翻转' : 'Flip vertically'}>
        <SwapOutlined class="ant-image-preview-flip-y-icon" />
      </button>
      <button type="button" data-media-viewer-reset aria-label={isZh ? '重置视图' : 'Reset view'} title={isZh ? '重置视图' : 'Reset view'}>
        <ReloadOutlined />
      </button>
      <button type="button" data-media-viewer-download aria-label={isZh ? '下载当前媒体' : 'Download current media'} title={isZh ? '下载当前媒体' : 'Download current media'}>
        <DownloadOutlined />
      </button>
    </div>
  </div>
</dialog>

<script>
  import { bindMediaViewers } from '../client/image-viewer';
  bindMediaViewers();
</script>
