---
import type { SkinRecord } from '../domain/communitydragon-content';
import { localizedPath, type Locale } from '../i18n/config';
interface Props { skin: SkinRecord; championName: string; locale?: Locale }
const { skin, championName, locale = 'en' } = Astro.props;
const isZh = locale === 'zh-cn';
const name = isZh ? skin.nameZh ?? skin.nameEn : skin.nameEn;
---
<article class="pbe-skin-card">
  <a href={localizedPath(locale, `/skins/${skin.slug}/`)}>
    <div class="pbe-skin-image">{skin.media.tileUrl || skin.media.focusedSplashUrl ? <img src={skin.media.tileUrl ?? skin.media.focusedSplashUrl} alt={name} loading="lazy" decoding="async" /> : <span aria-hidden="true">◇</span>}</div>
    <div class="pbe-skin-body"><strong>{name}</strong><span>{championName}</span><small>{skin.isBase ? (isZh ? '基础' : 'Base') : skin.isLegacy ? (isZh ? '已下架' : 'Legacy') : skin.stages.length ? (isZh ? '阶段任务' : 'Quest stages') : (isZh ? '皮肤' : 'Skin')}</small></div>
  </a>
</article>
