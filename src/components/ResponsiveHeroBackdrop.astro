---
interface Props {
  largeSrc: string;
  mediumSrc: string;
  largeFallback: string;
  mediumFallback: string;
  position?: string;
  mobilePosition?: string;
  opacity?: number;
  mobileOpacity?: number;
}

const {
  largeSrc,
  mediumSrc,
  largeFallback,
  mediumFallback,
  position = 'center top',
  mobilePosition = '62% top',
  opacity = 1,
  mobileOpacity = opacity,
} = Astro.props;
const backdropStyle = `--backdrop-position:${position};--backdrop-mobile-position:${mobilePosition};--backdrop-opacity:${opacity};--backdrop-mobile-opacity:${mobileOpacity}`;
---
<div class="responsive-hero-backdrop" data-responsive-backdrop aria-hidden="true" style={backdropStyle}>
  <picture>
    <source media="(max-width: 767px)" srcset={mediumSrc} data-fallback={mediumFallback} />
    <img
      data-backdrop-image
      src={largeSrc}
      data-fallback={largeFallback}
      data-placeholder="/placeholder.svg"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <div class="backdrop-overlay"></div>
</div>

<script>
  import { bindResponsiveBackdrops } from '../client/responsive-backdrop';
  bindResponsiveBackdrops();
</script>
