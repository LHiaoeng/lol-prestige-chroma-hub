---
import { communityDragonChannelLabel } from '../domain/communitydragon-url';
import type { Locale } from '../i18n/config';
import DomainIcon from './DomainIcon.astro';
import Dropdown from './Dropdown.astro';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === 'zh-cn';
const runtimeLocale = isZh ? 'zh_cn' : 'default';
const pbeLabel = communityDragonChannelLabel('pbe', runtimeLocale);
const latestLabel = communityDragonChannelLabel('latest', runtimeLocale);
---

<Dropdown id="runtime-channel-menu">
  <span slot="trigger">
    <DomainIcon name="reference" class="runtime-channel-icon" />
    <span class="sr-only">{isZh ? '资料版本' : 'Reference data'}</span>
    <span aria-live="polite" data-runtime-channel-label>{pbeLabel}</span>
    <svg class="runtime-channel-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
  </span>
  <li role="none"><button type="button" role="menuitemradio" aria-checked="true" data-ant-dropdown-item data-runtime-channel="pbe"><span>{pbeLabel}</span><span aria-hidden="true">✓</span></button></li>
  <li role="none"><button type="button" role="menuitemradio" aria-checked="false" data-ant-dropdown-item data-runtime-channel="latest"><span>{latestLabel}</span><span aria-hidden="true">✓</span></button></li>
</Dropdown>
