---
import type { Locale } from '../i18n/config';
import Divider from './Divider.astro';
import DomainIcon from './DomainIcon.astro';
import RuntimeChannelSwitcher from './RuntimeChannelSwitcher.astro';
import Dropdown from './Dropdown.astro';

interface Props {
  readonly locale: Locale;
  readonly kind: 'champion' | 'skin' | 'skinline' | 'universe' | 'chroma';
}

const { locale, kind } = Astro.props;
const isZh = locale === 'zh-cn';
---

{kind === 'chroma' ? <div class="runtime-detail-summary runtime-detail-summary--static" role="group" aria-label={isZh ? '臻彩摘要' : 'Chroma summary'}><slot /></div> : <div class="runtime-source runtime-channel-row runtime-detail-summary" data-runtime-source data-runtime-entity-detail-source={kind !== 'universe' ? 'true' : undefined} data-runtime-universe-detail-source={kind === 'universe' ? 'true' : undefined} data-runtime-summary-loading aria-label={isZh ? '资料版本' : 'Reference data channel'}>
  <RuntimeChannelSwitcher {locale} />
  {kind === 'skin' && <>
    <span class="runtime-entity-relation-summary" data-runtime-skin-champion-summary>
      <Divider type="vertical" />
      <span class="runtime-universe-stat"><DomainIcon name="champions" class="runtime-universe-stat-icon" tooltipDetail="" {locale} /><span data-runtime-skin-champion></span></span>
    </span>
    <span class="runtime-entity-relation-summary" data-runtime-skin-skinline-summary>
      <Divider type="vertical" />
      <span class="runtime-universe-stat"><DomainIcon name="skinlines" class="runtime-universe-stat-icon" tooltipDetail="" {locale} /><span class="runtime-skeleton-line runtime-skeleton-line--count runtime-universe-count-skeleton" aria-hidden="true" data-runtime-skin-skinlines></span></span>
    </span>
    <span class="runtime-entity-relation-summary" data-runtime-skin-universe-summary>
      <Divider type="vertical" />
      <span class="runtime-universe-stat"><DomainIcon name="universes" class="runtime-universe-stat-icon" tooltipDetail="" {locale} /><span class="runtime-skeleton-line runtime-skeleton-line--count runtime-universe-count-skeleton" aria-hidden="true" data-runtime-skin-universes></span></span>
    </span>
    <span class="runtime-entity-relation-summary" hidden data-runtime-skin-chroma-summary>
      <Divider type="vertical" />
      <a class="runtime-entity-relation-link" href="#runtime-skin-chromas"><span class="runtime-universe-stat"><DomainIcon name="prestige-chromas" class="runtime-universe-stat-icon" tooltipDetail="" {locale} /><span class="runtime-skeleton-line runtime-skeleton-line--count runtime-universe-count-skeleton" aria-hidden="true" data-runtime-skin-chroma-count></span></span></a>
    </span>
  </>}
  {kind === 'skinline' && <span class="runtime-entity-universe-summary" data-runtime-skinline-universe-summary>
    <Divider type="vertical" />
    <span class="runtime-universe-stat"><DomainIcon name="universes" class="runtime-universe-stat-icon" tooltipDetail="" {locale} /><span class="runtime-skeleton-line runtime-skeleton-line--count runtime-universe-count-skeleton" aria-hidden="true" data-runtime-skinline-universes></span></span>
  </span>}
  {(kind === 'champion' || kind === 'skinline') && <>
    <Divider type="vertical" />
    <span class="runtime-universe-stat"><DomainIcon name="skins" class="runtime-universe-stat-icon" tooltipDetail="" {locale} /><span class="runtime-skeleton-line runtime-skeleton-line--count runtime-universe-count-skeleton runtime-universe-count-skeleton--skins" aria-hidden="true" data-runtime-entity-skin-count></span></span>
  </>}
  {kind === 'universe' && <>
    <Divider type="vertical" />
    <span class="runtime-universe-stat"><DomainIcon name="skinlines" class="runtime-universe-stat-icon" tooltipDetail="" {locale} /><span class="runtime-skeleton-line runtime-skeleton-line--count runtime-universe-count-skeleton" aria-hidden="true" data-runtime-universe-skinline-count="true"></span></span>
    <Divider type="vertical" />
    <span class="runtime-universe-stat"><DomainIcon name="skins" class="runtime-universe-stat-icon" tooltipDetail="" {locale} /><span class="runtime-skeleton-line runtime-skeleton-line--count runtime-universe-count-skeleton runtime-universe-count-skeleton--skins" aria-hidden="true" data-runtime-universe-skin-count="true"></span></span>
  </>}
  {kind === 'skin' && <div class="runtime-skin-actions-summary" data-runtime-skin-actions-summary hidden>
    <Divider type="vertical" />
    <Dropdown id="runtime-skin-actions-menu" placement="bottomRight">
      <span slot="trigger"><svg class="runtime-channel-icon" data-summary-icon-tooltip={isZh ? '摘要扩展内容' : 'Summary actions'} aria-hidden="true" viewBox="0 0 24 24"><path d="M3 8h18v13H3zM8 8V5h8v3M3 12h18M10 12v2h4v-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg><span>{isZh ? '更多' : 'More'}</span><svg class="runtime-channel-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></span>
    </Dropdown>
  </div>}
  {(kind === 'champion' || kind === 'skinline' || kind === 'universe') && <div class="runtime-skin-actions-summary" data-runtime-entity-actions-summary hidden>
    <Divider type="vertical" />
    <Dropdown id="runtime-entity-actions-menu" placement="bottomRight">
      <span slot="trigger"><svg class="runtime-channel-icon" data-summary-icon-tooltip={isZh ? '摘要扩展内容' : 'Summary actions'} aria-hidden="true" viewBox="0 0 24 24"><path d="M3 8h18v13H3zM8 8V5h8v3M3 12h18M10 12v2h4v-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg><span>{isZh ? '更多' : 'More'}</span><svg class="runtime-channel-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></span>
    </Dropdown>
  </div>}
  <span class="runtime-skeleton-line runtime-summary-row-skeleton" data-runtime-summary-skeleton aria-hidden="true"></span>
</div>}

<script>
  import { createTooltip } from './tooltip';

  document.querySelectorAll<SVGSVGElement>('[data-summary-icon-tooltip]').forEach((icon) => {
    const label = icon.dataset.summaryIconTooltip;
    const parent = icon.parentElement;
    const nextSibling = icon.nextSibling;
    if (label && parent) {
      const trigger = createTooltip(icon, label);
      trigger.setAttribute('aria-label', label);
      parent.insertBefore(trigger, nextSibling);
    }
  });
</script>

<style>
  .runtime-detail-summary { position: relative; width: 100%; gap: var(--space-2); color: var(--gold); font-size: var(--font-size-title); line-height: var(--line-height-title); }
  .runtime-detail-summary--static { display: flex; flex-wrap: wrap; align-items: center; margin: 0; padding: 0; }
  .runtime-detail-summary--static > :global(dl) { width: 100%; }
  .runtime-detail-summary :global(.ant-divider-vertical) { margin-inline: 0; font-size: inherit; }
  .runtime-detail-summary :global(.ant-dropdown-trigger) { padding-inline: 0; font-size: inherit; line-height: inherit; }
  .runtime-detail-summary :global(.runtime-list-count) { font-size: inherit; }
  .runtime-detail-summary > :not(.runtime-summary-row-skeleton) { opacity: 1; transition: opacity var(--motion-mid) ease-out; }
  .runtime-detail-summary[data-runtime-summary-loading] > :not(.runtime-summary-row-skeleton) { visibility: hidden; opacity: 0; }
  .runtime-summary-row-skeleton { position: absolute; top: calc((var(--control-height) - var(--font-size-title)) / 2); left: 0; width: min(720px, 82%); height: var(--font-size-title); pointer-events: none; opacity: 0; visibility: hidden; transition: opacity var(--motion-mid) ease-out, visibility 0s linear var(--motion-mid); }
  .runtime-detail-summary[data-runtime-summary-loading] > .runtime-summary-row-skeleton { opacity: 1; visibility: visible; transition-delay: 0s; }
  .runtime-universe-stat { min-height: var(--control-height); white-space: nowrap; }
  .runtime-universe-stat,
  .runtime-skin-actions-summary:not([hidden]),
  .runtime-entity-universe-summary:not([hidden]),
  .runtime-entity-relation-summary:not([hidden]) { display: inline-flex; flex-shrink: 0; align-items: center; gap: var(--space-2); }
  [data-runtime-skin-champion-summary] { min-width: 0; flex-shrink: 1; }
  [data-runtime-skin-champion-summary] :global(.runtime-universe-stat) { min-width: 0; max-width: 100%; flex-shrink: 1; white-space: normal; }
  [data-runtime-skin-champion] { min-width: 0; overflow-wrap: anywhere; }
  .runtime-detail-summary :global(.runtime-universe-stat-icon) { width: 1em; height: 1em; flex: 0 0 auto; }
  @media (max-width: 767px) {
    .runtime-summary-row-skeleton { top: calc((var(--control-height) - var(--font-size-title)) / 2); }
  }
  @media (prefers-reduced-motion: reduce) {
    .runtime-detail-summary > :not(.runtime-summary-row-skeleton),
    .runtime-summary-row-skeleton { transition: none; }
  }
</style>
