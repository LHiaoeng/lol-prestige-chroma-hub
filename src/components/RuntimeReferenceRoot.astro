---
import { localizedPath, type Locale } from '../i18n/config';

interface Props {
  readonly page: 'champions' | 'skins' | 'skinlines' | 'universes';
  readonly locale: Locale;
  readonly label: string;
  readonly heading: string;
  readonly lede: string;
}

const { page, locale, label, heading, lede } = Astro.props;
const isZh = locale === 'zh-cn';
const runtimeLocale = isZh ? 'zh_cn' : 'default';
---

<div class="runtime-page">
  <nav class="breadcrumbs" aria-label={isZh ? '面包屑' : 'Breadcrumb'}>
    <a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><span>{label}</span>
  </nav>
  <header>
    <h1>{heading}</h1>
    <p class="runtime-lede">{lede}</p>
    <div class="runtime-source" data-runtime-source aria-label={isZh ? '资料版本' : 'Reference data channel'}>
      <span aria-live="polite"><span data-runtime-channel-label>pbe</span></span>
      <button type="button" data-runtime-channel="pbe" aria-pressed="true">pbe</button>
      <button type="button" data-runtime-channel="latest" aria-pressed="false">latest</button>
    </div>
  </header>
  <section class="runtime-section">
    <div class="runtime-reference-root" data-runtime-page={page} data-runtime-locale={runtimeLocale}>
      <p data-runtime-status role="status" aria-live="polite">{isZh ? '正在加载…' : 'Loading…'}</p>
      <div data-runtime-content></div>
    </div>
    <noscript><p class="runtime-noscript">{isZh ? '请启用 JavaScript 以浏览动态游戏资料。' : 'Enable JavaScript to browse dynamic game references.'}</p></noscript>
  </section>
</div>

<script>
  import { initRuntimeReference } from '../client/runtime-reference';
  import { bindRuntimeLanguageToggle } from '../client/runtime-url-state';
  bindRuntimeLanguageToggle(document);
  const root = document.querySelector<HTMLElement>('[data-runtime-page]');
  if (root) initRuntimeReference(root);
</script>
