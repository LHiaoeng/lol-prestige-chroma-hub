---
import { localizedPath, type Locale } from '../i18n/config';
import { communityDragonChannelLabel } from '../domain/communitydragon-url';

interface Props {
  readonly page: 'champions' | 'skins' | 'skinlines' | 'universes' | 'pbe-additions';
  readonly locale: Locale;
  readonly label: string;
  readonly heading: string;
  readonly lede: string;
  readonly mode: 'list' | 'detail' | 'pbe';
}

const { page, locale, label, heading, lede, mode } = Astro.props;
const isZh = locale === 'zh-cn';
const runtimeLocale = isZh ? 'zh_cn' : 'default';
const listPath = page === 'skins' || page === 'pbe-additions' ? undefined : localizedPath(locale, `/${page}/`);
const pbeLabel = communityDragonChannelLabel('pbe', runtimeLocale);
const latestLabel = communityDragonChannelLabel('latest', runtimeLocale);
---

<div class="runtime-page">
  <nav class="breadcrumbs" aria-label={isZh ? '面包屑' : 'Breadcrumb'}>
    <a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span>{mode === 'detail' ? <>{listPath && <><a href={listPath} data-runtime-channel-link>{label}</a><span>/</span></>}<span aria-current="page">{isZh ? `${label}详情` : `${label} detail`}</span></> : <span aria-current="page">{label}</span>}
  </nav>
  <header>
    <h1>{heading}</h1>
    <p class="runtime-lede">{lede}</p>
    <div class="runtime-source" data-runtime-source aria-label={isZh ? '资料版本' : 'Reference data channel'}>
      {mode === 'pbe' ? <span>{isZh ? `${pbeLabel} 与 ${latestLabel} 比较` : `${pbeLabel} vs ${latestLabel}`}</span> : <>
        <span aria-live="polite"><span data-runtime-channel-label>{pbeLabel}</span></span>
        <button type="button" data-runtime-channel="pbe" aria-pressed="true">{pbeLabel}</button>
        <button type="button" data-runtime-channel="latest" aria-pressed="false">{latestLabel}</button>
      </>}
    </div>
  </header>
  <section class="runtime-section">
    <div class="runtime-reference-root" data-runtime-page={page} data-runtime-locale={runtimeLocale} data-runtime-mode={mode}>
      <p data-runtime-status role="status" aria-live="polite">{isZh ? '正在加载…' : 'Loading…'}</p>
      <div data-runtime-content></div>
    </div>
    <noscript><p class="runtime-noscript">{isZh ? '请启用 JavaScript 以浏览动态游戏资料。' : 'Enable JavaScript to browse dynamic game references.'}</p></noscript>
  </section>
</div>

<script>
  import { initRuntimeReference } from '../client/runtime-reference';
  import { bindRuntimeChannelLinks, bindRuntimeLanguageToggle } from '../client/runtime-url-state';
  bindRuntimeLanguageToggle(document);
  bindRuntimeChannelLinks(document);
  const root = document.querySelector<HTMLElement>('[data-runtime-page]');
  if (root) initRuntimeReference(root);
</script>
