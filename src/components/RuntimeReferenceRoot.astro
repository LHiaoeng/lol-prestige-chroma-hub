---
import { localizedPath, type Locale } from '../i18n/config';
import Breadcrumb from './Breadcrumb.astro';
import Divider from './Divider.astro';
import Alert from './Alert.astro';
import Empty from './Empty.astro';
import Skeleton from './Skeleton.astro';
import DomainIcon from './DomainIcon.astro';
import RuntimeChannelSwitcher from './RuntimeChannelSwitcher.astro';
import TypographyParagraph from './TypographyParagraph.astro';
import RuntimeDetailSummary from './RuntimeDetailSummary.astro';
import { catalog } from '../data/catalog';
import { imageUrl, sourceImageUrl } from '../domain/chroma';

interface Props {
  readonly page: 'champions' | 'skins' | 'skinlines' | 'universes' | 'pbe-additions';
  readonly locale: Locale;
  readonly label: string;
  readonly heading: string;
  readonly lede?: string;
  readonly mode: 'list' | 'detail' | 'pbe';
}

const { page, locale, label, heading, lede, mode } = Astro.props;
const isZh = locale === 'zh-cn';
const runtimeLocale = isZh ? 'zh_cn' : 'default';
const listPath = page === 'pbe-additions' ? undefined : localizedPath(locale, `/${page}/`);
const invalidReturnPage = page;
const invalidReturnPath = localizedPath(locale, `/${invalidReturnPage}/`);
const invalidReturnLabel = label;
const showCompactListHeader = mode === 'list';
const showUniverseDetailSummary = page === 'universes' && mode === 'detail';
const showEntityDetailSummary = mode === 'detail' && ['champions', 'skins', 'skinlines', 'universes'].includes(page);
const listIcon = page === 'champions' ? 'champions' : page === 'skinlines' ? 'skinlines' : page === 'universes' ? 'universes' : 'prestige-chromas';
const listSkeletonLayout = page === 'champions' ? 'champions' : page === 'universes' ? 'universes' : 'skinlines';
const detailSkeletonLayout = page === 'skins' ? 'skin-detail' : page === 'skinlines' ? 'skinline-detail' : page === 'universes' ? 'universe-detail' : 'detail';
const skeletonLayout = mode === 'detail' ? detailSkeletonLayout : mode === 'list' ? listSkeletonLayout : 'pbe';
const detailDescriptionLines = page === 'champions' ? 3 : 2;
const skeletonFilterCount = mode !== 'list' ? 0 : page === 'champions' ? 3 : 2;
const skeletonItemCount = mode === 'list' ? 24 : 6;
const breadcrumbItems = [
  { title: isZh ? '首页' : 'Home', href: localizedPath(locale, '/') },
  { title: isZh ? '英雄联盟' : 'League of Legends', href: localizedPath(locale, '/#home-tools-title') },
  ...(mode === 'detail' && listPath ? [{ title: label, href: listPath, 'data-runtime-channel-link': '' }] : []),
  { title: mode === 'detail' ? (isZh ? `${label}详情` : `${label} detail`) : label, ...(mode === 'detail' ? { 'data-runtime-current-entity': '' } : {}) },
];
const prestigeChromaLinks = page === 'skins' && mode === 'detail'
  ? JSON.stringify(Object.fromEntries(catalog.map((chroma) => [
      chroma.skinId,
      {
        href: localizedPath(locale, `/chromas/${chroma.slug}/`),
        imageUrl: imageUrl(chroma.images.medium),
        fallbackUrl: sourceImageUrl('medium', chroma.instanceId),
        previewUrl: imageUrl(chroma.images.large),
        previewFallbackUrl: sourceImageUrl('large', chroma.instanceId),
        colors: chroma.colors,
      },
    ])))
  : undefined;
---

{mode === 'detail' && <div class="page-backdrop page-backdrop--behind page-backdrop--detail" data-runtime-reference-backdrop hidden aria-hidden="true">
  <img data-runtime-reference-backdrop-image data-placeholder="/placeholder.svg" alt="" width="1920" height="1080" loading="eager" decoding="async" />
</div>}
<Breadcrumb {locale} items={breadcrumbItems} />
{showEntityDetailSummary && <div class="runtime-entity-detail-summary" data-runtime-entity-detail-summary>
  <div class="runtime-entity-detail-header-skeleton" data-runtime-entity-header-skeleton aria-hidden="true">
    <div class="runtime-entity-title-skeleton">
      <span class="runtime-skeleton-media runtime-entity-title-icon-skeleton"></span>
      <span class="runtime-skeleton-line runtime-skeleton-line--heading"></span>
    </div>
    <div class="runtime-entity-description-skeleton">
      {Array.from({ length: detailDescriptionLines }, (_, index) => <span class="runtime-entity-description-skeleton-line">
        <span class:list={['runtime-skeleton-line', index === detailDescriptionLines - 1 ? 'runtime-skeleton-line--lede-short' : 'runtime-skeleton-line--lede']}></span>
      </span>)}
    </div>
  </div>
  <RuntimeDetailSummary {locale} kind={page === 'universes' ? 'universe' : page === 'skinlines' ? 'skinline' : page === 'skins' ? 'skin' : 'champion'} />
  <Divider class={showUniverseDetailSummary ? 'runtime-universe-detail-divider' : 'runtime-entity-detail-divider'} />
</div>}
{mode === 'detail' && !showEntityDetailSummary && <div class="runtime-source runtime-channel-row" data-runtime-source aria-label={isZh ? '资料版本' : 'Reference data channel'}><RuntimeChannelSwitcher {locale} /></div>}
<div class:list={['runtime-page', { 'runtime-page--detail': mode === 'detail', 'runtime-page--entity-detail': showEntityDetailSummary, 'runtime-page--universe-detail': showUniverseDetailSummary, 'runtime-page--compact-list-header': showCompactListHeader, 'runtime-page--universe-list': page === 'universes' && showCompactListHeader, 'runtime-page--pbe': mode === 'pbe' }]} data-runtime-page-shell data-runtime-loading>
  {mode !== 'detail' && <header>
    <div class="runtime-page-header-skeleton" aria-hidden="true">
      <span class="runtime-skeleton-line runtime-skeleton-line--heading"></span>
      {showCompactListHeader ? <div class="runtime-page-header-skeleton-meta">
        <span class="runtime-skeleton-line runtime-skeleton-line--version"></span>
        <span class="runtime-skeleton-line runtime-skeleton-line--divider"></span>
        <span class="runtime-skeleton-line runtime-skeleton-line--count"></span>
      </div> : <span class="runtime-skeleton-line runtime-skeleton-line--lede"></span>}
    </div>
    <h1>
      {(showCompactListHeader || mode === 'pbe') && <DomainIcon name={mode === 'pbe' ? 'pbe-additions' : listIcon} class="runtime-list-icon" />}
      {showCompactListHeader ? label : heading}
    </h1>
    {showCompactListHeader && <div class="runtime-source runtime-channel-row" data-runtime-source aria-label={isZh ? '资料版本' : 'Reference data channel'}>
      <RuntimeChannelSwitcher {locale} />
      <Divider type="vertical" />
      <span class="runtime-list-count" data-runtime-list-count hidden />
    </div>}
    {mode !== 'pbe' && !showCompactListHeader && <TypographyParagraph className="runtime-lede" expandLabel={isZh ? '展开' : 'Expand'} collapseLabel={isZh ? '收起' : 'Collapse'}>{lede}</TypographyParagraph>}
    {mode === 'pbe' && <div class="runtime-pbe-summary-slot" data-runtime-pbe-summary>
      <span class="runtime-skeleton-line runtime-skeleton-line--summary" aria-hidden="true"></span>
    </div>}
    <Divider class={showCompactListHeader ? undefined : 'runtime-header-divider'} />
  </header>}
  <section class="runtime-section">
    <div class="runtime-reference-root" data-runtime-page={page} data-runtime-locale={runtimeLocale} data-runtime-mode={mode} data-runtime-prestige-chroma-links={prestigeChromaLinks} aria-busy="true">
      <p data-runtime-status role="status" aria-live="polite">{isZh ? '正在加载游戏资料…' : 'Loading game reference…'}</p>
      {page === 'skins' && mode === 'detail' && <div class="runtime-skin-navigation" data-runtime-skin-navigation role="group" aria-label={isZh ? '切换皮肤' : 'Skin navigation'} hidden>
        <div class="runtime-skin-navigation-side runtime-skin-navigation-side--previous">
          <button class="ant-btn ant-btn-text runtime-skin-navigation-button" type="button" data-runtime-skin-navigation-previous aria-label={isZh ? '上一款皮肤' : 'Previous skin'} disabled>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg>
            <span class="runtime-skin-navigation-name" data-runtime-skin-navigation-previous-name hidden></span>
          </button>
        </div>
        <div class="runtime-skin-navigation-side runtime-skin-navigation-side--next">
          <button class="ant-btn ant-btn-text runtime-skin-navigation-button" type="button" data-runtime-skin-navigation-next aria-label={isZh ? '下一款皮肤' : 'Next skin'} disabled>
            <span class="runtime-skin-navigation-name" data-runtime-skin-navigation-next-name hidden></span>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
          </button>
        </div>
      </div>}
      <div data-runtime-content><Skeleton filterCount={skeletonFilterCount} itemCount={skeletonItemCount} layout={skeletonLayout} showDetailHeader={!showEntityDetailSummary} /></div>
      <template data-runtime-skeleton-template="list"><Skeleton filterCount={page === 'champions' ? 3 : 2} itemCount={24} layout={listSkeletonLayout} /></template>
      <template data-runtime-skeleton-template="detail"><Skeleton itemCount={6} layout={detailSkeletonLayout} showDetailHeader={!showEntityDetailSummary} /></template>
      <template data-runtime-skeleton-template="pbe"><Skeleton itemCount={6} layout="pbe" /></template>
      <template data-runtime-supplement-skeleton-template="skinline"><Skeleton itemCount={6} layout="skin-grid" /></template>
      <template data-runtime-supplement-skeleton-template="universe"><Skeleton filterCount={2} itemCount={6} layout="universe-detail" /></template>
      <template data-runtime-empty-template><Empty description={isZh ? '没有匹配结果' : 'No matching references'} /></template>
      <template data-runtime-chroma-empty-template><Empty description={isZh ? '暂无炫彩' : 'No chroma artwork available'} /></template>
      <template data-runtime-alert-template>
        <Alert type="error" showIcon>
          <span slot="description" data-runtime-alert-message></span>
          <button slot="action" class="runtime-retry" type="button" data-runtime-alert-retry>{isZh ? '重试' : 'Retry'}</button>
        </Alert>
      </template>
      <template data-runtime-invalid-template>
        <header class="runtime-detail runtime-detail--entity" data-runtime-invalid-header>
          <h1>{heading}</h1>
          <TypographyParagraph className="runtime-lede" expandLabel={isZh ? '展开' : 'Expand'} collapseLabel={isZh ? '收起' : 'Collapse'}>{isZh ? '链接参数无效，请检查链接后返回目录重新选择资料。' : 'The link parameters are invalid. Check the link or return to the directory and choose an entry again.'}</TypographyParagraph>
        </header>
        <Alert type="error" title={isZh ? '资料链接无效' : 'Invalid reference link'} showIcon>
          <span slot="description" data-runtime-invalid-message></span>
          <a slot="action" href={invalidReturnPath}>{isZh ? `返回${invalidReturnLabel}` : `Back to ${invalidReturnLabel}`}</a>
        </Alert>
      </template>
    </div>
    <noscript><p class="runtime-noscript">{isZh ? '请启用 JavaScript 以浏览动态游戏资料。' : 'Enable JavaScript to browse dynamic game references.'}</p></noscript>
  </section>
</div>

<script>
  import { initRuntimeReference } from '../client/runtime-reference';
  import { bindRuntimeChannelLinks, bindRuntimeLanguageToggle } from '../client/runtime-url-state-dom';
  bindRuntimeLanguageToggle(document);
  bindRuntimeChannelLinks(document);
  const root = document.querySelector<HTMLElement>('[data-runtime-page]');
  if (root) initRuntimeReference(root);
  const skinNavigation = document.querySelector<HTMLElement>('[data-runtime-skin-navigation]');
  const footer = document.querySelector<HTMLElement>('footer');
  if (skinNavigation && footer) {
    const pageShell = skinNavigation.closest<HTMLElement>('[data-runtime-page-shell]');
    const baseBottom = Number.parseFloat(getComputedStyle(skinNavigation).bottom) || 72;
    const pageSpacing = getComputedStyle(document.documentElement);
    const footerGap = Number.parseFloat(pageSpacing.getPropertyValue('--space-3'));
    const contentGap = Number.parseFloat(pageSpacing.getPropertyValue('--space-4'));
    const updatePosition = () => {
      const height = skinNavigation.offsetHeight;
      if (skinNavigation.hidden) pageShell?.style.removeProperty('--runtime-skin-navigation-page-padding');
      else pageShell?.style.setProperty('--runtime-skin-navigation-page-padding', `${height + footerGap + contentGap}px`);
      const footerTop = footer.getBoundingClientRect().top;
      skinNavigation.style.setProperty('--runtime-skin-navigation-bottom', `${Math.max(baseBottom, window.innerHeight - footerTop + footerGap)}px`);
      const headerHeight = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--site-header-height')) || 0;
      skinNavigation.toggleAttribute('data-footer-occluded', footerTop <= height + headerHeight + footerGap);
    };
    window.addEventListener('scroll', updatePosition, { passive: true });
    window.addEventListener('resize', updatePosition);
    if ('ResizeObserver' in window) new ResizeObserver(updatePosition).observe(skinNavigation);
    updatePosition();
  }
</script>

<style is:global>
  main:has([data-runtime-reference-backdrop]) { position: relative; isolation: isolate; }
  .runtime-skin-navigation { position: fixed; z-index: 9; inset: 0; pointer-events: none; }
  .runtime-skin-navigation-side { position: absolute; top: 50%; display: flex; align-items: center; gap: var(--space-2); max-width: calc(50vw - var(--page-gutter)); transform: translateY(-50%); }
  .runtime-skin-navigation-side--previous { left: var(--page-gutter); }
  .runtime-skin-navigation-side--next { right: var(--page-gutter); }
  .runtime-skin-navigation-button.ant-btn-text { width: max-content; min-width: var(--control-height); min-height: var(--control-height); max-width: 100%; gap: var(--space-2); padding: 8px 12px; border-color: transparent; background: transparent; color: var(--text); font-size: var(--font-size-body); font-weight: 600; line-height: var(--line-height-body); box-shadow: none; pointer-events: auto; }
  .runtime-skin-navigation-button.ant-btn-text:hover:not(:disabled) { border-color: transparent; background: color-mix(in srgb, var(--gold) 10%, transparent); color: var(--gold); }
  .runtime-skin-navigation-button:not(:disabled) svg { color: var(--gold); }
  .runtime-skin-navigation-button svg { width: 20px; height: 20px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .runtime-skin-navigation-name { display: block; min-width: 0; max-width: min(10rem, calc(50vw - var(--page-gutter) - var(--control-height) - var(--space-2) - 26px)); overflow: hidden; color: inherit; font-size: inherit; font-weight: inherit; line-height: inherit; text-align: left; text-overflow: ellipsis; white-space: nowrap; }
  .runtime-skin-navigation-side--next .runtime-skin-navigation-name { text-align: right; }
  .runtime-skin-navigation-name[hidden] { display: none; }
  @media (min-width: 1600px) {
    .runtime-skin-navigation-side--previous { left: calc((100vw - var(--content-width)) / 4); transform: translate(-50%, -50%); }
    .runtime-skin-navigation-side--next { right: calc((100vw - var(--content-width)) / 4); transform: translate(50%, -50%); }
    .runtime-skin-navigation-name { max-width: min(10rem, calc((100vw - var(--content-width)) / 2 - var(--control-height) - var(--space-2) - 26px)); }
  }
  @media (max-width: 1599px) {
    .runtime-page:has([data-runtime-skin-navigation]:not([hidden])) { padding-bottom: var(--runtime-skin-navigation-page-padding, calc(var(--space-5) * 3)); }
    .runtime-skin-navigation { inset: auto auto var(--runtime-skin-navigation-bottom, calc(env(safe-area-inset-bottom) + 72px)) 50%; width: min(560px, calc(100vw - (var(--page-gutter) * 2))); display: flex; align-items: center; gap: var(--space-2); padding: 4px 8px; border: 1px solid var(--line); border-radius: var(--radius-control); background: color-mix(in srgb, var(--panel) 94%, transparent); box-shadow: var(--shadow-popup); backdrop-filter: blur(12px); transform: translateX(-50%); }
    .runtime-skin-navigation[data-footer-occluded] { visibility: hidden; }
    .runtime-skin-navigation-side { position: static; top: auto; left: auto; right: auto; width: calc((100% - var(--space-2)) / 2); max-width: none; min-width: 0; transform: none; }
    .runtime-skin-navigation-side--previous { justify-content: flex-start; }
    .runtime-skin-navigation-side--next { justify-content: flex-end; }
    .runtime-skin-navigation-button.ant-btn-text { width: 100%; min-width: 0; justify-content: flex-start; padding-inline: 4px; }
    .runtime-skin-navigation-side--next .runtime-skin-navigation-button { justify-content: flex-end; }
    .runtime-skin-navigation-name { display: -webkit-box; flex: 1 1 auto; max-width: none; overflow: hidden; line-height: 1.35; white-space: normal; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .runtime-skin-navigation-side--next .runtime-skin-navigation-name { text-align: right; }
  }
  @media (min-width: 768px) and (max-width: 1599px) {
    .runtime-skin-navigation { width: min(var(--content-width), calc(100vw - (var(--page-gutter) * 2))); }
    .runtime-skin-navigation-button.ant-btn-text { padding-inline: 12px; }
  }
</style>
