---
import type { HTMLAttributes } from "astro/types";
import DownOutlined from "./icons/DownOutlined.astro";

export interface SelectOption {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface SelectOptionGroup {
  label: string;
  options: SelectOption[];
}

type OptionOrGroup = SelectOption | SelectOptionGroup;

interface Props extends Omit<HTMLAttributes<"select">, "size" | "value" | "aria-label"> {
  options: OptionOrGroup[];
  name?: string;
  value?: string;
  ariaLabel?: string;
  placeholder?: string;
  disabled?: boolean;
  showSearch?: boolean;
  filterOption?: boolean;
  optionFilterProp?: "label" | "value";
  allowClear?: boolean;
  prefix?: string;
  popupMatchSelectWidth?: boolean;
  size?: "small" | "medium" | "large";
  class?: string;
}

const {
  options,
  name,
  value,
  ariaLabel,
  placeholder,
  disabled = false,
  showSearch = false,
  filterOption = true,
  optionFilterProp = "label",
  allowClear = false,
  prefix,
  popupMatchSelectWidth = true,
  size = "medium",
  ...attributes
} = Astro.props;
const isGroup = (item: OptionOrGroup): item is SelectOptionGroup => "options" in item;
const flatOptions = options.flatMap((item) => isGroup(item) ? item.options : [item]);
const initialOption = flatOptions.find((option) => value !== undefined && option.value === value)
  ?? flatOptions.find((option) => !option.disabled);
const initialLabel = initialOption && (initialOption.value !== "" || !placeholder) ? initialOption.label : undefined;
---

<div class="ant-select-ssr" data-select-ssr>
<select
  {...attributes}
  class:list={["ant-select-source", attributes.class]}
  data-select-source
  data-select-size={size}
  data-select-show-search={showSearch ? "" : undefined}
  data-select-filter-option={filterOption ? undefined : "false"}
  data-select-option-filter-prop={optionFilterProp !== "label" ? optionFilterProp : undefined}
  data-select-allow-clear={allowClear ? "" : undefined}
  data-select-prefix={prefix}
  data-select-popup-match-width={popupMatchSelectWidth ? undefined : "false"}
  data-select-placeholder={placeholder}
  {name}
  aria-label={ariaLabel}
  disabled={disabled}
>
  {options.map((item) => isGroup(item)
    ? <optgroup label={item.label}>{item.options.map((option) => <option value={option.value} disabled={option.disabled} selected={value !== undefined && option.value === value}>{option.label}</option>)}</optgroup>
    : <option value={item.value} disabled={item.disabled} selected={value !== undefined && item.value === value}>{item.label}</option>)}
</select>
<div
  class:list={["ant-select", "ant-select-single", "ant-select-outlined", "ant-select-show-arrow", {
    "ant-select-sm": size === "small",
    "ant-select-lg": size === "large",
    "ant-select-disabled": disabled,
  }, attributes.class]}
  data-select-preview
  aria-hidden="true"
>
  {prefix && <span class="ant-select-prefix">{prefix}</span>}
  <div class:list={["ant-select-content", { "ant-select-content-has-value": initialLabel !== undefined }]}>
    {initialLabel !== undefined
      ? <span class="ant-select-content-value">{initialLabel}</span>
      : <div class="ant-select-placeholder">{placeholder}</div>}
  </div>
  <span class="ant-select-suffix"><DownOutlined /></span>
</div>
</div>

<script>
  import { enhanceSelects } from "./select";

  enhanceSelects(document);
</script>
