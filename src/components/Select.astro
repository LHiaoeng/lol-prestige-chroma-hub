---
import type { HTMLAttributes } from "astro/types";

export interface SelectOption {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface SelectOptionGroup {
  label: string;
  options: SelectOption[];
}

type OptionOrGroup = SelectOption | SelectOptionGroup;

interface Props extends Omit<HTMLAttributes<"select">, "size" | "value" | "aria-label"> {
  options: OptionOrGroup[];
  name?: string;
  value?: string;
  ariaLabel?: string;
  placeholder?: string;
  disabled?: boolean;
  showSearch?: boolean;
  allowClear?: boolean;
  prefix?: string;
  popupMatchSelectWidth?: boolean;
  size?: "small" | "middle" | "large";
  class?: string;
}

const {
  options,
  name,
  value,
  ariaLabel,
  placeholder,
  disabled = false,
  showSearch = false,
  allowClear = false,
  prefix,
  popupMatchSelectWidth = true,
  size = "middle",
  ...attributes
} = Astro.props;
const isGroup = (item: OptionOrGroup): item is SelectOptionGroup => "options" in item;
---

<select
  {...attributes}
  class:list={["ant-select-source", attributes.class]}
  data-select-source
  data-select-size={size}
  data-select-show-search={showSearch ? "" : undefined}
  data-select-allow-clear={allowClear ? "" : undefined}
  data-select-prefix={prefix}
  data-select-popup-match-width={popupMatchSelectWidth ? undefined : "false"}
  data-select-placeholder={placeholder}
  {name}
  aria-label={ariaLabel}
  disabled={disabled}
>
  {options.map((item) => isGroup(item)
    ? <optgroup label={item.label}>{item.options.map((option) => <option value={option.value} disabled={option.disabled} selected={value !== undefined && option.value === value}>{option.label}</option>)}</optgroup>
    : <option value={item.value} disabled={item.disabled} selected={value !== undefined && item.value === value}>{item.label}</option>)}
</select>

<script>
  import { enhanceSelects } from "./select";

  enhanceSelects(document);
</script>
