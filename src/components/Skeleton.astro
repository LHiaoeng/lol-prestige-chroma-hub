---
interface Props {
  readonly filterCount?: number;
  readonly itemCount?: number;
  readonly layout?: "champions" | "universes" | "skinlines" | "generic" | "detail" | "skin-detail" | "skinline-detail" | "skin-grid" | "universe-detail" | "pbe";
  readonly showDetailHeader?: boolean;
}

const { filterCount = 0, itemCount = 6, layout = "generic", showDetailHeader = true } = Astro.props;
---

<div class="runtime-skeleton" aria-hidden="true">
  {showDetailHeader && (layout === "detail" || layout === "skin-detail" || layout === "skinline-detail") && <div class="runtime-detail-skeleton-header">
    <div class="runtime-detail-skeleton-title">
      {(layout === "detail" || layout === "skinline-detail") && <span class="runtime-skeleton-media runtime-detail-skeleton-icon"></span>}
      <span class="runtime-skeleton-line runtime-skeleton-line--heading"></span>
    </div>
    <span class="runtime-skeleton-line runtime-skeleton-line--lede"></span>
    <span class="runtime-skeleton-line runtime-skeleton-line--lede-short"></span>
  </div>}
  {layout === "skin-detail" && <div class="runtime-skin-detail-skeleton">
    <section class="runtime-skin-media-skeleton">
      <span class="runtime-skeleton-line runtime-skeleton-line--group-title"></span>
      <div class="runtime-media-carousel-skeleton">
        <div class="runtime-skeleton-media"></div>
      </div>
      <div class="runtime-media-carousel-controls-skeleton">
        {Array.from({ length: 6 }, () => <span class="runtime-skeleton-line"></span>)}
      </div>
    </section>
  </div>}
  {layout === "skinline-detail" && <div class="runtime-skinline-detail-skeleton">
    <span class="runtime-skeleton-line runtime-skeleton-line--group-title"></span>
    <div class="runtime-skeleton-toolbar">
      <div class="runtime-skeleton-field"><span class="runtime-skeleton-label"></span><div class="runtime-skeleton-control"></div></div>
    </div>
    <div class="runtime-skeleton-grid runtime-skeleton-grid--skins">
      {Array.from({ length: itemCount }, () => <div class="runtime-skeleton-card runtime-skeleton-card--skin">
        <div class="runtime-skeleton-media"></div>
        <div class="runtime-skeleton-meta">
          <span class="runtime-skeleton-line runtime-skeleton-line--title"></span>
          <span class="runtime-skeleton-line runtime-skeleton-line--secondary"></span>
        </div>
      </div>)}
    </div>
  </div>}
  {layout === "detail" && <>
    <span class="runtime-skeleton-line runtime-skeleton-line--group-title"></span>
    <div class="runtime-skeleton-toolbar">
      {Array.from({ length: 2 }, () => <div class="runtime-skeleton-field"><span class="runtime-skeleton-label"></span><div class="runtime-skeleton-control"></div></div>)}
    </div>
  </>}
  {layout === "pbe" && <div class="runtime-pbe-skeleton">
    <div class="runtime-pbe-versions">
      {Array.from({ length: 2 }, () => <div class="runtime-pbe-version"><span class="runtime-skeleton-line"></span><span class="runtime-skeleton-line"></span></div>)}
    </div>
    <div class="runtime-pbe-summary"><span class="runtime-skeleton-line runtime-skeleton-line--summary"></span></div>
    <section class="runtime-pbe-section"><span class="runtime-skeleton-line runtime-skeleton-line--group-title"></span><div class="runtime-pbe-grid">
      {Array.from({ length: itemCount }, () => <div class="runtime-skeleton-card runtime-skeleton-card--skin runtime-skeleton-card--pbe-media"><div class="runtime-skeleton-media"></div><div class="runtime-skeleton-meta"><span class="runtime-skeleton-line runtime-skeleton-line--title"></span></div><div class="runtime-skeleton-pbe-owner"><span class="runtime-skeleton-line runtime-skeleton-line--secondary"></span></div></div>)}
    </div></section>
  </div>}
  {(filterCount > 0 || layout === "universe-detail") && <div class:list={["runtime-skeleton-toolbar", { "runtime-skeleton-toolbar--universe-detail": layout === "universe-detail" }]}>
    {Array.from({ length: filterCount }, () => <div class="runtime-skeleton-field">
      <span class="runtime-skeleton-label"></span>
      <div class="runtime-skeleton-control"></div>
    </div>)}
    {layout === "universe-detail" && filterCount === 0 && Array.from({ length: 2 }, () => <div class="runtime-skeleton-field">
      <span class="runtime-skeleton-label"></span>
      <div class="runtime-skeleton-control"></div>
    </div>)}
  </div>}
  {layout === "universe-detail" ? <div class="runtime-universe-skeleton-groups">
    {Array.from({ length: 2 }, () => <section class="runtime-universe-skeleton-group">
      <span class="runtime-skeleton-line runtime-skeleton-line--group-title"></span>
      <div class="runtime-skeleton-grid runtime-skeleton-grid--skins">
        {Array.from({ length: itemCount }, () => <div class="runtime-skeleton-card runtime-skeleton-card--skin">
          <div class="runtime-skeleton-media"></div>
          <div class="runtime-skeleton-meta">
            <span class="runtime-skeleton-line runtime-skeleton-line--title"></span>
            <span class="runtime-skeleton-line runtime-skeleton-line--secondary"></span>
          </div>
        </div>)}
      </div>
    </section>)}
  </div> : layout === "skin-detail" || layout === "skinline-detail" || layout === "pbe" ? null : <div class:list={["ant-skeleton-grid", "ant-masonry", "runtime-skeleton-grid", { "runtime-skeleton-grid--champions": layout === "champions", "runtime-skeleton-grid--skins": layout === "skin-grid" || layout === "detail" }]}>
    {Array.from({ length: itemCount }, (_, index) => <div class:list={["ant-skeleton-card", "runtime-skeleton-card", { "runtime-skeleton-card--champion": layout === "champions", "runtime-skeleton-card--skinline": layout === "skinlines", "runtime-skeleton-card--universe": layout === "universes", "runtime-skeleton-card--skin": layout === "skin-grid" || layout === "detail" }]}>
      {layout === "skinlines" ? <>
        <div class="runtime-skeleton-skinline-title"><span class="runtime-skeleton-line runtime-skeleton-line--title"></span></div>
        <div class="runtime-skeleton-skinline-universes">
          {Array.from({ length: index % 2 + 1 }, () => <span class="runtime-skeleton-line runtime-skeleton-line--chip"></span>)}
        </div>
      </> : <>
        {(layout === "champions" || layout === "skin-grid" || layout === "detail") && <div class="runtime-skeleton-media"></div>}
        <div class="runtime-skeleton-meta">
          <span class="runtime-skeleton-line runtime-skeleton-line--title"></span>
          {(layout === "skin-grid" || layout === "detail")
            ? <span class="runtime-skeleton-line runtime-skeleton-line--secondary"></span>
            : layout === "universes"
              ? Array.from({ length: (index % 3) + 1 }, () => <span class="runtime-skeleton-line runtime-skeleton-line--tree"></span>)
              : <span class="runtime-skeleton-line runtime-skeleton-line--secondary"></span>}
        </div>
      </>}
    </div>)}
  </div>}
</div>
