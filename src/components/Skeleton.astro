---
interface Props {
  readonly filterCount?: number;
  readonly itemCount?: number;
  readonly layout?: "champions" | "universes" | "skinlines" | "generic" | "detail" | "skin-detail" | "skinline-detail" | "skin-grid" | "universe-detail";
  readonly showDetailHeader?: boolean;
}

const { filterCount = 0, itemCount = 6, layout = "generic", showDetailHeader = true } = Astro.props;
---

<div class="runtime-skeleton" aria-hidden="true">
  {showDetailHeader && (layout === "detail" || layout === "skin-detail" || layout === "skinline-detail") && <div class="runtime-detail-skeleton-header">
    <div class="runtime-detail-skeleton-title">
      {(layout === "detail" || layout === "skinline-detail") && <span class="runtime-skeleton-media runtime-detail-skeleton-icon"></span>}
      <span class="runtime-skeleton-line runtime-skeleton-line--heading"></span>
    </div>
    <span class="runtime-skeleton-line runtime-skeleton-line--lede"></span>
    <span class="runtime-skeleton-line runtime-skeleton-line--lede-short"></span>
  </div>}
  {layout === "skin-detail" && <div class="runtime-skin-detail-skeleton">
    <div class="runtime-links runtime-skeleton-relations">
      <span class="runtime-skeleton-line runtime-skeleton-line--chip"></span>
    </div>
    <span class="runtime-skeleton-line runtime-skeleton-line--summary"></span>
    <div class="runtime-skin-detail-skeleton-media runtime-skeleton-media"></div>
    <span class="runtime-skeleton-line runtime-skeleton-line--group-title"></span>
    <div class="runtime-skeleton-grid runtime-skeleton-grid--skins">
      {Array.from({ length: 4 }, () => <div class="runtime-skeleton-card runtime-skeleton-card--skin">
        <div class="runtime-skeleton-media"></div>
        <div class="runtime-skeleton-meta">
          <span class="runtime-skeleton-line runtime-skeleton-line--title"></span>
        </div>
      </div>)}
    </div>
  </div>}
  {layout === "skinline-detail" && <div class="runtime-skinline-detail-skeleton">
    <div class="runtime-links runtime-skeleton-relations">
      {Array.from({ length: 3 }, () => <span class="runtime-skeleton-line runtime-skeleton-line--chip"></span>)}
    </div>
    <span class="runtime-skeleton-line runtime-skeleton-line--group-title"></span>
    <div class="runtime-skeleton-grid runtime-skeleton-grid--skins">
      {Array.from({ length: itemCount }, () => <div class="runtime-skeleton-card runtime-skeleton-card--skin">
        <div class="runtime-skeleton-media"></div>
        <div class="runtime-skeleton-meta">
          <span class="runtime-skeleton-line runtime-skeleton-line--title"></span>
          <span class="runtime-skeleton-line runtime-skeleton-line--secondary"></span>
        </div>
      </div>)}
    </div>
  </div>}
  {(filterCount > 0 || layout === "universe-detail") && <div class:list={["runtime-skeleton-toolbar", { "runtime-skeleton-toolbar--universe-detail": layout === "universe-detail" }]}>
    {Array.from({ length: filterCount }, () => <div class="runtime-skeleton-field">
      <span class="runtime-skeleton-label"></span>
      <div class="runtime-skeleton-control"></div>
    </div>)}
    {layout === "universe-detail" && filterCount === 0 && Array.from({ length: 2 }, () => <div class="runtime-skeleton-field">
      <span class="runtime-skeleton-label"></span>
      <div class="runtime-skeleton-control"></div>
    </div>)}
  </div>}
  {layout === "universe-detail" ? <div class="runtime-universe-skeleton-groups">
    {Array.from({ length: 2 }, () => <section class="runtime-universe-skeleton-group">
      <span class="runtime-skeleton-line runtime-skeleton-line--group-title"></span>
      <div class="runtime-skeleton-grid runtime-skeleton-grid--skins">
        {Array.from({ length: itemCount }, () => <div class="runtime-skeleton-card runtime-skeleton-card--skin">
          <div class="runtime-skeleton-media"></div>
          <div class="runtime-skeleton-meta">
            <span class="runtime-skeleton-line runtime-skeleton-line--title"></span>
            <span class="runtime-skeleton-line runtime-skeleton-line--secondary"></span>
          </div>
        </div>)}
      </div>
    </section>)}
  </div> : layout === "skin-detail" || layout === "skinline-detail" ? null : <div class:list={["ant-skeleton-grid", "ant-masonry", "runtime-skeleton-grid", { "runtime-skeleton-grid--champions": layout === "champions", "runtime-skeleton-grid--skins": layout === "skin-grid" || layout === "detail" }]}>
    {Array.from({ length: itemCount }, (_, index) => <div class:list={["ant-skeleton-card", "runtime-skeleton-card", { "runtime-skeleton-card--champion": layout === "champions", "runtime-skeleton-card--universe": layout === "universes", "runtime-skeleton-card--skin": layout === "skin-grid" || layout === "detail" }]}>
      {(layout === "champions" || layout === "skin-grid" || layout === "detail") && <div class="runtime-skeleton-media"></div>}
      <div class="runtime-skeleton-meta">
        <span class="runtime-skeleton-line runtime-skeleton-line--title"></span>
        {(layout === "skin-grid" || layout === "detail")
          ? <span class="runtime-skeleton-line runtime-skeleton-line--secondary"></span>
          : layout === "universes"
            ? Array.from({ length: (index % 3) + 1 }, () => <span class="runtime-skeleton-line runtime-skeleton-line--tree"></span>)
            : layout !== "skinlines" && <span class="runtime-skeleton-line runtime-skeleton-line--secondary"></span>}
      </div>
    </div>)}
  </div>}
</div>
