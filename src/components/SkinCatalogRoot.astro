---
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/config';
import Breadcrumb from './Breadcrumb.astro';
import Divider from './Divider.astro';
import DomainIcon from './DomainIcon.astro';
import RuntimeChannelSwitcher from './RuntimeChannelSwitcher.astro';
import Empty from './Empty.astro';
import Alert from './Alert.astro';
import Select from './Select.astro';
import '../styles/skin-catalog.css';
import releaseSnapshot from '../../data/skin-release-dates.json';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh-cn';
const releaseDates = JSON.stringify(releaseSnapshot.skins.map(({ skinId, globalReleaseDate, chinaReleaseDate, globalReleaseVersion, chinaReleaseVersion }) => [skinId, globalReleaseDate, chinaReleaseDate, globalReleaseVersion, chinaReleaseVersion]));
---

<Breadcrumb {locale} items={[
  { title: isZh ? '首页' : 'Home', href: localizedPath(locale, '/') },
  { title: isZh ? '英雄联盟' : 'League of Legends', href: localizedPath(locale, '/#home-tools-title') },
  { title: isZh ? '皮肤' : 'Skins' },
]} />
<section class="skin-catalog" data-skin-catalog data-catalog-locale={isZh ? 'zh_cn' : 'default'} data-catalog-release-dates={releaseDates} aria-labelledby="skin-catalog-title">
  <header class="skin-catalog-header">
    <h1 id="skin-catalog-title"><DomainIcon name="skins" />{isZh ? '皮肤' : 'Skins'}</h1>
    <div class="skin-catalog-summary-skeleton" data-catalog-summary-skeleton aria-hidden="true">
      <span class="runtime-skeleton-line runtime-skeleton-line--version"></span>
      <span class="runtime-skeleton-line runtime-skeleton-line--divider"></span>
      <span class="runtime-skeleton-line runtime-skeleton-line--count"></span>
    </div>
    <div class="runtime-source runtime-channel-row skin-catalog-summary" data-catalog-summary aria-label={isZh ? '资料版本' : 'Reference data channel'} hidden>
      <RuntimeChannelSwitcher {locale} />
      <Divider type="vertical" />
      <span class="runtime-list-count" data-catalog-count role="status" aria-live="polite" hidden></span>
    </div>
  </header>
  <Divider />
  <div class="skin-catalog-filter-skeleton" data-catalog-filter-skeleton aria-hidden="true">
    <span class="runtime-skeleton-line"></span>
    <span class="runtime-skeleton-line"></span>
    <span class="runtime-skeleton-line"></span>
  </div>
  <div class="skin-catalog-search" hidden>
    <label for="skin-catalog-search">{isZh ? '搜索皮肤或英雄' : 'Search skins or champions'}</label>
    <input class="cn-input" id="skin-catalog-search" type="search" data-catalog-search autocomplete="off" placeholder={isZh ? '输入皮肤或英雄名称' : 'Skin or champion name'} />
  </div>
  <fieldset class="skin-catalog-rarities" hidden>
    <legend>{isZh ? '稀有度' : 'Rarity'}</legend>
    <div class="skin-catalog-rarity-options" data-catalog-rarities></div>
  </fieldset>
  <div class="skin-catalog-toolbar" hidden>
    <div class="skin-catalog-display-settings">
      <label class="skin-catalog-framed-setting">
        <span data-catalog-framed-tooltip-trigger>
          <input type="checkbox" data-catalog-framed-all aria-label={isZh ? '显示边框' : 'Show borders'} />
          <span>{isZh ? '边框' : 'Borders'}</span>
        </span>
        <span class="skin-catalog-framed-count" data-catalog-framed-count></span>
      </label>
      {isZh && <label class="skin-catalog-emblems-setting">
        <input type="checkbox" data-catalog-emblems-all checked aria-label="显示皮肤徽章" />
        <span>徽章</span>
      </label>}
      <label class="skin-catalog-classic-setting">
        <input type="checkbox" data-catalog-classic aria-label={isZh ? '经典皮肤' : 'Classic skins'} />
        <span>{isZh ? '经典皮肤' : 'Classic skins'}</span>
      </label>
      <label class="skin-catalog-pbe-setting">
        <input type="checkbox" data-catalog-pbe-only aria-label={isZh ? 'PBE 新增' : 'PBE additions'} />
        <span>{isZh ? 'PBE 新增' : 'PBE additions'}</span>
      </label>
    </div>
    <div class="skin-catalog-view-switch" data-catalog-view-switch></div>
    <Select
      class="skin-catalog-sort"
      data-catalog-sort=""
      ariaLabel={isZh ? '排序方式' : 'Sort order'}
      popupMatchSelectWidth={false}
      options={[
        { value: 'asc', label: isZh ? '英雄名称升序' : 'Champion name A–Z' },
        { value: 'desc', label: isZh ? '英雄名称降序' : 'Champion name Z–A' },
        { value: 'release_desc', label: isZh ? '发布时间：最新优先' : 'Release date: newest first' },
        { value: 'release_asc', label: isZh ? '发布时间：最早优先' : 'Release date: oldest first' },
      ]}
    />
  </div>
  <p class="sr-only skin-catalog-status" data-catalog-status role="status" aria-live="polite"></p>
  <div data-catalog-content>
    <div class="skin-catalog-skeleton" aria-hidden="true">
      {Array.from({ length: 6 }, () => <div class="skin-catalog-skeleton-card"><span></span><span></span></div>)}
    </div>
    <ol class="skin-catalog-timeline-skeleton" aria-hidden="true" hidden>
      {Array.from({ length: 4 }, () => <li><div class="skin-catalog-timeline-skeleton-content"><div class="skin-catalog-timeline-skeleton-heading"><span></span></div><div class="skin-catalog-grid">{Array.from({ length: 6 }, () => <span></span>)}</div></div></li>)}
    </ol>
  </div>
  <template data-catalog-empty-template><Empty description="" /></template>
  <template data-catalog-error-template><Alert type="error" title="" /></template>
  <div class="skin-catalog-results" data-catalog-results role="region" aria-label={isZh ? '皮肤列表' : 'Skin list'} hidden>
    <div class="skin-catalog-grid" id="skin-catalog-grid" data-catalog-grid></div>
    <div class="skin-catalog-timeline" id="skin-catalog-timeline" data-catalog-timeline hidden></div>
    <div class="skin-catalog-load-more-footer" data-catalog-load-more-footer hidden>
      <button class="ant-btn" type="button" data-catalog-load-more aria-controls="skin-catalog-grid">{isZh ? '加载更多' : 'Load more'}</button>
    </div>
  </div>
  <noscript><p>{isZh ? '请启用 JavaScript 以浏览皮肤目录。' : 'Enable JavaScript to browse the skin catalog.'}</p></noscript>
</section>

<script>
  import { initSkinCatalog } from '../client/skin-catalog';
  const root = document.querySelector<HTMLElement>('[data-skin-catalog]');
  if (root) initSkinCatalog(root);
</script>
