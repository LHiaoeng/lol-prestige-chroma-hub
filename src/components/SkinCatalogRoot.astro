---
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/config';
import Breadcrumb from './Breadcrumb.astro';
import Divider from './Divider.astro';
import DomainIcon from './DomainIcon.astro';
import '../styles/skin-catalog.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isZh = locale === 'zh-cn';
---

<Breadcrumb {locale} items={[
  { title: isZh ? '首页' : 'Home', href: localizedPath(locale, '/') },
  { title: isZh ? '英雄联盟' : 'League of Legends', href: localizedPath(locale, '/#home-tools-title') },
  { title: isZh ? '皮肤' : 'Skins' },
]} />
<section class="skin-catalog" data-skin-catalog data-catalog-locale={isZh ? 'zh_cn' : 'default'} aria-labelledby="skin-catalog-title">
  <header class="skin-catalog-header">
    <h1 id="skin-catalog-title"><DomainIcon name="skins" />{isZh ? '皮肤' : 'Skins'}</h1>
    <div class="skin-catalog-channel" role="group" aria-label={isZh ? '资料版本' : 'Reference data channel'}>
      <button type="button" data-catalog-channel="pbe" aria-pressed="true">PBE</button>
      <button type="button" data-catalog-channel="latest" aria-pressed="false">{isZh ? '正式服' : 'Live'}</button>
    </div>
  </header>
  <Divider />
  <nav class="skin-catalog-explore" aria-label={isZh ? '其他浏览方式' : 'Other ways to browse'}>
    <a href={localizedPath(locale, '/champions/')}>{isZh ? '按英雄' : 'By champion'}</a>
    <a href={localizedPath(locale, '/skinlines/')}>{isZh ? '按系列' : 'By skinline'}</a>
  </nav>
  <div class="skin-catalog-search">
    <label for="skin-catalog-search">{isZh ? '搜索皮肤或英雄' : 'Search skins or champions'}</label>
    <input id="skin-catalog-search" type="search" data-catalog-search autocomplete="off" placeholder={isZh ? '输入皮肤或英雄名称' : 'Skin or champion name'} />
  </div>
  <fieldset class="skin-catalog-rarities">
    <legend>{isZh ? '稀有度' : 'Rarity'}</legend>
    <div class="skin-catalog-rarity-options" data-catalog-rarities></div>
  </fieldset>
  <div class="skin-catalog-toolbar">
    <p data-catalog-count role="status" aria-live="polite">{isZh ? '正在统计皮肤…' : 'Counting skins…'}</p>
    <label>{isZh ? '按英雄排序' : 'Sort by champion'}
      <select data-catalog-sort>
        <option value="asc">{isZh ? '英雄名称升序' : 'Champion name A–Z'}</option>
        <option value="desc">{isZh ? '英雄名称降序' : 'Champion name Z–A'}</option>
      </select>
    </label>
  </div>
  <p class="skin-catalog-status" data-catalog-status role="status" aria-live="polite">{isZh ? '正在加载皮肤资料…' : 'Loading skin references…'}</p>
  <div data-catalog-content>
    <div class="skin-catalog-skeleton" aria-hidden="true">
      {Array.from({ length: 6 }, () => <div class="skin-catalog-skeleton-card"><span></span><span></span></div>)}
    </div>
  </div>
  <div class="skin-catalog-viewport" data-catalog-viewport tabindex="0" role="region" aria-label={isZh ? '皮肤列表' : 'Skin list'} hidden></div>
  <noscript><p>{isZh ? '请启用 JavaScript 以浏览皮肤目录。' : 'Enable JavaScript to browse the skin catalog.'}</p></noscript>
</section>

<script>
  import { initSkinCatalog } from '../client/skin-catalog';
  const root = document.querySelector<HTMLElement>('[data-skin-catalog]');
  if (root) initSkinCatalog(root);
</script>
