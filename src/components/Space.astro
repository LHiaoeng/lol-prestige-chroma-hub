---
import type { HTMLAttributes } from 'astro/types';

type Orientation = 'horizontal' | 'vertical';
type Align = 'start' | 'end' | 'center' | 'baseline';
type Size = 'small' | 'middle' | 'medium' | 'large' | number;
type Part = 'root' | 'item' | 'separator';
type Style = Exclude<HTMLAttributes<'div'>['style'], string | null | undefined>;
type Semantic<T> = Partial<Record<Part, T>>;
type SemanticOption<T> = Semantic<T> | ((info: { props: Props }) => Semantic<T>);

interface Props extends Omit<HTMLAttributes<'div'>, 'style'> {
  readonly items?: readonly string[];
  readonly size?: Size | readonly [Size, Size];
  readonly orientation?: Orientation;
  readonly direction?: Orientation;
  readonly vertical?: boolean;
  readonly align?: Align;
  readonly wrap?: boolean;
  readonly separator?: string | number;
  readonly rootClass?: string;
  readonly classes?: SemanticOption<string>;
  readonly styles?: SemanticOption<Style>;
  readonly style?: Style;
}

const {
  items = ['default'], size = 'small', orientation, direction, vertical, align, wrap,
  separator, class: className, rootClass, classes, styles, style, ...attributes
} = Astro.props;
const axis = orientation ?? (vertical === undefined ? direction ?? 'horizontal' : vertical ? 'vertical' : 'horizontal');
const alignment = align ?? (axis === 'horizontal' ? 'center' : undefined);
const [column, row] = typeof size === 'object' ? size : [size, size];
const gaps = { small: 'var(--space-2)', middle: 'var(--space-3)', medium: 'var(--space-3)', large: 'var(--space-4)' };
const gap = (value: Size) => typeof value === 'number' ? `${value}px` : gaps[value];
const semanticProps = { props: { ...Astro.props, orientation: axis, align: alignment } };
const partClasses = typeof classes === 'function' ? classes(semanticProps) : classes;
const partStyles = typeof styles === 'function' ? styles(semanticProps) : styles;
const content = (await Promise.all(items.map((name) => Astro.slots.render(name)))).filter((html) => html?.trim());
const separatorHtml = Astro.slots.has('separator') ? await Astro.slots.render('separator') : undefined;
const hasSeparator = separatorHtml === undefined ? separator !== undefined && separator !== '' : Boolean(separatorHtml.trim());
---

{content.length > 0 && (
  <div
    {...attributes}
    class:list={['ant-space', `ant-space-${axis}`, alignment && `ant-space-align-${alignment}`, className, rootClass, partClasses?.root]}
    style={{ columnGap: gap(column), rowGap: gap(row), flexWrap: wrap && axis === 'horizontal' ? 'wrap' : undefined, ...partStyles?.root, ...style }}
  >
    {content.map((html, index) => (
      <>
        <div class:list={['ant-space-item', partClasses?.item]} style={partStyles?.item}><Fragment set:html={html} /></div>
        {index < content.length - 1 && hasSeparator && (
          <span class:list={['ant-space-item-item-separator', partClasses?.separator]} style={partStyles?.separator}>
            {separatorHtml === undefined ? separator : <Fragment set:html={separatorHtml} />}
          </span>
        )}
      </>
    ))}
  </div>
)}

<style>
  .ant-space { display: inline-flex; }
  .ant-space-vertical { flex-direction: column; }
  .ant-space-align-center { align-items: center; }
  .ant-space-align-start { align-items: flex-start; }
  .ant-space-align-end { align-items: flex-end; }
  .ant-space-align-baseline { align-items: baseline; }
</style>
