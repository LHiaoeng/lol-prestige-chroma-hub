---
import '../styles/global.css';
import '../styles/article.css';
import '../styles/backgrounds.css';
import '../components/happy-work-effect.css';
import BackToTop from '../components/BackToTop.astro';
import MediaViewer from '../components/MediaViewer.astro';
import AdSlot from '../components/AdSlot.astro';
import DomainIcon from '../components/DomainIcon.astro';
import DownOutlined from '../components/icons/DownOutlined.astro';
import Icon from '../components/icons/Icon.astro';
import Dropdown from '../components/Dropdown.astro';
import { headerNavigationState } from '../components/header-navigation';
import { safeJsonLd } from '../domain/chroma';
import { resolveAdProvider, resolveAdSenseSlot, type AdPlacement } from '../domain/ad-policy';
import { alternateUrls, localeConfig, localizedPath, resolveLocale, type Locale } from '../i18n/config';
import { SITE } from '../seo/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | readonly Record<string, unknown>[];
  locale?: Locale;
  noindex?: boolean;
  adPlacement?: AdPlacement;
  ads?: boolean;
}
const { title, description, canonical: canonicalInput, image = SITE.defaultImage, ogType = 'website', publishedTime, modifiedTime, jsonLd, adPlacement, ads = true } = Astro.props;
const adProvider = resolveAdProvider(process.env.AD_PROVIDER);
const adsenseSlot = adProvider === 'adsense' ? resolveAdSenseSlot(process.env.ADSENSE_AD_SLOT) : undefined;
const activeAdProvider = adProvider === 'none' ? undefined : adProvider;
const renderAds = ads && activeAdProvider;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const currentLocale = localeConfig[locale];
const isZh = locale === 'zh-cn';
const canonical = canonicalInput ? new URL(localizedPath(locale, new URL(canonicalInput).pathname), SITE.origin).toString() : undefined;
const alternates = canonical ? alternateUrls(canonical) : [];
const alternateOgLocales = Object.entries(localeConfig)
  .filter(([key]) => key !== locale)
  .map(([, config]) => config.ogLocale);
const otherLocale: Locale = isZh ? 'en' : 'zh-cn';
const languageHref = localizedPath(otherLocale, `${Astro.url.pathname}${Astro.url.search}`);
const socialImage = new URL(image, SITE.origin).toString();
const jsonLdText = jsonLd ? safeJsonLd(jsonLd) : undefined;
const headerNavigation = headerNavigationState(Astro.url.pathname);
---
<!doctype html>
<html lang={currentLocale.htmlLang} data-language={isZh ? 'zh' : 'en'} data-language-ready data-ads-disabled={!ads ? '' : undefined}>
  <head>
    <meta name="theme-color" content="#000000" />
    <script is:inline>
      (() => {
        try {
          let preference = localStorage.getItem('theme-mode');
          if (preference !== 'system' && preference !== 'light' && preference !== 'dark') preference = 'dark';
          const prefersDark = preference === 'system'
            && typeof window.matchMedia === 'function'
            && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = preference === 'dark' || prefersDark ? 'dark' : 'light';
          document.documentElement.dataset.themePreference = preference;
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          document.querySelector('meta[name="theme-color"]').content = theme === 'light' ? '#ffffff' : '#000000';
        } catch {
          document.documentElement.dataset.themePreference = 'dark';
          document.documentElement.dataset.theme = 'dark';
          document.documentElement.style.colorScheme = 'dark';
        }
      })();
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-N2XNGMV2"></script>
    <script is:inline>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.url} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={currentLocale.ogLocale} />
    {alternateOgLocales.map((alternate) => <meta property="og:locale:alternate" content={alternate} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
    <noscript>
      <style is:inline>
        .ant-select-ssr > [data-select-preview] { display: none; }
        .ant-select-ssr:has(> [data-select-preview]) > .ant-select-source { position: static; opacity: 1; }
      </style>
    </noscript>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localizedPath(locale, '/')} aria-label={isZh ? 'LoL Chroma Art 首页' : 'LoL Chroma Art home'}><img src="/logo.svg" alt="" width="32" height="32" /><span class="brand-text"><span>LoL CHROMA</span> ART</span></a>
      <div class="header-controls">
        <div class="header-browse">
          <Dropdown id="browse-nav">
            <a slot="trigger" role="button" tabindex="0" class="ant-btn ant-btn-variant-text" aria-label={isZh ? '英雄联盟' : 'League of Legends'}>
              <Icon name="league-of-legends" />
              {isZh ? <span>英雄联盟</span> : <><span class="browse-menu-label-wide">League of Legends</span><span class="browse-menu-label-short" aria-hidden="true">LoL</span></>}
              <DownOutlined class="ant-dropdown-down-icon" />
            </a>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/pbe-additions/')} aria-current={headerNavigation.current('/pbe-additions/')}><DomainIcon name="pbe-additions" class="ant-dropdown-menu-item-icon" />{isZh ? 'PBE 新增' : 'PBE additions'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/prestige-chromas/')} aria-current={headerNavigation.current('/prestige-chromas/', '/chromas/') ?? headerNavigation.current('/prestige-chromas/')}><DomainIcon name="prestige-chromas" class="ant-dropdown-menu-item-icon" />{isZh ? '臻彩原画' : 'Prestige Chroma Splash Art'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/champions/')} aria-current={headerNavigation.current('/champions/')}><DomainIcon name="champions" class="ant-dropdown-menu-item-icon" />{isZh ? '英雄' : 'Champions'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/skins/')} aria-current={headerNavigation.current('/skins/')}><DomainIcon name="skins" class="ant-dropdown-menu-item-icon" />{isZh ? '皮肤' : 'Skins'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/skinlines/')} aria-current={headerNavigation.current('/skinlines/')}><DomainIcon name="skinlines" class="ant-dropdown-menu-item-icon" />{isZh ? '系列' : 'Skinlines'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/universes/')} aria-current={headerNavigation.current('/universes/')}><DomainIcon name="universes" class="ant-dropdown-menu-item-icon" />{isZh ? '宇宙' : 'Universes'}</a></li>
          </Dropdown>
        </div>
        <div class="header-browse">
          <Dropdown id="tft-browse-nav">
            <a slot="trigger" role="button" tabindex="0" class="ant-btn ant-btn-variant-text" aria-label={isZh ? '云顶之弈' : 'Teamfight Tactics'}>
              <DomainIcon name="teamfight-tactics" />
              {isZh ? <span>云顶之弈</span> : <><span class="tft-nav-label-wide">Teamfight Tactics</span><span class="tft-nav-label-short" aria-hidden="true">TFT</span></>}
              <DownOutlined class="ant-dropdown-down-icon" />
            </a>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/tft/companions/')} aria-current={headerNavigation.current('/tft/companions/')}><DomainIcon name="tft-companions" class="ant-dropdown-menu-item-icon" />{isZh ? '小小英雄' : 'Tacticians'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/tft/arenas/')} aria-current={headerNavigation.current('/tft/arenas/')}><DomainIcon name="tft-arenas" class="ant-dropdown-menu-item-icon" />{isZh ? '棋盘' : 'Arenas'}</a></li>
          </Dropdown>
        </div>
        <a class="ant-btn ant-btn-variant-text header-blog-link" href={localizedPath(locale, '/blog/')} aria-current={headerNavigation.current('/blog/')}>
          <Icon name="FileTextOutlined" /> {isZh ? '博客' : 'Blog'}
        </a>
        {canonical && <a class="ant-btn ant-btn-variant-text ant-btn-icon-only language-toggle" href={languageHref} lang={localeConfig[otherLocale].htmlLang} hreflang={localeConfig[otherLocale].hreflang} aria-label={isZh ? '切换到英文' : 'Switch to Simplified Chinese'} title={isZh ? '中文 / English' : 'English / 中文'}><span class="language-toggle-mark" aria-hidden="true"><span class="language-toggle-current">{isZh ? '中' : 'En'}</span><span class="language-toggle-next">{isZh ? 'En' : '中'}</span></span></a>}
        <Dropdown id="theme-preference" placement="bottomRight">
          <button slot="trigger" type="button" class="ant-btn ant-btn-variant-text ant-btn-icon-only theme-toggle" aria-label={isZh ? '主题' : 'Theme'} title={isZh ? '主题' : 'Theme'}>
            <Icon name="theme-switch" style="fill:currentColor;stroke:none" />
          </button>
          <li role="none"><button type="button" role="menuitemradio" data-ant-dropdown-item data-theme-option="system" aria-checked="false"><Icon name="SyncOutlined" class="ant-dropdown-menu-item-icon" />{isZh ? '跟随系统' : 'System'}<span class="theme-option-dot" aria-hidden="true"></span></button></li>
          <li role="none"><button type="button" role="menuitemradio" data-ant-dropdown-item data-theme-option="light" aria-checked="false"><Icon name="SunOutlined" class="ant-dropdown-menu-item-icon" />{isZh ? '浅色主题' : 'Light theme'}<span class="theme-option-dot" aria-hidden="true"></span></button></li>
          <li role="none"><button type="button" role="menuitemradio" data-ant-dropdown-item data-theme-option="dark" aria-checked="true"><Icon name="MoonOutlined" class="ant-dropdown-menu-item-icon" />{isZh ? '暗黑主题' : 'Dark theme'}<span class="theme-option-dot" aria-hidden="true"></span></button></li>
          <li role="separator" class="theme-menu-separator"></li>
          <li role="none"><button type="button" role="menuitemcheckbox" data-ant-dropdown-item data-happy-work-toggle aria-checked="false"><Icon name="SmileOutlined" class="ant-dropdown-menu-item-icon" />{isZh ? '快乐工作特效' : 'Happy Work Effect'}<span class="theme-option-dot" aria-hidden="true"></span></button></li>
        </Dropdown>
      </div>
    </header>
    <main><slot /></main>
    <MediaViewer {locale} />
    {renderAds && <AdSlot placement={adPlacement ?? 'page'} provider={activeAdProvider} {adsenseSlot} {locale} />}
    <BackToTop />
    <footer><p>{isZh ? <>LoL Chroma Art 由爱好者独立维护，与 Riot Games 或腾讯不存在关联，也未获得其认可。本站依据 Riot Games 的 <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">“Legal Jibber Jabber”</a> 政策使用《英雄联盟》素材。</> : <>LoL Chroma Art is an independent fan-run site and is not affiliated with or endorsed by Riot Games or Tencent. League of Legends assets are used under Riot Games' <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">"Legal Jibber Jabber"</a> policy.</>}</p><p class="footer-links"><a href={localizedPath(locale, '/about/')}>{isZh ? '关于' : 'About'}</a><span class="footer-separator" aria-hidden="true">·</span><a href={localizedPath(locale, '/blog/')}>{isZh ? '博客' : 'Blog'}</a><span class="footer-separator" aria-hidden="true">·</span><a href={localizedPath(locale, '/privacy/')}>{isZh ? '隐私说明' : 'Privacy Policy'}</a></p></footer>
    <script>
      import { bindImageFallbacks } from '../client/image-fallback';
      import { bindHeaderGlass } from '../client/header-glass';
      import { bindThemeSwitcher } from '../client/theme-switcher';
      import { bindHappyWorkEffect } from '../components/happy-work-effect';
      import { bindTypographyParagraphs } from '../components/Typography';
      import { bindCardTitleTooltips } from '../components/card-title';
      bindImageFallbacks();
      bindHeaderGlass();
      bindThemeSwitcher();
      bindHappyWorkEffect();
      bindTypographyParagraphs();
      bindCardTitleTooltips();
    </script>
    <style is:global>
      html[data-language="zh"]:not([data-language-ready]) body { visibility: hidden; }
      html[data-language="en"] [data-language-content="zh"], html[data-language="zh"] [data-language-content="en"] { display: none; }
      .brand { display: flex; align-items: center; gap: var(--space-2); }
      .brand img { display: block; width: 32px; height: 32px; flex: none; }
      .brand > .brand-text { color: var(--text); }
      .site-header .brand-text { text-shadow: var(--header-brand-shadow); }
      .header-controls { display:flex; align-items:center; flex:0 0 auto; }
      .header-browse { display:flex; align-items:center; flex:0 0 auto; }
      .header-controls .header-blog-link[aria-current] { color:var(--gold-text); }
      .theme-toggle > svg { width:16px; height:16px; }
      .theme-option-dot { width:6px; height:6px; flex:none; margin-inline-start:auto; border-radius:50%; background:var(--theme-option-indicator); opacity:0; }
      [aria-checked="true"] > .theme-option-dot { opacity:1; }
      .ant-dropdown-menu .theme-menu-separator { margin-block:4px; border-block-start:1px solid var(--line); }
      .browse-menu-label-short { display:none; }
      .tft-nav-label-short { display:none; }
      .language-toggle-mark { position:relative; width:1em; height:1em; }
      .language-toggle-current, .language-toggle-next { position:absolute; border:1px solid currentColor; font-size:1em; line-height:1; }
      .language-toggle-current { z-index:1; inset-block-start:0; inset-inline-start:0; border-color:var(--gold-border); background:var(--gold); color:var(--on-gold); transform:scale(.7); transform-origin:top left; }
      .language-toggle-next { inset-block-end:0; inset-inline-end:0; transform:scale(.5); transform-origin:bottom right; }
      @media (max-width: 767px) {
        .header-controls .ant-btn { min-height:var(--control-height-sm); height:var(--control-height-sm); padding-inline:7px; }
        .header-controls .ant-btn-icon-only { width:var(--control-height-sm); min-width:var(--control-height-sm); padding:0; }
        .browse-menu-label-wide { display:none; }
        .browse-menu-label-short { display:inline; }
        .tft-nav-label-wide { display:none; }
        .tft-nav-label-short { display:inline; }
        .brand { gap: var(--space-2); min-width: 0; margin-right: var(--space-2); }
        .brand-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
      }
      @media (max-width: 420px) {
        .brand { flex:0 0 32px; margin-right:0; }
        .brand > .brand-text { display:none; }
        .header-browse .ant-btn > span { display:none; }
      }
      footer a { color: var(--gold-text); text-decoration: underline; text-underline-offset: 3px; }
      footer a:hover { color:var(--gold-hover-text); }
      footer a:active { color:var(--gold-active-text); }
      footer a:focus-visible { outline:2px solid var(--gold-text); outline-offset:3px; }
      .footer-links { display: flex; justify-content: center; align-items: center; gap: var(--space-2); }
      .footer-separator { color: var(--tertiary); font-size: var(--font-size-body); line-height:var(--line-height-body); }
    </style>
  </body>
</html>
