---
import '../styles/global.css';
import { safeJsonLd } from '../domain/chroma';
import { defaultLanguage, supportedLanguages } from '../i18n';
import { SITE } from '../seo/site';

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | readonly Record<string, unknown>[];
}
const { title, description, canonical, image = SITE.defaultImage, ogType = 'website', publishedTime, modifiedTime, jsonLd } = Astro.props;
const socialImage = new URL(image, SITE.origin).toString();
const jsonLdText = jsonLd ? safeJsonLd(jsonLd) : undefined;
const languageBootstrap = `try{const s=${JSON.stringify(supportedLanguages)},d=${JSON.stringify(defaultLanguage)},v=localStorage.getItem('chroma-art-language');document.documentElement.dataset.language=s.includes(v)?v:d}catch{document.documentElement.dataset.language=${JSON.stringify(defaultLanguage)}}`;
---
<!doctype html>
<html lang="en" data-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b15" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline set:html={languageBootstrap} />
    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="CHROMA ART home" data-aria-en="CHROMA ART home" data-aria-zh="CHROMA ART 首页"><img src="/logo.svg" alt="" width="32" height="32" /><span class="brand-text"><span>CHROMA</span> ART</span></a>
      <div class="header-controls">
        <a class="header-blog-link" href="/blog/" data-en="Blog" data-zh="博客">Blog</a>
        <button class="language-toggle" type="button" data-language-toggle data-en="中文" data-zh="EN" aria-label="切换到中文" data-aria-en="Switch to Chinese" data-aria-zh="切换到英文">中文</button>
      </div>
    </header>
    <main><slot /></main>
    <footer><p><span data-language-content="en">Chroma Art was created under Riot Games' <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">"Legal Jibber Jabber"</a> policy using assets owned by Riot Games. Riot Games does not endorse or sponsor this project.</span><span data-language-content="zh">Chroma Art 根据 Riot Games 的 <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">“Legal Jibber Jabber”</a> 政策创建，并使用 Riot Games 所拥有的素材。Riot Games 不对此项目提供认可或赞助。</span></p><p class="footer-links"><a href="/about/" data-en="About" data-zh="关于">About</a><span class="footer-separator" aria-hidden="true">·</span><a href="/blog/" data-en="Blog" data-zh="博客">Blog</a><span class="footer-separator" aria-hidden="true">·</span><a href="/privacy/" data-en="Privacy Policy" data-zh="隐私说明">Privacy Policy</a></p></footer>
    <script>
      import { bindImageFallbacks } from '../client/image-fallback';
      import { initializeLanguage } from '../client/language';
      initializeLanguage(document, localStorage);
      bindImageFallbacks();
    </script>
    <style is:global>
      html[data-language="zh"]:not([data-language-ready]) body { visibility: hidden; }
      html[data-language="en"] [data-language-content="zh"], html[data-language="zh"] [data-language-content="en"] { display: none; }
      .brand { display: flex; align-items: center; gap: 10px; }
      .brand img { display: block; width: 32px; height: 32px; }
      .brand > .brand-text { color: var(--text); }
      .header-controls { display: flex; align-items: center; gap: 14px; }
      .header-blog-link { display: inline-flex; align-items: center; min-height: var(--touch-target); color: var(--text); font-size: .86rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
      .header-blog-link:hover, .header-blog-link:focus-visible { color: var(--gold); }
      .language-toggle { min-height: var(--touch-target); border: 1px solid var(--gold); border-radius: 999px; background: transparent; color: var(--gold); padding: 6px 14px; cursor: pointer; }
      @media (max-width: 767px) {
        .header-controls { gap: 8px; }
        .header-blog-link { font-size: .76rem; letter-spacing: .05em; }
        .language-toggle { padding-inline: 12px; }
      }
      footer a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
      .footer-links { display: flex; justify-content: center; align-items: center; gap: 12px; }
      .footer-separator { color: color-mix(in srgb, var(--muted) 55%, transparent); font-size: 1rem; }
    </style>
  </body>
</html>
