---
import '../styles/global.css';
import '../styles/article.css';
import '../styles/backgrounds.css';
import BackToTop from '../components/BackToTop.astro';
import MediaViewer from '../components/MediaViewer.astro';
import AdSlot from '../components/AdSlot.astro';
import DomainIcon from '../components/DomainIcon.astro';
import DownOutlined from '../components/icons/DownOutlined.astro';
import Dropdown from '../components/Dropdown.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { headerNavigationState } from '../components/header-navigation';
import { safeJsonLd } from '../domain/chroma';
import type { AdPlacement } from '../domain/ad-policy';
import { alternateUrls, localeConfig, localizedPath, resolveLocale, type Locale } from '../i18n/config';
import { SITE } from '../seo/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | readonly Record<string, unknown>[];
  locale?: Locale;
  noindex?: boolean;
  adPlacement?: AdPlacement;
}
const { title, description, canonical: canonicalInput, image = SITE.defaultImage, ogType = 'website', publishedTime, modifiedTime, jsonLd, adPlacement } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const currentLocale = localeConfig[locale];
const isZh = locale === 'zh-cn';
const canonical = canonicalInput ? new URL(localizedPath(locale, new URL(canonicalInput).pathname), SITE.origin).toString() : undefined;
const alternates = canonical ? alternateUrls(canonical) : [];
const alternateOgLocales = Object.entries(localeConfig)
  .filter(([key]) => key !== locale)
  .map(([, config]) => config.ogLocale);
const otherLocale: Locale = isZh ? 'en' : 'zh-cn';
const languageHref = localizedPath(otherLocale, `${Astro.url.pathname}${Astro.url.search}`);
const socialImage = new URL(image, SITE.origin).toString();
const jsonLdText = jsonLd ? safeJsonLd(jsonLd) : undefined;
const headerNavigation = headerNavigationState(Astro.url.pathname);
---
<!doctype html>
<html lang={currentLocale.htmlLang} data-language={isZh ? 'zh' : 'en'} data-language-ready>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.url} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={currentLocale.ogLocale} />
    {alternateOgLocales.map((alternate) => <meta property="og:locale:alternate" content={alternate} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {adPlacement && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1090619659930920" crossorigin="anonymous"></script>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localizedPath(locale, '/')} aria-label={isZh ? 'LoL Chroma Art 首页' : 'LoL Chroma Art home'}><img src="/logo.svg" alt="" width="32" height="32" /><span class="brand-text"><span>LoL CHROMA</span> ART</span></a>
      <div class="header-controls">
        <div class:list={['header-browse', { 'header-browse--current': headerNavigation.browsePath }]}>
          <Dropdown id="browse-nav" triggerLabel={isZh ? '英雄联盟' : 'League of Legends'} triggerVariant="text">
            <span slot="trigger" class="header-browse-trigger">
              <img class="browse-league-icon" src="/img/icons/league-of-legends.svg" alt="" width="14" height="14" />
              {isZh ? <span>英雄联盟</span> : <><span class="browse-menu-label-wide">League of Legends</span><span class="browse-menu-label-short" aria-hidden="true">LoL</span></>}
              <DownOutlined class="browse-menu-chevron" width="12" height="12" />
            </span>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/pbe-additions/')} aria-current={headerNavigation.current('/pbe-additions/')}><DomainIcon name="pbe-additions" class="browse-nav-icon" />{isZh ? 'PBE 新增' : 'PBE additions'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/champions/')} aria-current={headerNavigation.current('/champions/')}><DomainIcon name="champions" class="browse-nav-icon" />{isZh ? '英雄' : 'Champions'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/skins/')} aria-current={headerNavigation.current('/skins/')}><DomainIcon name="skins" class="browse-nav-icon" />{isZh ? '皮肤' : 'Skins'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/skinlines/')} aria-current={headerNavigation.current('/skinlines/')}><DomainIcon name="skinlines" class="browse-nav-icon" />{isZh ? '系列' : 'Skinlines'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/universes/')} aria-current={headerNavigation.current('/universes/')}><DomainIcon name="universes" class="browse-nav-icon" />{isZh ? '宇宙' : 'Universes'}</a></li>
          </Dropdown>
        </div>
        <div class:list={['header-browse', 'header-browse--tft', { 'header-browse--current': headerNavigation.current('/tft/companions/', '/tft/') }]}>
          <Dropdown id="tft-browse-nav" triggerLabel={isZh ? '云顶之弈' : 'Teamfight Tactics'} triggerVariant="text">
            <span slot="trigger" class="header-browse-trigger tft-nav-link">
              <DomainIcon name="teamfight-tactics" class="tft-nav-icon" />
              {isZh ? <span>云顶之弈</span> : <><span class="tft-nav-label-wide">Teamfight Tactics</span><span class="tft-nav-label-short" aria-hidden="true">TFT</span></>}
              <DownOutlined class="browse-menu-chevron" width="12" height="12" />
            </span>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/tft/companions/')} aria-current={headerNavigation.current('/tft/companions/', '/tft/')}>{isZh ? '小小英雄' : 'Tacticians'}</a></li>
            <li role="none"><a role="menuitem" data-ant-dropdown-item href={localizedPath(locale, '/tft/arenas/')} aria-current={headerNavigation.current('/tft/arenas/', '/tft/')}>{isZh ? '棋盘' : 'Arenas'}</a></li>
          </Dropdown>
        </div>
        <ButtonLink class="header-action header-blog-link" href={localizedPath(locale, '/blog/')} aria-current={headerNavigation.current('/blog/')}>{isZh ? '博客' : 'Blog'}</ButtonLink>
        {canonical && <ButtonLink class="header-action language-toggle" iconOnly href={languageHref} lang={localeConfig[otherLocale].htmlLang} hreflang={localeConfig[otherLocale].hreflang} aria-label={isZh ? '切换到英文' : 'Switch to Simplified Chinese'} title={isZh ? '中文 / English' : 'English / 中文'}><span class="language-toggle-mark" aria-hidden="true"><span class="language-toggle-current">{isZh ? '中' : 'En'}</span><span class="language-toggle-next">{isZh ? 'En' : '中'}</span></span></ButtonLink>}
      </div>
    </header>
    <main><slot /></main>
    <MediaViewer {locale} />
    {adPlacement && <AdSlot placement={adPlacement} />}
    <BackToTop />
    <footer><p>{isZh ? <>LoL Chroma Art 是独立的爱好者图鉴，与 Riot Games 或腾讯不存在关联，也未获得其认可。本站依据 Riot Games 的 <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">“Legal Jibber Jabber”</a> 政策使用《英雄联盟》素材。</> : <>LoL Chroma Art is an independent fan archive and is not affiliated with or endorsed by Riot Games or Tencent. League of Legends assets are used under Riot Games' <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">"Legal Jibber Jabber"</a> policy.</>}</p><p class="footer-links"><a href={localizedPath(locale, '/about/')}>{isZh ? '关于' : 'About'}</a><span class="footer-separator" aria-hidden="true">·</span><a href={localizedPath(locale, '/blog/')}>{isZh ? '博客' : 'Blog'}</a><span class="footer-separator" aria-hidden="true">·</span><a href={localizedPath(locale, '/privacy/')}>{isZh ? '隐私说明' : 'Privacy Policy'}</a></p></footer>
    <script>
      import { bindImageFallbacks } from '../client/image-fallback';
      import { bindHeaderGlass } from '../client/header-glass';
      import { bindTypographyParagraphs } from '../components/Typography';
      bindImageFallbacks();
      bindHeaderGlass();
      bindTypographyParagraphs();
    </script>
    <style is:global>
      html[data-language="zh"]:not([data-language-ready]) body { visibility: hidden; }
      html[data-language="en"] [data-language-content="zh"], html[data-language="zh"] [data-language-content="en"] { display: none; }
      .brand { display: flex; align-items: center; gap: var(--space-2); }
      .brand img { display: block; width: 32px; height: 32px; flex: none; }
      .brand > .brand-text { color: var(--text); }
      .site-header .brand-text { text-shadow: 0 1px 7px #000000d9; }
      .header-controls { display: flex; align-items: center; gap: var(--space-1); min-width: 0; }
      .header-browse { display:flex; align-items:center; flex:0 0 auto; }
      .site-header .header-action[aria-current], .site-header .header-browse--current .ant-dropdown-trigger { color:var(--gold); }
      .site-header .header-action[aria-current]:hover, .site-header .header-browse--current .ant-dropdown-trigger:hover { color:var(--gold-hover); }
      .site-header .header-browse .ant-dropdown-open .ant-dropdown-trigger { background:var(--fill); }
      .site-header .header-browse-trigger { display:inline-flex; align-items:center; gap:var(--space-1); }
      .browse-league-icon { display:block; width:14px; height:14px; flex:none; }
      .browse-menu-label-short { display:none; }
      .tft-nav-link { gap:var(--space-1); }
      .tft-nav-icon { width:14px; height:14px; flex:none; }
      .tft-nav-label-short { display:none; }
      .browse-menu-chevron { width:12px; height:12px; flex:none; transition:transform var(--motion-mid) ease; }
      .header-browse .ant-dropdown-open .browse-menu-chevron { transform:rotate(180deg); }
      .site-header .ant-dropdown-menu a { justify-content:flex-start; gap:var(--space-2); white-space:nowrap; }
      .site-header .ant-dropdown-menu .browse-nav-icon { width:12px; height:12px; margin-inline:1px; flex:none; color:inherit; }
      .header-blog-link { flex-shrink:0; }
      .language-toggle { position:relative; width:var(--control-height); min-width:var(--control-height); height:var(--control-height); flex-shrink:0; }
      .language-toggle-mark { position:relative; width:32px; height:32px; }
      .language-toggle-current, .language-toggle-next { position:absolute; border:1px solid var(--line); font-size:16.8px; line-height:16.8px; white-space:nowrap; }
      .language-toggle-current { z-index:1; top:7px; left:7px; border-color:var(--gold); background:var(--gold); color:var(--on-gold); font-weight:400; transform:scale(.7); transform-origin:top left; }
      .language-toggle-next { top:15px; left:16px; background:transparent; color:var(--muted); transform:scale(.5); transform-origin:top left; }
      @media (max-width: 767px) {
        .header-controls { gap: var(--space-1); }
        .browse-menu-label-wide { display:none; }
        .browse-menu-label-short { display:inline; }
        .tft-nav-label-wide { display:none; }
        .tft-nav-label-short { display:inline; }
        .brand { gap: var(--space-2); min-width: 0; margin-right: var(--space-2); }
        .brand-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
        .header-controls { flex: 0 0 auto; }
      }
      @media (max-width: 479px) {
        .header-browse .ant-dropdown-popup { left:auto; right:0; }
      }
      @media (max-width: 420px) {
        .brand { flex:0 0 32px; margin-right:0; }
        .brand > .brand-text { display:none; }
        .header-controls { gap:var(--space-1); }
        .site-header .header-browse-trigger { gap:0; }
        .header-browse-trigger > span, .tft-nav-link > span { display:none; }
        .site-header .header-browse .ant-dropdown-trigger { padding-inline:8px; }
        .site-header .header-browse--tft .ant-dropdown-trigger { width:var(--control-height); min-width:var(--control-height); padding:0; }
      }
      footer a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
      footer a:hover { color:var(--gold-hover); }
      footer a:active { color:var(--gold-active); }
      footer a:focus-visible { outline:2px solid var(--gold); outline-offset:3px; }
      .footer-links { display: flex; justify-content: center; align-items: center; gap: var(--space-2); }
      .footer-separator { color: var(--tertiary); font-size: var(--font-size-body); line-height:var(--line-height-body); }
    </style>
  </body>
</html>
