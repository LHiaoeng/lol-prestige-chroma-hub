---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';
import AdSlot from '../components/AdSlot.astro';
import { safeJsonLd } from '../domain/chroma';
import type { AdPlacement } from '../domain/ad-policy';
import { alternateUrls, localeConfig, localizedPath, resolveLocale, type Locale } from '../i18n/config';
import { SITE } from '../seo/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | readonly Record<string, unknown>[];
  locale?: Locale;
  noindex?: boolean;
  adPlacement?: AdPlacement;
}
const { title, description, canonical: canonicalInput, image = SITE.defaultImage, ogType = 'website', publishedTime, modifiedTime, jsonLd, adPlacement } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const currentLocale = localeConfig[locale];
const isZh = locale === 'zh-cn';
const canonical = canonicalInput ? new URL(localizedPath(locale, new URL(canonicalInput).pathname), SITE.origin).toString() : undefined;
const alternates = canonical ? alternateUrls(canonical) : [];
const alternateOgLocales = Object.entries(localeConfig)
  .filter(([key]) => key !== locale)
  .map(([, config]) => config.ogLocale);
const otherLocale: Locale = isZh ? 'en' : 'zh-cn';
const languageHref = localizedPath(otherLocale, `${Astro.url.pathname}${Astro.url.search}`);
const socialImage = new URL(image, SITE.origin).toString();
const jsonLdText = jsonLd ? safeJsonLd(jsonLd) : undefined;
---
<!doctype html>
<html lang={currentLocale.htmlLang} data-language={isZh ? 'zh' : 'en'} data-language-ready>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#090b15" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.url} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={currentLocale.ogLocale} />
    {alternateOgLocales.map((alternate) => <meta property="og:locale:alternate" content={alternate} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {adPlacement && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1090619659930920" crossorigin="anonymous"></script>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localizedPath(locale, '/')} aria-label={isZh ? 'LoL Chroma Art 首页' : 'LoL Chroma Art home'}><img src="/logo.svg" alt="" width="32" height="32" /><span class="brand-text"><span>LoL CHROMA</span> ART</span></a>
      <div class="header-controls">
        <div class="browse-menu">
          <button type="button" class="browse-menu-toggle" aria-label={isZh ? '更多导航' : 'More'} aria-expanded="false">
            <svg class="browse-menu-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            <span>{isZh ? '更多' : 'More'}</span>
          </button>
          <nav class="browse-nav" aria-label={isZh ? '更多导航' : 'More'}>
            <a href={localizedPath(locale, '/champions/')}>{isZh ? '英雄' : 'Champions'}</a>
            <a href={localizedPath(locale, '/skinlines/')}>{isZh ? '系列' : 'Skinlines'}</a>
            <a href={localizedPath(locale, '/universes/')}>{isZh ? '宇宙' : 'Universes'}</a>
            <a href={localizedPath(locale, '/pbe-additions/')}>{isZh ? 'PBE 新增' : 'PBE additions'}</a>
          </nav>
        </div>
        <a class="header-blog-link" href={localizedPath(locale, '/blog/')}>{isZh ? '博客' : 'Blog'}</a>
        {canonical && <a class="language-toggle" href={languageHref} lang={localeConfig[otherLocale].htmlLang} hreflang={localeConfig[otherLocale].hreflang} aria-label={isZh ? '切换到英文' : 'Switch to Simplified Chinese'}>{isZh ? 'EN' : '简体中文'}</a>}
      </div>
    </header>
    <main><slot /></main>
    {adPlacement && <AdSlot placement={adPlacement} />}
    <BackToTop />
    <footer><p>{isZh ? <>LoL Chroma Art 是独立的爱好者图鉴，与 Riot Games 或腾讯不存在关联，也未获得其认可。本站依据 Riot Games 的 <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">“Legal Jibber Jabber”</a> 政策使用《英雄联盟》素材。</> : <>LoL Chroma Art is an independent fan archive and is not affiliated with or endorsed by Riot Games or Tencent. League of Legends assets are used under Riot Games' <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">"Legal Jibber Jabber"</a> policy.</>}</p><p class="footer-links"><a href={localizedPath(locale, '/about/')}>{isZh ? '关于' : 'About'}</a><span class="footer-separator" aria-hidden="true">·</span><a href={localizedPath(locale, '/blog/')}>{isZh ? '博客' : 'Blog'}</a><span class="footer-separator" aria-hidden="true">·</span><a href={localizedPath(locale, '/privacy/')}>{isZh ? '隐私说明' : 'Privacy Policy'}</a></p></footer>
    <script>
      import { bindImageFallbacks } from '../client/image-fallback';
      import { bindHeaderGlass } from '../client/header-glass';
      bindImageFallbacks();
      bindHeaderGlass();
      // 移动端浏览菜单展开/折叠
      const browseMenu = document.querySelector<HTMLElement>('.browse-menu');
      const browseToggle = document.querySelector<HTMLButtonElement>('.browse-menu-toggle');
      if (browseMenu && browseToggle) {
        browseToggle.addEventListener('click', () => {
          const open = browseMenu.classList.toggle('is-open');
          browseToggle.setAttribute('aria-expanded', String(open));
        });
        // 点击外部关闭（仅移动端）
        document.addEventListener('click', (e) => {
          if (window.innerWidth >= 768) return;
          if (browseMenu.classList.contains('is-open') && !browseMenu.contains(e.target as Node)) {
            browseMenu.classList.remove('is-open');
            browseToggle.setAttribute('aria-expanded', 'false');
          }
        });
      }
    </script>
    <style is:global>
      html[data-language="zh"]:not([data-language-ready]) body { visibility: hidden; }
      html[data-language="en"] [data-language-content="zh"], html[data-language="zh"] [data-language-content="en"] { display: none; }
      .brand { display: flex; align-items: center; gap: 10px; }
      .brand img { display: block; width: 32px; height: 32px; }
      .brand > .brand-text { color: var(--text); }
      .site-header .brand-text, .site-header .browse-nav a, .site-header .browse-menu-toggle, .site-header .header-blog-link, .site-header .language-toggle { text-shadow: 0 1px 7px #000000d9; }
      .header-controls { display: flex; align-items: center; gap: 14px; min-width: 0; }
      .browse-menu { display: flex; align-items: center; min-width: 0; flex: 1 1 auto; }
      .browse-menu > .browse-menu-toggle { display: none; background: none; border: none; font-family: inherit; }
      .browse-menu > .browse-nav { display: flex; }
      .browse-nav { align-items:center; gap:12px; overflow-x:auto; scrollbar-width:none; min-width: 0; }
      .browse-nav::-webkit-scrollbar { display:none; }
      .browse-nav a { display:inline-flex; align-items:center; min-height:var(--touch-target); padding:0 12px; border-radius:999px; color:var(--muted); font-size:.78rem; font-weight:700; white-space:nowrap; transition:color .2s ease, background-color .2s ease; }
      .browse-nav a:hover, .browse-nav a:focus-visible { color:var(--gold); background: color-mix(in srgb, var(--text) 7%, transparent); }
      .header-blog-link { display: inline-flex; align-items: center; min-height: var(--touch-target); padding: 0 12px; border-radius: 999px; color: var(--text); font-size: .86rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; transition: color .2s ease, background-color .2s ease; flex-shrink: 0; }
      .header-blog-link:hover, .header-blog-link:focus-visible { color: var(--gold); background: color-mix(in srgb, var(--text) 7%, transparent); }
      .language-toggle { display: inline-flex; align-items: center; justify-content: center; position: relative; min-height: 32px; border: 1px solid var(--gold); border-radius: 999px; background: color-mix(in srgb, var(--text) 7%, transparent); color: var(--gold); padding: 3px 10px; font-size: .78rem; line-height: 1; cursor: pointer; transition: background-color .2s ease, border-color .2s ease, color .2s ease; flex-shrink: 0; white-space: nowrap; }
      .language-toggle:hover, .language-toggle:focus-visible { background: color-mix(in srgb, var(--gold) 18%, transparent); }
      .language-toggle::before { content: ""; position: absolute; inset: -6px; border-radius: inherit; }
      @media (max-width: 767px) {
        .header-controls { gap: 8px; }
        .brand { gap: 8px; }
        .browse-menu { position: relative; flex: 0 0 auto; }
        .browse-menu > .browse-menu-toggle { display: inline-flex; align-items: center; gap: 4px; min-height: var(--touch-target); padding: 0 10px; border-radius: 999px; color: var(--muted); font-size: .76rem; font-weight: 700; cursor: pointer; transition: color .2s ease, background-color .2s ease; }
        .browse-menu > .browse-menu-toggle:hover, .browse-menu > .browse-menu-toggle:focus-visible { color: var(--gold); background: color-mix(in srgb, var(--text) 7%, transparent); }
        .browse-menu > .browse-menu-toggle:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
        .browse-menu > .browse-nav { display: none; position: absolute; top: calc(100% + 6px); right: 0; flex-direction: column; gap: 2px; min-width: 140px; padding: 8px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,.5); z-index: 30; }
        .browse-menu.is-open > .browse-nav { display: flex; }
        .browse-menu > .browse-nav a { width: 100%; justify-content: flex-start; font-size: .82rem; padding: 10px 12px; }
        .header-blog-link { font-size: .76rem; letter-spacing: .05em; padding-inline: 9px; }
        .language-toggle { padding-inline: 9px; font-size: .75rem; }
      }
      @media (max-width: 479px) {
        .header-controls { gap: 6px; }
        .browse-menu > .browse-menu-toggle { font-size: .72rem; padding-inline: 8px; }
        .browse-menu > .browse-nav { min-width: 130px; }
        .header-blog-link { font-size: .72rem; padding-inline: 7px; }
        .language-toggle { padding-inline: 7px; font-size: .72rem; }
      }
      footer a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
      .footer-links { display: flex; justify-content: center; align-items: center; gap: 12px; }
      .footer-separator { color: color-mix(in srgb, var(--muted) 55%, transparent); font-size: 1rem; }
    </style>
  </body>
</html>
