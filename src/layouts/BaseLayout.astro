---
import '../styles/global.css';
import '../styles/article.css';
import '../styles/backgrounds.css';
import BackToTop from '../components/BackToTop.astro';
import AdSlot from '../components/AdSlot.astro';
import DomainIcon from '../components/DomainIcon.astro';
import { safeJsonLd } from '../domain/chroma';
import type { AdPlacement } from '../domain/ad-policy';
import { alternateUrls, localeConfig, localizedPath, resolveLocale, type Locale } from '../i18n/config';
import { SITE } from '../seo/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | readonly Record<string, unknown>[];
  locale?: Locale;
  noindex?: boolean;
  adPlacement?: AdPlacement;
}
const { title, description, canonical: canonicalInput, image = SITE.defaultImage, ogType = 'website', publishedTime, modifiedTime, jsonLd, adPlacement } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const currentLocale = localeConfig[locale];
const isZh = locale === 'zh-cn';
const canonical = canonicalInput ? new URL(localizedPath(locale, new URL(canonicalInput).pathname), SITE.origin).toString() : undefined;
const alternates = canonical ? alternateUrls(canonical) : [];
const alternateOgLocales = Object.entries(localeConfig)
  .filter(([key]) => key !== locale)
  .map(([, config]) => config.ogLocale);
const otherLocale: Locale = isZh ? 'en' : 'zh-cn';
const languageHref = localizedPath(otherLocale, `${Astro.url.pathname}${Astro.url.search}`);
const socialImage = new URL(image, SITE.origin).toString();
const jsonLdText = jsonLd ? safeJsonLd(jsonLd) : undefined;
---
<!doctype html>
<html lang={currentLocale.htmlLang} data-language={isZh ? 'zh' : 'en'} data-language-ready>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.url} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={currentLocale.ogLocale} />
    {alternateOgLocales.map((alternate) => <meta property="og:locale:alternate" content={alternate} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {adPlacement && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1090619659930920" crossorigin="anonymous"></script>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localizedPath(locale, '/')} aria-label={isZh ? 'LoL Chroma Art 首页' : 'LoL Chroma Art home'}><img src="/logo.svg" alt="" width="32" height="32" /><span class="brand-text"><span>LoL CHROMA</span> ART</span></a>
      <div class="header-controls">
        <div class="browse-menu">
          <button type="button" class="header-action browse-menu-toggle" aria-label={isZh ? '英雄联盟' : 'League of Legends'} aria-expanded="false" aria-controls="browse-nav">
            <img class="browse-league-icon" src="/img/icons/league-of-legends.svg" alt="" width="18" height="18" />
            {isZh ? <span>英雄联盟</span> : <><span class="browse-menu-label-wide">League of Legends</span><span class="browse-menu-label-short" aria-hidden="true">LoL</span></>}
            <svg class="browse-menu-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <nav id="browse-nav" class="browse-nav" aria-label={isZh ? '英雄联盟' : 'League of Legends'}>
            <a href={localizedPath(locale, '/pbe-additions/')}><DomainIcon name="pbe-additions" class="browse-nav-icon" />{isZh ? 'PBE 新增' : 'PBE additions'}</a>
            <a href={localizedPath(locale, '/champions/')}><DomainIcon name="champions" class="browse-nav-icon" />{isZh ? '英雄' : 'Champions'}</a>
            <a href={localizedPath(locale, '/skinlines/')}><DomainIcon name="skinlines" class="browse-nav-icon" />{isZh ? '系列' : 'Skinlines'}</a>
            <a href={localizedPath(locale, '/universes/')}><DomainIcon name="universes" class="browse-nav-icon" />{isZh ? '宇宙' : 'Universes'}</a>
          </nav>
        </div>
        <a class="header-action header-blog-link" href={localizedPath(locale, '/blog/')}>{isZh ? '博客' : 'Blog'}</a>
        {canonical && <a class="header-action language-toggle" href={languageHref} lang={localeConfig[otherLocale].htmlLang} hreflang={localeConfig[otherLocale].hreflang} aria-label={isZh ? '切换到英文' : 'Switch to Simplified Chinese'} title={isZh ? '中文 / English' : 'English / 中文'}><span class="language-toggle-mark" aria-hidden="true"><span class="language-toggle-current">{isZh ? '中' : 'En'}</span><span class="language-toggle-next">{isZh ? 'En' : '中'}</span></span></a>}
      </div>
    </header>
    <main><slot /></main>
    {adPlacement && <AdSlot placement={adPlacement} />}
    <BackToTop />
    <footer><p>{isZh ? <>LoL Chroma Art 是独立的爱好者图鉴，与 Riot Games 或腾讯不存在关联，也未获得其认可。本站依据 Riot Games 的 <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">“Legal Jibber Jabber”</a> 政策使用《英雄联盟》素材。</> : <>LoL Chroma Art is an independent fan archive and is not affiliated with or endorsed by Riot Games or Tencent. League of Legends assets are used under Riot Games' <a href="https://www.riotgames.com/en/legal" target="_blank" rel="noreferrer">"Legal Jibber Jabber"</a> policy.</>}</p><p class="footer-links"><a href={localizedPath(locale, '/about/')}>{isZh ? '关于' : 'About'}</a><span class="footer-separator" aria-hidden="true">·</span><a href={localizedPath(locale, '/blog/')}>{isZh ? '博客' : 'Blog'}</a><span class="footer-separator" aria-hidden="true">·</span><a href={localizedPath(locale, '/privacy/')}>{isZh ? '隐私说明' : 'Privacy Policy'}</a></p></footer>
    <script>
      import { bindImageFallbacks } from '../client/image-fallback';
      import { bindHeaderGlass } from '../client/header-glass';
      bindImageFallbacks();
      bindHeaderGlass();
      const browseMenu = document.querySelector<HTMLElement>('.browse-menu');
      const browseToggle = document.querySelector<HTMLButtonElement>('.browse-menu-toggle');
      if (browseMenu && browseToggle) {
        browseToggle.addEventListener('click', () => {
          const open = browseMenu.classList.toggle('is-open');
          browseToggle.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', (e) => {
          if (browseMenu.classList.contains('is-open') && !browseMenu.contains(e.target as Node)) {
            browseMenu.classList.remove('is-open');
            browseToggle.setAttribute('aria-expanded', 'false');
          }
        });
        browseMenu.querySelectorAll('.browse-nav a').forEach((link) => link.addEventListener('click', () => {
          browseMenu.classList.remove('is-open');
          browseToggle.setAttribute('aria-expanded', 'false');
        }));
        browseMenu.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape' || !browseMenu.classList.contains('is-open')) return;
          browseMenu.classList.remove('is-open');
          browseToggle.setAttribute('aria-expanded', 'false');
          browseToggle.focus();
        });
      }
    </script>
    <style is:global>
      html[data-language="zh"]:not([data-language-ready]) body { visibility: hidden; }
      html[data-language="en"] [data-language-content="zh"], html[data-language="zh"] [data-language-content="en"] { display: none; }
      .brand { display: flex; align-items: center; gap: var(--space-2); }
      .brand img { display: block; width: 32px; height: 32px; flex: none; }
      .brand > .brand-text { color: var(--text); }
      .site-header .brand-text, .site-header .browse-nav a, .site-header .header-action { text-shadow: 0 1px 7px #000000d9; }
      .header-controls { display: flex; align-items: center; gap: var(--space-1); min-width: 0; }
      .browse-menu { position: relative; display: flex; align-items: center; flex: 0 0 auto; }
      .header-action { display:inline-flex; align-items:center; justify-content:center; min-height:var(--control-height); padding:0 var(--space-2); border:1px solid transparent; border-radius:var(--radius-control); background:transparent; color:var(--text); font-size:var(--font-size-body); line-height:var(--line-height-body); font-weight:400; white-space:nowrap; transition:color var(--motion-fast) ease, background-color var(--motion-fast) ease; }
      .header-action:hover, .browse-menu.is-open > .browse-menu-toggle { color:var(--gold-hover); background:var(--hover-bg); }
      .header-action:active { color:var(--gold-active); background:var(--hover-bg); }
      .header-action:focus-visible { outline:2px solid var(--gold); outline-offset:2px; }
      .browse-menu > .browse-menu-toggle { gap:var(--space-1); cursor:pointer; }
      .browse-league-icon { display:block; width:18px; height:18px; flex:none; }
      .browse-menu-label-short { display:none; }
      .browse-menu-chevron { flex:none; transition:transform var(--motion-fast) ease; }
      .browse-menu.is-open .browse-menu-chevron { transform:rotate(180deg); }
      .browse-menu > .browse-nav { display:none; position:absolute; top:calc(100% + 6px); left:0; flex-direction:column; min-width:160px; padding:5px 0; background:var(--panel2); border:1px solid var(--line); border-radius:var(--radius-card); box-shadow:var(--shadow-popup); z-index:30; }
      .browse-menu.is-open > .browse-nav { display:flex; }
      .browse-nav a { display:inline-flex; align-items:center; width:calc(100% - 8px); min-height:max(40px, var(--control-height)); margin:4px; justify-content:flex-start; gap:10px; padding:0 16px; border-radius:var(--radius-control); color:var(--muted); font-size:var(--font-size-body); line-height:var(--line-height-body); white-space:nowrap; transition:color var(--motion-fast) ease, background-color var(--motion-fast) ease; }
      .browse-nav a .browse-nav-icon { width:14px; height:14px; flex:none; color:inherit; }
      .browse-nav a:hover { color:var(--gold-hover); background:var(--hover-bg); }
      .browse-nav a:active { color:var(--gold-active); }
      .browse-nav a:focus-visible { outline:2px solid var(--gold); outline-offset:2px; }
      .header-blog-link { flex-shrink:0; }
      .language-toggle { position:relative; width:var(--control-height); min-width:var(--control-height); height:var(--control-height); padding:0; flex-shrink:0; }
      .language-toggle-mark { position: relative; width: 32px; height: 32px; }
      .language-toggle-current, .language-toggle-next { position: absolute; border: 1px solid var(--line); font-size: 16.8px; line-height: 16.8px; white-space: nowrap; }
      .language-toggle-current { z-index: 1; top: 7px; left: 7px; border-color: var(--gold); background: var(--gold); color: var(--on-gold); font-weight: 400; transform: scale(.7); transform-origin: top left; }
      .language-toggle-next { top: 15px; left: 16px; background: transparent; color: var(--muted); transform: scale(.5); transform-origin: top left; }
      @media (max-width: 767px) {
        .header-controls { gap: var(--space-1); }
        .browse-menu-label-wide { display:none; }
        .browse-menu-label-short { display:inline; }
        .brand { gap: var(--space-2); min-width: 0; margin-right: var(--space-2); }
        .brand-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
        .header-controls { flex: 0 0 auto; }
      }
      @media (max-width: 479px) {
        .browse-menu > .browse-nav { left:auto; right:0; }
      }
      footer a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
      footer a:hover { color:var(--gold-hover); }
      footer a:active { color:var(--gold-active); }
      footer a:focus-visible { outline:2px solid var(--gold); outline-offset:3px; }
      .footer-links { display: flex; justify-content: center; align-items: center; gap: var(--space-2); }
      .footer-separator { color: var(--tertiary); font-size: var(--font-size-body); line-height:var(--line-height-body); }
    </style>
  </body>
</html>
