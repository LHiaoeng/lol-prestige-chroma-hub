---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogAdjacentNavigation from '../../components/BlogAdjacentNavigation.astro';
import BlogChromaCard from '../../components/BlogChromaCard.astro';
import BlogChromaGrid from '../../components/BlogChromaGrid.astro';
import ArticleMaintenance from '../../components/ArticleMaintenance.astro';
import { blogArticles, formatBlogDate } from '../../blog/articles';
import { evergreenGuideMaintenance } from '../../blog/evergreen-guides';
import { catalog } from '../../data/catalog';
import { latestGameVersion } from '../../domain/champion-coverage';
import type { Chroma } from '../../domain/chroma';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { SITE } from '../../seo/site';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const article = blogArticles.find((entry) => entry.slug === 'champion-most-prestige-chromas');
if (!article) throw new Error('Champion most prestige chromas article metadata is missing');
const maintenance = evergreenGuideMaintenance['champion-most-prestige-chromas'];
const title = `${isZh ? article.titleZh : article.titleEn} | ${SITE.name}`;
const description = isZh ? article.summaryZh : article.summaryEn;
const canonical = new URL(localizedPath(locale, article.href), SITE.origin).toString();
const homeUrl = new URL(localizedPath(locale, '/'), SITE.origin).toString();
const blogUrl = new URL(localizedPath(locale, '/blog/'), SITE.origin).toString();

const totalChromas = catalog.length;
const championCount = new Set(catalog.map((item) => item.heroId)).size;
const patchVersion = latestGameVersion(catalog.map((item) => item.gameVer));
const leaderboard = (() => {
  const map = new Map<string, { heroId: string; nameEn: string; nameZh: string; count: number }>();
  for (const chroma of catalog) {
    const entry = map.get(chroma.heroId);
    if (entry) { entry.count++; } else {
      map.set(chroma.heroId, { heroId: chroma.heroId, nameEn: chroma.heroNameEn, nameZh: chroma.heroNameZh, count: 1 });
    }
  }
  return [...map.values()].sort((a, b) => b.count - a.count).slice(0, 10);
})();
const leader = leaderboard[0];
if (!leader) throw new Error('Prestige chroma leaderboard is empty');
const leaderChromas: Chroma[] = catalog.filter((item) => item.heroId === leader.heroId);
const leaderSkinGroups = (() => {
  const map = new Map<string, { skinNameEn: string; skinNameZh: string; chromas: Chroma[] }>();
  for (const chroma of leaderChromas) {
    const key = chroma.skinNameEn;
    if (!map.has(key)) map.set(key, { skinNameEn: chroma.skinNameEn, skinNameZh: chroma.skinNameZh, chromas: [] });
    map.get(key)!.chromas.push(chroma);
  }
  return [...map.values()];
})();
function commonTrailingWords(values: readonly string[]): string {
  const tokenLists = values.map((value) => value.trim().split(/\s+/).reverse());
  if (tokenLists.length === 0) return '';
  const shared: string[] = [];
  for (let index = 0; tokenLists.every((tokens) => tokens[index] != null); index++) {
    const candidate = tokenLists[0][index];
    if (!tokenLists.every((tokens) => tokens[index].toLocaleLowerCase() === candidate.toLocaleLowerCase())) break;
    shared.push(candidate);
  }
  return shared.reverse().join(' ');
}
function shortHeroName(heroId: string, language: 'en' | 'zh', fallback: string): string {
  const skinNames = [...new Set(catalog.filter((item) => item.heroId === heroId).map((item) => language === 'en' ? item.skinNameEn : item.skinNameZh))];
  return commonTrailingWords(skinNames) || fallback.replace(/^the\s+/i, '');
}
const leaderNameEn = shortHeroName(leader.heroId, 'en', leader.nameEn);
const leaderNameZh = shortHeroName(leader.heroId, 'zh', leader.nameZh);
const largestSkinGroup = [...leaderSkinGroups].sort((left, right) => right.chromas.length - left.chromas.length)[0];
const runnerUpCount = leaderboard[1]?.count ?? 0;
const runnersUp = leaderboard.filter((entry) => entry.heroId !== leader.heroId && entry.count === runnerUpCount);
const runnersUpEn = runnersUp.map((entry) => shortHeroName(entry.heroId, 'en', entry.nameEn));
const runnersUpZh = runnersUp.map((entry) => shortHeroName(entry.heroId, 'zh', entry.nameZh));
const lead = leader.count - runnerUpCount;
const leadComparisonEn = lead > 0
  ? `${lead} ahead of ${runnersUpEn.join(' and ')} at ${runnerUpCount}`
  : `tied with ${runnersUpEn.join(' and ')} at ${leader.count}`;
const leadComparisonZh = lead > 0
  ? `比并列第二的${runnersUpZh.join('和')}（各 ${runnerUpCount} 款）多 ${lead} 款`
  : `与${runnersUpZh.join('和')}同为 ${leader.count} 款`;

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: isZh ? article.titleZh : article.titleEn,
    description, image: `${SITE.origin}${article.coverUrl}`, datePublished: article.publishedAt,
    dateModified: maintenance.updatedAt, mainEntityOfPage: canonical,
    inLanguage: isZh ? 'zh-CN' : 'en', articleSection: isZh ? '英雄联盟臻彩' : 'League of Legends Prestige Chroma',
    author: { '@type': 'Organization', name: SITE.name, url: homeUrl },
    publisher: { '@type': 'Organization', name: SITE.name, url: homeUrl },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isZh ? '首页' : 'Home', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: isZh ? '博客' : 'Blog', item: blogUrl },
      { '@type': 'ListItem', position: 3, name: isZh ? article.titleZh : article.titleEn, item: canonical },
    ],
  },
];
---
<BaseLayout {title} {description} {canonical} image={article.coverUrl} ogType="article" publishedTime={article.publishedAt} modifiedTime={maintenance.updatedAt} {jsonLd} {locale} adPlacement="editorial-article">
  <nav class="blog-breadcrumbs" aria-label={isZh ? '面包屑' : 'Breadcrumb'}>
    <a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><a href={localizedPath(locale, '/blog/')}>{isZh ? '博客' : 'Blog'}</a><span>/</span><span aria-current="page">{isZh ? '臻彩数量榜' : 'Prestige Chroma Leaderboard'}</span>
  </nav>

  {!isZh && <article class="blog-article">
    <header class="article-header">
      <p class="kicker">LoL PRESTIGE CHROMA LEADERBOARD</p>
      <h1>{article.titleEn}</h1>
      <p class="article-deck">{leaderNameEn} currently leads the catalog with {leader.count} prestige chromas across {leaderSkinGroups.length} skin families.</p>
      <p class="article-meta"><time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'en')}</time><span>·</span><span>{article.readingMinutes} min read</span></p>
    </header>
    <figure class="article-hero">
      <img src={article.coverUrl} alt={article.coverAltEn} data-alt-en={article.coverAltEn} data-alt-zh={article.coverAltZh} data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1788" height="880" loading="eager" decoding="async" />
      <figcaption>{leader.count} of {totalChromas} prestige chromas belong to {leaderNameEn}, the current number one.</figcaption>
    </figure>

    <section>
      <h2>The numbers</h2>
      <p>As of patch {patchVersion}, <a href={localizedPath(locale, '/blog/what-are-prestige-chromas/')}>prestige chromas</a> are spread across {championCount} champions. Most have one or two, while a handful reach double digits. <strong>{leaderNameEn} is first with {leader.count}</strong>, {leadComparisonEn}.</p>
      <div class="leaderboard-table-wrapper">
        <table class="leaderboard-table">
          <thead>
            <tr><th>#</th><th>Champion</th><th>Prestige Chromas</th></tr>
          </thead>
          <tbody>
            {leaderboard.map((entry, index) => (
              <tr class:list={{ ['leaderboard-highlight']: entry.heroId === leader.heroId }}>
                <td class="rank-cell">{index + 1}</td>
                <td>{entry.nameEn}</td>
                <td class="count-cell">{entry.count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>{leaderNameEn} prestige chroma collection</h2>
      <p>{leaderNameEn} has {leaderChromas.length} prestige chromas across {leaderSkinGroups.length} different skins. The gallery below is grouped by base skin and reads directly from the current catalog.</p>
    </section>

    {leaderSkinGroups.map((group) => (
    <section>
      <h2>{group.skinNameEn}</h2>
      <p>{group.skinNameEn} has {group.chromas.length} prestige chroma{group.chromas.length !== 1 ? 's' : ''}:</p>
      <BlogChromaGrid>
        {group.chromas.map((chroma) => (
          <BlogChromaCard chroma={chroma} {locale} />
        ))}
      </BlogChromaGrid>
    </section>
    ))}

    <section>
      <h2>Why is {leaderNameEn} first?</h2>
      <p>The current catalog records {leaderChromas.length} chromas across {leaderSkinGroups.length} skin families for {leaderNameEn}. {largestSkinGroup && <>{largestSkinGroup.skinNameEn} is the largest group with {largestSkinGroup.chromas.length}. </>}That breadth is what creates the lead over champions represented by fewer skins or variants.</p>
    </section>

    <section class="faq">
      <h2>FAQ</h2>
      <details>
        <summary>Does the leaderboard change often?</summary>
        <p>It moves when new prestige chromas drop, which tends to happen every couple of patches. Whenever our catalogue updates, these numbers refresh. We also <a href={localizedPath(locale, '/blog/top-2-prestige-chroma-champions/')}>break down the top two champions</a> in a separate gallery.</p>
      </details>
      <details>
        <summary>Who has the fewest?</summary>
        <p>Plenty of champions have just one, and <a href={localizedPath(locale, '/blog/champions-without-prestige-chroma/')}>quite a few still have zero</a>. Check the live tracker for the current count.</p>
      </details>
      <details>
        <summary>Are chromas without prestige splash art counted here?</summary>
        <p>No. Only chromas with their own prestige splash art. Standard recolour variants aren't included.</p>
      </details>
      <details>
        <summary>Can I still get all {leaderChromas.length} {leaderNameEn} chromas?</summary>
        <p>Some were event-limited, some rotate through the Mythic Shop. The older ones aren't always available. More detail in the <a href={localizedPath(locale, '/blog/what-are-prestige-chromas/')}>prestige chroma guide</a>.</p>
      </details>
    </section>
    <ArticleMaintenance {locale} updatedAt={maintenance.updatedAt} sources={maintenance.sources} related={maintenance.related} />
  </article>}

  {isZh && <article class="blog-article">
    <header class="article-header">
      <p class="kicker">LoL 臻彩数量排行榜</p>
      <h1>{article.titleZh}</h1>
      <p class="article-deck">{leaderNameZh}目前以 {leader.count} 款臻彩位居目录第一，横跨 {leaderSkinGroups.length} 个皮肤系列。</p>
      <p class="article-meta"><time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'zh')}</time><span>·</span><span>阅读约 {article.readingMinutes} 分钟</span></p>
    </header>
    <figure class="article-hero">
      <img src={article.coverUrl} alt={article.coverAltZh} data-alt-en={article.coverAltEn} data-alt-zh={article.coverAltZh} data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1788" height="880" loading="eager" decoding="async" />
      <figcaption>{totalChromas} 款臻彩中，{leaderNameZh}拥有 {leader.count} 款，当前排名第一。</figcaption>
    </figure>

    <section>
      <h2>数据</h2>
      <p>截至 {patchVersion} 版本，{totalChromas} 款<a href={localizedPath(locale, '/blog/what-are-prestige-chromas/')}>臻彩</a>分布在 {championCount} 位英雄头上。大多数只有一两款，少数上了两位数。<strong>{leaderNameZh}以 {leader.count} 款排名第一</strong>，{leadComparisonZh}。</p>
      <div class="leaderboard-table-wrapper">
        <table class="leaderboard-table">
          <thead>
            <tr><th>#</th><th>英雄</th><th>臻彩数量</th></tr>
          </thead>
          <tbody>
            {leaderboard.map((entry, index) => (
              <tr class:list={{ ['leaderboard-highlight']: entry.heroId === leader.heroId }}>
                <td class="rank-cell">{index + 1}</td>
                <td>{entry.nameZh}</td>
                <td class="count-cell">{entry.count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>{leaderNameZh}的臻彩收藏</h2>
      <p>{leaderNameZh}目前拥有 {leaderChromas.length} 款臻彩，涵盖 {leaderSkinGroups.length} 款不同皮肤。下方原画按原皮肤分组，并直接读取当前目录。</p>
    </section>

    {leaderSkinGroups.map((group) => (
    <section>
      <h2>{group.skinNameZh}</h2>
      <p>{group.skinNameZh}拥有 {group.chromas.length} 款臻彩：</p>
      <BlogChromaGrid>
        {group.chromas.map((chroma) => (
          <BlogChromaCard chroma={chroma} {locale} />
        ))}
      </BlogChromaGrid>
    </section>
    ))}

    <section>
      <h2>为什么{leaderNameZh}排在第一？</h2>
      <p>当前目录为{leaderNameZh}记录了 {leaderChromas.length} 款臻彩，分布在 {leaderSkinGroups.length} 个皮肤系列中。{largestSkinGroup && <>{largestSkinGroup.skinNameZh}以 {largestSkinGroup.chromas.length} 款成为数量最多的一组。</>}相比只覆盖一两个皮肤系列的英雄，这种跨度更容易积累出数量优势。</p>
    </section>

    <section class="faq">
      <h2>常见问题</h2>
      <details>
        <summary>排行榜会经常变吗？</summary>
        <p>有新臻彩上线就会变，一般每隔几个版本会有变动。目录数据更新后这边也会同步刷新。另外也单独整理了一篇<a href={localizedPath(locale, '/blog/top-2-prestige-chroma-champions/')}>臻彩数量前二的英雄图鉴</a>。</p>
      </details>
      <details>
        <summary>谁最少？</summary>
        <p>只有一款的英雄很多，<a href={localizedPath(locale, '/blog/champions-without-prestige-chroma/')}>连一款都没有的也不少</a>。</p>
      </details>
      <details>
        <summary>这个统计包括没有专属臻彩原画的炫彩吗？</summary>
        <p>不包括。这里只统计拥有专属臻彩原画的条目。</p>
      </details>
      <details>
        <summary>{leaderChromas.length} 款{leaderNameZh}臻彩现在还能获取吗？</summary>
        <p>部分是限时活动的，部分在神话商店轮换。老款不一定随时能拿到。详情看<a href={localizedPath(locale, '/blog/what-are-prestige-chromas/')}>臻彩专题</a>。</p>
      </details>
    </section>
    <ArticleMaintenance {locale} updatedAt={maintenance.updatedAt} sources={maintenance.sources} related={maintenance.related} />
  </article>}

  <BlogAdjacentNavigation currentSlug={article.slug} {locale} />

  <style is:global>
    .blog-breadcrumbs,.blog-article{width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2)));margin-inline:auto}.blog-breadcrumbs{display:flex;gap:9px;padding:28px 0 0;color:var(--muted);font-size:.84rem;white-space:nowrap;overflow-x:auto}.blog-article{padding:clamp(52px,8vw,90px) 0 110px}.article-header,.blog-article>section,.blog-article>figure{width:100%;margin-inline:auto}.article-header{margin-bottom:42px}.article-header h1{font-family:Georgia,"Noto Serif SC",serif;font-size:clamp(2.7rem,6vw,5rem);line-height:1.05;font-weight:500;margin:.34em 0 .35em;overflow-wrap:anywhere}.article-deck{color:#c7cad4;font-size:clamp(1.05rem,2vw,1.25rem);line-height:1.7}.article-meta{display:flex;flex-wrap:wrap;gap:9px;color:var(--muted);font-size:.8rem}.blog-article section{margin-top:48px}.blog-article h2{font-family:Georgia,"Noto Serif SC",serif;color:var(--gold);font-size:clamp(1.65rem,3.3vw,2.25rem);line-height:1.2;margin:0 0 18px}.blog-article h3{color:#e4c880;font-size:1.12rem;margin:30px 0 8px}.blog-article section p{color:#c7cad4;font-size:1.06rem;line-height:1.9;margin:0 0 1.2em}.blog-article a{color:var(--gold);text-decoration:underline;text-underline-offset:3px}.blog-article figure{margin-top:42px}.article-hero{overflow:hidden;border:1px solid var(--line);background:#10121d}.article-hero img{display:block;width:100%;height:auto;background:#15182a}.blog-article .article-hero figcaption{margin:0;padding:10px 13px;border-top:1px solid var(--line)}.blog-article figcaption{color:var(--muted);font-size:.78rem;line-height:1.6;overflow-wrap:anywhere}.faq details{border-top:1px solid var(--line);padding:16px 0}.faq details:last-child{border-bottom:1px solid var(--line)}.faq summary{color:#e6e8ee;font-weight:700;line-height:1.5;cursor:pointer}.faq details p{margin:12px 0 0}

    .leaderboard-table-wrapper{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:24px}.leaderboard-table{width:100%;border-collapse:collapse;font-size:.96rem}.leaderboard-table th{text-align:left;color:var(--muted);font-weight:600;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;padding:0 16px 12px}.leaderboard-table td{padding:12px 16px;color:#c7cad4;border-bottom:1px solid var(--line)}.leaderboard-table tbody tr:hover{background:#15182a}.leaderboard-highlight td{color:var(--gold);font-weight:700;background:#15182a}.rank-cell{width:48px;color:var(--muted);font-variant-numeric:tabular-nums}.count-cell{text-align:right;font-variant-numeric:tabular-nums;font-weight:700}
    @media(max-width:767px){.blog-breadcrumbs{padding-top:18px}.blog-article{padding:42px 0 76px}.article-header{margin-bottom:28px}.article-header h1{font-size:clamp(2.35rem,12vw,3.4rem)}.blog-article section{margin-top:36px}.blog-article section p{font-size:1rem;line-height:1.78}}
  </style>
</BaseLayout>
