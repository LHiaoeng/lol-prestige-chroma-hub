---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogArticles, formatBlogDate } from '../../blog/articles';
import { SITE } from '../../seo/site';

const article = blogArticles.find((entry) => entry.slug === 'champions-without-prestige-chroma');
if (!article) throw new Error('Champions-without-prestige-chroma article metadata is missing');
const title = `${article.titleEn} | ${SITE.name}`;
const description = article.summaryEn;
const canonical = `${SITE.origin}${article.href}`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: article.titleEn,
    description, image: `${SITE.origin}${article.coverUrl}`, datePublished: article.publishedAt,
    dateModified: article.publishedAt, mainEntityOfPage: canonical,
    inLanguage: ['en', 'zh'], articleSection: 'League of Legends Prestige Chroma',
    author: { '@type': 'Organization', name: SITE.name, url: `${SITE.origin}/` },
    publisher: { '@type': 'Organization', name: SITE.name, url: `${SITE.origin}/` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.origin}/blog/` },
      { '@type': 'ListItem', position: 3, name: article.titleEn, item: canonical },
    ],
  },
];

// Ordered by release date (ascending), source: lolnow.gg/lol-champions-by-release-date
