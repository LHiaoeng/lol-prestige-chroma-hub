---
import BlogIndexView from '../../components/BlogIndexView.astro';
import { BLOG_PAGE_SIZE } from '../../blog/articles';
import { resolveLocale, type Locale } from '../../i18n/config';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
---
<BlogIndexView page={1} pageSize={BLOG_PAGE_SIZE} {locale} adPlacement="editorial-article" />
