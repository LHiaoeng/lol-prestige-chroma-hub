---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogArticles } from '../../blog/articles';
import { catalog } from '../../data/catalog';
import { imageUrl, sourceImageUrl } from '../../domain/chroma';
import { SITE } from '../../seo/site';

const article = blogArticles[0];
const backgroundChroma = catalog.find((item) => item.rank === 1);
if (!backgroundChroma) throw new Error('The blog background requires a rank-one chroma');
const title = `League of Legends Blog | ${SITE.name}`;
const description = 'Explore League of Legends guides and stories about champions, Summoner’s Rift, gameplay, art, and the world of Runeterra.';
const canonical = `${SITE.origin}/blog/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: `${SITE.origin}/` },
};
---
<BaseLayout {title} {description} {canonical} image={article.coverUrl} {jsonLd}>
  <div class="blog-page">
    <div class="blog-backdrop" aria-hidden="true">
      <picture>
        <source media="(max-width: 767px)" srcset={imageUrl(backgroundChroma.images.medium)} data-fallback={sourceImageUrl('medium', backgroundChroma.instanceId)} />
        <img src={imageUrl(backgroundChroma.images.large)} data-fallback={sourceImageUrl('large', backgroundChroma.instanceId)} data-placeholder="/placeholder.svg" alt="" width="1920" height="1080" loading="eager" decoding="async" />
      </picture>
    </div>
    <section class="blog-index">
    <header class="blog-heading">
      <div data-language-content="en">
        <p class="kicker">CHROMA ART JOURNAL</p>
        <h1>Stories from the Rift</h1>
        <p>Guides and stories about the game, champions, and visual world behind League of Legends.</p>
      </div>
      <div data-language-content="zh">
        <p class="kicker">CHROMA ART 博客</p>
        <h1>峡谷内外的故事</h1>
        <p>探索《英雄联盟》的游戏玩法、英雄角色与视觉世界。</p>
      </div>
    </header>

    <article class="featured-post">
      <a class="featured-post-link" href={article.href}>
        <div class="featured-post-art">
          <img src={article.coverUrl} alt={article.coverAltEn} data-alt-en={article.coverAltEn} data-alt-zh={article.coverAltZh} data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="3288" height="2100" loading="eager" decoding="async" />
        </div>
        <div class="featured-post-copy">
          <p class="eyebrow" data-en="FEATURED GUIDE" data-zh="精选指南">FEATURED GUIDE</p>
          <h2 data-en={article.titleEn} data-zh={article.titleZh}>{article.titleEn}</h2>
          <p class="post-summary" data-en={article.summaryEn} data-zh={article.summaryZh}>{article.summaryEn}</p>
          <p class="post-meta">
            <time datetime={article.publishedAt}>July 19, 2026</time>
            <span aria-hidden="true">·</span>
            <span data-en={`${article.readingMinutes} min read`} data-zh={`阅读约 ${article.readingMinutes} 分钟`}>{article.readingMinutes} min read</span>
          </p>
          <span class="read-more" data-en="Read the story →" data-zh="阅读全文 →">Read the story →</span>
        </div>
      </a>
    </article>
    </section>
  </div>

  <style>
    .blog-page { position:relative; isolation:isolate; overflow:hidden; }
    .blog-page::after { content:""; position:absolute; z-index:-1; inset:0; background:linear-gradient(180deg,#090b1538 0%,#090b158f 62%,#090b15db 100%),linear-gradient(90deg,#090b157a 0%,transparent 58%,#090b154d 100%); }
    .blog-backdrop { position:absolute; z-index:-2; inset:0; overflow:hidden; background:#090b15; }
    .blog-backdrop picture { display:block; width:100%; height:100%; }
    .blog-backdrop img { display:block; width:100%; height:100%; object-fit:cover; object-position:center top; opacity:.7; filter:saturate(.95) contrast(1.05); transform:scale(1.02); }
    .blog-index { position:relative; width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2))); margin-inline:auto; padding:clamp(72px,9vw,120px) 0 110px; }
    .blog-heading { max-width:780px; margin-bottom:clamp(38px,6vw,64px); }
    .blog-heading h1 { font-family:Georgia,"Noto Serif SC",serif; font-size:clamp(2.8rem,6vw,5.2rem); line-height:1.04; margin:.28em 0 .32em; font-weight:500; overflow-wrap:anywhere; }
    .blog-heading>div>p:last-child { color:var(--muted); font-size:1.08rem; line-height:1.7; margin:0; }
    .featured-post { overflow:hidden; border:1px solid var(--line); border-radius:14px; background:var(--panel); box-shadow:0 28px 80px #0007; }
    .featured-post-link { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(300px,.85fr); min-height:430px; }
    .featured-post-art { min-width:0; overflow:hidden; background:#15182a; }
    .featured-post-art img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .45s ease; }
    .featured-post-copy { display:flex; flex-direction:column; justify-content:center; padding:clamp(30px,4vw,58px); }
    .featured-post-copy h2 { font-family:Georgia,"Noto Serif SC",serif; font-size:clamp(1.8rem,3.1vw,3rem); line-height:1.12; margin:.5em 0 .4em; overflow-wrap:anywhere; }
    .post-summary { color:#c7cad4; line-height:1.75; margin:0; }
    .post-meta { display:flex; flex-wrap:wrap; gap:9px; color:var(--muted); font-size:.78rem; margin:22px 0; }
    .read-more { color:var(--gold); font-weight:700; }
    .featured-post-link:focus-visible { outline:2px solid var(--gold); outline-offset:-4px; }
    @media (hover:hover) and (pointer:fine) { .featured-post-link:hover .featured-post-art img { transform:scale(1.025); } }
    @media (max-width: 1023px) { .featured-post-link { grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr); min-height:380px; } }
    @media (max-width: 767px) {
      .blog-page::after { background:linear-gradient(180deg,#090b1545 0%,#090b159e 60%,#090b15e0 100%); }
      .blog-backdrop img { object-position:center top; opacity:.62; filter:saturate(.9) contrast(1.04); transform:scale(1.01); }
      .blog-index { padding:54px 0 76px; }
      .blog-heading { margin-bottom:32px; }
      .blog-heading h1 { font-size:clamp(2.35rem,12vw,3.5rem); }
      .blog-heading>div>p:last-child { font-size:1rem; }
      .featured-post-link { grid-template-columns:1fr; min-height:0; }
      .featured-post-art { aspect-ratio:16/10; }
      .featured-post-copy { padding:24px 20px 28px; }
    }
    @media (prefers-reduced-motion:reduce) { .featured-post-art img { transition:none; } }
  </style>
</BaseLayout>
