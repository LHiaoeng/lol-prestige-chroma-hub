---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveHeroBackdrop from '../../components/ResponsiveHeroBackdrop.astro';
import { articleHref, blogArticles, formatBlogDate } from '../../blog/articles';
import { catalog } from '../../data/catalog';
import { imageUrl, sourceImageUrl } from '../../domain/chroma';
import { SITE } from '../../seo/site';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';

const article = blogArticles[0];
const backgroundChroma = catalog.find((item) => item.rank === 1);
if (!backgroundChroma) throw new Error('The blog background requires a rank-one chroma');
const title = isZh ? `英雄联盟博客 | ${SITE.name}` : `League of Legends Blog | ${SITE.name}`;
const description = isZh ? '阅读关于《英雄联盟》玩法、英雄、符文之地与炫彩原画的指南和故事。' : 'Explore League of Legends guides and stories about champions, Summoner’s Rift, gameplay, art, and the world of Runeterra.';
const canonical = new URL(localizedPath(locale, '/blog/'), SITE.origin).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonical,
  inLanguage: isZh ? 'zh-CN' : 'en',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: new URL(localizedPath(locale, '/'), SITE.origin).toString() },
};
---
<BaseLayout {title} {description} {canonical} image={article.coverUrl} {jsonLd} {locale}>
  <div class="blog-page">
    <section class="blog-hero" data-backdrop-scope>
      <div class="blog-backdrop">
        <ResponsiveHeroBackdrop
          largeSrc={imageUrl(backgroundChroma.images.large)}
          mediumSrc={imageUrl(backgroundChroma.images.medium)}
          largeFallback={sourceImageUrl('large', backgroundChroma.instanceId)}
          mediumFallback={sourceImageUrl('medium', backgroundChroma.instanceId)}
          opacity={.7}
          mobileOpacity={.85}
        />
      </div>
      <header class="blog-heading">
        {isZh ? <div>
          <p class="kicker">LoL CHROMA ART 博客</p>
          <h1>峡谷内外的故事</h1>
          <p>探索《英雄联盟》的游戏玩法、英雄角色与视觉世界。</p>
        </div> : <div>
          <p class="kicker">LoL CHROMA ART JOURNAL</p>
          <h1>Stories from the Rift</h1>
          <p>Guides and stories about the game, champions, and visual world behind League of Legends.</p>
        </div>}
      </header>
      <section class="blog-index">
        <div class="post-list">
        {blogArticles.map((entry, index) => (
        <article class="featured-post">
          <a class="featured-post-link" href={articleHref(entry, locale)}>
            <div class="featured-post-art">
              <img src={entry.coverUrl} alt={isZh ? entry.coverAltZh : entry.coverAltEn} data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width={index === 0 ? 1920 : 3288} height={index === 0 ? 944 : 2100} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            <div class="featured-post-copy">
              <p class="eyebrow">{isZh ? (index === 0 ? '精选文章' : '指南') : (index === 0 ? 'FEATURED STORY' : 'GUIDE')}</p>
              <h2>{isZh ? entry.titleZh : entry.titleEn}</h2>
              <p class="post-summary">{isZh ? entry.summaryZh : entry.summaryEn}</p>
              <p class="post-meta">
                <time datetime={entry.publishedAt}>{formatBlogDate(entry.publishedAt, isZh ? 'zh' : 'en')}</time>
                <span aria-hidden="true">·</span>
                <span>{isZh ? `阅读约 ${entry.readingMinutes} 分钟` : `${entry.readingMinutes} min read`}</span>
              </p>
              <span class="read-more">{isZh ? '阅读全文 →' : 'Read the story →'}</span>
            </div>
          </a>
        </article>
        ))}
        </div>
      </section>
    </section>
  </div>

  <style>
    .blog-page { background:#090b15; }
    .blog-hero { position:relative; isolation:isolate; min-height:calc(100svh - var(--site-header-height)); padding:clamp(58px,7vw,88px) 0 110px; overflow:hidden; }
    .blog-backdrop { position:absolute; z-index:-1; inset:0 0 auto; height:calc(100svh - var(--site-header-height)); min-height:480px; }
    .blog-heading { position:relative; z-index:1; width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2))); max-width:1240px; margin-inline:auto; }
    .blog-heading>div { max-width:780px; }
    .blog-index { position:relative; z-index:1; width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2))); margin-inline:auto; padding-top:clamp(32px,4vw,48px); }
    .blog-heading h1 { font-family:Georgia,"Noto Serif SC",serif; font-size:clamp(2.8rem,6vw,5.2rem); line-height:1.04; margin:.28em 0 .32em; font-weight:500; overflow-wrap:anywhere; text-shadow:0 5px 30px #000b; }
    .blog-heading>div>p:last-child { color:var(--muted); font-size:1.08rem; line-height:1.7; margin:0; text-shadow:0 2px 18px #000; }
    .post-list { display:grid; gap:32px; }
    .featured-post { overflow:hidden; border:1px solid var(--line); border-radius:14px; background:var(--panel); box-shadow:0 28px 80px #0007; }
    .featured-post-link { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(300px,.85fr); min-height:430px; }
    .featured-post-art { min-width:0; overflow:hidden; background:#15182a; }
    .featured-post-art img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .45s ease; }
    .featured-post-copy { display:flex; flex-direction:column; justify-content:center; padding:clamp(30px,4vw,58px); }
    .featured-post-copy h2 { font-family:Georgia,"Noto Serif SC",serif; font-size:clamp(1.8rem,3.1vw,3rem); line-height:1.12; margin:.5em 0 .4em; overflow-wrap:anywhere; }
    .post-summary { color:#c7cad4; line-height:1.75; margin:0; }
    .post-meta { display:flex; flex-wrap:wrap; gap:9px; color:var(--muted); font-size:.78rem; margin:22px 0; }
    .read-more { color:var(--gold); font-weight:700; }
    .featured-post-link:focus-visible { outline:2px solid var(--gold); outline-offset:-4px; }
    @media (hover:hover) and (pointer:fine) { .featured-post-link:hover .featured-post-art img { transform:scale(1.025); } }
    @media (max-width: 1023px) { .featured-post-link { grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr); min-height:380px; } }
    @media (max-width: 767px) {
      .blog-hero { padding:44px 0 76px; }
      .blog-index { padding-top:32px; }
      .blog-heading h1 { font-size:clamp(2.35rem,12vw,3.5rem); }
      .blog-heading>div>p:last-child { font-size:1rem; }
      .featured-post-link { grid-template-columns:1fr; min-height:0; }
      .featured-post-art { aspect-ratio:16/10; }
      .featured-post-copy { padding:24px 20px 28px; }
    }
    @media (prefers-reduced-motion:reduce) { .featured-post-art img { transition:none; } }
  </style>
</BaseLayout>
