---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BlogAdjacentNavigation from '../../components/BlogAdjacentNavigation.astro';
import BlogPrestigeChromaCard from '../../components/BlogPrestigeChromaCard.astro';
import BlogChromaGrid from '../../components/BlogChromaGrid.astro';
import { blogArticles, formatBlogDate } from '../../blog/articles';
import { catalog } from '../../data/catalog';
import type { Chroma } from '../../domain/chroma';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { SITE } from '../../seo/site';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const article = blogArticles.find((entry) => entry.slug === 'lucky-gate-summon-202620');
if (!article) throw new Error('Lucky Gate Session 202620 article metadata is missing');
const title = `${isZh ? article.titleZh : article.titleEn} | ${SITE.name}`;
const description = isZh ? article.summaryZh : article.summaryEn;
const canonical = new URL(localizedPath(locale, article.href), SITE.origin).toString();
const homeUrl = new URL(localizedPath(locale, '/'), SITE.origin).toString();
const blogUrl = new URL(localizedPath(locale, '/blog/'), SITE.origin).toString();

const sourceUrl = 'https://lol.qq.com/news/detail.shtml?docid=10333356014946692462';
const eventUrl = 'https://lol.qq.com/act/a202610094865prizewheel/index.html?e_code=500132';

const ireliaChroma = catalog.find((c) => c.heroId === '39' && c.skinNameEn === 'Breadsticks Irelia');
const luxChroma = catalog.find((c) => c.heroId === '99' && c.skinNameEn === 'Porcelain Lux');
const missFortuneChroma = catalog.find((c) => c.heroId === '21' && c.skinNameEn === 'Ruined Miss Fortune');
const catalogChromas: Chroma[] = [ireliaChroma, luxChroma, missFortuneChroma].filter((c): c is Chroma => c != null);

const faqEntries = isZh ? [
  { question: '幸运之门·召唤活动是第几期？什么时候开始和结束？', answer: '本期是幸运之门系列的第 202620 期，2026 年 10 月 9 日上线，持续至 11 月 5 日 23:59，在国服限时开放。' },
  { question: '奖池里的臻彩和普通<a href="' + localizedPath(locale, '/blog/what-are-chroma-skins/') + '">炫彩</a>有什么区别？', answer: '臻彩是炫彩升级后的珍稀限时类型，拥有专属臻彩原画，但仍然依附于基础皮肤，不是一款独立皮肤。详见我们的<a href="' + localizedPath(locale, '/blog/what-are-prestige-chromas/') + '">臻彩专题</a>。' },
  { question: '真实伤害 突破界限 艾克是臻彩吗？', answer: '不是。<a href="' + localizedPath(locale, '/skins/detail/') + '?id=245056&champion=245">真实伤害 突破界限 艾克</a>是一款神话品质的完整皮肤，玩家不需要先拥有另一款皮肤就能使用，和依附于基础皮肤的炫彩不是同一个层级。' },
  { question: '利刃充饥面包师傅 艾瑞莉娅 飞舞吧，香橙面包收录进图鉴了吗？', answer: '已经收录。这款随利刃充饥面包师傅 艾瑞莉娅新皮肤登场的钻石臻彩属于 26.20 版本批次，上方卡片可直接进入它的详情页；青花瓷 拉克丝 含苞与破败军团 厄运小姐 帝国征伐使也均已在目录中。' },
] : [
  { question: 'Which Lucky Gate session is this, and when does it start and end?', answer: 'This is Session 202620 of the Lucky Gate series; it opened on October 9, 2026 and runs through November 5, 2026 (23:59) on the Chinese server.' },
  { question: 'How are the prestige chromas in this wheel different from regular <a href="' + localizedPath(locale, '/blog/what-are-chroma-skins/') + '">chroma skins</a>?', answer: 'Prestige chromas are upgraded, limited-time chromas with dedicated splash art, but they still attach to a base skin and are not standalone skins. See our <a href="' + localizedPath(locale, '/blog/what-are-prestige-chromas/') + '">prestige chroma guide</a> for the full breakdown.' },
  { question: 'Is Breakout True Damage Ekko a prestige chroma?', answer: 'No. <a href="' + localizedPath(locale, '/skins/detail/') + '?id=245056&champion=245">Breakout True Damage Ekko</a> is a mythic-tier complete skin, not a chroma. It does not require a base skin the way a chroma does.' },
  { question: 'Is Breadsticks Irelia (Emerald) in the archive?', answer: 'Yes. This Diamond prestige chroma, released alongside the brand-new Breadsticks Irelia skin in the Patch 26.20 batch, is now catalogued &mdash; the card above links straight to its detail page. Porcelain Lux (Rose Quartz) and Ruined Miss Fortune (Ruby) are also in the archive.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: isZh ? article.titleZh : article.titleEn,
    description, image: `${SITE.origin}${article.coverUrl}`, datePublished: article.publishedAt,
    dateModified: article.publishedAt, mainEntityOfPage: canonical,
    inLanguage: isZh ? 'zh-CN' : 'en', articleSection: isZh ? '英雄联盟臻彩' : 'League of Legends Prestige Chroma',
    author: { '@type': 'Organization', name: 'LoL Chroma Art Editorial Team', url: homeUrl },
    publisher: { '@type': 'Organization', name: SITE.name, url: homeUrl },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isZh ? '首页' : 'Home', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: isZh ? '博客' : 'Blog', item: blogUrl },
      { '@type': 'ListItem', position: 3, name: isZh ? article.titleZh : article.titleEn, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqEntries.map((entry) => ({
      '@type': 'Question', name: entry.question,
      acceptedAnswer: { '@type': 'Answer', text: entry.answer },
    })),
  },
];
---
<BaseLayout {title} {description} {canonical} image={article.coverUrl} ogType="article" publishedTime={article.publishedAt} modifiedTime={article.publishedAt} {jsonLd} {locale} adPlacement="editorial-article">
  <Breadcrumb article {locale} items={[
    { label: isZh ? '首页' : 'Home', href: localizedPath(locale, '/') },
    { label: isZh ? '博客' : 'Blog', href: localizedPath(locale, '/blog/') },
    { label: isZh ? '幸运之门·召唤' : 'Lucky Gate Summoning' },
  ]} />

  {!isZh && <article class="blog-article">
    <header class="article-header">
      <p class="kicker">LOL PRESTIGE CHROMA SUMMON EVENT</p>
      <h1>{article.titleEn}</h1>
      <p class="article-deck">The Lucky Gate summoning event (Session 202620) opened October 9 and runs through November 5, 2026 on the Chinese server, with a 3 RMB first summon. The brand-new Breadsticks Irelia (Emerald) prestige chroma debuts in the wheel alongside Porcelain Lux (Rose Quartz) and Ruined Miss Fortune (Ruby), plus the mythic <a href={`${localizedPath(locale, '/skins/detail/')}?id=245056&champion=245`}>Breakout True Damage Ekko</a> skin.</p>
      <p class="article-meta">
        <span>By LoL Chroma Art Editorial Team</span><span>·</span>
        <time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'en')}</time>
        <span>·</span>
        <span>{article.readingMinutes} min read</span>
      </p>
    </header>

    <figure>
      <img src={article.coverUrl} data-alt-en={article.coverAltEn} data-alt-zh={article.coverAltZh} data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" alt={article.coverAltEn} width="1920" height="1080" loading="eager" decoding="async" />
      <figcaption>Porcelain Lux (Rose Quartz), one of three prestige chromas in the Lucky Gate Session 202620 wheel.</figcaption>
    </figure>

    <section>
      <h2>Three prestige chromas and one mythic skin</h2>
      <p>The official announcement names four headline rewards. Three are <a href={localizedPath(locale, '/blog/what-are-prestige-chromas/')}>prestige chromas</a> &mdash; one brand-new release and two returning favourites, all three now in our archive; the fourth is a complete skin rather than a <a href={localizedPath(locale, '/blog/what-are-chroma-skins/')}>chroma</a>. This is Session 202620 of the Lucky Gate series; the previous <a href={localizedPath(locale, '/blog/lucky-gate-summon-october-2026/')}>Session 202619 wheel</a> runs its own separate prize pool.</p>
      <BlogChromaGrid columns={3}>
        {catalogChromas.map((chroma) => <BlogPrestigeChromaCard chroma={chroma} {locale} />)}
      </BlogChromaGrid>
      <p><strong>Breadsticks Irelia (Emerald)</strong> is the debut prestige chroma for the newly released Breadsticks Irelia epic skin &mdash; a Diamond entry from the Patch 26.20 batch, now catalogued with its own detail page. <strong>Porcelain Lux (Rose Quartz)</strong> arrived in the <a href={localizedPath(locale, '/blog/patch-26-15-prestige-chromas/')}>Patch 26.15 batch</a> &mdash; a rose-quartz pink colourway from the Porcelain skinline under the Lunar New Year universe. <strong>Ruined Miss Fortune (Ruby)</strong> is a <a href={localizedPath(locale, '/blog/patch-26-18-prestige-chromas/')}>Patch 26.18 entry</a> from the Ruined skinline under The Ruined King Saga; the original chroma was first released as a bundle exclusive in 2021.</p>
      <p>The remaining headline reward is not a chroma:</p>
      <ul>
        <li><a href={`${localizedPath(locale, '/skins/detail/')}?id=245056&champion=245`}><strong>Breakout True Damage Ekko</strong></a> &mdash; a mythic-tier skin for Ekko from the True Damage line. It is a complete skin, so it does not require a base skin the way a chroma does.</li>
      </ul>
    </section>

    <section>
      <h2>How the Lucky Gate wheel works</h2>
      <p>Lucky Gate sessions use a self-select prize pool and a ticket-round structure: before summoning, players pick which rewards go into the pool, and drawing a round ticket advances the wheel while granting a random super reward. Sessions traditionally open with a discounted first summon &mdash; this session sets that to 3 RMB. Each session has its own pool, draw price, and drop rates &mdash; the official announcement and event page for this session are the source for the exact costs and probabilities, so plan around those rather than the numbers from earlier sessions.</p>
    </section>

    <section>
      <h2>Open October 9 through November 5, alongside two other summon events</h2>
      <p>This Lucky Gate wheel closes on November 5, 2026. Its run overlaps with two other concurrent summon events: the <a href={localizedPath(locale, '/blog/splendid-treasure-september-2026/')}>Splendid Treasure Summoning — September 2026</a> (through October 25) and the <a href={localizedPath(locale, '/blog/prestige-chroma-summon-2026-21/')}>Brilliant Prestige Chroma Summoning — Session 202621</a> (through October 18). All three are separate event series with separate currencies and pools &mdash; Lucky Gate draws from a rotating wheel, the Splendid Treasure session is built around a fragment exchange shop, and the Brilliant session centres on self-select grand- and first-prize chroma pools. If you want rewards from more than one, treat the budgets as independent.</p>
    </section>

    <section>
      <h2>Previous Lucky Gate sessions still open</h2>
      <p>Two earlier Lucky Gate sessions are still running alongside this one:</p>
      <table class="event-table">
        <thead><tr><th>Session</th><th class="num">Closes</th><th>Headline reward</th></tr></thead>
        <tbody>
          <tr><td><a href={localizedPath(locale, '/blog/lucky-gate-summon-october-2026/')}>Lucky Gate Summoning — Session 202619</a></td><td class="num">Nov 1</td><td>Demoncursed Vayne (Sapphire), Heavenscale Kai&rsquo;Sa (Lustrous), Heavenscale Master Yi (Lustrous) + mythic Dark Cosmic Erasure Jhin</td></tr>
          <tr><td><a href={localizedPath(locale, '/blog/lucky-gate-ocean-song-202609/')}>Lucky Gate: Ocean Song — Session 202618</a></td><td class="num">Oct 11</td><td>Three Ocean Song prestige chromas (Soraka Pearl, Jinx Pearl, Yone Tanzanite) + mythic Admiral Battle Bunny Miss Fortune</td></tr>
        </tbody>
      </table>
    </section>

    <section>
      <h2>Other active prestige chroma events</h2>
      <p>Beyond the Lucky Gate series, three other prestige chroma acquisition events are currently live on the Chinese server:</p>
      <table class="event-table">
        <thead><tr><th>Event</th><th class="num">Closes</th><th>Headline reward</th></tr></thead>
        <tbody>
          <tr><td><a href={localizedPath(locale, '/blog/splendid-treasure-september-2026/')}>Splendid Treasure Summoning — September 2026</a></td><td class="num">Oct 25</td><td>Lunar Goddess Diana (Obsidian) &mdash; 1,200 fragments</td></tr>
          <tr><td><a href={localizedPath(locale, '/blog/prestige-chroma-summon-2026-21/')}>Brilliant Prestige Chroma Summoning — Session 202621</a></td><td class="num">Oct 18</td><td>Dumpling Darlings Syndra (Pearl), Faerie Court Ezreal (Rose Quartz)</td></tr>
          <tr><td><a href={localizedPath(locale, '/blog/full-gift-reward-prestige-chroma-202608/')}>Full Gift Reward Event</a></td><td class="num">Oct 11</td><td>Battle Queen Fiora prestige chroma (1000-point tier; claim by Oct 18)</td></tr>
        </tbody>
      </table>
    </section>

    <section class="faq">
      <h2>FAQ</h2>
      {faqEntries.map((entry) => <details><summary set:html={entry.question}></summary><p set:html={entry.answer}></p></details>)}
    </section>

    <aside class="official-sources" aria-label="Official sources">
      <strong>Official sources</strong>
      <ul>
        <li><a class="official-source-link" href={sourceUrl} target="_blank" rel="noreferrer">Lucky Gate Summoning announcement &mdash; LoL Official Site</a></li>
        <li><a class="official-source-link" href={eventUrl} target="_blank" rel="noreferrer">Lucky Gate Summoning event page &mdash; LoL Official Site</a></li>
      </ul>
    </aside>
  </article>}

  {isZh && <article class="blog-article">
    <header class="article-header">
      <p class="kicker">LOL 臻彩召唤活动</p>
      <h1>{article.titleZh}</h1>
      <p class="article-deck">2026 年 10 月 9 日至 11 月 5 日，幸运之门·召唤活动（第 202620 期）限时上线，首次召唤 3 元。全新利刃充饥面包师傅 艾瑞莉娅 飞舞吧，香橙面包臻彩首次登场，青花瓷 拉克丝 含苞与破败军团 厄运小姐 帝国征伐使同步开放，另含神话皮肤<a href={`${localizedPath(locale, '/skins/detail/')}?id=245056&champion=245`}>真实伤害 突破界限 艾克</a>。</p>
      <p class="article-meta">
        <span>LoL Chroma Art 编辑团队</span><span>·</span>
        <time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'zh')}</time>
        <span>·</span>
        <span>阅读约 {article.readingMinutes} 分钟</span>
      </p>
    </header>

    <figure>
      <img src={article.coverUrl} data-alt-en={article.coverAltEn} data-alt-zh={article.coverAltZh} data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" alt={article.coverAltZh} width="1920" height="1080" loading="eager" decoding="async" />
      <figcaption>青花瓷 拉克丝 含苞，本期幸运之门奖池三款臻彩之一。</figcaption>
    </figure>

    <section>
      <h2>三款臻彩，外加一款神话皮肤</h2>
      <p>官方公告列出了四项重点奖励。其中三款是<a href={localizedPath(locale, '/blog/what-are-prestige-chromas/')}>臻彩</a>——一款全新登场、两款往期复刻，三款目前均已收录本站目录；第四项是一款完整皮肤，不是<a href={localizedPath(locale, '/blog/what-are-chroma-skins/')}>炫彩</a>。本期是幸运之门系列的第 202620 期活动，奖池与上一期<a href={localizedPath(locale, '/blog/lucky-gate-summon-october-2026/')}>第 202619 期</a>相互独立。</p>
      <BlogChromaGrid columns={3}>
        {catalogChromas.map((chroma) => <BlogPrestigeChromaCard chroma={chroma} {locale} />)}
      </BlogChromaGrid>
      <p><strong>利刃充饥面包师傅 艾瑞莉娅 飞舞吧，香橙面包</strong>随全新上线的利刃充饥面包师傅 艾瑞莉娅史诗皮肤首次登场，是 26.20 版本批次的钻石臻彩，现已收录图鉴并拥有独立详情页。<strong>青花瓷 拉克丝 含苞</strong>是<a href={localizedPath(locale, '/blog/patch-26-15-prestige-chromas/')}>26.15 版本批次</a>的条目，粉晶配色，属于青花瓷系列，隶属春节宇宙。<strong>破败军团 厄运小姐 帝国征伐使</strong>是<a href={localizedPath(locale, '/blog/patch-26-18-prestige-chromas/')}>26.18 版本新增条目</a>，属于破败军团系列，隶属破败之王传说宇宙，其炫彩最初于 2021 年作为礼包专属发布。</p>
      <p>剩余一项重点奖励不是臻彩：</p>
      <ul>
        <li><a href={`${localizedPath(locale, '/skins/detail/')}?id=245056&champion=245`}><strong>真实伤害 突破界限 艾克</strong></a> — 真实伤害系列的神话品质完整皮肤，不像炫彩那样需要先拥有基础皮肤。</li>
      </ul>
    </section>

    <section>
      <h2>幸运之门玩法：自选奖池与门票轮次</h2>
      <p>幸运之门系列采用自选奖池加门票轮次的结构：召唤前可以自行选择奖池内的奖励，抽中本轮门票后会获得一个幸运之门超级奖励并进入下一轮；系列活动通常以优惠价开启首次召唤，本期首次召唤 3 元。每一期的奖池、召唤价格和概率都独立设置，本期具体费用与掉率以官方公告和活动页面为准，不要直接套用往期数字。</p>
    </section>

    <section>
      <h2>10 月 9 日至 11 月 5 日，与两场并行召唤活动同期</h2>
      <p>本期幸运之门·召唤持续到 2026 年 11 月 5 日。期间与另外两场召唤活动并行：<a href={localizedPath(locale, '/blog/splendid-treasure-september-2026/')}>华彩秘宝·召唤 9 月场</a>（至 10 月 25 日）与<a href={localizedPath(locale, '/blog/prestige-chroma-summon-2026-21/')}>璀璨臻彩召唤第 202621 期</a>（至 10 月 18 日）。三者是不同的活动系列，货币和奖池互不通用：幸运之门走轮转奖池抽奖，华彩秘宝以碎片兑换商店为核心，璀璨臻彩召唤以特等奖、一等奖自选臻彩为核心。如果多场奖励都想要，建议按独立预算规划。</p>
    </section>

    <section>
      <h2>仍在开放中的往期幸运之门活动</h2>
      <p>除本期外，还有两期往期幸运之门·召唤活动仍在开放：</p>
      <table class="event-table">
        <thead><tr><th>期次</th><th class="num">截止</th><th>主要奖励</th></tr></thead>
        <tbody>
          <tr><td><a href={localizedPath(locale, '/blog/lucky-gate-summon-october-2026/')}>幸运之门·召唤 — 第 202619 期</a></td><td class="num">11 月 1 日</td><td>恶魔诅咒 薇恩 诡诈附体、天龙之子 卡莎 赫赫龙威、天龙之子 易 赫赫龙威 + 神话皮肤暗星绝杀 烬</td></tr>
          <tr><td><a href={localizedPath(locale, '/blog/lucky-gate-ocean-song-202609/')}>幸运之门·海之歌召唤 — 第 202618 期</a></td><td class="num">10 月 11 日</td><td>三款海之歌系列臻彩 + 神话皮肤幻灵战斗兔司令 厄运小姐</td></tr>
        </tbody>
      </table>
    </section>

    <section>
      <h2>其他未过期臻彩获取活动</h2>
      <p>除幸运之门系列外，国服当前还有以下臻彩获取活动正在进行：</p>
      <table class="event-table">
        <thead><tr><th>活动</th><th class="num">截止</th><th>主要奖励</th></tr></thead>
        <tbody>
          <tr><td><a href={localizedPath(locale, '/blog/splendid-treasure-september-2026/')}>华彩秘宝·召唤 9 月场</a></td><td class="num">10 月 25 日</td><td>素影霓裳 嫦娥臻彩（1200 碎片）</td></tr>
          <tr><td><a href={localizedPath(locale, '/blog/prestige-chroma-summon-2026-21/')}>璀璨臻彩召唤 — 第 202621 期</a></td><td class="num">10 月 18 日</td><td>点心宝贝 辛德拉 芥菜点心、花仙贵族 伊泽瑞尔 玫瑰水晶眼</td></tr>
          <tr><td><a href={localizedPath(locale, '/blog/full-gift-reward-prestige-chroma-202608/')}>满额礼赠活动</a></td><td class="num">10 月 11 日</td><td>女帝菲奥娜臻彩（满 1000 积分；领取截止 10 月 18 日）</td></tr>
        </tbody>
      </table>
    </section>

    <section class="faq">
      <h2>常见问题解答</h2>
      {faqEntries.map((entry) => <details><summary set:html={entry.question}></summary><p set:html={entry.answer}></p></details>)}
    </section>

    <aside class="official-sources" aria-label="官方来源">
      <strong>官方来源</strong>
      <ul>
        <li><a class="official-source-link" href={sourceUrl} target="_blank" rel="noreferrer">幸运之门·召唤活动公告 — 英雄联盟官网</a></li>
        <li><a class="official-source-link" href={eventUrl} target="_blank" rel="noreferrer">幸运之门·召唤活动页面 — 英雄联盟官网</a></li>
      </ul>
    </aside>
  </article>}

  <BlogAdjacentNavigation currentSlug={article.slug} {locale} />

  <style is:global>
    .blog-article{width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2)));margin-inline:auto}.blog-article{padding:clamp(52px,8vw,90px) 0 110px}.article-header,.blog-article>section,.blog-article>figure,.showcase{width:100%;margin-inline:auto}.article-header{margin-bottom:42px}.article-header h1{font-family:Georgia,"Noto Serif SC",serif;font-size:clamp(2.7rem,6vw,5rem);line-height:1.05;font-weight:500;margin:.34em 0 .35em;overflow-wrap:anywhere}.article-deck{color:#c7cad4;font-size:clamp(1.05rem,2vw,1.25rem);line-height:1.7}.article-meta{display:flex;flex-wrap:wrap;gap:9px;color:var(--muted);font-size:.8rem}.blog-article section{margin-top:48px}.blog-article h2{font-family:Georgia,"Noto Serif SC",serif;color:var(--gold);font-size:clamp(1.65rem,3.3vw,2.25rem);line-height:1.2;margin:0 0 18px}.blog-article section p{color:#c7cad4;font-size:1.06rem;line-height:1.9;margin:0 0 1.2em}.blog-article strong{color:#f1f2f5}.blog-article a{color:var(--gold);text-decoration:none}.blog-article section p a{text-decoration:underline;text-underline-offset:3px}.blog-article ul{color:#c7cad4;font-size:1.06rem;line-height:1.9;margin:0 0 1.2em;padding-left:1.5em}.blog-article li{margin-bottom:.5em}.blog-article figure{margin-top:42px}.blog-article figure img{display:block;width:100%;height:auto;border:1px solid var(--line);background:#15182a;box-shadow:0 22px 64px #0007}.blog-article figcaption{color:var(--muted);font-size:.78rem;line-height:1.6;margin-top:10px;overflow-wrap:anywhere}.faq details{border-top:1px solid var(--line);padding:16px 0}.faq details:last-child{border-bottom:1px solid var(--line)}.faq summary{color:#e6e8ee;font-weight:700;line-height:1.5;cursor:pointer}.faq details p{margin:12px 0 0}.official-sources{margin-top:48px;padding:20px 24px;border:1px solid var(--line);border-radius:8px;background:#11131e}.official-sources strong{display:block;color:#e6e8ee;font-size:.95rem;margin-bottom:10px}.official-sources ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:6px}.official-source-link{color:var(--gold);text-decoration:none;font-size:.9rem}.official-source-link:hover{text-decoration:underline}.event-table{width:100%;border-collapse:collapse;font-size:.96rem;margin:0 0 1.2em}.event-table th{text-align:left;color:var(--muted);font-weight:600;font-size:.78rem;letter-spacing:.06em;padding:0 16px 12px;border-bottom:1px solid var(--line)}.event-table td{padding:12px 16px;color:#c7cad4;border-bottom:1px solid var(--line);vertical-align:top}.event-table tbody tr:last-child td{border-bottom:none}.event-table tbody tr:hover td{background:#15182a}.event-table td.num,.event-table th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.event-table a{text-decoration:none}.event-table a:hover{text-decoration:underline}

    @media(max-width:767px){.blog-article{padding:42px 0 76px}.article-header{margin-bottom:28px}.article-header h1{font-size:clamp(2.35rem,12vw,3.4rem)}.blog-article section{margin-top:36px}.blog-article section p{font-size:1rem;line-height:1.78}.event-table{font-size:.9rem}.event-table th,.event-table td{padding:10px 12px}}
  </style>
</BaseLayout>
