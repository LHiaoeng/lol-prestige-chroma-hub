---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogAdjacentNavigation from '../../components/BlogAdjacentNavigation.astro';
import BlogChromaCard from '../../components/BlogChromaCard.astro';
import BlogChromaGrid from '../../components/BlogChromaGrid.astro';
import { blogArticles, formatBlogDate } from '../../blog/articles';
import { catalog } from '../../data/catalog';
import { imageUrl, sourceImageUrl, type Chroma } from '../../domain/chroma';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { SITE } from '../../seo/site';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const article = blogArticles.find((entry) => entry.slug === 'patch-26-15-prestige-chromas');
if (!article) throw new Error('Patch 26.15 prestige chroma article metadata is missing');
const patchChromas: Chroma[] = catalog.filter((item) => item.gameVer === '26.15');
if (patchChromas.length === 0) throw new Error('No prestige chromas found for Patch 26.15');
const title = `${isZh ? article.titleZh : article.titleEn} | ${SITE.name}`;
const description = isZh ? article.summaryZh : article.summaryEn;
const canonical = new URL(localizedPath(locale, article.href), SITE.origin).toString();
const homeUrl = new URL(localizedPath(locale, '/'), SITE.origin).toString();
const blogUrl = new URL(localizedPath(locale, '/blog/'), SITE.origin).toString();
const faqEntries = isZh ? [
  { question: '26.15 版本有哪些臻彩？', answer: `共 ${patchChromas.length} 款：踏雪寻梅亚索、莉莉娅、卡特琳娜，灵魂莲华凯尔，女帝菲奥娜和青花瓷拉克丝。` },
  { question: '这些是至臻皮肤吗？', answer: '不是。它们是拥有独立原画的臻彩，也就是现有皮肤的炫彩内容，并非传统的至臻皮肤。' },
  { question: '这篇文章的数据会跟着目录更新吗？', answer: '会。臻彩数量、展示顺序、名称、图片和详情链接都在构建时读取站内目录；文章不会把整份 JSON 暴露到网页中。' },
] : [
  { question: 'Which prestige chromas are in LoL Patch 26.15?', answer: `${patchChromas.length} in total: Petals of Spring Yasuo, Lillia, and Katarina; Spirit Blossom Kayle; Battle Queen Fiora; and Porcelain Lux.` },
  { question: 'Are these traditional Prestige skins?', answer: 'No. These are chromas of existing skins with dedicated splash art, rather than traditional Prestige skins.' },
  { question: 'Does this article stay in sync with the catalog?', answer: 'Yes. The count, order, names, images, and detail links are read from the site catalog at build time, without publishing the full JSON file to the web.' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: isZh ? article.titleZh : article.titleEn,
    description, image: imageUrl(patchChromas[0].images.large), datePublished: article.publishedAt,
    dateModified: article.publishedAt, url: canonical, mainEntityOfPage: canonical, inLanguage: isZh ? 'zh-CN' : 'en',
    articleSection: isZh ? '英雄联盟臻彩' : 'League of Legends Prestige Chroma',
    keywords: isZh ? '英雄联盟26.15, 臻彩, 臻彩原画, 亚索, 莉莉娅, 卡特琳娜, 凯尔, 菲奥娜, 拉克丝' : 'LoL Patch 26.15, prestige chromas, chroma splash art, Yasuo, Lillia, Katarina, Kayle, Fiora, Lux',
    about: { '@type': 'VideoGame', name: 'League of Legends' },
    isPartOf: { '@type': 'Blog', name: isZh ? 'LoL Chroma Art 博客' : 'LoL Chroma Art Blog', url: blogUrl },
    author: { '@type': 'Organization', name: SITE.name, url: homeUrl },
    publisher: { '@type': 'Organization', name: SITE.name, url: homeUrl },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isZh ? '首页' : 'Home', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: isZh ? '博客' : 'Blog', item: blogUrl },
      { '@type': 'ListItem', position: 3, name: isZh ? article.titleZh : article.titleEn, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: isZh ? '26.15 版本臻彩原画列表' : 'LoL Patch 26.15 Prestige Chroma List',
    numberOfItems: patchChromas.length,
    itemListElement: patchChromas.map((chroma, index) => ({
      '@type': 'ListItem', position: index + 1,
      item: {
        '@type': 'CreativeWork', name: isZh ? chroma.nameZh : chroma.nameEn,
        url: new URL(localizedPath(locale, `/chromas/${chroma.slug}/`), SITE.origin).toString(),
        image: imageUrl(chroma.images.large),
      },
    })),
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqEntries.map((entry) => ({
      '@type': 'Question', name: entry.question,
      acceptedAnswer: { '@type': 'Answer', text: entry.answer },
    })),
  },
];
---
<BaseLayout {title} {description} {canonical} image={article.coverUrl} ogType="article" publishedTime={article.publishedAt} modifiedTime={article.publishedAt} {jsonLd} {locale} adPlacement="editorial-article">
  <nav class="blog-breadcrumbs" aria-label={isZh ? '面包屑' : 'Breadcrumb'}>
    <a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><a href={localizedPath(locale, '/blog/')}>{isZh ? '博客' : 'Blog'}</a><span>/</span><span aria-current="page">{isZh ? '26.15 版本臻彩' : 'Patch 26.15 Prestige Chromas'}</span>
  </nav>

  <article class="blog-article">
    <header class="article-header">
      <p class="kicker">{isZh ? '26.15 版本 · 臻彩原画' : 'PATCH 26.15 · PRESTIGE CHROMA ART'}</p>
      <h1>{isZh ? article.titleZh : article.titleEn}</h1>
      <p class="article-deck">{isZh ? `26.15 这一批一共 ${patchChromas.length} 款：三款踏雪寻梅，外加灵魂莲华凯尔、女帝菲奥娜和青花瓷拉克丝。` : `Patch 26.15 brings ${patchChromas.length} additions: three Petals of Spring chromas, plus Spirit Blossom Kayle, Battle Queen Fiora, and Porcelain Lux.`}</p>
      <p class="article-meta"><time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, isZh ? 'zh' : 'en')}</time><span>·</span><span>{isZh ? `阅读约 ${article.readingMinutes} 分钟` : `${article.readingMinutes} min read`}</span></p>
    </header>

    <figure class="article-hero">
      <a href={localizedPath(locale, `/chromas/${patchChromas[0].slug}/`)} aria-label={isZh ? `查看 ${patchChromas[0].nameZh} 详情` : `View ${patchChromas[0].nameEn} details`}>
        <picture>
          <source media="(max-width: 767px)" srcset={imageUrl(patchChromas[0].images.medium)} data-fallback={sourceImageUrl('medium', patchChromas[0].instanceId)} />
          <img src={imageUrl(patchChromas[0].images.large)} data-fallback={sourceImageUrl('large', patchChromas[0].instanceId)} data-placeholder="/placeholder.svg" alt={isZh ? `${patchChromas[0].nameZh}臻彩原画` : `${patchChromas[0].nameEn} prestige chroma splash art`} width="1920" height="1080" loading="eager" decoding="async" />
        </picture>
      </a>
      <figcaption>{isZh ? patchChromas[0].nameZh : patchChromas[0].nameEn}</figcaption>
    </figure>

    <section>
      <h2>{isZh ? '六款，分成四个系列' : 'Six chromas across four skinlines'}</h2>
      {isZh ? <><p>26.15 的名单很整齐。踏雪寻梅一次加入亚索、莉莉娅和卡特琳娜三款“独步早春”；剩下三款分别来自灵魂莲华、女帝和青花瓷。三款生肖限定臻彩、两款钻石臻彩，再加一款臻彩，正好组成这次更新。之后官方又在<a href={localizedPath(locale, '/blog/lucky-gate-petals-of-spring-chromas-202607/')}>幸运之门公告</a>中点名了这三款踏雪寻梅臻彩。</p><p>这里的<a href={localizedPath(locale, '/blog/what-are-prestige-chromas/')}>臻彩</a>指国服定义的炫彩类型，依附于已有皮肤并拥有独立原画，不是通常所说的至臻皮肤。下方每张图都可以点进详情页，查看基础皮肤、所属系列、版本和配色。</p></> : <><p>The list splits neatly into four skinlines. Petals of Spring contributes Emerald chromas for Yasuo, Lillia, and Katarina. Spirit Blossom, Battle Queen, and Porcelain supply the other three. By category, that is three Lunar Revel Prestige Chromas, two Diamond Prestige Chromas, and one Prestige Chroma. The later <a href={localizedPath(locale, '/blog/lucky-gate-petals-of-spring-chromas-202607/')}>Lucky Gate announcement</a> names those three Petals of Spring chromas again.</p><p>On this site, <a href={localizedPath(locale, '/blog/what-are-prestige-chromas/')}>“Prestige Chroma”</a> is the English label for 臻彩: a China Server chroma type attached to an existing skin with its own splash art. It is not the same thing as a traditional Prestige Skin. Every image below links to a detail page with the base skin, skinline, patch, category, and colour data.</p></>}
    </section>

    <section>
      <h2>{isZh ? '踏雪寻梅，一口气补齐三款' : 'Three Emerald additions for Petals of Spring'}</h2>
      {isZh ? <><p>这次数量最多的是踏雪寻梅。亚索、莉莉娅和卡特琳娜的臻彩都叫“独步早春”，英文名称则统一标为 Emerald。三款配色记录也是同一组翡翠绿，因此放在一起看，会比单独翻目录更容易看出它们是一套。</p><p>踏雪寻梅的故事围绕精神领域中的神话花园展开：园丁照料承载凡人希望、梦想与苦难的植物，霜火花盛开时，积雪开始消融，春天重新回到花园和凡间。“独步早春”没有另起一套概念，而是顺着这个由冬入春的主题继续往前走。</p></> : <><p>Petals of Spring accounts for half of the update. Yasuo, Lillia, and Katarina all receive Emerald chromas, and the Chinese catalog gives each one the shared subtitle “独步早春.” Their recorded colour is the same emerald green, so they read as a set rather than three unrelated releases.</p><p>The skinline is set in a mythical garden deep in the spirit realm. Its gardeners tend plants shaped by mortal hopes, dreams, and suffering; when the Frostpyre flowers bloom, the snow begins to melt and spring returns. These three chromas stay close to that change-of-season idea instead of introducing a separate theme.</p></>}
    </section>

    <section>
      <h2>{isZh ? '凯尔、菲奥娜和拉克丝，各自走自己的路线' : 'Kayle, Fiora, and Lux round out the patch'}</h2>
      {isZh ? <><p><strong>灵魂莲华 凯尔 星回</strong>是本批唯一的紫色系臻彩，英文配色名为 Tanzanite，分类是钻石臻彩。灵魂莲华本来就围绕绽灵节、生者与灵体的相遇展开，“星回”这个名字放在这个系列里并不突兀。</p><p><strong>女帝 菲奥娜 纹章之刻印·强运</strong>使用 Rose Quartz 配色，同样属于钻石臻彩。女帝系列的背景是以“神圣加冕礼”维系诸国联盟，纹章和刻印一直是这套世界观里的重要符号，中文名也延续了这套命名方式。</p><p><strong>青花瓷 拉克丝 含苞</strong>也是 Rose Quartz 配色，但目录分类是普通臻彩。青花瓷系列围绕十二生肖圣物与守护者展开，“含苞”比前两款的名字更轻，和拉克丝这一张粉色系原画放在一起也更直观。整个青花瓷系列（包括艾瑞莉娅、丽桑卓、伊泽瑞尔和拉克丝）后来以景德镇瓷艺为主题推出了独立的<a href={localizedPath(locale, '/blog/blue-porcelain-prestige-chromas/')}>青花瓷臻彩专题</a>。26.16 版本中，四款青花瓷皮肤进一步升级为钻石臻彩，详见 <a href={localizedPath(locale, '/blog/patch-26-16-prestige-chromas/')}>26.16 版本臻彩</a>。</p></> : <><p><strong>Spirit Blossom Kayle (Tanzanite)</strong> is the only purple entry in the batch and is listed as a Diamond Prestige Chroma. Spirit Blossom already deals with the meeting of the living and the spirit world during the festival, which gives Kayle a very different setting from the other five.</p><p><strong>Battle Queen Fiora (Rose Quartz)</strong> is also a Diamond Prestige Chroma. The Battle Queens setting centres on rival queendoms and the Grand Coronation, and the long Chinese subtitle keeps the skinline's heraldic naming style.</p><p><strong>Porcelain Lux (Rose Quartz)</strong> shares Fiora's colour label but belongs to the standard Prestige Chroma category. Porcelain is built around Zodiac Relics and their immortal protectors, so Lux closes the patch with another Lunar New Year skinline without repeating the Petals of Spring setting. The full Porcelain series later received a dedicated <a href={localizedPath(locale, '/blog/blue-porcelain-prestige-chromas/')}>Jingdezhen porcelain collaboration</a> with four new chromas.</p><p>The full Porcelain series later received Diamond-tier upgrades with their own splash art in <a href={localizedPath(locale, '/blog/patch-26-16-prestige-chromas/')}>patch 26.16</a>.</p></>}
    </section>

    <section>
      <h2>{isZh ? '26.15 臻彩原画一览' : 'Patch 26.15 prestige chroma gallery'}</h2>
      <p>{isZh ? '卡片顺序与站内目录一致。图片下方的圆点是该款臻彩的主配色，点击原画即可进入对应详情页。这 6 款新增也影响了<a href={localizedPath(locale, \'/blog/top-2-prestige-chroma-champions/\')}>臻彩数量排行榜</a>。' : 'The cards follow the same order as the main catalog. The circle on each image shows its recorded colour; select the artwork to open the matching detail page. These 6 additions also shifted the <a href={localizedPath(locale, \'/blog/top-2-prestige-chroma-champions/\')}>prestige chroma leaderboard</a>.'}</p>
      <BlogChromaGrid>
        {patchChromas.map((chroma) => <BlogChromaCard chroma={chroma} {locale} />)}
      </BlogChromaGrid>
    </section>

    <section class="faq">
      <h2>{isZh ? '常见问题' : 'FAQ'}</h2>
      {faqEntries.map((entry) => <details><summary>{entry.question}</summary><p>{entry.answer}</p></details>)}
    </section>
  </article>

  <BlogAdjacentNavigation currentSlug={article.slug} {locale} />

  <style is:global>
    .blog-breadcrumbs,.blog-article{width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2)));margin-inline:auto}.blog-breadcrumbs{display:flex;gap:9px;padding:28px 0 0;color:var(--muted);font-size:.84rem;white-space:nowrap;overflow-x:auto}.blog-article{padding:clamp(52px,8vw,90px) 0 110px}.article-header,.blog-article>section,.blog-article>figure{width:100%;margin-inline:auto}.article-header{margin-bottom:42px}.article-header h1{font-family:Georgia,"Noto Serif SC",serif;font-size:clamp(2.7rem,6vw,5rem);line-height:1.05;font-weight:500;margin:.34em 0 .35em;overflow-wrap:anywhere}.article-deck{color:#c7cad4;font-size:clamp(1.05rem,2vw,1.25rem);line-height:1.7}.article-meta{display:flex;flex-wrap:wrap;gap:9px;color:var(--muted);font-size:.8rem}.blog-article section{margin-top:48px}.blog-article h2{font-family:Georgia,"Noto Serif SC",serif;color:var(--gold);font-size:clamp(1.65rem,3.3vw,2.25rem);line-height:1.2;margin:0 0 18px}.blog-article section p{color:#c7cad4;font-size:1.06rem;line-height:1.9;margin:0 0 1.2em}.blog-article strong{color:#f1f2f5}.blog-article a{color:var(--gold);text-decoration:none}.blog-article section p a{text-decoration:underline;text-underline-offset:3px}.blog-article figure{margin-top:42px}.blog-article figure img{display:block;width:100%;height:auto;border:1px solid var(--line);background:#15182a;box-shadow:0 22px 64px #0007}.article-hero img{height:auto}.blog-article figcaption{color:var(--muted);font-size:.78rem;line-height:1.6;margin-top:10px;overflow-wrap:anywhere}.faq details{border-top:1px solid var(--line);padding:16px 0}.faq details:last-child{border-bottom:1px solid var(--line)}.faq summary{color:#e6e8ee;font-weight:700;line-height:1.5;cursor:pointer}.faq details p{margin:12px 0 0}

    @media(max-width:767px){.blog-breadcrumbs{padding-top:18px}.blog-article{padding:42px 0 76px}.article-header{margin-bottom:28px}.article-header h1{font-size:clamp(2.3rem,11vw,3.35rem)}.blog-article section{margin-top:36px}.blog-article section p{font-size:1rem;line-height:1.78}.blog-article figure{margin-top:32px}}
  </style>
</BaseLayout>
