---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogAdjacentNavigation from '../../components/BlogAdjacentNavigation.astro';
import { blogArticles, formatBlogDate } from '../../blog/articles';
import { SITE } from '../../seo/site';

const article = blogArticles.find((entry) => entry.slug === 'what-are-chroma-skins');
if (!article) throw new Error('Chroma explainer article metadata is missing');
const title = `${article.titleEn} | ${SITE.name}`;
const description = article.summaryEn;
const canonical = `${SITE.origin}${article.href}`;
const mediaRoot = '/img/blog/chroma-history-';
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: article.titleEn,
    description, image: `${SITE.origin}${article.coverUrl}`, datePublished: article.publishedAt,
    dateModified: article.publishedAt, mainEntityOfPage: canonical,
    inLanguage: ['en', 'zh'], articleSection: 'League of Legends Guides',
    author: { '@type': 'Organization', name: SITE.name, url: `${SITE.origin}/` },
    publisher: { '@type': 'Organization', name: SITE.name, url: `${SITE.origin}/` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.origin}/blog/` },
      { '@type': 'ListItem', position: 3, name: article.titleEn, item: canonical },
    ],
  },
];
---
<BaseLayout {title} {description} {canonical} image={article.coverUrl} ogType="article" publishedTime={article.publishedAt} modifiedTime={article.publishedAt} {jsonLd}>
  <nav class="blog-breadcrumbs" aria-label="Breadcrumb" data-aria-en="Breadcrumb" data-aria-zh="面包屑">
    <a href="/" data-en="Home" data-zh="首页">Home</a><span>/</span><a href="/blog/" data-en="Blog" data-zh="博客">Blog</a><span>/</span><span aria-current="page" data-en="Chroma skins" data-zh="炫彩皮肤">Chroma skins</span>
  </nav>

  <article class="blog-article" data-language-content="en">
    <header class="article-header"><p class="kicker">LoL CHROMA ART GUIDE</p><h1>{article.titleEn}</h1><p class="article-deck">Background, colour schemes, purchase methods, and common questions about chroma skins.</p><p class="article-meta"><time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'en')}</time><span>·</span><span>{article.readingMinutes} min read</span></p></header>
    <figure><img src={article.coverUrl} alt={article.coverAltEn} data-alt-en={article.coverAltEn} data-alt-zh={article.coverAltZh} data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1788" height="880" loading="eager" decoding="async" /><figcaption>Chroma Skins 1.1.</figcaption></figure>
    <section><h2>Background</h2><p>Chroma skins launched in Patch 6.17 to give players more ways to personalise content they already owned, liked and used. Changes to art direction, pricing and packaging gave favourite skins more distinct colour options.</p></section>
    <section><h2>Skin showcase</h2></section>
    <div class="showcase"><figure><img src={`${mediaRoot}poppy-chroma.png`} alt="Warring Kingdoms Poppy chroma artwork" data-alt-en="Warring Kingdoms Poppy chroma artwork" data-alt-zh="军神战甲波比炫彩展示图" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1910" height="1080" loading="lazy" decoding="async" /><figcaption>Warring Kingdoms Poppy</figcaption></figure><figure><img src={`${mediaRoot}braum-chroma.png`} alt="Dragonslayer Braum chroma artwork" data-alt-en="Dragonslayer Braum chroma artwork" data-alt-zh="屠龙勇士布隆炫彩展示图" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1910" height="1080" loading="lazy" decoding="async" /><figcaption>Dragonslayer Braum</figcaption></figure></div>
    <section><h2>Purchase methods</h2><h3>Individual purchase</h3><p>Players could select one favourite chroma or buy the full set as a discounted bundle.</p></section>
    <figure><img src={`${mediaRoot}individual-purchase-en.png`} alt="English infographic comparing individual chroma purchase with a discounted bundle" data-alt-en="English infographic comparing individual chroma purchase with a discounted bundle" data-alt-zh="对比单独购买炫彩与折扣礼包的英文信息图" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1663" height="945" loading="lazy" decoding="async" /><figcaption>Individual purchase and discounted bundle.</figcaption></figure>
    <section><h3>Blue Essence purchase</h3><p>Chromas released for more than five months may become available for limited-time purchase with Blue Essence. Sale dates are announced separately.</p></section>
    <figure><img src={`${mediaRoot}blue-essence-en.png`} alt="English timeline explaining chroma purchases with Blue Essence" data-alt-en="English timeline explaining chroma purchases with Blue Essence" data-alt-zh="说明炫彩皮肤蓝色精萃购买时间线的英文信息图" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1950" height="807" loading="lazy" decoding="async" /><figcaption>Release, RP sale and Blue Essence sale timeline.</figcaption></figure>
    <section><h3>Limited-time promotion</h3><p>Chromas could take part in promotions like champions and skins, with discounts announced in advance. These are historical rules recorded by the entry; current prices and availability should be checked in the live client.</p></section>
    <section><h2>Colour schemes</h2><p>Chroma palettes are designed to be clear, lively and varied. Some chromas also add small visual touches that make each colour option more distinctive.</p></section>
    <div class="comparison" role="group" aria-label="Official chroma colour comparison"><figure><img src={`${mediaRoot}refined-before.png`} alt="Official chroma colour example before refinement" data-alt-en="Official chroma colour example before refinement" data-alt-zh="官方炫彩配色调整前示例" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="293" height="292" loading="lazy" decoding="async" /><figcaption>Before</figcaption></figure><figure><img src={`${mediaRoot}refined-after.png`} alt="Official chroma colour example after refinement" data-alt-en="Official chroma colour example after refinement" data-alt-zh="官方炫彩配色调整后示例" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="293" height="292" loading="lazy" decoding="async" /><figcaption>After</figcaption></figure></div>
    <section class="faq"><h2>FAQ</h2><details><summary>Why were chromas changed?</summary><p>Riot wanted chromas to offer more ways to personalise favourite League content. Feedback showed the first version had not fully reached that goal, so the team spent several months improving the experience.</p></details><details><summary>How were skins selected for new chromas?</summary><p>The team looked at popular skins and considered their creative potential, including colour combinations and materials. A concept moved forward when it looked strong and felt distinctive.</p></details><details><summary>How can chromas be purchased with Blue Essence?</summary><p>The Blue Essence Emporium offers selected chromas for a limited time. Prices and availability depend on the current store rotation.</p></details><details><summary>Would there be more chromas?</summary><p>Yes. The page said more skins would receive chroma versions in the future.</p></details><details><summary>Did chromas replace the creation of new skins?</summary><p>No. Riot said it would continue making both new skins and chromas.</p></details><details><summary>Were chroma bundles discounted?</summary><p>Yes. Bundles included a discount, with exact details shown in the game store.</p></details><details><summary>Where could players see all available chromas?</summary><p>Bundles appeared under the store’s bundle tab. Individual chromas could be offered through the campaign page, with availability announced officially.</p></details><details><summary>Would more chromas be made for champions’ classic appearances?</summary><p>At that time the focus had shifted to chromas for skins, which were intended to deepen the connection with a favourite cosmetic. Existing classic-appearance chromas remained available, but the page said no more were planned then.</p></details></section>
  </article>

  <article class="blog-article" data-language-content="zh">
    <header class="article-header"><p class="kicker">LoL CHROMA ART 指南</p><h1>{article.titleZh}</h1><p class="article-deck">介绍炫彩皮肤的推出背景、配色、购买方式与常见问题。</p><p class="article-meta"><time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'zh')}</time><span>·</span><span>阅读约 {article.readingMinutes} 分钟</span></p></header>
    <figure><img src={article.coverUrl} alt={article.coverAltZh} data-alt-en={article.coverAltEn} data-alt-zh={article.coverAltZh} data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1788" height="880" loading="eager" decoding="async" /><figcaption>炫彩皮肤 1.1。</figcaption></figure>
    <section><h2>推出背景</h2><p>炫彩皮肤于 6.17 版本上线，为玩家已经拥有、喜爱和使用的游戏内容提供更多个性化选择。经过美术设计、价格与包装方面的调整，长期喜爱的皮肤也能拥有更鲜明的不同配色。</p></section>
    <section><h2>皮肤展示</h2></section>
    <div class="showcase"><figure><img src={`${mediaRoot}poppy-chroma.png`} alt="军神战甲波比炫彩展示图" data-alt-en="Warring Kingdoms Poppy chroma artwork" data-alt-zh="军神战甲波比炫彩展示图" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1910" height="1080" loading="lazy" decoding="async" /><figcaption>军神战甲 波比</figcaption></figure><figure><img src={`${mediaRoot}braum-chroma.png`} alt="屠龙勇士布隆炫彩展示图" data-alt-en="Dragonslayer Braum chroma artwork" data-alt-zh="屠龙勇士布隆炫彩展示图" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1910" height="1080" loading="lazy" decoding="async" /><figcaption>屠龙勇士 布隆</figcaption></figure></div>
    <section><h2>购买方式</h2><h3>单独购买</h3><p>玩家可以逐一购买自己喜欢的炫彩，也可以通过带折扣的礼包一次收齐。</p></section>
    <figure><img src={`${mediaRoot}individual-purchase-en.png`} alt="对比单独购买炫彩与折扣礼包的英文信息图" data-alt-en="English infographic comparing individual chroma purchase with a discounted bundle" data-alt-zh="对比单独购买炫彩与折扣礼包的英文信息图" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1663" height="945" loading="lazy" decoding="async" /><figcaption>单独购买与折扣礼包英文示意图。</figcaption></figure>
    <section><h3>蓝色精萃购买</h3><p>推出超过五个月的炫彩有机会限时开放蓝色精萃购买，具体时间以官方公告为准。</p></section>
    <figure><img src={`${mediaRoot}blue-essence-en.png`} alt="说明炫彩皮肤蓝色精萃购买时间线的英文信息图" data-alt-en="English timeline explaining chroma purchases with Blue Essence" data-alt-zh="说明炫彩皮肤蓝色精萃购买时间线的英文信息图" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="1950" height="807" loading="lazy" decoding="async" /><figcaption>推出、点券促销与蓝色精萃促销时间线。</figcaption></figure>
    <section><h3>限时促销</h3><p>炫彩也可能像英雄和皮肤一样参加促销，打折前会提前公告。以上为词条记录的历史规则，当前价格与开放情况请以客户端商城为准。</p></section>
    <section><h2>配色方案</h2><p>炫彩皮肤的颜色主题更加明确、生动和丰富；部分炫彩还会增加一些小设计，让不同配色更有特色。</p></section>
    <div class="comparison" role="group" aria-label="官方炫彩配色前后对比"><figure><img src={`${mediaRoot}refined-before.png`} alt="官方炫彩配色调整前示例" data-alt-en="Official chroma colour example before refinement" data-alt-zh="官方炫彩配色调整前示例" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="293" height="292" loading="lazy" decoding="async" /><figcaption>调整前</figcaption></figure><figure><img src={`${mediaRoot}refined-after.png`} alt="官方炫彩配色调整后示例" data-alt-en="Official chroma colour example after refinement" data-alt-zh="官方炫彩配色调整后示例" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" width="293" height="292" loading="lazy" decoding="async" /><figcaption>调整后</figcaption></figure></div>
    <section class="faq"><h2>常见问题解答</h2><details><summary>为什么要对炫彩皮肤进行改动？</summary><p>制作炫彩的初衷，是让玩家用更多方式个性化自己喜欢的内容。第一次尝试的反馈表明目标没有完全实现，因此团队用数月时间改善体验。</p></details><details><summary>如何选择新的炫彩制作目标？</summary><p>官方会优先考虑受欢迎的皮肤，同时查看颜色组合、材质等创作空间；当方案足够好看并具有鲜明特色时，才会继续探索。</p></details><details><summary>如何用蓝色精萃购买炫彩皮肤？</summary><p>蓝色精萃商店会限时开放部分炫彩，每款所需精萃和开放范围以当期商城为准。</p></details><details><summary>还会有更多炫彩皮肤吗？</summary><p>会。官方表示将来会为更多皮肤制作炫彩版本。</p></details><details><summary>制作炫彩后还会制作新皮肤吗？</summary><p>会。官方明确表示新皮肤和炫彩皮肤都会继续制作。</p></details><details><summary>购买炫彩礼包会有折扣吗？</summary><p>会。礼包会提供一定折扣，具体内容以当时游戏商城为准。</p></details><details><summary>如何查看全部可用炫彩？</summary><p>炫彩礼包可以在商店“道具包”标签下查看；单个炫彩可通过活动页面购买，具体开放情况关注官方公告。</p></details><details><summary>还会为英雄经典皮肤制作更多炫彩吗？</summary><p>当时的重点已经转向为皮肤制作炫彩，让玩家进一步个性化喜爱的皮肤。已有的英雄经典造型炫彩仍可购买，但专题表示暂时不计划继续制作。</p></details></section>
  </article>

  <BlogAdjacentNavigation currentSlug={article.slug} />

  <style>
    .blog-breadcrumbs,.blog-article{width:min(760px,calc(100% - (var(--page-gutter) * 2)));margin-inline:auto}.blog-breadcrumbs{display:flex;gap:9px;padding:28px 0 0;color:var(--muted);font-size:.84rem;white-space:nowrap;overflow-x:auto}.blog-article{padding:clamp(52px,8vw,90px) 0 110px}.article-header,.blog-article>section,.blog-article>figure,.comparison,.showcase{width:100%;margin-inline:auto}.article-header{margin-bottom:42px}.article-header h1{font-family:Georgia,"Noto Serif SC",serif;font-size:clamp(2.7rem,6vw,5rem);line-height:1.05;font-weight:500;margin:.34em 0 .35em;overflow-wrap:anywhere}.article-deck{color:#c7cad4;font-size:clamp(1.05rem,2vw,1.25rem);line-height:1.7}.article-meta{display:flex;flex-wrap:wrap;gap:9px;color:var(--muted);font-size:.8rem}.blog-article section{margin-top:48px}.blog-article h2{font-family:Georgia,"Noto Serif SC",serif;color:var(--gold);font-size:clamp(1.65rem,3.3vw,2.25rem);line-height:1.2;margin:0 0 18px}.blog-article h3{color:#e4c880;font-size:1.12rem;margin:30px 0 8px}.blog-article section p{color:#c7cad4;font-size:1.06rem;line-height:1.9;margin:0 0 1.2em}.blog-article a{color:var(--gold);text-decoration:underline;text-underline-offset:3px}.blog-article figure{margin-top:42px}.blog-article figure img{display:block;width:100%;height:auto;object-fit:cover;border:1px solid var(--line);background:#15182a;box-shadow:0 22px 64px #0007}.blog-article figcaption{color:var(--muted);font-size:.78rem;line-height:1.6;margin-top:10px;overflow-wrap:anywhere}.comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:42px}.comparison figure,.showcase figure{width:auto;margin:0}.comparison img{aspect-ratio:1}.comparison figcaption{text-align:center}.showcase{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:42px}.showcase img{aspect-ratio:1910/1080}.faq details{border-top:1px solid var(--line);padding:16px 0}.faq details:last-child{border-bottom:1px solid var(--line)}.faq summary{color:#e6e8ee;font-weight:700;line-height:1.5;cursor:pointer}.faq details p{margin:12px 0 0}
    .blog-breadcrumbs,.blog-article{width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2)))}
    @media(max-width:767px){.blog-breadcrumbs{padding-top:18px}.blog-article{padding:42px 0 76px}.article-header{margin-bottom:28px}.article-header h1{font-size:clamp(2.35rem,12vw,3.4rem)}.blog-article section{margin-top:36px}.blog-article section p{font-size:1rem;line-height:1.78}.comparison{gap:10px;margin-top:32px}.showcase{grid-template-columns:1fr;gap:26px;margin-top:32px}}
  </style>
</BaseLayout>
