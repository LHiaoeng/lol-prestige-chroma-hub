---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogArticles, formatBlogDate } from '../../blog/articles';
import { catalog } from '../../data/catalog';
import { imageUrl, sourceImageUrl, type Chroma } from '../../domain/chroma';
import { SITE } from '../../seo/site';

const article = blogArticles.find((entry) => entry.slug === 'what-are-prestige-chromas');
if (!article) throw new Error('Prestige chroma article metadata is missing');
const title = `${article.titleEn} | ${SITE.name}`;
const description = article.summaryEn;
const canonical = `${SITE.origin}${article.href}`;
const showcase: Chroma[] = [
  catalog.find((c) => c.instanceId === '6abd93a6-2390-4e0a-934c-758b33a8ac5e'),
  catalog.find((c) => c.instanceId === 'bd3ce601-6d7a-402b-a76e-7a1d799702dd'),
  catalog.find((c) => c.instanceId === 'f5069942-3c9f-4cb3-8a67-299d9b1b7406'),
  catalog.find((c) => c.instanceId === '58cd810b-fa2e-4939-ac2a-0bae7e06f4fb'),
].filter((c): c is Chroma => c != null);
const lplChroma = catalog.find((c) => c.instanceId === '9c393600-64bc-402b-8b02-f57f3211d9c3');
const charityChromas: Chroma[] = [
  catalog.find((c) => c.instanceId === '2dd13664-1978-4b31-a975-f68acd305aea'),
  catalog.find((c) => c.instanceId === 'ad61d21c-8887-47ac-815e-24755defe46e'),
  catalog.find((c) => c.instanceId === 'bf061ede-7cec-4c1f-a914-4253ec3cdc48'),
].filter((c): c is Chroma => c != null);
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: article.titleEn,
    description, image: `${SITE.origin}${article.coverUrl}`, datePublished: article.publishedAt,
    dateModified: article.publishedAt, mainEntityOfPage: canonical,
    inLanguage: ['en', 'zh'], articleSection: 'League of Legends Guides',
    author: { '@type': 'Organization', name: SITE.name, url: `${SITE.origin}/` },
    publisher: { '@type': 'Organization', name: SITE.name, url: `${SITE.origin}/` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.origin}/blog/` },
      { '@type': 'ListItem', position: 3, name: article.titleEn, item: canonical },
    ],
  },
];
---
<BaseLayout {title} {description} {canonical} image={article.coverUrl} ogType="article" publishedTime={article.publishedAt} modifiedTime={article.publishedAt} {jsonLd}>
  <nav class="blog-breadcrumbs" aria-label="Breadcrumb" data-aria-en="Breadcrumb" data-aria-zh="面包屑">
    <a href="/" data-en="Home" data-zh="首页">Home</a><span>/</span><a href="/blog/" data-en="Blog" data-zh="博客">Blog</a><span>/</span><span aria-current="page" data-en="Prestige Chromas" data-zh="臻彩">Prestige Chromas</span>
  </nav>

  <article class="blog-article" data-language-content="en">
    <header class="article-header"><p class="kicker">LoL CHROMA ART ARCHIVE</p><h1>{article.titleEn}</h1><p class="article-deck">Prestige chromas are the best of the China-exclusive chroma splash art archive — limited-edition artworks with their own illustrations, collector frames, and a look that's a lot more than just a colour swap.</p><p class="article-meta"><time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'en')}</time><span>·</span><span>{article.readingMinutes} min read</span></p></header>

    <section><h2>What are prestige chromas?</h2><p>Prestige chromas (臻彩) are a rare, limited-edition chroma tier in the Chinese version of League of Legends, operated by Tencent. They launched on January 13, 2023 with the Prestige Chroma Collection system and are the top-tier visual option for select skins.</p><p>Regular chromas just shift the colour palette. Prestige chromas come with their own splash art, a special display frame in the client, and sometimes even original theme music. This archive documents those exclusive artworks.</p></section>

    <section><h2>The chroma art showcase</h2><p>Each prestige chroma in this archive has its own full-colour illustration, meant to be collected as art. Here are a few picks from the collection.</p></section>
    <div class="showcase">{showcase.map((chroma) => <figure><img src={imageUrl(chroma.images.large)} data-fallback={sourceImageUrl('large', chroma.instanceId)} data-alt-en={`${chroma.nameEn} — prestige chroma splash art`} data-alt-zh={`${chroma.nameZh} — 臻彩原画`} data-placeholder="/placeholder.svg" alt={`${chroma.nameEn} prestige chroma`} width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>{chroma.nameEn}</figcaption></figure>)}</div>

    <section><h2>What sets them apart</h2><p>Regular chromas change a skin's colour scheme while keeping the same splash art, model, and effects. Prestige chromas take it further: each one has its own illustration for champion select and the loading screen, shown in a flag-like frame with the character breaking out of it.</p><p>The upgrade shows up in the client too. Regular chromas are just small colour swatches, but prestige chromas get a full bordered display with extra detail. Some series even come with exclusive theme music, which pushes them into collector's item territory.</p></section>

    <section><h2>The collection system</h2><p>The Prestige Chroma Collection system in the League client lets players view, organise, and share their prestige chroma collection. Each prestige chroma unlocks an illustration you can display and share.</p></section>
    <section><p>Players also get a personal collection homepage where they can pick which prestige chromas to show off — basically curating their own gallery for others to browse.</p></section>
    <figure><img src="/images/blog/what-are-prestige-chromas/profile.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Personal prestige chroma collection homepage" data-alt-zh="个人臻彩收藏主页" alt="Personal collection homepage" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>Personal collection homepage — profile and holdings</figcaption></figure>
    <section><p>Collection progress is tracked with three tiers of exclusive Poro icons: Prestige Enthusiast, Prestige Connoisseur, and Prestige Collector. Collect more, unlock fancier icons.</p></section>
    <figure><img src="/images/blog/what-are-prestige-chromas/cover.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Prestige Chroma Collection interface in the League of Legends client" data-alt-zh="《英雄联盟》客户端中的臻彩藏馆界面" alt="Prestige Chroma Collection interface" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>Prestige Chroma Collection — in-client interface</figcaption></figure>
    <section><p>There's also a Collection Ranking board showing the top collectors on your server, ranked by prestige chroma count. The leaderboard updates every hour — friendly competition between the most dedicated collectors.</p></section>
    <figure><img src="/images/blog/what-are-prestige-chromas/ranking.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Prestige Chroma Collection Ranking leaderboard" data-alt-zh="臻彩藏馆收藏排行 leaderboard" alt="Collection Ranking leaderboard" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>Collection Ranking — server leaderboard</figcaption></figure>

    <section><h2>How to obtain prestige chromas</h2><h3>Event token exchange</h3><p>New prestige chromas typically launch during limited-time events. Players earn event tokens through gameplay and exchange them in the event shop — usually at a cost of around 2,000 tokens per chroma.</p><h3>Summoning events</h3><p>Events such as "Brilliant Prestige Summoning" offer a gacha-style path to prestige chromas, often with a self-select pool and ultimate prizes.</p><h3>Mythic Essence exchange</h3><p>Older prestige chromas may become available through the Mythic Shop using Mythic Essence. The shop rotates its offerings, so availability depends on the current rotation.</p><h3>Collection achievements</h3><p>Some prestige chromas can be earned by completing in-game skin collection milestones, rewarding dedicated collectors who reach specific thresholds.</p></section>

    <section><h2>Design philosophy</h2><p>Prestige chroma designs lean heavily on Eastern aesthetics and traditional Chinese art. The colours, motifs, and illustrations tap into cultural themes, so each one has its own identity instead of just being another colour variant.</p><p>In 2026, the prestige chroma line got a big technical upgrade — better illustrations and a nicer in-client presentation. This archive captures those artworks at full resolution so you can actually see the detail.</p></section>

    <section><h2>Cultural content and collaborations</h2><p>Prestige chromas aren't just cosmetics anymore — they've become a way to celebrate culture and give back. The LPL Top 10 Players series is a good example, with exclusive artwork honouring the league's most iconic pro players.</p></section>
    {lplChroma && <figure><img src={imageUrl(lplChroma.images.large)} data-fallback={sourceImageUrl('large', lplChroma.instanceId)} data-alt-en={`${lplChroma.nameEn} — ${lplChroma.nameZh} prestige chroma splash art`} data-alt-zh={`${lplChroma.nameZh} — ${lplChroma.nameEn} 臻彩原画`} data-placeholder="/placeholder.svg" alt={`${lplChroma.nameEn} prestige chroma`} width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>{lplChroma.nameEn} · {lplChroma.nameZh}</figcaption></figure>}
    <section><p>On the charity side, proceeds from select prestige chroma sales have gone to good causes. From 5 November to 3 December 2025, three prestige chromas — "Sichuan Embroidery", "Mount Qingcheng", and "Hot Pot" — were sold as limited-time releases, with all revenue going to the "Heritage Craftsmanship, Building Rural Dreams" intangible cultural heritage project.</p></section>
    <div class="showcase showcase-row-3">{charityChromas.map((chroma) => <figure><img src={imageUrl(chroma.images.large)} data-fallback={sourceImageUrl('large', chroma.instanceId)} data-alt-en={`${chroma.nameEn} — ${chroma.nameZh} prestige chroma splash art`} data-alt-zh={`${chroma.nameZh} — ${chroma.nameEn} 臻彩原画`} data-placeholder="/placeholder.svg" alt={`${chroma.nameEn} prestige chroma`} width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>{chroma.nameEn} · {chroma.nameZh}</figcaption></figure>)}</div>

    <section class="faq"><h2>FAQ</h2><details><summary>Do I need the base skin to use a prestige chroma?</summary><p>Yes. A prestige chroma requires ownership of the corresponding base skin before it can be applied.</p></details><details><summary>Can prestige chromas be purchased directly with RP?</summary><p>Prestige chromas are typically obtained through event tokens, summoning events, or Mythic Essence rather than direct RP purchase. Check the current event or Mythic Shop for available options.</p></details><details><summary>Are prestige chromas available globally?</summary><p>Availability varies. Some prestige chromas are released for all regions, while others may be limited to the Chinese server operated by Tencent. Always check official announcements for your region.</p></details><details><summary>What makes prestige chromas different from regular chromas?</summary><p>Prestige chromas include exclusive splash art, a special in-client display frame, and sometimes unique theme music. Regular chromas only change the colour palette of an existing skin.</p></details><details><summary>Will older prestige chromas come back?</summary><p>Some older prestige chromas rotate into the Mythic Shop periodically. There is no guarantee for every past chroma, but the pattern suggests select returns over time.</p></details><details><summary>How can I track my collection progress?</summary><p>Open the Prestige Chroma Collection page in the League client to view your holdings, illustrations, and progress toward exclusive Poro icon rewards.</p></details></section>
  </article>

  <article class="blog-article" data-language-content="zh">
    <header class="article-header"><p class="kicker">LoL CHROMA ART 图鉴</p><h1>{article.titleZh}</h1><p class="article-deck">臻彩是中国服炫彩原画图鉴里最顶的一档——限量发行，有独立原画和收藏边框，比普通换色强太多。</p><p class="article-meta"><time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'zh')}</time><span>·</span><span>阅读约 {article.readingMinutes} 分钟</span></p></header>

    <section><h2>什么是臻彩？</h2><p>臻彩（也叫"臻品炫彩"）是腾讯《英雄联盟》中国服里的一种稀有限定炫彩，2023 年 1 月 13 日跟着"臻彩藏馆"系统一起上线，是目前选定皮肤能拿到的最高档视觉个性化。</p><p>普通炫彩就是换个配色，臻彩不一样：每款都有自己的原画、客户端展示边框，有的还带专属主题音乐。本站就是专门收录这些原画的。</p></section>

    <section><h2>臻彩原画展示</h2><p>图鉴里每款臻彩都有自己的全彩插画，值得收藏。下面挑了几张看看。</p></section>
    <div class="showcase">{showcase.map((chroma) => <figure><img src={imageUrl(chroma.images.large)} data-fallback={sourceImageUrl('large', chroma.instanceId)} data-alt-en={`${chroma.nameEn} — prestige chroma splash art`} data-alt-zh={`${chroma.nameZh} — 臻彩原画`} data-placeholder="/placeholder.svg" alt={`${chroma.nameZh} 臻彩原画`} width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>{chroma.nameZh}</figcaption></figure>)}</div>

    <section><h2>与普通炫彩的区别</h2><p>普通炫彩只改颜色，原画、模型、特效都不变。臻彩不一样：每款都有自己的插画，在选英雄和载入界面用旗帜状边框展示，人物像从画里走出来一样。</p><p>客户端里也能看出来差别。普通炫彩就是个小色块，臻彩有完整的画框和更多细节。有的系列还带专属背景音乐，已经不只是皮肤升级了，更像是收藏品。</p></section>

    <section><h2>臻彩藏馆系统</h2><p>臻彩藏馆系统在客户端里就能打开，用来查看、整理和分享你的臻彩收藏。每拿到一款臻彩，就解锁一张插画，可以展示和分享。</p></section>
    <section><p>每个玩家还有自己的收藏主页，可以自己选哪些臻彩展示出来——相当于搭一个自己的臻彩小展厅，给别人看。</p></section>
    <figure><img src="/images/blog/what-are-prestige-chromas/profile.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Personal prestige chroma collection homepage" data-alt-zh="个人臻彩收藏主页" alt="个人收藏主页" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>个人收藏主页 — 个人资料与藏品展示</figcaption></figure>
    <section><p>收藏进度分三档，对应三款专属魄罗图标：臻彩爱好者、臻彩鉴赏师和臻彩收藏家。集得越多，图标越华丽。</p></section>
    <figure><img src="/images/blog/what-are-prestige-chromas/cover.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Prestige Chroma Collection interface in the League of Legends client" data-alt-zh="《英雄联盟》客户端中的臻彩藏馆界面" alt="臻彩藏馆界面" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>臻彩藏馆 — 客户端内界面</figcaption></figure>
    <section><p>藏馆里还有个"收藏排行"，能看到你所在服务器臻彩最多的玩家。榜单每小时刷新，收藏大佬之间互相卷。</p></section>
    <figure><img src="/images/blog/what-are-prestige-chromas/ranking.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Prestige Chroma Collection Ranking leaderboard" data-alt-zh="臻彩藏馆收藏排行 leaderboard" alt="收藏排行" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>收藏排行 — 服务器排行榜</figcaption></figure>

    <section><h2>获取方式</h2><h3>活动代币兑换</h3><p>新臻彩通常随限时活动上线。玩家通过对局获得活动代币，并在活动商店中兑换——一般需要约 2,000 代币。</p><h3>召唤活动</h3><p>"璀璨臻彩召唤"等活动提供抽取式获取途径，通常设有自选奖池并可能限时加入至臻皮肤作为特等奖。</p><h3>神话精粹兑换</h3><p>往期臻彩有机会通过神话商店使用神话精粹兑换。商店定期轮换，可兑换内容取决于当期轮换。</p><h3>收藏成就</h3><p>部分臻彩可以通过完成游戏内的皮肤收藏里程碑拿到，给肝到一定程度的收藏玩家一点奖励。</p></section>

    <section><h2>设计理念</h2><p>臻彩的设计大量借鉴了东方美学和国风元素。配色、纹样、插画都融入了传统文化，每款都有自己的辨识度，不是随便换个色就完事。</p><p>2026 年臻彩做了一次比较大的技术升级，插画质量和客户端展示都提了一档。本站把这些原画以最高分辨率收录进来，细节拉满。</p></section>

    <section><h2>文化内容与联动</h2><p>臻彩早就不只是换个皮肤了，现在也用来做文化表达和公益。比如"LPL 十大选手"系列，用专属原画致敬职业赛场上最有代表性的十位选手。</p></section>
    {lplChroma && <figure><img src={imageUrl(lplChroma.images.large)} data-fallback={sourceImageUrl('large', lplChroma.instanceId)} data-alt-en={`${lplChroma.nameEn} — ${lplChroma.nameZh} prestige chroma splash art`} data-alt-zh={`${lplChroma.nameZh} — ${lplChroma.nameEn} 臻彩原画`} data-placeholder="/placeholder.svg" alt={`${lplChroma.nameZh} 臻彩原画`} width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>{lplChroma.nameZh} · {lplChroma.nameEn}</figcaption></figure>}
    <section><p>公益方面也有动作。2025 年 11 月 5 日到 12 月 3 日，"蜀绣"、"青城山"、"火锅"三款熊猫娃娃拉克丝限定臻彩限时发售，收入全部捐给"匠心传承筑梦乡村"非遗公益项目，支持传统手工艺和乡村发展。</p></section>
    <div class="showcase showcase-row-3">{charityChromas.map((chroma) => <figure><img src={imageUrl(chroma.images.large)} data-fallback={sourceImageUrl('large', chroma.instanceId)} data-alt-en={`${chroma.nameEn} — ${chroma.nameZh} prestige chroma splash art`} data-alt-zh={`${chroma.nameZh} — ${chroma.nameEn} 臻彩原画`} data-placeholder="/placeholder.svg" alt={`${chroma.nameZh} 臻彩原画`} width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>{chroma.nameZh} · {chroma.nameEn}</figcaption></figure>)}</div>

    <section class="faq"><h2>常见问题解答</h2><details><summary>使用臻彩需要先拥有原皮肤吗？</summary><p>需要。臻彩必须在拥有对应原皮肤后才能使用。</p></details><details><summary>臻彩可以直接用点券购买吗？</summary><p>臻彩通常通过活动代币、召唤活动或神话精粹获取，而非直接点券购买。请关注当前活动或神话商店的可用选项。</p></details><details><summary>臻彩在全球都可以获得吗？</summary><p>获取范围因地区而异。部分臻彩面向所有服务器发布，另一些可能仅限于腾讯运营的中国服务器。请以所在地区的官方公告为准。</p></details><details><summary>臻彩和普通炫彩有什么区别？</summary><p>臻彩拥有专属原画、独特的客户端展示边框，部分还附带专属主题音乐；普通炫彩仅改变皮肤配色。</p></details><details><summary>往期的臻彩还会返场吗？</summary><p>部分往期臻彩会不定期进入神话商店轮换。并非所有历史臻彩都会返场，但已有先例表明部分臻彩会随时间回归。</p></details><details><summary>如何查看自己的收藏进度？</summary><p>在《英雄联盟》客户端中打开"臻彩藏馆"页面，即可查看已拥有的臻彩、插画以及专属魄罗图标的解锁进度。</p></details></section>
  </article>

  <style>
    .blog-breadcrumbs,.blog-article{width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2)));margin-inline:auto}.blog-breadcrumbs{display:flex;gap:9px;padding:28px 0 0;color:var(--muted);font-size:.84rem;white-space:nowrap;overflow-x:auto}.blog-article{padding:clamp(52px,8vw,90px) 0 110px}.article-header,.blog-article>section,.blog-article>figure,.showcase{width:100%;margin-inline:auto}.article-header{margin-bottom:42px}.article-header h1{font-family:Georgia,"Noto Serif SC",serif;font-size:clamp(2.7rem,6vw,5rem);line-height:1.05;font-weight:500;margin:.34em 0 .35em;overflow-wrap:anywhere}.article-deck{color:#c7cad4;font-size:clamp(1.05rem,2vw,1.25rem);line-height:1.7}.article-meta{display:flex;flex-wrap:wrap;gap:9px;color:var(--muted);font-size:.8rem}.blog-article section{margin-top:48px}.blog-article h2{font-family:Georgia,"Noto Serif SC",serif;color:var(--gold);font-size:clamp(1.65rem,3.3vw,2.25rem);line-height:1.2;margin:0 0 18px}.blog-article h3{color:#e4c880;font-size:1.12rem;margin:30px 0 8px}.blog-article section p{color:#c7cad4;font-size:1.06rem;line-height:1.9;margin:0 0 1.2em}.blog-article a{color:var(--gold);text-decoration:underline;text-underline-offset:3px}.blog-article figure{margin-top:42px}.blog-article figure img{display:block;width:100%;height:auto;object-fit:cover;border:1px solid var(--line);background:#15182a;box-shadow:0 22px 64px #0007}.blog-article figcaption{color:var(--muted);font-size:.78rem;line-height:1.6;margin-top:10px;overflow-wrap:anywhere}.showcase{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:42px}.showcase-row-3{grid-template-columns:repeat(3,minmax(0,1fr))}.showcase figure{width:auto;margin:0}.showcase img{aspect-ratio:1920/1080}.showcase figcaption{text-align:center}.faq details{border-top:1px solid var(--line);padding:16px 0}.faq details:last-child{border-bottom:1px solid var(--line)}.faq summary{color:#e6e8ee;font-weight:700;line-height:1.5;cursor:pointer}.faq details p{margin:12px 0 0}
    @media(max-width:767px){.blog-breadcrumbs{padding-top:18px}.blog-article{padding:42px 0 76px}.article-header{margin-bottom:28px}.article-header h1{font-size:clamp(2.35rem,12vw,3.4rem)}.blog-article section{margin-top:36px}.blog-article section p{font-size:1rem;line-height:1.78}.showcase{grid-template-columns:1fr;gap:26px;margin-top:32px}}
  </style>
</BaseLayout>
