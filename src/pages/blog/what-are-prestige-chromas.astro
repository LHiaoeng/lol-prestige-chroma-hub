---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogAdjacentNavigation from '../../components/BlogAdjacentNavigation.astro';
import { blogArticles, formatBlogDate } from '../../blog/articles';
import { catalog } from '../../data/catalog';
import { imageUrl, sourceImageUrl, type Chroma } from '../../domain/chroma';
import { CHINA_EXCLUSIVE_DEFINITION, SITE } from '../../seo/site';

const article = blogArticles.find((entry) => entry.slug === 'what-are-prestige-chromas');
if (!article) throw new Error('Prestige chroma article metadata is missing');
const title = `${article.titleEn} | ${SITE.name}`;
const description = article.summaryEn;
const canonical = `${SITE.origin}${article.href}`;
const showcase: Chroma[] = [
  catalog.find((c) => c.instanceId === '6abd93a6-2390-4e0a-934c-758b33a8ac5e'),
  catalog.find((c) => c.instanceId === 'bd3ce601-6d7a-402b-a76e-7a1d799702dd'),
  catalog.find((c) => c.instanceId === 'f5069942-3c9f-4cb3-8a67-299d9b1b7406'),
  catalog.find((c) => c.instanceId === '58cd810b-fa2e-4939-ac2a-0bae7e06f4fb'),
].filter((c): c is Chroma => c != null);
const designChroma = catalog.find((c) => c.instanceId === 'e26f28ec-534a-442a-b4be-3406116f93da');
const cultureChroma = catalog.find((c) => c.instanceId === '9c393600-64bc-402b-8b02-f57f3211d9c3');
if (!designChroma || !cultureChroma) throw new Error('Prestige chroma section artwork is missing');
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: article.titleEn,
    description, image: `${SITE.origin}${article.coverUrl}`, datePublished: article.publishedAt,
    dateModified: article.publishedAt, mainEntityOfPage: canonical,
    inLanguage: ['en', 'zh'], articleSection: 'League of Legends Guides',
    author: { '@type': 'Organization', name: SITE.name, url: `${SITE.origin}/` },
    publisher: { '@type': 'Organization', name: SITE.name, url: `${SITE.origin}/` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.origin}/blog/` },
      { '@type': 'ListItem', position: 3, name: article.titleEn, item: canonical },
    ],
  },
];
---
<BaseLayout {title} {description} {canonical} image={article.coverUrl} ogType="article" publishedTime={article.publishedAt} modifiedTime={article.publishedAt} {jsonLd}>
  <nav class="blog-breadcrumbs" aria-label="Breadcrumb" data-aria-en="Breadcrumb" data-aria-zh="面包屑">
    <a href="/" data-en="Home" data-zh="首页">Home</a><span>/</span><a href="/blog/" data-en="Blog" data-zh="博客">Blog</a><span>/</span><span aria-current="page" data-en="Prestige Chromas" data-zh="臻彩">Prestige Chromas</span>
  </nav>

  <article class="blog-article" data-language-content="en">
    <header class="article-header"><p class="kicker">LoL CHROMA ART ARCHIVE</p><h1>{article.titleEn}</h1><p class="article-deck">A concise guide to prestige chromas, their collection system, acquisition paths, artwork, and cultural themes in League of Legends.</p><p class="article-meta"><time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'en')}</time><span>·</span><span>{article.readingMinutes} min read</span></p></header>

    <section><h2>What are prestige chromas?</h2><p>Prestige chromas—also described as premium chromas in Chinese League of Legends materials—are a rare, limited type of chroma. They launched on January 13, 2023 alongside the Prestige Chroma Collection system.</p><p>A prestige chroma is attached to an existing skin rather than sold as a separate skin. You must own the corresponding base skin before you can use its prestige chroma.</p></section>

    <section><h2>The chroma art showcase</h2><p>Each prestige chroma in this archive has its own full-colour illustration, meant to be collected as art. Here are a few picks from the collection.</p></section>
    <div class="showcase">{showcase.map((chroma) => <figure><a class="chroma-art-link" href={`/chromas/${chroma.slug}/`} aria-label={`View ${chroma.nameEn} details`} data-aria-en={`View ${chroma.nameEn} details`} data-aria-zh={`查看 ${chroma.nameZh} 详情`}><img src={imageUrl(chroma.images.large)} data-fallback={sourceImageUrl('large', chroma.instanceId)} data-alt-en={`${chroma.nameEn} — prestige chroma splash art`} data-alt-zh={`${chroma.nameZh} — 臻彩原画`} data-placeholder="/placeholder.svg" alt={`${chroma.nameEn} prestige chroma`} width="1920" height="1080" loading="lazy" decoding="async" /></a><figcaption>{chroma.nameEn}</figcaption></figure>)}</div>

    <section><h2>What sets them apart</h2><p>Regular chromas mainly change a skin's colour palette. Prestige chromas go further by pairing the colour treatment with exclusive splash art, giving each release a stronger identity in the collection and in supported game interfaces.</p></section>

    <section><h2>The collection system</h2><p>The Prestige Chroma Collection system in the League client lets players view, organise, and share their prestige chroma collection. Each prestige chroma unlocks an illustration you can display and share.</p></section>
    <section><p>Players also get a personal collection homepage where they can pick which prestige chromas to show off — basically curating their own gallery for others to browse.</p></section>
    <figure><img src="/img/blog/prestige-chromas-profile.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Personal prestige chroma collection homepage" data-alt-zh="个人臻彩收藏主页" alt="Personal collection homepage" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>Personal collection homepage — profile and holdings</figcaption></figure>
    <section><p>Collection progress is tracked with three tiers of exclusive Poro icons: Prestige Enthusiast, Prestige Connoisseur, and Prestige Collector. Collect more, unlock fancier icons.</p></section>
    <figure><img src="/img/blog/prestige-chromas-cover.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Prestige Chroma Collection interface in the League of Legends client" data-alt-zh="《英雄联盟》客户端中的臻彩藏馆界面" alt="Prestige Chroma Collection interface" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>Prestige Chroma Collection — in-client interface</figcaption></figure>
    <section><p>There's also a Collection Ranking board showing the top collectors on your server, ranked by prestige chroma count. The leaderboard updates every hour — friendly competition between the most dedicated collectors.</p></section>
    <figure><img src="/img/blog/prestige-chromas-ranking.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Prestige Chroma Collection Ranking leaderboard" data-alt-zh="臻彩藏馆收藏排行 leaderboard" alt="Collection Ranking leaderboard" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>Collection Ranking — server leaderboard</figcaption></figure>

    <section><h2>How to obtain prestige chromas</h2><p>Prestige chromas are distributed through rotating, limited-time channels rather than one permanent store path. Exact pools, exchange costs, and schedules depend on the current event.</p><h3>Summoning events</h3><p>Brilliant Prestige Summoning and Splendid Treasure Summoning are two event formats that may include prestige chromas. Their rules and available rewards are announced separately for each run.</p><h3>Event token exchange</h3><p>Selected releases may be exchanged with event tokens earned during a limited-time event.</p><h3>Mythic Essence exchange</h3><p>Some prestige chromas may enter the rotating Mythic Shop and become exchangeable with Mythic Essence.</p><h3>Collection achievements</h3><p>Selected prestige chromas can also be awarded for completing in-game skin-collection achievements or reaching specified collection milestones.</p></section>
    <aside class="official-sources" aria-label="Official acquisition sources"><strong>Official acquisition sources</strong><ul><li><a class="official-source-link" href="https://lol.qq.com/act/a202607034771tendraws31/index.html" target="_blank" rel="noreferrer">Brilliant Prestige Summoning — July 2026</a></li><li><a class="official-source-link" href="https://lol.qq.com/act/a202606264151prizewheel/index.html" target="_blank" rel="noreferrer">Lucky Gate — June 26, 2026</a></li><li><a class="official-source-link" href="https://lol.qq.com/act/a202606117610prizewheel/index.html" target="_blank" rel="noreferrer">Lucky Gate — June 11, 2026</a></li></ul></aside>

    <section><h2>Design philosophy</h2><p>New prestige chromas continue to be released while existing series may receive visual or technical upgrades. Their designs often combine Eastern aesthetics with Chinese-inspired colours, motifs, materials, and decorative details. Some series also include dedicated theme music to extend the identity beyond the artwork itself.</p></section>
    <aside class="official-sources" aria-label="Official cultural sources"><strong>Official cultural sources</strong><ul><li><a class="official-source-link" href="https://www.bilibili.com/video/BV1EQF3z7ETt" target="_blank" rel="noreferrer">“Rushi Ge” — Bamboo and Plum Prestige Chroma theme song</a></li><li><a class="official-source-link" href="https://www.bilibili.com/video/BV1w5E96ME4h" target="_blank" rel="noreferrer">Dunhuang Prestige Chroma showcase</a></li></ul></aside>
    <figure><a class="chroma-art-link" href={`/chromas/${designChroma.slug}/`} aria-label={`View ${designChroma.nameEn} details`} data-aria-en={`View ${designChroma.nameEn} details`} data-aria-zh={`查看 ${designChroma.nameZh} 详情`}><img src={imageUrl(designChroma.images.large)} data-fallback={sourceImageUrl('large', designChroma.instanceId)} data-placeholder="/placeholder.svg" alt="Heavenscale Ezreal (Beacon) prestige chroma splash art" width="1920" height="1080" loading="lazy" decoding="async" /></a><figcaption>Heavenscale Ezreal (Beacon) — Eastern-inspired colour, motifs, and ornament</figcaption></figure>

    <section><h2>Cultural content and collaborations</h2><p>Some prestige chroma sales have supported charitable projects. League of Legends also released commemorative prestige chromas for the LPL tenth anniversary, connecting the collection with the history of China's professional league.</p></section>
    <aside class="official-sources" aria-label="Official collaboration sources"><strong>Official collaboration sources</strong><ul><li><a class="official-source-link" href="https://lol.qq.com/act/a2023lpl10celebration2s/index.html?pos=2" target="_blank" rel="noreferrer">LPL 10th Anniversary commemorative Prestige Chromas</a></li><li><a class="official-source-link" href="https://lol.qq.com/news/space-detail.shtml?docid=2507283551738806898" target="_blank" rel="noreferrer">Panda Lux Prestige Chroma charity project</a></li></ul></aside>
    <figure><a class="chroma-art-link" href={`/chromas/${cultureChroma.slug}/`} aria-label={`View ${cultureChroma.nameEn} details`} data-aria-en={`View ${cultureChroma.nameEn} details`} data-aria-zh={`查看 ${cultureChroma.nameZh} 详情`}><img src={imageUrl(cultureChroma.images.large)} data-fallback={sourceImageUrl('large', cultureChroma.instanceId)} data-placeholder="/placeholder.svg" alt="Soulstealer Vayne (First Decennial) prestige chroma splash art" width="1920" height="1080" loading="lazy" decoding="async" /></a><figcaption>Soulstealer Vayne (First Decennial) — commemorative prestige chroma</figcaption></figure>

    <section class="faq"><h2>FAQ</h2><details><summary>Do I need the base skin to use a prestige chroma?</summary><p>Yes. A prestige chroma requires ownership of the corresponding base skin before it can be applied.</p></details><details><summary>Can prestige chromas be purchased directly with RP?</summary><p>Prestige chromas are typically obtained through event tokens, summoning events, or Mythic Essence rather than direct RP purchase. Check the current event or Mythic Shop for available options.</p></details><details><summary>What does “China Exclusive” mean here?</summary><p>{CHINA_EXCLUSIVE_DEFINITION.en} The chroma itself may also be available in other regions; acquisition varies by region, event, and patch.</p></details><details><summary>What makes prestige chromas different from regular chromas?</summary><p>Prestige chromas include exclusive splash art displayed in champion select and the loading screen.</p></details><details><summary>Will older prestige chromas come back?</summary><p>Some older prestige chromas rotate into the Mythic Shop periodically. There is no guarantee for every past chroma, but the pattern suggests select returns over time.</p></details><details><summary>How can I track my collection progress?</summary><p>Open the Prestige Chroma Collection page in the League client to view your holdings, illustrations, and progress toward exclusive Poro icon rewards.</p></details></section>
  </article>

  <article class="blog-article" data-language-content="zh">
    <header class="article-header"><p class="kicker">LoL CHROMA ART 图鉴</p><h1>{article.titleZh}</h1><p class="article-deck">简要介绍臻彩的定位、藏馆系统、获取方式、专属原画与文化特色。</p><p class="article-meta"><time datetime={article.publishedAt}>{formatBlogDate(article.publishedAt, 'zh')}</time><span>·</span><span>阅读约 {article.readingMinutes} 分钟</span></p></header>

    <section><h2>什么是臻彩？</h2><p>臻彩在《英雄联盟》中又称“臻品炫彩”，是一种珍稀、限时开放的炫彩类型，于 2023 年 1 月 13 日随“臻彩藏馆”系统上线。</p><p>臻彩依附于已有皮肤，并不是一款独立皮肤。使用臻彩前，需要先拥有对应的原皮肤。</p></section>

    <section><h2>臻彩原画展示</h2><p>图鉴里每款臻彩都有自己的全彩插画，值得收藏。下面挑了几张看看。</p></section>
    <div class="showcase">{showcase.map((chroma) => <figure><a class="chroma-art-link" href={`/chromas/${chroma.slug}/`} aria-label={`查看 ${chroma.nameZh} 详情`} data-aria-en={`View ${chroma.nameEn} details`} data-aria-zh={`查看 ${chroma.nameZh} 详情`}><img src={imageUrl(chroma.images.large)} data-fallback={sourceImageUrl('large', chroma.instanceId)} data-alt-en={`${chroma.nameEn} — prestige chroma splash art`} data-alt-zh={`${chroma.nameZh} — 臻彩原画`} data-placeholder="/placeholder.svg" alt={`${chroma.nameZh} 臻彩原画`} width="1920" height="1080" loading="lazy" decoding="async" /></a><figcaption>{chroma.nameZh}</figcaption></figure>)}</div>

    <section><h2>与普通炫彩的区别</h2><p>普通炫彩主要改变皮肤的配色；臻彩在配色之外还拥有专属原画，在藏馆及支持的游戏界面中形成更完整的收藏展示。</p></section>

    <section><h2>臻彩藏馆系统</h2><p>臻彩藏馆系统在客户端里就能打开，用来查看、整理和分享你的臻彩收藏。每拿到一款臻彩，就解锁一张插画，可以展示和分享。</p></section>
    <section><p>每个玩家还有自己的收藏主页，可以自己选哪些臻彩展示出来——相当于搭一个自己的臻彩小展厅，给别人看。</p></section>
    <figure><img src="/img/blog/prestige-chromas-profile.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Personal prestige chroma collection homepage" data-alt-zh="个人臻彩收藏主页" alt="个人收藏主页" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>个人收藏主页 — 个人资料与藏品展示</figcaption></figure>
    <section><p>收藏进度分三档，对应三款专属魄罗图标：臻彩爱好者、臻彩鉴赏师和臻彩收藏家。集得越多，图标越华丽。</p></section>
    <figure><img src="/img/blog/prestige-chromas-cover.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Prestige Chroma Collection interface in the League of Legends client" data-alt-zh="《英雄联盟》客户端中的臻彩藏馆界面" alt="臻彩藏馆界面" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>臻彩藏馆 — 客户端内界面</figcaption></figure>
    <section><p>藏馆里还有个"收藏排行"，能看到你所在服务器臻彩最多的玩家。榜单每小时刷新，收藏大佬之间互相卷。</p></section>
    <figure><img src="/img/blog/prestige-chromas-ranking.png" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" data-alt-en="Prestige Chroma Collection Ranking leaderboard" data-alt-zh="臻彩藏馆收藏排行 leaderboard" alt="收藏排行" width="1920" height="1080" loading="lazy" decoding="async" /><figcaption>收藏排行 — 服务器排行榜</figcaption></figure>

    <section><h2>获取方式</h2><p>臻彩通常通过定期开放的限时渠道获取，并没有固定不变的商城入口。具体奖池、兑换数量和开放时间以当期活动说明为准。</p><h3>召唤活动</h3><p>“璀璨臻彩召唤”和“华彩秘宝·召唤”等活动可能提供臻彩，活动规则与可获取内容会在每期开放前单独公布。</p><h3>活动代币兑换</h3><p>部分新臻彩会随限时活动上线，玩家可以使用当期活动代币兑换。</p><h3>神话精粹兑换</h3><p>部分臻彩可能进入轮换的神话商店，开放期间可以使用神话精粹兑换。</p><h3>收藏成就</h3><p>部分臻彩也会作为游戏内“皮肤收藏”成就或指定收藏里程碑的奖励。</p></section>
    <aside class="official-sources" aria-label="官方获取来源"><strong>官方获取来源</strong><ul><li><a class="official-source-link" href="https://lol.qq.com/act/a202607034771tendraws31/index.html" target="_blank" rel="noreferrer">璀璨臻彩召唤 — 2026 年 7 月</a></li><li><a class="official-source-link" href="https://lol.qq.com/act/a202606264151prizewheel/index.html" target="_blank" rel="noreferrer">幸运之门 — 2026 年 6 月 26 日</a></li><li><a class="official-source-link" href="https://lol.qq.com/act/a202606117610prizewheel/index.html" target="_blank" rel="noreferrer">幸运之门 — 2026 年 6 月 11 日</a></li></ul></aside>

    <section><h2>设计理念</h2><p>官方会持续推出新臻彩，也会对已有系列进行视觉或技术升级。臻彩的设计广泛融合东方美学与国风元素，通过色彩、纹样、材质和装饰细节形成鲜明主题；部分系列还拥有专属主题音乐。</p></section>
    <aside class="official-sources" aria-label="官方文化来源"><strong>官方文化来源</strong><ul><li><a class="official-source-link" href="https://www.bilibili.com/video/BV1EQF3z7ETt" target="_blank" rel="noreferrer">《如是歌》— 竹映梅香臻彩系列主题曲</a></li><li><a class="official-source-link" href="https://www.bilibili.com/video/BV1w5E96ME4h" target="_blank" rel="noreferrer">敦煌臻彩展示片</a></li></ul></aside>
    <figure><a class="chroma-art-link" href={`/chromas/${designChroma.slug}/`} aria-label={`查看 ${designChroma.nameZh} 详情`} data-aria-en={`View ${designChroma.nameEn} details`} data-aria-zh={`查看 ${designChroma.nameZh} 详情`}><img src={imageUrl(designChroma.images.large)} data-fallback={sourceImageUrl('large', designChroma.instanceId)} data-placeholder="/placeholder.svg" alt="天龙之子 伊泽瑞尔 飞天臻彩原画" width="1920" height="1080" loading="lazy" decoding="async" /></a><figcaption>天龙之子 伊泽瑞尔 飞天 — 东方配色、纹样与装饰细节</figcaption></figure>

    <section><h2>文化内容与合作</h2><p>部分臻彩的销售收益会用于公益项目。为纪念 LPL 十周年，《英雄联盟》还推出了 LPL 纪念臻彩，将这套收藏内容与中国职业联赛的重要节点联系起来。</p></section>
    <aside class="official-sources" aria-label="官方合作来源"><strong>官方合作来源</strong><ul><li><a class="official-source-link" href="https://lol.qq.com/act/a2023lpl10celebration2s/index.html?pos=2" target="_blank" rel="noreferrer">LPL 十周年纪念臻彩</a></li><li><a class="official-source-link" href="https://lol.qq.com/news/space-detail.shtml?docid=2507283551738806898" target="_blank" rel="noreferrer">熊猫拉克丝臻彩公益项目</a></li></ul></aside>
    <figure><a class="chroma-art-link" href={`/chromas/${cultureChroma.slug}/`} aria-label={`查看 ${cultureChroma.nameZh} 详情`} data-aria-en={`View ${cultureChroma.nameEn} details`} data-aria-zh={`查看 ${cultureChroma.nameZh} 详情`}><img src={imageUrl(cultureChroma.images.large)} data-fallback={sourceImageUrl('large', cultureChroma.instanceId)} data-placeholder="/placeholder.svg" alt="无畏竞巅峰 薇恩臻彩原画" width="1920" height="1080" loading="lazy" decoding="async" /></a><figcaption>无畏竞巅峰 薇恩 — LPL 十周年纪念臻彩</figcaption></figure>

    <section class="faq"><h2>常见问题解答</h2><details><summary>使用臻彩需要先拥有原皮肤吗？</summary><p>需要。臻彩必须在拥有对应原皮肤后才能使用。</p></details><details><summary>臻彩可以直接用点券购买吗？</summary><p>臻彩通常通过活动代币、召唤活动或神话精粹获取，而非直接点券购买。请关注当前活动或神话商店的可用选项。</p></details><details><summary>这里的“中国服专属”是什么意思？</summary><p>{CHINA_EXCLUSIVE_DEFINITION.zh} 炫彩本身也可能在其他地区提供；具体获取范围会随地区、活动和版本变化。</p></details><details><summary>臻彩和普通炫彩有什么区别？</summary><p>每款臻彩都有专属原画，在选英雄和载入界面中展示；普通炫彩仅改变皮肤配色。</p></details><details><summary>往期的臻彩还会返场吗？</summary><p>部分往期臻彩会不定期进入神话商店轮换。并非所有历史臻彩都会返场，但已有先例表明部分臻彩会随时间回归。</p></details><details><summary>如何查看自己的收藏进度？</summary><p>在《英雄联盟》客户端中打开"臻彩藏馆"页面，即可查看已拥有的臻彩、插画以及专属魄罗图标的解锁进度。</p></details></section>
  </article>

  <BlogAdjacentNavigation currentSlug={article.slug} />

  <style>
