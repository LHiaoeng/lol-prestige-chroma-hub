---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RuntimeReferenceRoot from '../../components/RuntimeReferenceRoot.astro';
import { resolveLocale, type Locale } from '../../i18n/config';
import { createEntitySeo } from '../../seo/entity-seo';

const locale = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) as Locale;
const isZh = locale === 'zh-cn';
const seo = createEntitySeo('champions', undefined, isZh ? '英雄资料' : 'Champion references', isZh ? '在浏览器中读取 CommunityDragon 英雄资料，并按语言与数据通道保持独立。' : 'Browse CommunityDragon champion references in the browser with independent locale and data-channel views.', locale);
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} jsonLd={seo.jsonLd} noindex {locale}>
  <RuntimeReferenceRoot page="champions" {locale} label={isZh ? '英雄' : 'Champions'} heading={isZh ? '英雄资料' : 'Champion references'} lede={isZh ? '列表、英雄详情和皮肤正向集合会在浏览器中加载；CommunityDragon 暂时不可用时保留明确失败状态。' : 'Lists, champion details, and forward skin collections load in the browser; source failures remain explicit and retryable.'} />
</BaseLayout>
