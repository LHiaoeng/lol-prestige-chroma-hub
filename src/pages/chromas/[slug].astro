---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ChromaColorCircle from '../../components/ChromaColorCircle.astro';
import Divider from '../../components/Divider.astro';
import DomainIcon from '../../components/DomainIcon.astro';
import RuntimeDetailSummary from '../../components/RuntimeDetailSummary.astro';
import Dropdown from '../../components/Dropdown.astro';
import ExpandableChromaGroup from '../../components/ExpandableChromaGroup.astro';
import ImageViewer from '../../components/ImageViewer.astro';
import { catalog } from '../../data/catalog';
import { imageUrl, sourceImageUrl } from '../../domain/chroma';
import { googleSearchUrl, khadaModelUrl, patchNotesUrl, skinSpotlightsSearchUrl } from '../../domain/detail-actions';
import { findRelatedGroups } from '../../domain/related';
import { brilliantSummonSessions } from '../../domain/brilliant-summon';
import { categoryName } from '../../i18n';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { createChromaSeo } from '../../seo/chroma-seo';
import { formatRuntimeUrl, readRuntimeUrlState } from '../../domain/runtime-url-state';

export async function getStaticPaths() {
  return catalog.flatMap((chroma) => [chroma.slug, String(chroma.skinId)]
    .map((slug) => ({
      params: { slug },
      props: { chroma },
    })));
}
interface Props { chroma: typeof catalog[number]; locale?: Locale }
const { chroma } = Astro.props;
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const runtimeUrlState = readRuntimeUrlState(Astro.url);
const runtimeChannel = runtimeUrlState.channel;
const runtimePath = (
  path: string,
  state: { readonly id?: number; readonly champion?: number },
  include: readonly ('id' | 'champion' | 'channel')[],
) => {
  const target = new URL(localizedPath(locale, path), Astro.url);
  const formatted = formatRuntimeUrl(target, {
    ...state,
    channel: runtimeChannel,
    channelExplicit: runtimeUrlState.channelExplicit,
  }, include);
  return `${formatted.pathname}${formatted.search}`;
};
const sourceSkinPath = runtimePath('/skins/detail/', { id: Number(chroma.sourceSkinId), champion: Number(chroma.heroId) }, ['id', 'champion', 'channel']);
const skinlinePath = (id: number) => runtimePath('/skinlines/detail/', { id }, ['id', 'channel']);
const universePath = (id: number) => runtimePath('/universes/detail/', { id }, ['id', 'channel']);
const seo = createChromaSeo(chroma, locale);
const image = seo.image;
const categoryLabel = categoryName(chroma.categoryId, isZh ? 'zh' : 'en');
const mediumImage = imageUrl(chroma.images.medium);
const relatedGroups = findRelatedGroups(catalog, chroma);
const relatedGroupIcons = { hero: 'champions', skinSet: 'skinlines', universe: 'universes', version: 'game-version' } as const;
const prestigeChromaKeyword = chroma.nameEn;
const actionLabels = {
  skinSpotlights: { labelEn: 'VIEW ON SKINSPOTLIGHTS', labelZh: '在 SKINSPOTLIGHTS 查看' },
  khada: { labelEn: 'VIEW 3D MODEL ON KHADA', labelZh: '在 KHADA 查看 3D 模型' },
  google: { labelEn: 'GOOGLE SEARCH', labelZh: '谷歌搜索' },
};
const prestigeChromaActions = [
  { ...actionLabels.skinSpotlights, href: skinSpotlightsSearchUrl(prestigeChromaKeyword) },
  { ...actionLabels.khada, href: khadaModelUrl(chroma.sourceSkinId, chroma.skinId) },
  { ...actionLabels.google, href: googleSearchUrl(prestigeChromaKeyword) },
];
const isSummonGuideChroma = brilliantSummonSessions.some((session) => session.rewards.some((reward) => reward.chromaNameEn === chroma.nameEn));
const summonGuideUrl = localizedPath(locale, '/blog/brilliant-prestige-chroma-summoning-guide/');
const championRuntimeUrl = runtimePath('/champions/detail/', { id: Number(chroma.heroId) }, ['id', 'channel']);
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} jsonLd={seo.jsonLd} {locale}>
  <div class="page-backdrop page-backdrop--behind page-backdrop--detail detail-background" aria-hidden="true">
    <picture>
      <source media="(max-width: 767px)" srcset={mediumImage} data-fallback={sourceImageUrl('medium', chroma.instanceId)} />
      <img src={image} data-fallback={sourceImageUrl('large', chroma.instanceId)} data-placeholder="/placeholder.svg" alt="" width="1920" height="1080" loading="eager" decoding="async" />
    </picture>
  </div>
  <Breadcrumb {locale} items={[
    { title: isZh ? '首页' : 'Home', href: localizedPath(locale, '/') },
    { title: isZh ? '英雄联盟' : 'League of Legends', href: localizedPath(locale, '/#home-tools-title') },
    { title: isZh ? '臻彩原画' : 'Prestige chromas', href: localizedPath(locale, '/#prestige-chroma-gallery') },
    { title: isZh ? chroma.nameZh : chroma.nameEn },
  ]} />
  <article class="detail runtime-detail runtime-detail--entity chroma-detail">
    <div class="detail-title-row"><h1 class="detail-display-title"><ChromaColorCircle colors={chroma.colors} />{isZh ? chroma.nameZh : chroma.nameEn}</h1></div>
    {(isZh ? chroma.descriptionZh : chroma.descriptionEn) && <p class="detail-lede">{isZh ? chroma.descriptionZh : chroma.descriptionEn}</p>}
    <div class="detail-summary">
      <RuntimeDetailSummary locale={locale} kind="chroma"><dl>
        <div><dt class="sr-only">{isZh ? '分类' : 'Category'}</dt><dd><span class="detail-summary-item"><DomainIcon name="prestige-chromas" tooltipDetail={categoryLabel} {locale} /><span class="detail-category-name" data-category-icon={sourceImageUrl('tag', chroma.tagId)}>{categoryLabel}</span></span></dd></div>
        <div><dt class="sr-only">{isZh ? '英雄' : 'Champion'}</dt><dd><Divider type="vertical" /><span class="detail-summary-item"><DomainIcon name="champions" tooltipDetail={isZh ? chroma.heroNameZh : chroma.heroNameEn} {locale} /><a class="runtime-entity-relation-link" data-runtime-channel-link href={championRuntimeUrl}>{isZh ? chroma.heroNameZh : chroma.heroNameEn}</a></span></dd></div>
        {chroma.skinSets.length > 0 && <div><dt class="sr-only">{isZh ? '皮肤系列' : 'Skinlines'}</dt><dd><Divider type="vertical" /><span class="detail-summary-item"><DomainIcon name="skinlines" tooltipDetail={chroma.skinSets.map((item) => isZh ? item.nameZh : item.nameEn).join(isZh ? '、' : ', ')} {locale} /><span class="detail-related-links">{chroma.skinSets.map((item, index) => <><a class="runtime-entity-relation-link" data-runtime-channel-link href={skinlinePath(item.id)}>{isZh ? item.nameZh : item.nameEn}</a>{index < chroma.skinSets.length - 1 ? (isZh ? '、' : ', ') : ''}</>)}</span></span></dd></div>}
        {chroma.universes.length > 0 && <div><dt class="sr-only">{isZh ? '皮肤宇宙' : 'Universes'}</dt><dd><Divider type="vertical" /><span class="detail-summary-item"><DomainIcon name="universes" tooltipDetail={chroma.universes.map((item) => isZh ? item.nameZh : item.nameEn).join(isZh ? '、' : ', ')} {locale} /><span class="detail-related-links">{chroma.universes.map((item, index) => <><a class="runtime-entity-relation-link" data-runtime-channel-link href={universePath(item.id)}>{isZh ? item.nameZh : item.nameEn}</a>{index < chroma.universes.length - 1 ? (isZh ? '、' : ', ') : ''}</>)}</span></span></dd></div>}
        <div><dt class="sr-only">{isZh ? '所属皮肤' : 'Chroma parent skin'}</dt><dd><Divider type="vertical" /><span class="detail-summary-item"><DomainIcon name="skins" tooltipDetail={isZh ? chroma.skinNameZh : chroma.skinNameEn} {locale} /><a class="runtime-entity-relation-link" data-runtime-channel-link href={sourceSkinPath}>{isZh ? chroma.skinNameZh : chroma.skinNameEn}</a></span></dd></div>
        <div><dt class="sr-only">{isZh ? '游戏版本' : 'Patch'}</dt><dd><Divider type="vertical" /><span class="detail-summary-item"><DomainIcon name="game-version" tooltipDetail={chroma.gameVer} {locale} /><a class="runtime-entity-relation-link" href={patchNotesUrl(chroma.gameVer)} target="_blank" rel="noopener noreferrer" aria-label={isZh ? `查看 ${chroma.gameVer} 版本公告` : `View patch ${chroma.gameVer} notes`}>{chroma.gameVer}</a></span></dd></div>
        <div><dt class="sr-only">{isZh ? '更多' : 'More'}</dt><dd><Divider type="vertical" /><div class="runtime-skin-actions-summary">
          <Dropdown id="chroma-actions-menu" placement="bottomRight">
            <span slot="trigger"><svg class="runtime-channel-icon" data-summary-icon-tooltip={isZh ? '摘要扩展内容' : 'Summary actions'} aria-hidden="true" viewBox="0 0 24 24"><path d="M3 8h18v13H3zM8 8V5h8v3M3 12h18M10 12v2h4v-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg><span>{isZh ? '更多' : 'More'}</span><svg class="runtime-channel-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></span>
            {prestigeChromaActions.map((action) => <li role="none"><a role="menuitem" data-ant-dropdown-item href={action.href} target="_blank" rel="noopener noreferrer" aria-label={isZh ? action.labelZh : action.labelEn}>{isZh ? action.labelZh : action.labelEn}</a></li>)}
          </Dropdown>
        </div></dd></div>
      </dl></RuntimeDetailSummary>
    </div>
    <Divider class="runtime-entity-detail-divider" />
    <section class="detail-artwork-section">
      <h2><DomainIcon name="prestige-chromas" />{isZh ? '臻彩原画' : 'Chroma artwork'}</h2>
      <div class="detail-media">
        <div class="detail-image">
          <ImageViewer src={image} fallback={sourceImageUrl('large', chroma.instanceId)} altEn={seo.imageAlt} altZh={seo.imageAlt} {locale} />
        </div>
      </div>
    </section>
    {isSummonGuideChroma && <p class="detail-context-link"><a href={summonGuideUrl}>{isZh ? '阅读璀璨臻彩召唤完全指南' : 'Read the complete Brilliant Prestige Chroma Summoning guide'}</a></p>}
  </article>
  {relatedGroups.length > 0 && (
    <section class="related detail-related">
      {relatedGroups.map((group) => (
        <>
          <Divider class="detail-module-divider" />
          <ExpandableChromaGroup
            titleEn={group.titleEn}
            titleZh={group.titleZh}
            icon={relatedGroupIcons[group.kind]}
            chromas={group.chromas}
            {locale}
          />
        </>
      ))}
    </section>
  )}
</BaseLayout>
<script>
  import { createTooltip } from '../../components/tooltip';
  import { bindRuntimeChannelLinks, bindRuntimeLanguageToggle } from '../../client/runtime-url-state-dom';
  document.querySelectorAll<HTMLElement>('.detail-category-name[data-category-icon]').forEach((trigger) => {
    const parent = trigger.parentElement!;
    const next = trigger.nextSibling;
    const icon = document.createElement('img');
    icon.src = trigger.dataset.categoryIcon!;
    icon.alt = '';
    icon.className = 'category-icon-tooltip-image';
    const tooltipTrigger = createTooltip(trigger, icon);
    parent.insertBefore(tooltipTrigger, next);
  });
  bindRuntimeLanguageToggle(document);
  bindRuntimeChannelLinks(document);
</script>
<style>
  :global(main){position:relative;isolation:isolate}
  .detail{grid-template-columns:minmax(0,1fr);align-items:stretch;gap:var(--space-3);padding-bottom:0}
  .detail-media{min-width:0}
  .detail-title-row{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:16px;min-width:0}
  .detail-display-title{display:flex;flex:1;align-items:center;gap:8px;min-width:0;margin:0;color:var(--gold);font-family:var(--font-ui);font-size:var(--font-size-display);line-height:var(--line-height-display);font-weight:600;overflow-wrap:anywhere}
  .detail-display-title :global(.color-wrap),.detail-display-title :global(.color-circle){width:1em;height:1em;flex:0 0 1em}
  .detail-category-name{cursor:help}
  :global(.category-icon-tooltip-image){display:block;width:auto;height:auto;max-width:min(240px,calc(100vw - (var(--page-gutter) * 2)));max-height:min(240px,65vh);object-fit:contain}
  .detail-lede{grid-column:1/-1;margin:0;color:var(--muted);line-height:1.7}
  .detail-summary{grid-column:1/-1}
  .detail-summary :global(dl){display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:0;border:0;color:var(--gold);font-size:var(--font-size-title);line-height:var(--line-height-title)}
  .detail-summary :global(dl>div){display:flex;align-items:center;gap:0;padding:0;border:0}
  .detail-summary :global(dt){color:var(--muted);font-size:var(--font-size-small)}
  .detail-summary :global(dd){display:inline-flex;align-items:center;gap:8px;margin:0;color:var(--gold)}
  .detail-summary :global(.ant-divider-vertical){margin-inline:0;font-size:inherit}
  .detail-summary :global(.domain-icon){width:1em;height:1em;flex:0 0 auto}
  .detail-summary :global(.detail-summary-item){display:inline-flex;min-width:0;min-height:var(--control-height);align-items:center;gap:8px;overflow-wrap:anywhere}
  .detail-summary :global(.runtime-skin-actions-summary){display:inline-flex;align-items:center;gap:8px}
  .detail-artwork-section{display:grid;grid-column:1/-1;min-width:0;gap:var(--space-3)}
  .detail-artwork-section h2,.detail-related :global(.section-heading h2){display:flex;align-items:center;gap:var(--space-2);margin:0;color:var(--gold);font-size:var(--font-size-headline-sm);line-height:var(--line-height-headline-sm);font-weight:600}
  .detail-artwork-section h2 :global(.domain-icon),.detail-related :global(.section-heading h2 .domain-icon){width:1em;height:1em;flex:0 0 auto}
  .detail-image{height:auto;aspect-ratio:auto;padding:0;border-radius:var(--radius-card);background:var(--panel2);box-shadow:none}
  .detail-image :global(.image-viewer),.detail-image :global(.viewer-trigger),.detail-image :global(.viewer-trigger picture){height:auto}
  .detail-image :global(.viewer-image){height:auto;aspect-ratio:16/9;object-fit:contain}
  .detail-related{padding:0 0 96px}
  .detail-related :global(.detail-module-divider){margin:var(--space-4) 0}
  .detail-related :global(.related-group){margin:0}
  .detail-related :global(.section-heading){align-items:center;margin-bottom:var(--space-3)}
  .detail-context-link{margin:16px 0 0;color:var(--muted);font-size:var(--font-size-body);line-height:1.6;text-align:center}.detail-context-link a{color:var(--gold);text-decoration:underline;text-underline-offset:3px}
  :global(.detail-related-links){line-height:1.7}
  @media(max-width:767px){
    .detail{width:min(var(--content-width),calc(100% - (var(--page-gutter) * 2)));padding-bottom:0}
    .detail-title-row{align-items:flex-start}
    .detail-related{padding:24px 0 72px}
  }
</style>
