---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChromaCard from '../../components/ChromaCard.astro';
import ChromaColorCircle from '../../components/ChromaColorCircle.astro';
import CategoryIconPreview from '../../components/CategoryIconPreview.astro';
import DetailActionMenu from '../../components/DetailActionMenu.astro';
import ImageViewer from '../../components/ImageViewer.astro';
import { catalog } from '../../data/catalog';
import { imageUrl, sourceImageUrl } from '../../domain/chroma';
import { googleSearchUrl, khadaChampionUrl, khadaModelUrl, patchNotesUrl, skinSpotlightsSearchUrl } from '../../domain/detail-actions';
import { findRelatedChromas } from '../../domain/related';
import { categoryName } from '../../i18n';

export function getStaticPaths() {
  return catalog.flatMap((chroma) => [chroma.slug, String(chroma.skinId)]
    .map((slug) => ({ params: { slug }, props: { chroma } })));
}
const { chroma } = Astro.props;
const canonical = `https://chromaart.lol/chromas/${chroma.slug}/`;
const image = imageUrl(chroma.images.large);
const description = chroma.descriptionEn
  ?? `View high-resolution splash art and patch ${chroma.gameVer} details for ${chroma.nameEn}, a ${chroma.heroNameEn} prestige chroma.`;
const related = findRelatedChromas(catalog, chroma);
const skinSetsEn = chroma.skinSets.map((item) => item.nameEn).join(', ');
const skinSetsZh = chroma.skinSets.map((item) => item.nameZh).join('、');
const universesEn = chroma.universes.map((item) => item.nameEn).join(', ');
const universesZh = chroma.universes.map((item) => item.nameZh).join('、');
const prestigeChromaKeyword = chroma.nameEn;
const baseSkinKeyword = chroma.skinNameEn;
const prestigeChromaActions = [
  { label: 'VIEW ON SKINSPOTLIGHTS', href: skinSpotlightsSearchUrl(prestigeChromaKeyword) },
  { label: 'VIEW 3D MODEL ON KHADA', href: khadaModelUrl(chroma.sourceSkinId, chroma.skinId) },
  { label: 'GOOGLE SEARCH', href: googleSearchUrl(prestigeChromaKeyword) },
];
const baseSkinActions = [
  { label: 'VIEW ON SKINSPOTLIGHTS', href: skinSpotlightsSearchUrl(baseSkinKeyword) },
  { label: 'VIEW 3D MODEL ON KHADA', href: khadaModelUrl(chroma.sourceSkinId) },
  { label: 'GOOGLE SEARCH', href: googleSearchUrl(baseSkinKeyword) },
];
const championActions = [
  { label: 'VIEW ON SKINSPOTLIGHTS', href: skinSpotlightsSearchUrl(chroma.heroNameEn) },
  { label: 'VIEW 3D MODEL ON KHADA', href: khadaChampionUrl(chroma.heroId) },
  { label: 'GOOGLE SEARCH', href: googleSearchUrl(chroma.heroNameEn) },
];
const skinlineActions = [
  { label: 'GOOGLE SEARCH', href: googleSearchUrl(`${skinSetsEn} Skinlines`) },
];
const universeActions = [
  { label: 'GOOGLE SEARCH', href: googleSearchUrl(`${universesEn} Universes`) },
];
const patchActions = [
  { label: 'VIEW PATCH NOTES', href: patchNotesUrl(chroma.gameVer) },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'ImageObject', name: chroma.nameEn, contentUrl: image, description },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chromaart.lol/' },
    { '@type': 'ListItem', position: 2, name: chroma.skinNameEn },
    { '@type': 'ListItem', position: 3, name: chroma.nameEn, item: canonical },
  ] },
];
---
<BaseLayout title={`${chroma.nameEn} · ${chroma.heroNameEn} | Chroma Art`} {description} {canonical} {image} {jsonLd}>
  <nav class="breadcrumbs" aria-label="Breadcrumb" data-aria-en="Breadcrumb" data-aria-zh="面包屑"><a href="/" data-en="Home" data-zh="首页">Home</a><span>/</span><span data-en={chroma.skinNameEn} data-zh={chroma.skinNameZh}>{chroma.skinNameEn}</span><span>/</span><span aria-current="page" data-en={chroma.nameEn} data-zh={chroma.nameZh}>{chroma.nameEn}</span></nav>
  <article class="detail">
    <h1 class="sr-only detail-accessible-title" data-en={chroma.nameEn} data-zh={chroma.nameZh}>{chroma.nameEn}</h1>
    <div class="detail-image">
      <ImageViewer src={image} fallback={sourceImageUrl('large', chroma.instanceId)} altEn={`${chroma.heroNameEn} ${chroma.nameEn} prestige chroma splash art`} altZh={`${chroma.heroNameZh} ${chroma.nameZh} 高清原画`} />
      <div class="detail-poster-copy" aria-hidden="true">
        <p class="eyebrow">PRESTIGE CHROMA</p>
        <p class="detail-poster-title" data-en={chroma.nameEn} data-zh={chroma.nameZh}>{chroma.nameEn}</p>
        <div class="detail-poster-tags">
          <span data-en={categoryName(chroma.categoryId, 'en')} data-zh={categoryName(chroma.categoryId, 'zh')}>{categoryName(chroma.categoryId, 'en')}</span>
          <span data-en={chroma.heroNameEn} data-zh={chroma.heroNameZh}>{chroma.heroNameEn}</span>
          <span>{chroma.gameVer}</span>
        </div>
      </div>
    </div>
    <div class="detail-copy">
      <details class="detail-info-disclosure" open>
      <summary><span data-en="Details" data-zh="详细资料">Details</span><span class="detail-info-icon" aria-hidden="true">＋</span></summary>
      <div class="detail-info-body">
      <div class="detail-title-row"><p class="detail-display-title" data-en={chroma.nameEn} data-zh={chroma.nameZh} aria-hidden="true">{chroma.nameEn}</p><DetailActionMenu actions={prestigeChromaActions} /></div>
      <dl>
        <div><dt data-en="Category" data-zh="分类">Category</dt><dd data-en={categoryName(chroma.categoryId, 'en')} data-zh={categoryName(chroma.categoryId, 'zh')}>{categoryName(chroma.categoryId, 'en')}</dd></div>
        <div><dt data-en="Category icon" data-zh="分类图标">Category icon</dt><dd><CategoryIconPreview src={sourceImageUrl('tag', chroma.tagId)} /></dd></div>
        {chroma.colors.length > 0 && <div><dt data-en="Colors" data-zh="颜色">Colors</dt><dd><ChromaColorCircle colors={chroma.colors} /></dd></div>}
        {chroma.descriptionEn && <div class="description-row" data-language-content="en"><dt>Description</dt><dd>{chroma.descriptionEn}</dd></div>}
        {chroma.descriptionZh && <div class="description-row" data-language-content="zh"><dt>描述</dt><dd>{chroma.descriptionZh}</dd></div>}
        <div><dt data-en="Base skin" data-zh="原皮">Base skin</dt><dd class="detail-value-with-actions"><span data-en={chroma.skinNameEn} data-zh={chroma.skinNameZh}>{chroma.skinNameEn}</span><DetailActionMenu actions={baseSkinActions} /></dd></div>
        {chroma.skinSets.length > 0 && <div><dt data-en="Skinlines" data-zh="皮肤系列">Skinlines</dt><dd class="detail-value-with-actions"><span data-en={skinSetsEn} data-zh={skinSetsZh}>{skinSetsEn}</span><DetailActionMenu actions={skinlineActions} /></dd></div>}
        {chroma.universes.length > 0 && <div><dt data-en="Universes" data-zh="皮肤宇宙">Universes</dt><dd class="detail-value-with-actions"><span data-en={universesEn} data-zh={universesZh}>{universesEn}</span><DetailActionMenu actions={universeActions} /></dd></div>}
        <div><dt data-en="Champions" data-zh="英雄">Champions</dt><dd class="detail-value-with-actions"><span data-en={chroma.heroNameEn} data-zh={chroma.heroNameZh}>{chroma.heroNameEn}</span><DetailActionMenu actions={championActions} /></dd></div>
        <div><dt data-en="Patch" data-zh="游戏版本">Patch</dt><dd class="detail-value-with-actions"><span>{chroma.gameVer}</span><DetailActionMenu actions={patchActions} /></dd></div>
      </dl>
      </div>
      </details>
    </div>
  </article>
  {related.length > 0 && <section class="related"><div class="section-heading"><h2 data-en="Related Prestige Chromas" data-zh="相关臻彩">Related Prestige Chromas</h2></div><div class="chroma-grid">{related.map((item) => <ChromaCard chroma={item} />)}</div></section>}
</BaseLayout>
<script>
  const detailDisclosure = document.querySelector<HTMLDetailsElement>('.detail-info-disclosure');
  const desktop = matchMedia('(min-width: 768px)');
  const syncDetailDisclosure = () => detailDisclosure?.toggleAttribute('open', desktop.matches);
  syncDetailDisclosure();
  desktop.addEventListener('change', syncDetailDisclosure);
</script>
<style>
  .detail-poster-copy{display:none}
  .detail-info-disclosure>summary{display:none}
  .detail-info-disclosure:not([open])>.detail-info-body,.detail-info-body{display:block}
  .detail-title-row{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:nowrap;margin-bottom:20px}
  .detail-display-title{margin:0;color:var(--gold);font-family:Georgia,"Noto Serif SC",serif;font-size:28px;font-weight:600;white-space:nowrap}
  .detail-copy dl{margin-top:0}
  .detail-copy dl>div{grid-template-columns:100px minmax(0,1fr)!important;column-gap:10px}
  .description-row dd{color:var(--muted);line-height:1.7}
  .detail-value-with-actions{display:flex;align-items:center;justify-content:space-between;gap:16px;min-width:0}
  @media(max-width:767px){
    .detail-poster-copy{display:block;position:absolute;z-index:2;left:0;right:0;bottom:0;padding:120px max(var(--page-gutter),env(safe-area-inset-left)) 24px;background:linear-gradient(transparent,#090b15e8 55%,#090b15);pointer-events:none}
    .detail-poster-copy .eyebrow{margin:0 0 8px}
    .detail-poster-title{margin:0;color:var(--text);font-family:Georgia,"Noto Serif SC",serif;font-size:clamp(2rem,10vw,3.25rem);line-height:1.02;text-wrap:balance}
    .detail-poster-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:16px}
    .detail-poster-tags span{padding:6px 9px;border:1px solid #ffffff30;border-radius:999px;background:#090b1566;color:#f4f0e6;font-size:.72rem;backdrop-filter:blur(8px)}
    .detail-copy{width:calc(100% - (var(--page-gutter) * 2));margin:0 auto;padding:14px 0 24px}
    .detail-info-disclosure{border:1px solid var(--line);border-radius:10px;background:var(--panel)}
    .detail-info-disclosure>summary{display:flex;min-height:var(--touch-target);align-items:center;justify-content:space-between;padding:0 14px;color:var(--gold);font-size:.82rem;font-weight:700;list-style:none;cursor:pointer}
    .detail-info-disclosure>summary::-webkit-details-marker{display:none}
    .detail-info-icon{font-size:1.2rem;transition:transform .2s ease}
    .detail-info-disclosure[open] .detail-info-icon{transform:rotate(45deg)}
    .detail-info-disclosure:not([open])>.detail-info-body{display:none}
    .detail-info-body{padding:0 14px 12px}
    .detail-title-row{justify-content:space-between;margin:8px 0}
    .detail-display-title{font-size:1.25rem;white-space:normal}
    .detail-copy dl>div{grid-template-columns:88px minmax(0,1fr)!important;padding:13px 0}
    .detail-value-with-actions{gap:10px}
  }
</style>
