---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChromaColorCircle from '../../components/ChromaColorCircle.astro';
import CategoryIconPreview from '../../components/CategoryIconPreview.astro';
import DetailActionMenu from '../../components/DetailActionMenu.astro';
import ExpandableChromaGroup from '../../components/ExpandableChromaGroup.astro';
import ImageViewer from '../../components/ImageViewer.astro';
import { catalog } from '../../data/catalog';
import { getChampionIndex } from '../../data/champion-index';
import { getCommunityDragonPbeGraph } from '../../data/communitydragon-pbe';
import { imageUrl, sourceImageUrl } from '../../domain/chroma';
import { googleSearchUrl, khadaChampionUrl, khadaModelUrl, patchNotesUrl, skinSpotlightsSearchUrl } from '../../domain/detail-actions';
import { findRelatedGroups } from '../../domain/related';
import { brilliantSummonSessions } from '../../domain/brilliant-summon';
import { categoryName } from '../../i18n';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { createChromaSeo } from '../../seo/chroma-seo';

export async function getStaticPaths() {
  const requiredIds = [...new Set(catalog.map((chroma) => chroma.heroId))];
  const championIndex = await getChampionIndex(requiredIds);
  const slugById = new Map(championIndex.map((entry) => [entry.id, entry.slug]));
  const graph = await getCommunityDragonPbeGraph();
  return catalog.flatMap((chroma) => [chroma.slug, String(chroma.skinId)]
    .map((slug) => ({
      params: { slug },
      props: { chroma, championSlug: slugById.get(chroma.heroId)!, pbeSkin: graph.skins.find((skin) => skin.chromas.some((entry) => entry.id === chroma.skinId)) },
    })));
}
interface Props { chroma: typeof catalog[number]; championSlug: string; pbeSkin?: import('../../domain/communitydragon-content').SkinRecord; locale?: Locale }
const { chroma } = Astro.props;
const { championSlug } = Astro.props;
const pbeSkinProp = Astro.props.pbeSkin;
const pbeGraph = await getCommunityDragonPbeGraph();
const pbeSkin = pbeSkinProp ?? pbeGraph.skins.find((skin) => skin.chromas.some((entry) => entry.id === chroma.skinId));
const pbeSkinlines = pbeSkin?.skinlineIds.map((id) => pbeGraph.skinlinesById.get(id)).filter(Boolean) ?? [];
const pbeUniverses = pbeSkin?.universeIds.map((id) => pbeGraph.universesById.get(id)).filter(Boolean) ?? [];
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const seo = createChromaSeo(chroma, locale);
const image = seo.image;
const mobileImage = imageUrl(chroma.images.medium);
const relatedGroups = findRelatedGroups(catalog, chroma);
const skinSetsEn = chroma.skinSets.map((item) => item.nameEn).join(', ');
const skinSetsZh = chroma.skinSets.map((item) => item.nameZh).join('、');
const universesEn = chroma.universes.map((item) => item.nameEn).join(', ');
const universesZh = chroma.universes.map((item) => item.nameZh).join('、');
const prestigeChromaKeyword = chroma.nameEn;
const baseSkinKeyword = chroma.skinNameEn;
const actionLabels = {
  skinSpotlights: { labelEn: 'VIEW ON SKINSPOTLIGHTS', labelZh: '在 SKINSPOTLIGHTS 查看' },
  khada: { labelEn: 'VIEW 3D MODEL ON KHADA', labelZh: '在 KHADA 查看 3D 模型' },
  google: { labelEn: 'GOOGLE SEARCH', labelZh: '谷歌搜索' },
  patch: { labelEn: 'VIEW PATCH NOTES', labelZh: '查看版本公告' },
};
const prestigeChromaActions = [
  { ...actionLabels.skinSpotlights, href: skinSpotlightsSearchUrl(prestigeChromaKeyword) },
  { ...actionLabels.khada, href: khadaModelUrl(chroma.sourceSkinId, chroma.skinId) },
  { ...actionLabels.google, href: googleSearchUrl(prestigeChromaKeyword) },
];
const baseSkinActions = [
  { ...actionLabels.skinSpotlights, href: skinSpotlightsSearchUrl(baseSkinKeyword) },
  { ...actionLabels.khada, href: khadaModelUrl(chroma.sourceSkinId) },
  { ...actionLabels.google, href: googleSearchUrl(baseSkinKeyword) },
];
const championActions = [
  { ...actionLabels.skinSpotlights, href: skinSpotlightsSearchUrl(chroma.heroNameEn) },
  { ...actionLabels.khada, href: khadaChampionUrl(chroma.heroId) },
  { ...actionLabels.google, href: googleSearchUrl(chroma.heroNameEn) },
];
const skinlineActions = [
  { ...actionLabels.google, href: googleSearchUrl(`${skinSetsEn} Skinlines`) },
];
const universeActions = [
  { ...actionLabels.google, href: googleSearchUrl(`${universesEn} Universes`) },
];
const patchActions = [
  { ...actionLabels.patch, href: patchNotesUrl(chroma.gameVer) },
];
const isSummonGuideChroma = brilliantSummonSessions.some((session) => session.rewards.some((reward) => reward.chromaNameEn === chroma.nameEn));
const summonGuideUrl = localizedPath(locale, '/blog/brilliant-prestige-chroma-summoning-guide/');
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} jsonLd={seo.jsonLd} {locale} noindex>
  <div class="detail-background" aria-hidden="true">
    <picture>
      <source media="(max-width: 767px)" srcset={mobileImage} data-fallback={sourceImageUrl('medium', chroma.instanceId)} />
      <img src={image} data-fallback={sourceImageUrl('large', chroma.instanceId)} data-placeholder="/placeholder.svg" alt="" width="1920" height="1080" loading="eager" decoding="async" />
    </picture>
  </div>
  <nav class="breadcrumbs" aria-label={isZh ? '面包屑' : 'Breadcrumb'}><a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><span aria-current="page">{isZh ? chroma.nameZh : chroma.nameEn}</span></nav>
  <article class="detail">
    <h1 class="sr-only detail-accessible-title">{seo.imageAlt}</h1>
    <div class="detail-media">
      <div class="detail-image">
        <ImageViewer src={image} fallback={sourceImageUrl('large', chroma.instanceId)} altEn={seo.imageAlt} altZh={seo.imageAlt} {locale} />
      </div>
      <p class="detail-preview-hint">{isZh ? '点击图片预览' : 'Click the image to preview'}</p>
    </div>
    <div class="detail-copy">
      <div class="detail-title-row"><p class="detail-display-title" aria-hidden="true">{isZh ? chroma.nameZh : chroma.nameEn}</p><DetailActionMenu actions={prestigeChromaActions} {locale} /></div>
      <details class="detail-info-disclosure" open>
      <summary><span>{isZh ? '详细资料' : 'Details'}</span><span class="detail-info-icon" aria-hidden="true">＋</span></summary>
      <div class="detail-info-body">
      <dl>
        <div><dt>{isZh ? '分类' : 'Category'}</dt><dd>{categoryName(chroma.categoryId, isZh ? 'zh' : 'en')}</dd></div>
        <div><dt>{isZh ? '分类图标' : 'Category icon'}</dt><dd><CategoryIconPreview src={sourceImageUrl('tag', chroma.tagId)} /></dd></div>
        {chroma.colors.length > 0 && <div><dt>{isZh ? '颜色' : 'Colors'}</dt><dd><ChromaColorCircle colors={chroma.colors} /></dd></div>}
        {(isZh ? chroma.descriptionZh : chroma.descriptionEn) && <div class="description-row"><dt>{isZh ? '描述' : 'Description'}</dt><dd>{isZh ? chroma.descriptionZh : chroma.descriptionEn}</dd></div>}
        <div><dt>{isZh ? '原皮' : 'Base skin'}</dt><dd class="detail-value-with-actions"><span>{isZh ? chroma.skinNameZh : chroma.skinNameEn}</span><DetailActionMenu actions={baseSkinActions} {locale} /></dd></div>
        {chroma.skinSets.length > 0 && <div><dt>{isZh ? '皮肤系列' : 'Skinlines'}</dt><dd class="detail-value-with-actions"><span class="pbe-links">{pbeSkinlines.length > 0 ? pbeSkinlines.map((line) => <a class="pbe-chip" href={localizedPath(locale, `/skinlines/${line!.slug}/`)}>{isZh ? line!.nameZh ?? line!.nameEn : line!.nameEn}</a>) : (isZh ? skinSetsZh : skinSetsEn)}</span><DetailActionMenu actions={skinlineActions} {locale} /></dd></div>}
        {chroma.universes.length > 0 && <div><dt>{isZh ? '皮肤宇宙' : 'Universes'}</dt><dd class="detail-value-with-actions"><span class="pbe-links">{pbeUniverses.length > 0 ? pbeUniverses.map((universe) => <a class="pbe-chip" href={localizedPath(locale, `/universes/${universe!.slug}/`)}>{isZh ? universe!.nameZh ?? universe!.nameEn : universe!.nameEn}</a>) : (isZh ? universesZh : universesEn)}</span><DetailActionMenu actions={universeActions} {locale} /></dd></div>}
        {pbeSkin && <div><dt>{isZh ? 'PBE 皮肤' : 'PBE skin'}</dt><dd><a class="champion-detail-link" href={localizedPath(locale, `/skins/${pbeSkin.slug}/`)}>{isZh ? pbeSkin.nameZh ?? pbeSkin.nameEn : pbeSkin.nameEn}</a></dd></div>}
        <div><dt>{isZh ? '英雄' : 'Champions'}</dt><dd class="detail-value-with-actions"><a class="champion-detail-link" href={localizedPath(locale, `/champions/${championSlug}/`)}>{isZh ? chroma.heroNameZh : chroma.heroNameEn}</a><DetailActionMenu actions={championActions} {locale} /></dd></div>
        <div><dt>{isZh ? '游戏版本' : 'Patch'}</dt><dd class="detail-value-with-actions"><span>{chroma.gameVer}</span><DetailActionMenu actions={patchActions} {locale} /></dd></div>
      </dl>
      </div>
      </details>
      {isSummonGuideChroma && <p class="detail-context-link"><a href={summonGuideUrl}>{isZh ? '阅读璀璨臻彩召唤完全指南' : 'Read the complete Brilliant Prestige Chroma Summoning guide'}</a></p>}
    </div>
  </article>
  {relatedGroups.length > 0 && (
    <section class="related">
      {relatedGroups.map((group) => (
        <ExpandableChromaGroup
          titleEn={group.titleEn}
          titleZh={group.titleZh}
          chromas={group.chromas}
          {locale}
        />
      ))}
    </section>
  )}
</BaseLayout>
<script>
  const detailDisclosure = document.querySelector<HTMLDetailsElement>('.detail-info-disclosure');
  const desktop = matchMedia('(min-width: 768px)');
  const syncDetailDisclosure = () => detailDisclosure?.toggleAttribute('open', desktop.matches);
  syncDetailDisclosure();
  desktop.addEventListener('change', syncDetailDisclosure);
</script>
<style>
  :global(main){position:relative;isolation:isolate}
  .detail-background{position:absolute;z-index:-1;inset:calc(-1 * var(--site-header-height)) 0 auto;height:100svh;overflow:hidden;pointer-events:none}
  .detail-background::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#090b15f2 0%,#090b15a8 45%,#090b1566 75%),linear-gradient(0deg,#090b15 0%,transparent 52%,#090b1570 100%)}
  .detail-background picture{display:block;width:100%;height:100%}
  .detail-background img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top;opacity:.52;filter:saturate(.85)}
  .detail-media{min-width:0}
  .detail-preview-hint{margin:10px 0 0;color:var(--muted);font-size:.78rem;text-align:center}
  .detail-info-disclosure>summary{display:none}
  .detail-info-disclosure:not([open])>.detail-info-body,.detail-info-body{display:block}
  .detail-title-row{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:nowrap;margin-bottom:20px}
  .detail-display-title{margin:0;color:var(--gold);font-family:Georgia,"Noto Serif SC",serif;font-size:28px;font-weight:600;white-space:nowrap}
  .detail-copy dl{margin-top:0}
  .detail-copy dl>div{grid-template-columns:100px minmax(0,1fr)!important;column-gap:10px}
  .description-row dd{color:var(--muted);line-height:1.7}
  .detail-context-link{margin:18px 0 0;color:var(--muted);font-size:.86rem;line-height:1.6;text-align:center}.detail-context-link a{color:var(--gold);text-decoration:underline;text-underline-offset:3px}
  .detail-value-with-actions{display:flex;align-items:center;justify-content:space-between;gap:16px;min-width:0}
  .champion-detail-link{color:var(--gold);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
  .champion-detail-link:hover,.champion-detail-link:focus-visible{color:var(--text);text-decoration-thickness:2px}
  @media(max-width:767px){
    .detail-background::after{background:linear-gradient(0deg,#090b15 0%,#090b1599 45%,#090b154d 100%)}
    .detail-background img{opacity:.42;object-position:center top}
    .detail-image :global(.image-viewer),.detail-image :global(.viewer-trigger),.detail-image :global(.viewer-trigger picture){height:auto}
    .detail-image :global(.viewer-image){height:auto;object-fit:contain}
    .detail-preview-hint{width:calc(100% - (var(--page-gutter) * 2));margin:10px auto 0}
    .detail-copy{width:calc(100% - (var(--page-gutter) * 2));margin:0 auto;padding:14px 0 24px}
    .detail-info-disclosure{border:1px solid var(--line);border-radius:10px;background:var(--panel)}
    .detail-info-disclosure>summary{display:flex;min-height:var(--touch-target);align-items:center;justify-content:space-between;padding:0 14px;color:var(--gold);font-size:.82rem;font-weight:700;list-style:none;cursor:pointer}
    .detail-info-disclosure>summary::-webkit-details-marker{display:none}
    .detail-info-icon{font-size:1.2rem;transition:transform .2s ease}
    .detail-info-disclosure[open] .detail-info-icon{transform:rotate(45deg)}
    .detail-info-disclosure:not([open])>.detail-info-body{display:none}
    .detail-info-body{padding:0 14px 12px}
    .detail-title-row{justify-content:space-between;margin:8px 0}
    .detail-display-title{font-size:1.25rem;white-space:normal}
    .detail-copy dl>div{grid-template-columns:88px minmax(0,1fr)!important;padding:13px 0}
    .detail-value-with-actions{gap:10px}
  }
</style>
