---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChromaCard from '../components/ChromaCard.astro';
import Filters from '../components/Filters.astro';
import ResponsiveHeroBackdrop from '../components/ResponsiveHeroBackdrop.astro';
import { toBrowserCatalog } from '../catalog/browser-catalog';
import { catalog } from '../data/catalog';
import { imageUrl, safeJsonLd, sourceImageUrl } from '../domain/chroma';
import { selectFeaturedChroma } from '../domain/featured-chroma';
import { HOME_SEO } from '../seo/site';
const firstPage = catalog.slice(0, 24);
const featuredChroma = selectFeaturedChroma(catalog);
const browserCatalogJson = safeJsonLd(toBrowserCatalog(catalog));
---
<BaseLayout title={HOME_SEO.title} description={HOME_SEO.description} canonical={HOME_SEO.canonical} jsonLd={HOME_SEO.jsonLd}>
  <section class="hero-section" data-backdrop-scope>
    {featuredChroma && <ResponsiveHeroBackdrop
      largeSrc={imageUrl(featuredChroma.images.large)}
      mediumSrc={imageUrl(featuredChroma.images.medium)}
      largeFallback={sourceImageUrl('large', featuredChroma.instanceId)}
      mediumFallback={sourceImageUrl('medium', featuredChroma.instanceId)}
    />}
    <div class="hero-content">
      <h1><span data-language-content="en">League of Legends<br /><em>China-Exclusive Chroma Splash Arts</em></span><span data-language-content="zh">英雄联盟中国服专属<br /><em>炫彩原画</em></span></h1>
      <p data-en="Explore an independent archive of unique splash arts created for selected chromas in the Chinese version of League of Legends, operated by Tencent." data-zh="探索由腾讯运营的《英雄联盟》中国版本中，为特定炫彩单独创作的原画。">Explore an independent archive of unique splash arts created for selected chromas in the Chinese version of League of Legends, operated by Tencent.</p>
    </div>
    <div class="scroll-hint" aria-hidden="true">
      <span class="scroll-mouse"><span class="scroll-wheel"></span></span>
    </div>
  </section>
  <section class="catalog-section" aria-labelledby="catalog-title">
    <div class="section-heading"><div><h2 id="catalog-title" data-en="China-Exclusive Chroma Splash Art Archive" data-zh="中国服炫彩原画图鉴">China-Exclusive Chroma Splash Art Archive</h2></div></div>
    <Filters {catalog} />
    <div class="status" data-status aria-live="polite" hidden></div>
    <div class="chroma-grid" data-chroma-list>
      {firstPage.map((chroma, index) => <ChromaCard {chroma} eager={index < 4} />)}
    </div>
    <template data-chroma-card-template>
      <article class="chroma-card">
        <a href="/">
          <div class="card-image">
            <img src="/placeholder.svg" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" alt="" width="960" height="540" loading="lazy" decoding="async" />
            <img class="category-icon" src="/placeholder.svg" alt="" aria-hidden="true" />
            <span class="new-badge" data-en="NEW" data-zh="新增">NEW</span>
          </div>
          <div class="card-body">
            <h2></h2>
            <div class="card-tags"><span class="category"></span><span class="version-tag"></span></div>
          </div>
        </a>
      </article>
    </template>
    {catalog.length === 0 && <div class="empty" data-initial-empty><h3 data-en="The archive is waiting for data" data-zh="资料库等待导入">The archive is waiting for data</h3><p data-en="Chroma splash arts will appear here after the data import runs." data-zh="运行数据导入命令后，炫彩原画会在这里出现。">Chroma splash arts will appear here after the data import runs.</p></div>}
    <nav class="pagination" data-pagination aria-label="Pagination" data-aria-en="Pagination" data-aria-zh="分页"></nav>
  </section>
  <script is:inline id="catalog-data" type="application/json" set:html={browserCatalogJson}></script>
  <script>
    import '../catalog/browser-app';

    document.querySelector('.scroll-hint')?.addEventListener('click', () => {
      const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      document.querySelector('.catalog-section')?.scrollIntoView({ behavior });
    });
  </script>
</BaseLayout>
<style>
  .hero-section { position: relative; isolation:isolate; width:100%; max-width:none; height:calc(100svh - var(--site-header-height)); min-height:480px; display:grid; align-items:center; overflow:hidden; padding:80px 0; }
  .hero-content { position: relative; z-index: 1; width: min(1240px, calc(100% - 48px)); margin-inline: auto; }
  .hero-content > p:last-child { max-width: 650px; color: #d4d6df; font-size: 1.05rem; text-shadow: 0 2px 18px #000; }
  .hero-content h1 { text-shadow: 0 5px 30px #000b; }
  .scroll-hint { position: absolute; bottom: 8vh; left: 50%; transform: translateX(-50%); z-index: 2; cursor: pointer; animation: scroll-bounce 2s ease-in-out infinite; }
  .scroll-mouse { display: block; width: 26px; height: 40px; border: 2px solid rgba(215,181,109,.6); border-radius: 13px; position: relative; }
  .scroll-wheel { display: block; width: 4px; height: 8px; background: var(--gold); border-radius: 2px; position: absolute; top: 8px; left: 50%; transform: translateX(-50%); animation: scroll-wheel 2s ease-in-out infinite; }
  @keyframes scroll-bounce { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(6px); } }
  @keyframes scroll-wheel { 0% { opacity: 1; top: 8px; } 100% { opacity: 0; top: 22px; } }
  @media (max-width: 680px) {
    .hero-section { padding:64px 0; }
    .hero-content { width: min(100% - 28px, 1240px); }
  }
  @media (prefers-reduced-motion: reduce) { .scroll-hint { animation:none; } }
</style>
