---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChromaCard from '../components/ChromaCard.astro';
import Filters from '../components/Filters.astro';
import { toBrowserCatalog } from '../catalog/browser-catalog';
import { catalog } from '../data/catalog';
import { imageUrl, safeJsonLd, sourceImageUrl } from '../domain/chroma';
import { selectFeaturedChroma } from '../domain/featured-chroma';
import { HOME_SEO } from '../seo/site';
const firstPage = catalog.slice(0, 24);
const featuredChroma = selectFeaturedChroma(catalog);
const browserCatalogJson = safeJsonLd(toBrowserCatalog(catalog));
---
<BaseLayout title={HOME_SEO.title} description={HOME_SEO.description} canonical={HOME_SEO.canonical} jsonLd={HOME_SEO.jsonLd}>
  <section class="hero-section">
    {featuredChroma && <picture>
      <source media="(max-width: 767px)" srcset={imageUrl(featuredChroma.images.medium)} data-fallback={sourceImageUrl('medium', featuredChroma.instanceId)} />
      <img class="hero-background" src={imageUrl(featuredChroma.images.large)} data-fallback={sourceImageUrl('large', featuredChroma.instanceId)} data-placeholder="/placeholder.svg" alt="" aria-hidden="true" width="1920" height="1080" loading="eager" decoding="async" fetchpriority="high" />
    </picture>}
    <div class="hero-content">
      <h1><span data-language-content="en">League of Legends<br /><em>China-Exclusive Chroma Splash Arts</em></span><span data-language-content="zh">英雄联盟中国服专属<br /><em>炫彩原画</em></span></h1>
      <p data-en="Explore an independent archive of unique splash arts created for selected chromas in the Chinese version of League of Legends, operated by Tencent." data-zh="探索由腾讯运营的《英雄联盟》中国版本中，为特定炫彩单独创作的原画。">Explore an independent archive of unique splash arts created for selected chromas in the Chinese version of League of Legends, operated by Tencent.</p>
    </div>
  </section>
  <section class="catalog-section" aria-labelledby="catalog-title">
    <div class="section-heading"><div><h2 id="catalog-title" data-en="China-Exclusive Chroma Splash Art Archive" data-zh="中国服炫彩原画图鉴">China-Exclusive Chroma Splash Art Archive</h2></div></div>
    <Filters {catalog} />
    <div class="status" data-status aria-live="polite" hidden></div>
    <div class="chroma-grid" data-chroma-list>
      {firstPage.map((chroma, index) => <ChromaCard {chroma} eager={index < 4} />)}
    </div>
    <template data-chroma-card-template>
      <article class="chroma-card">
        <a href="/">
          <div class="card-image">
            <img src="/placeholder.svg" data-fallback="/placeholder.svg" data-placeholder="/placeholder.svg" alt="" width="960" height="540" loading="lazy" decoding="async" />
            <img class="category-icon" src="/placeholder.svg" alt="" aria-hidden="true" />
            <span class="new-badge" data-en="NEW" data-zh="新增">NEW</span>
          </div>
          <div class="card-body">
            <h2></h2>
            <div class="card-tags"><span class="category"></span><span class="version-tag"></span></div>
          </div>
        </a>
      </article>
    </template>
    {catalog.length === 0 && <div class="empty" data-initial-empty><h3 data-en="The archive is waiting for data" data-zh="资料库等待导入">The archive is waiting for data</h3><p data-en="Chroma splash arts will appear here after the data import runs." data-zh="运行数据导入命令后，炫彩原画会在这里出现。">Chroma splash arts will appear here after the data import runs.</p></div>}
    <nav class="pagination" data-pagination aria-label="Pagination" data-aria-en="Pagination" data-aria-zh="分页"></nav>
  </section>
  <script is:inline id="catalog-data" type="application/json" set:html={browserCatalogJson}></script>
  <script>
    import '../catalog/browser-app';

    const hero = document.querySelector<HTMLElement>('.hero-section');
    const heroBackground = hero?.querySelector<HTMLElement>('.hero-background');
    const canParallax = matchMedia('(hover: hover) and (pointer: fine)').matches
      && !matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hero && heroBackground && canParallax) {
      let currentX = 0;
      let currentY = 0;
      let targetX = 0;
      let targetY = 0;
      let frame = 0;

      const render = () => {
        currentX += (targetX - currentX) * .1;
        currentY += (targetY - currentY) * .1;
        heroBackground.style.setProperty('--hero-x', `${currentX.toFixed(2)}px`);
        heroBackground.style.setProperty('--hero-y', `${currentY.toFixed(2)}px`);
        if (Math.abs(targetX - currentX) > .05 || Math.abs(targetY - currentY) > .05) {
          frame = requestAnimationFrame(render);
        } else {
          frame = 0;
        }
      };

      const animate = () => {
        if (!frame) frame = requestAnimationFrame(render);
      };

      hero.addEventListener('pointermove', (event) => {
        const bounds = hero.getBoundingClientRect();
        targetX = ((event.clientX - bounds.left) / bounds.width - .5) * -36;
        targetY = ((event.clientY - bounds.top) / bounds.height - .5) * -24;
        animate();
      });
      hero.addEventListener('pointerleave', () => {
        targetX = 0;
        targetY = 0;
        animate();
      });
    }
  </script>
</BaseLayout>
<style>
  .hero-section { position: relative; isolation: isolate; width: 100%; max-width: none; min-height: clamp(480px, 68vh, 720px); display: grid; align-items: center; overflow: hidden; padding: 80px 0; }
  .hero-background { position: absolute; z-index: -2; inset: -12px; display: block; width: calc(100% + 24px); height: calc(100% + 24px); object-fit: cover; object-position: center top; transform: translate3d(var(--hero-x, 0), var(--hero-y, 0), 0) scale(1.025); animation: hero-drift 18s ease-in-out infinite alternate; will-change: transform; }
  .hero-section::after { content: ""; position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(4,6,12,.96) 0%, rgba(4,6,12,.76) 38%, rgba(4,6,12,.3) 68%, rgba(4,6,12,.12) 100%), linear-gradient(0deg, rgba(9,11,21,.72), transparent 45%); }
  .hero-content { width: min(1240px, calc(100% - 48px)); margin-inline: auto; }
  .hero-content > p:last-child { max-width: 650px; color: #d4d6df; font-size: 1.05rem; text-shadow: 0 2px 18px #000; }
  .hero-content h1 { text-shadow: 0 5px 30px #000b; }
  @keyframes hero-drift {
    from { transform: translate3d(var(--hero-x, 0), var(--hero-y, 0), 0) scale(1.025); }
    to { transform: translate3d(var(--hero-x, 0), var(--hero-y, 0), 0) scale(1.065); }
  }
  @media (max-width: 680px) {
    .hero-section { min-height: 520px; padding: 64px 0; }
    .hero-background { object-position: 62% top; }
    .hero-section::after { background: linear-gradient(90deg, rgba(4,6,12,.92), rgba(4,6,12,.48)), linear-gradient(0deg, rgba(9,11,21,.9), rgba(9,11,21,.12) 75%); }
    .hero-content { width: min(100% - 28px, 1240px); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-background { animation: none; transform: none; } }
</style>
