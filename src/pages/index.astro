---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLatestBlog from '../components/HomeLatestBlog.astro';
import HomeToolNavigation from '../components/HomeToolNavigation.astro';
import HomeChromaCatalog from '../components/HomeChromaCatalog.astro';
import ResponsiveHeroBackdrop from '../components/ResponsiveHeroBackdrop.astro';
import { catalog } from '../data/catalog';
import { imageUrl, sourceImageUrl } from '../domain/chroma';
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';
import { HOME_SEO, SITE } from '../seo/site';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const title = isZh ? '英雄联盟臻彩原画与游戏资料 | LoL Chroma Art' : HOME_SEO.title;
const description = isZh
  ? '浏览英雄联盟国服臻彩原画，查找 PBE 新增、英雄、皮肤系列和皮肤宇宙资料。中国服专属指原画，不代表炫彩仅限国服。'
  : HOME_SEO.description;
const canonical = new URL(localizedPath(locale, '/'), SITE.origin).toString();
const backgroundChroma = catalog.find((item) => item.rank === 1);
if (!backgroundChroma) throw new Error('The homepage background requires a rank-one chroma');
const jsonLd = isZh ? [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: canonical, inLanguage: 'zh-CN' },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: '英雄联盟臻彩原画与游戏资料', description, url: canonical, inLanguage: 'zh-CN' },
] : HOME_SEO.jsonLd;
---

<BaseLayout {title} {description} {canonical} {jsonLd} {locale} adPlacement="catalog-index">
  <div class="home-page" data-backdrop-scope>
    <div class="home-backdrop">
      <ResponsiveHeroBackdrop
        largeSrc={imageUrl(backgroundChroma.images.large)}
        mediumSrc={imageUrl(backgroundChroma.images.medium)}
        largeFallback={sourceImageUrl('large', backgroundChroma.instanceId)}
        mediumFallback={sourceImageUrl('medium', backgroundChroma.instanceId)}
        opacity={.7}
        mobileOpacity={.85}
      />
    </div>
    <div class="home-content">
      <h1 class="sr-only">{isZh ? '英雄联盟臻彩原画与游戏资料' : 'League of Legends prestige chroma splash arts and game references'}</h1>
      <HomeLatestBlog {locale} />
      <HomeToolNavigation {locale} />
      <HomeChromaCatalog {locale} />
    </div>
  </div>
</BaseLayout>
<style>
  .home-page { position:relative; isolation:isolate; background:var(--bg); }
  .home-backdrop { position:fixed; z-index:0; inset:0; height:100svh; }
  .home-content { position:relative; z-index:1; }
</style>
