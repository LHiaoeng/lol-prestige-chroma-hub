---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLatestBlog from '../components/HomeLatestBlog.astro';
import HomeToolNavigation from '../components/HomeToolNavigation.astro';
import HomeCatalogCard from '../components/HomeCatalogCard.astro';
import HomeChromaCatalog from '../components/HomeChromaCatalog.astro';
import TftCatalogIcon from '../components/TftCatalogIcon.astro';
import DomainIcon from '../components/DomainIcon.astro';
import ResponsiveHeroBackdrop from '../components/ResponsiveHeroBackdrop.astro';
import { catalog } from '../data/catalog';
import { imageUrl, sourceImageUrl } from '../domain/chroma';
import { communityDragonAssetUrl } from '../domain/communitydragon-url';
import { selectFeaturedChroma } from '../domain/featured-chroma';
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';
import { createHomeSeo } from '../seo/home-seo';
import { SITE } from '../seo/site';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const { tagline, title, description, canonical, jsonLd } = createHomeSeo(locale);
const backgroundChroma = selectFeaturedChroma(catalog);
const socialImage = backgroundChroma ? imageUrl(backgroundChroma.images.large) : SITE.defaultImage;
// Curated live records: companion 49001, arena 114, boom 194003, portal 35.
const tftCovers = [
  {
    catalog: 'companions',
    title: isZh ? '小小英雄' : 'Tacticians',
    name: isZh ? '小小阿狸' : 'Chibi Ahri',
    asset: '/lol-game-data/assets/ASSETS/Loadouts/Companions/Tooltip_ChibiAhri_Base_Classic_Tier1.png',
    height: 344,
  },
  {
    catalog: 'arenas',
    title: isZh ? '棋盘' : 'Arenas',
    name: isZh ? 'K/DA练习室' : 'K/DA Practice Room',
    asset: '/lol-game-data/assets/ASSETS/Loadouts/TFTMapSkins/Square_Battlefield_Lg_Backstage_Day.png',
    height: 512,
  },
  {
    catalog: 'booms',
    title: isZh ? '进攻特效' : 'Booms',
    name: isZh ? '水晶玫瑰 小小格温 快刀剪乱' : 'Crystal Rose Snip Snip!',
    asset: '/lol-game-data/assets/ASSETS/Loadouts/TFTDamageSkins/Boom_Gwen_CrystalRose.png',
    height: 512,
  },
  {
    catalog: 'portals',
    title: isZh ? '传送门' : 'Portals',
    name: isZh ? '馥郁晶昙' : 'Crystal Caress',
    asset: '/lol-game-data/assets/ASSETS/Loadouts/TFTZoomSkins/Portal1_CrystalRose.png',
    height: 512,
  },
] as const;
---

<BaseLayout {title} {description} {canonical} image={socialImage} {jsonLd} {locale} adPlacement="catalog-index">
  <div class="home-page" data-backdrop-scope>
    <div class="page-backdrop page-backdrop--home home-backdrop">
      {backgroundChroma && <ResponsiveHeroBackdrop
        largeSrc={imageUrl(backgroundChroma.images.large)}
        mediumSrc={imageUrl(backgroundChroma.images.medium)}
        largeFallback={sourceImageUrl('large', backgroundChroma.instanceId)}
        mediumFallback={sourceImageUrl('medium', backgroundChroma.instanceId)}
      />}
    </div>
    <div class="home-content">
      <h1 class="sr-only">{tagline}</h1>
      <HomeLatestBlog {locale} />
      <HomeToolNavigation {locale}>
        <HomeChromaCatalog {locale} />
      </HomeToolNavigation>
      <section class="home-tft" aria-labelledby="home-tft-title">
        <div class="section-heading">
          <h2 id="home-tft-title"><DomainIcon name="teamfight-tactics" /> {isZh ? '云顶之弈' : 'Teamfight Tactics'}</h2>
        </div>
        <ul class="home-catalog-links" role="list">
          {tftCovers.map(({ catalog: tftCatalog, title, name, asset, height }) => (
            <li>
              <HomeCatalogCard href={localizedPath(locale, `/tft/${tftCatalog}/`)} {title} caption={name} cover={communityDragonAssetUrl(asset, 'latest')} {height}>
                <TftCatalogIcon slot="icon" catalog={tftCatalog} />
              </HomeCatalogCard>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
<style>
  .home-page { position:relative; isolation:isolate; background:var(--bg); }
  .home-content { position:relative; z-index:1; }
  .home-content :global(.section-heading h2) { display: flex; align-items: center; gap: var(--space-2); color: var(--gold-text); }
  .home-tft { width: min(var(--content-width), calc(100% - (var(--page-gutter) * 2))); margin-inline: auto; padding-bottom: 40px; }
</style>
