---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { resolveAdProvider } from '../domain/ad-policy';
import { localizedPath, resolveLocale, type Locale } from '../i18n/config';
import { SITE } from '../seo/site';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale);
const isZh = locale === 'zh-cn';
const title = isZh ? '隐私说明 | LoL Chroma Art' : 'Privacy Policy | LoL Chroma Art';
const description = isZh ? '了解 LoL Chroma Art 的静态托管、第三方链接、访问衡量与广告相关信息。' : 'Learn how LoL Chroma Art handles hosting data, third-party links, measurement, and advertising information.';
const canonical = new URL(localizedPath(locale, '/privacy/'), SITE.origin).toString();
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: isZh ? 'zh-CN' : 'en' };
const adProvider = resolveAdProvider(process.env.AD_PROVIDER);
---
<BaseLayout {title} {description} {canonical} {jsonLd} {locale} ads={false}>
  <Breadcrumb {locale} items={[
    { title: isZh ? '首页' : 'Home', href: localizedPath(locale, '/') },
    { title: isZh ? '隐私说明' : 'Privacy Policy' },
  ]} />
  {!isZh && <article class="privacy-page">
    <h1>Privacy Policy</h1>
    <p class="effective-date">Effective: November 17, 2026</p>
    <p>LoL Chroma Art is a static, read-only site for game content. You can browse it without creating an account or directly providing personal information.</p>

    <section>
      <h2>Information used by this site</h2>
      <p>English and Simplified Chinese are published at separate URLs. When you open the homepage, the site can use your browser’s language preferences. When you choose a language in the header, the site saves your choice in a <code>site-language</code> cookie for one year. You can remove it by clearing this site’s cookies in your browser.</p>
      <p>The site and its images are delivered through Cloudflare services. Like most hosting and security providers, Cloudflare may automatically process technical information such as your IP address, request time, requested URL, browser or device information, and security signals to deliver the site, prevent abuse, and maintain service reliability.</p>
    </section>

    <section>
      <h2>Google tag and measurement</h2>
      <p>LoL Chroma Art loads one Google tag (Google Tag Manager container <code>GTM-N2XNGMV2</code>) in the <code>&lt;head&gt;</code> of every page. Google may set or read cookies and process technical information such as the page URL, browser or device information, and IP address to measure visits to this and other websites.</p>
      <p>You can limit this measurement through your browser's cookie settings, <a href="https://adssettings.google.com/" target="_blank" rel="noreferrer">Google's Ads Settings</a>, or the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noreferrer">Google Analytics opt-out browser add-on</a>. See <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noreferrer">how Google uses information from partner sites</a>.</p>
    </section>

    <section>
      <h2>Game reference requests</h2>
      <p>The browser directly requests selected public JSON and media from a <a href="https://raw.communitydragon.org/" target="_blank" rel="noopener noreferrer">public game-data source</a> for the runtime champion, skin, skinline, universe, optional chroma reference views, and Teamfight Tactics Tacticians and Arenas. The Tacticians page loads all three companion categories from <code>companions.json</code> and their images directly from CommunityDragon; the Arenas page loads <code>tftmapskins.json</code> and its artwork directly from CommunityDragon. The site does not proxy or persist these responses, and requests are made without credentials and with the Referer omitted where the browser permits.</p>
      <p>These requests are optional for the static archive, chroma pages, and blog articles. If the data source is unavailable, the static page remains readable and the affected reference area shows a retryable failure.</p>
    </section>

    <section>
      <h2>Advertising</h2>
      <p>LoL Chroma Art supports Adsterra and Google AdSense, with one provider selected through site configuration. Read the <a href="https://adsterra.com/privacy-policy/" target="_blank" rel="noreferrer">Adsterra Privacy Policy</a> and <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noreferrer">Google's information about partner sites</a> for details on their data practices.</p>
      {adProvider === 'adsterra' && <p>Adsterra currently provides display ads on pages where advertising is enabled.</p>}
      {adProvider === 'adsense' && <p>Google AdSense currently provides display ads on pages where advertising is enabled. You can manage personalized advertising in <a href="https://adssettings.google.com/" target="_blank" rel="noreferrer">Google's Ads Settings</a>.</p>}
      {adProvider === 'none' && <p>Advertising is currently disabled on LoL Chroma Art.</p>}
    </section>

    <section>
      <h2>Third-party links</h2>
      <p>LoL Chroma Art links to websites operated by Riot Games, Google, and others. Their privacy practices are governed by their own policies, and this policy does not cover information they collect after you follow an external link.</p>
    </section>

    <section>
      <h2>Children's privacy</h2>
      <p>LoL Chroma Art is intended for a general audience and does not knowingly collect personal information from children. If you believe a child has provided personal information through a service connected to this site, please contact us so the concern can be reviewed.</p>
    </section>

    <section>
      <h2>Your choices and contact</h2>
      <p>You can manage personalized advertising through the selected provider's settings and limit measurement through your browser. For privacy questions or requests, contact <a href="mailto:lolchromaart@outlook.com">lolchromaart@outlook.com</a>.</p>
      <p>This policy may be updated when the site's services or legal requirements change. Material revisions will be reflected by the effective date shown above.</p>
    </section>
  </article>}

  {isZh && <article class="privacy-page">
    <h1>隐私说明</h1>
    <p class="effective-date">生效日期：2026 年 11 月 17 日</p>
    <p>LoL Chroma Art 是一个静态、只读的游戏内容站。你无需创建账户，也无需直接提供个人信息即可浏览本站。</p>

    <section>
      <h2>本站使用的信息</h2>
      <p>英文和简体中文发布在不同网址。打开首页时，本站可参考浏览器的语言偏好。你在页头手动切换语言后，本站会用 <code>site-language</code> Cookie 将选择保存一年。你可以在浏览器中清除本站 Cookie 来移除这项选择。</p>
      <p>本站及其图片通过 Cloudflare 服务提供。与多数托管和安全服务商一样，Cloudflare 可能自动处理 IP 地址、请求时间、访问网址、浏览器或设备信息以及安全信号等技术信息，用于提供网站、防止滥用并维持服务可靠性。</p>
    </section>

    <section>
      <h2>Google 代码与访问衡量</h2>
      <p>LoL Chroma Art 在每个网页的 <code>&lt;head&gt;</code> 中加载一份 Google 代码（Google 代码管理工具容器 <code>GTM-N2XNGMV2</code>）。Google 可能设置或读取 Cookie，并处理访问网址、浏览器或设备信息、IP 地址等技术信息，用于衡量本站及其他网站的访问情况。</p>
      <p>你可以通过浏览器的 Cookie 设置、<a href="https://adssettings.google.com/" target="_blank" rel="noreferrer">Google 广告设置</a>或 <a href="https://tools.google.com/dlpage/gaoptout?hl=zh-CN" target="_blank" rel="noreferrer">Google Analytics 停用浏览器插件</a>限制此类衡量，并查看 <a href="https://policies.google.com/technologies/partner-sites?hl=zh-CN" target="_blank" rel="noreferrer">Google 如何使用合作伙伴网站提供的信息</a>。</p>
    </section>

    <section>
      <h2>游戏资料请求</h2>
      <p>浏览器会直接从<a href="https://raw.communitydragon.org/" target="_blank" rel="noopener noreferrer">公开游戏资料源</a>请求运行时英雄、皮肤、皮肤系列、宇宙、臻彩辅助资料和云顶之弈小小英雄及棋盘目录所需的公开 JSON 与媒体。小小英雄页面会从 CommunityDragon 直接读取 <code>companions.json</code> 中的小小英雄、英雄级小小英雄和不朽弈士形象及对应图片；棋盘页面会从 CommunityDragon 直接读取 <code>tftmapskins.json</code> 中的棋盘资料及对应图片。本站不代理或持久保存这些响应，请求不携带凭据，并在浏览器允许时省略 Referer。</p>
      <p>这些请求不影响静态图鉴、臻彩正文和博客文章的阅读。资料源不可用时，静态页面仍保持可读，受影响的资料区会显示可以重试的失败状态。</p>
    </section>

    <section>
      <h2>广告</h2>
      <p>LoL Chroma Art 支持 Adsterra 和 Google AdSense，通过站点配置选择其中一家投放。有关两家服务的数据处理方式，请阅读 <a href="https://adsterra.com/privacy-policy/" target="_blank" rel="noreferrer">Adsterra 隐私政策</a>和 <a href="https://policies.google.com/technologies/partner-sites?hl=zh-CN" target="_blank" rel="noreferrer">Google 对合作伙伴网站信息的说明</a>。</p>
      {adProvider === 'adsterra' && <p>当前由 Adsterra 在启用广告的页面展示广告。</p>}
      {adProvider === 'adsense' && <p>当前由 Google AdSense 在启用广告的页面展示广告。你可以前往 <a href="https://adssettings.google.com/" target="_blank" rel="noreferrer">Google 广告设置</a>管理个性化广告。</p>}
      {adProvider === 'none' && <p>LoL Chroma Art 当前未启用广告。</p>}
    </section>

    <section>
      <h2>第三方链接</h2>
      <p>LoL Chroma Art 包含由 Riot Games、Google 及其他主体运营的网站链接。你访问外部链接后产生的信息由相应网站自己的隐私政策约束，不适用本说明。</p>
    </section>

    <section>
      <h2>儿童隐私</h2>
      <p>LoL Chroma Art 面向一般受众，不会故意收集儿童的个人信息。如果你认为儿童通过与本站相关的服务提供了个人信息，请联系我们进行核查。</p>
    </section>

    <section>
      <h2>你的选择与联系我们</h2>
      <p>你可以通过当前广告平台的设置管理个性化广告，并通过浏览器设置限制访问衡量。如有隐私问题或请求，请发送邮件至 <a href="mailto:lolchromaart@outlook.com">lolchromaart@outlook.com</a>。</p>
      <p>当本站使用的服务或适用要求发生变化时，本说明可能更新；重要修订将通过上方的生效日期体现。</p>
    </section>
  </article>}


</BaseLayout>
