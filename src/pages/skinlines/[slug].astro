---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PbeSkinCard from '../../components/PbeSkinCard.astro';
import PbeSourceNote from '../../components/PbeSourceNote.astro';
import { getCommunityDragonPbeGraph } from '../../data/communitydragon-pbe';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { createEntitySeo } from '../../seo/entity-seo';
export async function getStaticPaths() { const graph = await getCommunityDragonPbeGraph(); return graph.skinlines.map((line) => ({ params: { slug: line.slug }, props: { id: line.id, slug: line.slug } })); }
interface Props { id: number; slug: string; locale?: Locale }
const { id, slug } = Astro.props; const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale); const isZh = locale === 'zh-cn'; const graph = await getCommunityDragonPbeGraph(); const line = graph.skinlinesById.get(Number(id)); if (!line || line.slug !== slug) throw new Error(`Unknown skinline ${id}`); const name = isZh ? line.nameZh ?? line.nameEn : line.nameEn; const skins = graph.skinsBySkinlineId.get(line.id) ?? []; const universeLinks = line.universeIds.map((value) => graph.universesById.get(value)).filter(Boolean); const champions = [...new Map(skins.map((skin) => [skin.championId, graph.championsById.get(skin.championId)])).values()].filter(Boolean); const seo = createEntitySeo('skinlines', line.slug, `${name} ${isZh ? '皮肤系列' : 'Skinline'}`, isZh ? `${name} 皮肤系列与所属皮肤。` : `${name} skinline and its PBE skins.`, locale);
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} jsonLd={seo.jsonLd} {locale}><div class="pbe-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><a href={localizedPath(locale, '/skinlines/')}>{isZh ? '皮肤系列' : 'Skinlines'}</a><span>/</span><span>{name}</span></nav><header><p class="eyebrow">{isZh ? '皮肤系列' : 'Skinline'}</p><h1>{name}</h1><p class="pbe-lede">{isZh ? line.descriptionZh ?? line.descriptionEn : line.descriptionEn}</p><PbeSourceNote locale={locale} /></header>{universeLinks.length > 0 && <section class="pbe-section"><h2>{isZh ? '所属宇宙' : 'Universes'}</h2><div class="pbe-links">{universeLinks.map((universe) => <a class="pbe-chip" href={localizedPath(locale, `/universes/${universe!.slug}/`)}>{isZh ? universe!.nameZh ?? universe!.nameEn : universe!.nameEn}</a>)}</div></section>}<section class="pbe-section"><h2>{isZh ? '相关英雄' : 'Champions represented'}</h2><div class="pbe-links">{champions.map((champion) => <a class="pbe-chip" href={localizedPath(locale, `/champions/${champion!.slug}/`)}>{isZh ? champion!.nameZh ?? champion!.nameEn : champion!.nameEn}</a>)}</div></section><section class="pbe-section"><div class="section-heading"><h2>{isZh ? '所属皮肤' : 'Skins'}</h2><p>{skins.length}</p></div><div class="pbe-grid">{skins.map((skin) => { const champion = graph.championsById.get(skin.championId); return <PbeSkinCard {skin} championName={champion ? isZh ? champion.nameZh ?? champion.nameEn : champion.nameEn : String(skin.championId)} locale={locale} />; })}</div></section></div></BaseLayout>
