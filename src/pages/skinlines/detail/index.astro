---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RuntimeReferenceRoot from '../../../components/RuntimeReferenceRoot.astro';
import { resolveLocale, type Locale } from '../../../i18n/config';
import { createEntitySeo } from '../../../seo/entity-seo';

const locale = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) as Locale;
const isZh = locale === 'zh-cn';
const seo = createEntitySeo('skinlines/detail', undefined, isZh ? '皮肤系列详情' : 'Skinline detail', isZh ? '在浏览器中读取指定皮肤系列资料及其宇宙关联。' : 'Read a selected skinline and its universe connections in the browser.', locale);
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} jsonLd={seo.jsonLd} noindex {locale}>
  <RuntimeReferenceRoot page="skinlines" mode="detail" {locale} label={isZh ? '皮肤系列' : 'Skinlines'} heading={isZh ? '皮肤系列详情' : 'Skinline detail'} lede={isZh ? '查看简体中文皮肤系列资料。' : 'View the English skinline reference.'} />
</BaseLayout>
