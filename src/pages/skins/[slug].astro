---
import ImageViewer from '../../components/ImageViewer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PbeSkinCard from '../../components/PbeSkinCard.astro';
import PbeSourceNote from '../../components/PbeSourceNote.astro';
import { getCommunityDragonPbeGraph } from '../../data/communitydragon-pbe';
import { catalog } from '../../data/catalog';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { artworkDownloadFilename, artworkFileExtension, choosePreferredArtwork, type ArtworkOption } from '../../client/skin-artwork';
import { createEntitySeo } from '../../seo/entity-seo';

export async function getStaticPaths() { const graph = await getCommunityDragonPbeGraph(); return graph.skins.map((skin) => ({ params: { slug: skin.slug }, props: { id: skin.id, slug: skin.slug } })); }
interface Props { id: number; slug: string; locale?: Locale }
const { id, slug } = Astro.props; const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale); const isZh = locale === 'zh-cn';
const graph = await getCommunityDragonPbeGraph(); const skin = graph.skinsById.get(Number(id));
if (!skin || skin.slug !== slug) throw new Error(`Unknown skin ${id}`);
const champion = graph.championsById.get(skin.championId); const championName = champion ? (isZh ? champion.nameZh ?? champion.nameEn : champion.nameEn) : String(skin.championId); const name = isZh ? skin.nameZh ?? skin.nameEn : skin.nameEn;
const rarityKey = isZh ? skin.rarityZh ?? skin.rarity : skin.rarity;
const rarityLabels: Record<string, { en: string; zh: string }> = {
  kUltimate: { en: 'Ultimate', zh: '终极' },
  kMythic: { en: 'Mythic', zh: '神话' },
  kLegendary: { en: 'Legendary', zh: '传说' },
  kEpic: { en: 'Epic', zh: '史诗' },
  kRare: { en: 'Rare', zh: '稀有' },
  kExalted: { en: 'Exalted', zh: '超凡' },
  kTranscendent: { en: 'Transcendent', zh: '超越' },
};
const rarityBadge = rarityKey ? rarityLabels[rarityKey] : undefined;
const rarityLabel = isZh ? skin.rarityLabelZh ?? rarityBadge?.zh : rarityBadge?.en;
const rarityGemUrl = isZh ? skin.rarityGemUrlZh ?? skin.rarityGemUrl : skin.rarityGemUrl;
const availability = isZh ? skin.availabilityZh ?? skin.availability : skin.availability;
const isLegacy = availability === 'legacy';
const description = isZh ? skin.descriptionZh ?? skin.descriptionEn : skin.descriptionEn;
const backdropImage = skin.media.focusedSplashUrl ?? skin.media.unfocusedSplashUrl;
const backdropVideo = skin.media.focusedAnimatedSplashUrl;
const skinlines = skin.skinlineIds.map((id) => graph.skinlinesById.get(id)).filter(Boolean); const universes = skin.universeIds.map((id) => graph.universesById.get(id)).filter(Boolean);
const parent = skin.parentSkinId ? graph.skinsById.get(skin.parentSkinId) : undefined; const archive = skin.chromas.map((chroma) => chroma.prestigeArchiveSlug ? catalog.find((entry) => entry.slug === chroma.prestigeArchiveSlug) : undefined).filter(Boolean);
const seo = createEntitySeo('skins', skin.slug, `${name} ${isZh ? '皮肤' : 'Skin'}`, isZh ? `${name} 的 PBE 皮肤详情、原画、动态原画与炫彩。` : `${name} PBE skin detail with splash art, animated art, and chromas.`, locale, skin.media.focusedSplashUrl);
const label = (entry: { nameEn: string; nameZh?: string }) => isZh ? entry.nameZh ?? entry.nameEn : entry.nameEn;
const artworkOptions = [
  skin.media.focusedAnimatedSplashUrl && { kind: 'animated', focus: 'focused' },
  skin.media.unfocusedAnimatedSplashUrl && { kind: 'animated', focus: 'unfocused' },
  skin.media.focusedSplashUrl && { kind: 'static', focus: 'focused' },
  skin.media.unfocusedSplashUrl && { kind: 'static', focus: 'unfocused' },
].filter((option): option is ArtworkOption => Boolean(option));
const initialArtwork = choosePreferredArtwork(artworkOptions);
const hasStaticArtwork = artworkOptions.some((option) => option.kind === 'static');
const hasAnimatedArtwork = artworkOptions.some((option) => option.kind === 'animated');
const initialArtworkKind = initialArtwork?.kind ?? 'static';
const initialArtworkFocus = initialArtwork?.focus ?? 'focused';
interface ArtworkDownload extends ArtworkOption { url: string; label: string; filename: string; extension: string }
const artworkDownload = (url: string | undefined, kind: ArtworkOption['kind'], focus: ArtworkOption['focus']): ArtworkDownload | undefined => {
  if (!url) return undefined;
  const extension = artworkFileExtension(url, kind);
  const kindLabel = isZh ? (kind === 'animated' ? '动态原画' : '静态原画') : (kind === 'animated' ? 'Animated artwork' : 'Static artwork');
  const focusLabel = isZh ? (focus === 'focused' ? '聚焦' : '非聚焦') : (focus === 'focused' ? 'Focused' : 'Unfocused');
  return {
    kind,
    focus,
    url,
    extension,
    label: `${focusLabel} · ${kindLabel}`,
    filename: artworkDownloadFilename({ nameEn: skin.nameEn, nameZh: skin.nameZh, locale, kind, focus, url }),
  };
};
const artworkDownloads = [
  artworkDownload(skin.media.focusedAnimatedSplashUrl, 'animated', 'focused'),
  artworkDownload(skin.media.unfocusedAnimatedSplashUrl, 'animated', 'unfocused'),
  artworkDownload(skin.media.focusedSplashUrl, 'static', 'focused'),
  artworkDownload(skin.media.unfocusedSplashUrl, 'static', 'unfocused'),
].filter((resource): resource is ArtworkDownload => Boolean(resource));
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} jsonLd={seo.jsonLd} {locale}><div class="skin-backdrop" aria-hidden="true">
  {backdropImage && <img src={backdropImage} alt="" width="1920" height="1080" loading="eager" />}
  {backdropVideo && <video autoplay muted loop playsinline preload="metadata" src={backdropVideo}></video>}
</div><div class="pbe-page skin-detail"><nav class="breadcrumbs" aria-label={isZh ? '面包屑导航' : 'Breadcrumb'}><a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><a href={localizedPath(locale, '/skins/')}>{isZh ? '皮肤' : 'Skins'}</a><span>/</span><span>{name}</span></nav><header class="skin-exhibit">
  {(hasStaticArtwork || hasAnimatedArtwork) && <figure class="skin-artwork" data-skin-artwork data-locale={locale}>
    <div class="skin-artwork-stage" id="skin-artwork-stage" data-skin-artwork-stage>
      {skin.media.focusedAnimatedSplashUrl && <div class="skin-artwork-panel" data-artwork-panel data-kind="animated" data-focus="focused" hidden={!(initialArtworkKind === 'animated' && initialArtworkFocus === 'focused')}><video muted loop playsinline preload="metadata" src={skin.media.focusedAnimatedSplashUrl} aria-label={isZh ? `${name} 聚焦动态原画` : `${skin.nameEn} focused animated splash`}></video></div>}
      {skin.media.unfocusedAnimatedSplashUrl && <div class="skin-artwork-panel" data-artwork-panel data-kind="animated" data-focus="unfocused" hidden={!(initialArtworkKind === 'animated' && initialArtworkFocus === 'unfocused')}><video muted loop playsinline preload="metadata" src={skin.media.unfocusedAnimatedSplashUrl} aria-label={isZh ? `${name} 非聚焦动态原画` : `${skin.nameEn} unfocused animated splash`}></video></div>}
      {skin.media.focusedSplashUrl && <div class="skin-artwork-panel" data-artwork-panel data-kind="static" data-focus="focused" hidden={!(initialArtworkKind === 'static' && initialArtworkFocus === 'focused')}><ImageViewer fallback="/placeholder.svg" src={skin.media.focusedSplashUrl} altEn={`${skin.nameEn} focused splash art`} altZh={`${name} 聚焦原画`} {locale} /></div>}
      {skin.media.unfocusedSplashUrl && <div class="skin-artwork-panel" data-artwork-panel data-kind="static" data-focus="unfocused" hidden={!(initialArtworkKind === 'static' && initialArtworkFocus === 'unfocused')}><ImageViewer fallback="/placeholder.svg" src={skin.media.unfocusedSplashUrl} altEn={`${skin.nameEn} unfocused splash art`} altZh={`${name} 非聚焦原画`} {locale} /></div>}
    </div>
    <div class="skin-artwork-actions" role="group" aria-label={isZh ? '原画类型与聚焦切换' : 'Artwork type and focus controls'}>
      {hasStaticArtwork && <button type="button" data-artwork-kind="static" aria-controls="skin-artwork-stage" aria-pressed={initialArtworkKind === 'static'} aria-label={isZh ? '静态原画；重复点击切换聚焦视图' : 'Static artwork; click again to toggle focus'} title={isZh ? '静态原画（再次点击切换聚焦）' : 'Static artwork (click again to toggle focus)'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m5 17 4.5-4.5 3 3 2.5-2.5 4 4"/></svg>
      </button>}
      {hasAnimatedArtwork && <button type="button" data-artwork-kind="animated" aria-controls="skin-artwork-stage" aria-pressed={initialArtworkKind === 'animated'} aria-label={isZh ? '动态原画；重复点击切换聚焦视图' : 'Animated artwork; click again to toggle focus'} title={isZh ? '动态原画（再次点击切换聚焦）' : 'Animated artwork (click again to toggle focus)'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m10 9 5 3-5 3Z"/><path d="M7 4v3M17 4v3M7 17v3M17 17v3"/></svg>
      </button>}
      <details class="skin-artwork-download" data-artwork-download-menu>
        <summary aria-label={isZh ? '下载原画' : 'Download artwork'} title={isZh ? '下载原画' : 'Download artwork'}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M5 19h14"/></svg>
        </summary>
        <nav class="skin-artwork-download-list" aria-label={isZh ? '可下载原画' : 'Available artwork downloads'}>
          {artworkDownloads.map((resource) => <a
            href={resource.url}
            download={resource.filename}
            data-artwork-download
            data-kind={resource.kind}
            data-focus={resource.focus}
            aria-current={resource.kind === initialArtworkKind && resource.focus === initialArtworkFocus ? 'true' : undefined}
          >
            <span class="skin-artwork-download-current" aria-hidden="true">✓</span>
            <span>{resource.label}</span>
            <small>{resource.extension.toUpperCase()}</small>
          </a>)}
        </nav>
      </details>
    </div>
  </figure>}
  <section class="skin-profile" aria-labelledby="skin-profile-name">
    <div class="skin-profile-heading">
      {rarityLabel && rarityGemUrl && <img class="skin-rarity-gem" src={rarityGemUrl} alt={isZh ? `${rarityLabel}稀有度` : `${rarityLabel} rarity`} title={isZh ? `稀有度：${rarityLabel}` : `Rarity: ${rarityLabel}`} width="42" height="42" loading="lazy" />}
      {rarityLabel && !rarityGemUrl && <span class="skin-rarity-text">{rarityLabel}</span>}
      <h1 id="skin-profile-name" title={name}>{name}</h1>
    </div>
    {description && <div class="skin-profile-story">
      <div class="skin-profile-rule" aria-hidden="true"></div>
      <p>{description}</p>
    </div>}
    <div class="skin-profile-meta">
      <a class="skin-champion" href={localizedPath(locale, `/champions/${champion?.slug ?? ''}/`)}>{championName}<span aria-hidden="true"> ↗</span></a>
      <div class="pbe-links">{isLegacy && <span class="skin-badge skin-badge-legacy" title={isZh ? '典藏内容：不一定长期开放购买' : 'Legacy content: not always available in the store'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 14.2 8l5.3.5-4 3.5 1.2 5.2-4.7-2.8-4.7 2.8 1.2-5.2-4-3.5L9.8 8 12 3Z" /></svg><span>{isZh ? '典藏' : 'Legacy'}</span></span>}{skin.isBase && <span class="pbe-chip">{isZh ? '基础皮肤' : 'Base skin'}</span>}{skin.parentSkinId && parent && <a class="pbe-chip" href={localizedPath(locale, `/skins/${parent.slug}/`)}>{isZh ? '阶段母体' : 'Parent skin'}: {label(parent)}</a>}</div>
      <dl class="skin-facts">
        <div><dt>{isZh ? '炫彩' : 'Chromas'}</dt><dd>{String(skin.chromas.length).padStart(2, '0')}</dd></div>
        <div><dt>{isZh ? '档案编号' : 'Archive ID'}</dt><dd>{skin.id}</dd></div>
      </dl>
    </div>
    <PbeSourceNote {locale} />
  </section>
</header>

{(skinlines.length || universes.length) > 0 &&
<section class="pbe-section"><h2>{isZh ? '所属系列与宇宙' : 'Collections'}</h2><div class="pbe-links">{skinlines.map((entry) => <a class="pbe-chip" href={localizedPath(locale, `/skinlines/${entry!.slug}/`)}>{label(entry!)}</a>)}{universes.map((entry) => <a class="pbe-chip" href={localizedPath(locale, `/universes/${entry!.slug}/`)}>{label(entry!)}</a>)}</div></section>
}{skin.chromas.length > 0 &&
<section class="pbe-section"><h2>{isZh ? '炫彩列表' : 'Chromas'}</h2><div class="pbe-chroma-grid">{skin.chromas.map((chroma) => { const archiveEntry = chroma.prestigeArchiveSlug ? catalog.find((entry) => entry.slug === chroma.prestigeArchiveSlug) : undefined; return <a class="pbe-chroma" href={archiveEntry ? localizedPath(locale, `/chromas/${archiveEntry.slug}/`) : localizedPath(locale, `/skins/${skin.slug}/#chroma-${chroma.id}`)} id={`chroma-${chroma.id}`}><div>{chroma.imageUrl ? <img src={chroma.imageUrl} alt={isZh ? chroma.nameZh ?? chroma.nameEn ?? `Chroma ${chroma.id}` : chroma.nameEn ?? `Chroma ${chroma.id}`} loading="lazy" /> : <div style="aspect-ratio:1;background:var(--panel2)"></div>}</div><span>{isZh ? chroma.nameZh ?? chroma.nameEn : chroma.nameEn ?? `Chroma ${chroma.id}`}</span>{chroma.colors.length > 0 && <div class="pbe-swatches">{chroma.colors.map((color) => <i style={`background:${color}`} title={color}></i>)}</div>}</a>; })}</div></section>
}{skin.stages.length > 0 &&
<section class="pbe-section"><h2>{isZh ? '事件阶段' : 'Event stages'}</h2><div class="pbe-grid">{skin.stages.map((stage) => { const target = stage.id ? graph.skinsById.get(stage.id) : undefined; return target && target.id !== skin.id ? <PbeSkinCard skin={target} championName={championName} locale={locale} /> : <article class="pbe-card" id={stage.key}><h3>{isZh ? stage.nameZh ?? stage.nameEn : stage.nameEn}</h3><p>{isZh ? '该阶段没有独立详情路由，媒体保留在本页。' : 'This stage is retained on the parent page.'}</p></article>; })}</div></section>
}{archive.length > 0 &&
<section class="pbe-section"><h2>{isZh ? '本站臻彩对应' : 'Archive matches'}</h2><div class="pbe-links">{archive.map((entry) => <a class="pbe-chip" href={localizedPath(locale, `/chromas/${entry!.slug}/`)}>{isZh ? entry!.nameZh : entry!.nameEn}</a>)}</div></section>
}</div></BaseLayout>

<script>
  import { bindSkinArtworks } from '../../client/skin-artwork';
  bindSkinArtworks();
</script>

<style>
  .skin-backdrop{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none;background:var(--bg)}
  .skin-backdrop img,.skin-backdrop video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.34;filter:saturate(.9) contrast(.94) blur(2px);transform:scale(1.035)}
  .skin-backdrop video{z-index:1}
  .skin-backdrop::before{content:"";position:absolute;inset:0;z-index:2;background:linear-gradient(90deg,#090b15dc 0%,#090b1578 50%,#090b15dc 100%),linear-gradient(180deg,#090b15a8 0%,#090b155c 34%,#090b15f5 100%)}
  .skin-backdrop::after{content:"";position:absolute;inset:0;z-index:3;background:radial-gradient(ellipse at 50% 20%,#20213b35 0,transparent 58%)}
  @media(prefers-reduced-motion:no-preference){.skin-backdrop:has(video) img{display:none}}
  .skin-detail{position:relative;z-index:1;width:min(1440px,calc(100% - (var(--page-gutter) * 2)));padding-top:22px}
  .skin-detail .breadcrumbs{width:100%;margin:0 0 18px;padding:12px 0;flex-wrap:wrap;font-size:.75rem;line-height:1.7}
  .skin-exhibit{display:grid;grid-template-columns:minmax(0,1fr);gap:0;padding:0 0 clamp(54px,7vw,96px)}
  .skin-artwork{--artwork-controls-height:60px;position:relative;display:grid;width:min(100%,calc(max(0px,100svh - var(--site-header-height) - 172px) * 1.77778));min-width:0;margin:0 auto;grid-template-rows:auto var(--artwork-controls-height)}
  .skin-artwork-actions{display:flex;min-height:var(--artwork-controls-height);align-items:center;justify-content:center;gap:8px}
  .skin-artwork-actions button,.skin-artwork-download summary{position:relative;display:grid;width:var(--touch-target);height:var(--touch-target);padding:0;place-items:center;border:1px solid var(--line);border-radius:6px;background:#090b15c7;color:var(--muted);cursor:pointer}
  .skin-artwork-download summary{list-style:none}
  .skin-artwork-download summary::-webkit-details-marker{display:none}
  .skin-artwork-actions button[aria-pressed="true"]{border-color:var(--gold);background:var(--gold);color:#121019}
  .skin-artwork-actions button:hover,.skin-artwork-download summary:hover,.skin-artwork-download[open] summary{border-color:var(--gold);color:var(--gold)}
  .skin-artwork-actions button[aria-pressed="true"]:hover{color:#121019}
  .skin-artwork-actions button[data-current-focus]::after{content:"";position:absolute;top:5px;right:5px;width:5px;height:5px;border-radius:50%;background:currentColor}
  .skin-artwork-actions button[data-current-focus="unfocused"]::after{width:9px;border-radius:999px}
  .skin-artwork-actions svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .skin-artwork-download{position:relative}
  .skin-artwork-download-list{position:absolute;z-index:5;right:0;bottom:calc(100% + 8px);display:grid;width:min(310px,calc(100vw - (var(--page-gutter) * 2)));padding:6px;border:1px solid #65583e;border-radius:8px;background:#090b15f5;box-shadow:0 18px 50px #000b;backdrop-filter:blur(12px)}
  .skin-artwork-download-list a{display:grid;grid-template-columns:16px minmax(0,1fr) auto;min-height:44px;align-items:center;gap:9px;padding:8px 10px;border:1px solid transparent;border-radius:5px;color:var(--text);font-size:.78rem;line-height:1.35}
  .skin-artwork-download-list a:hover,.skin-artwork-download-list a:focus-visible{border-color:var(--gold);background:#d7b56d14}
  .skin-artwork-download-list a[aria-current="true"]{border-color:var(--gold);background:var(--gold);color:#121019;font-weight:700}
  .skin-artwork-download-current{visibility:hidden;color:currentColor;font-weight:900}
  .skin-artwork-download-list a[aria-current="true"] .skin-artwork-download-current{visibility:visible}
  .skin-artwork-download-list small{color:var(--muted);font-size:.62rem;letter-spacing:.08em}
  .skin-artwork-download-list a[aria-current="true"] small{color:#121019b8}
  .skin-artwork-download-list a[aria-busy="true"]{opacity:.55;pointer-events:none}
  .skin-artwork-stage{position:relative;aspect-ratio:16/9;overflow:hidden;background:#05060c;border:1px solid #65583e;box-shadow:0 30px 90px #000a}
  .skin-artwork-panel{width:100%;height:100%}
  .skin-artwork-panel[hidden]{display:none}
  .skin-artwork-panel video{display:block;width:100%;height:100%;object-fit:contain;background:#05060c}
  .skin-artwork :global(.image-viewer){height:auto}
  .skin-artwork-panel :global(.image-viewer),.skin-artwork-panel :global(.viewer-trigger),.skin-artwork-panel :global(.viewer-trigger picture){height:100%}
  .skin-detail :global(.viewer-trigger),.skin-detail :global(.viewer-trigger picture){height:auto}
  .skin-detail :global(.viewer-image){height:auto;object-fit:contain}
  .skin-artwork-panel :global(.viewer-image){width:100%;height:100%;object-fit:contain}
  .skin-profile{width:100%;min-width:0;padding:clamp(28px,4vw,52px) 0 0}
  .skin-profile-heading{--skin-title-size:clamp(1.5rem,2.4vw,2.1rem);display:flex;min-width:0;align-items:flex-start;gap:clamp(10px,1.5vw,16px)}
  .skin-profile-heading h1{min-width:0;margin:0;color:var(--gold);font-size:var(--skin-title-size);line-height:1.15;letter-spacing:-.025em;overflow-wrap:anywhere;text-wrap:balance}
  .skin-rarity-gem{width:var(--skin-title-size);height:var(--skin-title-size);flex:0 0 auto;margin-top:.06em;object-fit:contain;filter:drop-shadow(0 5px 14px #0008)}
  .skin-rarity-text{flex:0 0 auto;color:#f0d79b;font-size:var(--skin-title-size);font-weight:700;line-height:1;text-transform:uppercase}
  .skin-badge{display:inline-flex;min-height:32px;align-items:center;gap:7px;padding:5px 10px;border:1px solid #65583e;border-radius:999px;background:#090b15a8;color:var(--text);font-size:.66rem;letter-spacing:.06em;text-transform:uppercase}
  .skin-badge-legacy{border-color:#847da3;background:#78709b14;color:#cfc8e9}
  .skin-badge-legacy svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
  .skin-profile-story{margin-top:clamp(18px,2.5vw,28px)}
  .skin-profile-rule{width:100%;height:1px;background:linear-gradient(90deg,var(--gold),#65583e 72%,transparent)}
  .skin-profile-story p{width:100%;margin:clamp(20px,2.8vw,30px) 0 0;color:#d6d2c7;font-size:clamp(.96rem,1.15vw,1.08rem);line-height:1.95;text-wrap:pretty}
  .skin-profile-meta{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:clamp(18px,3vw,42px);margin-top:clamp(24px,3.5vw,38px);padding-top:18px;border-top:1px solid var(--line)}
  .skin-profile-meta>.pbe-links{min-width:0}
  .skin-profile-meta>.pbe-links:empty{display:none}
  .skin-champion{display:inline-flex;align-items:center;gap:16px;min-height:44px;color:var(--gold);font-size:.9rem;white-space:nowrap}
  .skin-facts{display:grid;grid-template-columns:repeat(2,minmax(74px,auto));justify-self:end;gap:clamp(16px,2.8vw,34px);margin:0}
  .skin-facts dt{font-size:.65rem;color:var(--muted);margin-bottom:9px;letter-spacing:.06em;text-transform:uppercase}
  .skin-facts dd{margin:0;font-family:Georgia,"Noto Serif SC",serif;font-size:1rem;overflow-wrap:anywhere}
  .skin-profile :global(.pbe-note){font-size:.69rem;line-height:1.75;margin-top:16px}
  .skin-detail .pbe-section{border-top:1px solid var(--line);padding:32px 0 44px}
  .skin-detail .pbe-section h2{font-size:clamp(1.6rem,2.8vw,2.2rem);margin:0 0 24px;letter-spacing:-.02em}
  .skin-detail .pbe-media{margin:0;border-radius:3px}
  .skin-detail .pbe-media :global(.image-viewer){height:auto}
  .skin-detail .pbe-media :global(.viewer-full){aspect-ratio:auto}
