---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PbeSkinCard from '../../components/PbeSkinCard.astro';
import PbeSourceNote from '../../components/PbeSourceNote.astro';
import { getCommunityDragonPbeGraph } from '../../data/communitydragon-pbe';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { createEntitySeo } from '../../seo/entity-seo';
const locale = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) as Locale; const isZh = locale === 'zh-cn';
const graph = await getCommunityDragonPbeGraph();
const seo = createEntitySeo('skins', undefined, isZh ? '皮肤列表' : 'Skins', isZh ? '浏览 CommunityDragon PBE 全部英雄皮肤。' : 'Browse every League of Legends skin in the CommunityDragon PBE snapshot.', locale);
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} jsonLd={seo.jsonLd} {locale}><div class="pbe-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><span>{isZh ? '皮肤' : 'Skins'}</span></nav><header><p class="eyebrow">{isZh ? 'PBE 资料库' : 'PBE database'}</p><h1>{isZh ? '皮肤列表' : 'Skins'}</h1><p class="pbe-lede">{isZh ? '按英雄与系列浏览全部皮肤，阶段任务与已下架皮肤不会被过滤。' : 'A dense index of all skins, including legacy and quest-stage entries.'}</p><PbeSourceNote locale={locale} /></header><section class="pbe-section"><div class="pbe-grid">{graph.skins.map((skin) => { const champion = graph.championsById.get(skin.championId); const championName = champion ? (isZh ? champion.nameZh ?? champion.nameEn : champion.nameEn) : String(skin.championId); return <PbeSkinCard {skin} {championName} locale={locale} />; })}</div></section></div></BaseLayout>
