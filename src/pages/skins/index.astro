---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PbeSourceNote from '../../components/PbeSourceNote.astro';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { createEntitySeo } from '../../seo/entity-seo';
const locale = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) as Locale; const isZh = locale === 'zh-cn';
const seo = createEntitySeo('skins', undefined, isZh ? '皮肤列表' : 'Skins', isZh ? '浏览 CommunityDragon PBE 全部英雄皮肤。' : 'Browse every League of Legends skin in the CommunityDragon PBE snapshot.', locale);
const kind = 'skins';
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} jsonLd={seo.jsonLd} {locale}><div class="pbe-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><span>{isZh ? '皮肤' : 'Skins'}</span></nav><header><p class="eyebrow">{isZh ? 'PBE 资料库' : 'PBE database'}</p><h1>{isZh ? '皮肤列表' : 'Skins'}</h1><p class="pbe-lede">{isZh ? '按英雄与系列浏览全部皮肤，阶段任务与已下架皮肤不会被过滤。' : 'A dense index of all skins, including legacy and quest-stage entries.'}</p><PbeSourceNote locale={locale} /></header><section class="pbe-section"><div class="listing-root" data-url={localizedPath(locale, `/listing/${kind}.json`)} data-kind={kind} data-locale={locale}><p class="status" role="status">{isZh ? '加载中…' : 'Loading…'}</p></div><noscript><p>{isZh ? '请启用 JavaScript 以浏览动态列表。' : 'Please enable JavaScript to browse the dynamic listing.'}</p></noscript></section></div>
  <script>
    import { initListing } from '../../client/listing';
    const root = document.querySelector<HTMLElement>('.listing-root');
    if (root) initListing(root);
  </script>
</BaseLayout>
