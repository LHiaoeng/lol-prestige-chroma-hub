---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TftCompanionsRoot from '../../../components/TftCompanionsRoot.astro';
import { resolveLocale, type Locale } from '../../../i18n/config';
import { createTftCompanionsSeo } from '../../../seo/tft-companions-seo';

const locale = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) as Locale;
const seo = createTftCompanionsSeo(locale);
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} jsonLd={seo.jsonLd} {locale}>
  <TftCompanionsRoot {locale} />
</BaseLayout>
