---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PbeSkinCard from '../../components/PbeSkinCard.astro';
import PbeSourceNote from '../../components/PbeSourceNote.astro';
import { getCommunityDragonPbeGraph } from '../../data/communitydragon-pbe';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { createEntitySeo } from '../../seo/entity-seo';
export async function getStaticPaths() { const graph = await getCommunityDragonPbeGraph(); return graph.universes.map((universe) => ({ params: { slug: universe.slug }, props: { id: universe.id, slug: universe.slug } })); }
interface Props { id: number; slug: string; locale?: Locale }
const { id, slug } = Astro.props; const locale = Astro.props.locale ?? resolveLocale(Astro.currentLocale); const isZh = locale === 'zh-cn'; const graph = await getCommunityDragonPbeGraph(); const universe = graph.universesById.get(Number(id)); if (!universe || universe.slug !== slug) throw new Error(`Unknown universe ${id}`); const name = isZh ? universe.nameZh ?? universe.nameEn : universe.nameEn; const lines = universe.skinlineIds.map((lineId) => graph.skinlinesById.get(lineId)).filter(Boolean); const skins = universe.skinlineIds.flatMap((lineId) => graph.skinsBySkinlineId.get(lineId) ?? []); const champions = [...new Map(skins.map((skin) => [skin.championId, graph.championsById.get(skin.championId)])).values()].filter(Boolean); const seo = createEntitySeo('universes', universe.slug, `${name} ${isZh ? '宇宙' : 'Universe'}`, isZh ? `${name} 宇宙、皮肤系列与所属皮肤。` : `${name} universe, skinlines, and PBE skins.`, locale, universe.imageUrl);
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} jsonLd={seo.jsonLd} {locale}><div class="pbe-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><a href={localizedPath(locale, '/universes/')}>{isZh ? '宇宙' : 'Universes'}</a><span>/</span><span>{name}</span></nav><header class="pbe-hero">{universe.imageUrl && <img src={universe.imageUrl} alt={name} width="180" height="180" loading="eager" />}<div><p class="eyebrow">{isZh ? '宇宙' : 'Universe'}</p><h1>{name}</h1><p class="pbe-lede">{isZh ? universe.descriptionZh ?? universe.descriptionEn : universe.descriptionEn}</p><PbeSourceNote locale={locale} /></div></header><section class="pbe-section"><h2>{isZh ? '皮肤系列' : 'Skinlines'}</h2><div class="pbe-links">{lines.map((line) => <a class="pbe-chip" href={localizedPath(locale, `/skinlines/${line!.slug}/`)}>{isZh ? line!.nameZh ?? line!.nameEn : line!.nameEn}</a>)}</div></section><section class="pbe-section"><h2>{isZh ? '相关英雄' : 'Champions represented'}</h2><div class="pbe-links">{champions.map((champion) => <a class="pbe-chip" href={localizedPath(locale, `/champions/${champion!.slug}/`)}>{isZh ? champion!.nameZh ?? champion!.nameEn : champion!.nameEn}</a>)}</div></section><section class="pbe-section"><div class="section-heading"><h2>{isZh ? '所属皮肤' : 'Skins'}</h2><p>{skins.length}</p></div><div class="pbe-grid">{skins.map((skin) => { const champion = graph.championsById.get(skin.championId); return <PbeSkinCard {skin} championName={champion ? isZh ? champion.nameZh ?? champion.nameEn : champion.nameEn : String(skin.championId)} locale={locale} />; })}</div></section></div></BaseLayout>
