---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RuntimeReferenceRoot from '../../../components/RuntimeReferenceRoot.astro';
import { resolveLocale, type Locale } from '../../../i18n/config';
import { createEntitySeo } from '../../../seo/entity-seo';

const locale = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) as Locale;
const isZh = locale === 'zh-cn';
const seo = createEntitySeo('universes/detail', undefined, isZh ? '宇宙详情' : 'Universe detail', isZh ? '在浏览器中读取指定皮肤宇宙资料及其系列关联。' : 'Read a selected skin universe and its skinline connections in the browser.', locale);
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} jsonLd={seo.jsonLd} noindex {locale}>
  <RuntimeReferenceRoot page="universes" mode="detail" {locale} label={isZh ? '宇宙' : 'Universes'} heading={isZh ? '宇宙详情' : 'Universe detail'} lede={isZh ? '查看当前区域数据视图中的皮肤宇宙资料。' : 'View the skin universe reference for the current regional data view.'} />
</BaseLayout>
