---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PbeSourceNote from '../../components/PbeSourceNote.astro';
import { getCommunityDragonPbeGraph } from '../../data/communitydragon-pbe';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { createEntitySeo } from '../../seo/entity-seo';
const locale = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) as Locale; const isZh = locale === 'zh-cn'; const graph = await getCommunityDragonPbeGraph(); const seo = createEntitySeo('universes', undefined, isZh ? '宇宙列表' : 'Universes', isZh ? '浏览英雄联盟 PBE 宇宙与皮肤系列。' : 'Browse League of Legends PBE universes and skinlines.', locale);
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} jsonLd={seo.jsonLd} {locale}><div class="pbe-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><span>{isZh ? '宇宙' : 'Universes'}</span></nav><header><p class="eyebrow">{isZh ? 'PBE 资料库' : 'PBE database'}</p><h1>{isZh ? '宇宙列表' : 'Universes'}</h1><p class="pbe-lede">{isZh ? '从宇宙进入系列，再进入所属皮肤与英雄，保持完整的资料链路。' : 'Follow a universe to its skinlines, skins, and represented champions.'}</p><PbeSourceNote locale={locale} /></header><section class="pbe-section"><div class="pbe-grid">{graph.universes.map((universe) => { const name = isZh ? universe.nameZh ?? universe.nameEn : universe.nameEn; const skinCount = (universe.skinlineIds.flatMap((lineId) => graph.skinsBySkinlineId.get(lineId) ?? [])).length; return <a class="pbe-card" href={localizedPath(locale, `/universes/${universe.slug}/`)}>{universe.imageUrl && <img src={universe.imageUrl} alt="" loading="lazy" style="display:block;width:100%;aspect-ratio:16/7;object-fit:cover;border-radius:6px;margin-bottom:12px" />}<p class="eyebrow">{universe.id}</p><h2>{name}</h2><p>{isZh ? universe.descriptionZh ?? universe.descriptionEn : universe.descriptionEn}</p><span class="count">{universe.skinlineIds.length} {isZh ? '个系列' : 'skinlines'} · {skinCount} {isZh ? '款皮肤' : 'skins'}</span></a>; })}</div></section></div></BaseLayout>
