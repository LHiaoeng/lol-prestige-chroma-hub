---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PbeSourceNote from '../../components/PbeSourceNote.astro';
import { localizedPath, resolveLocale, type Locale } from '../../i18n/config';
import { createEntitySeo } from '../../seo/entity-seo';
const locale = (Astro.props.locale ?? resolveLocale(Astro.currentLocale)) as Locale; const isZh = locale === 'zh-cn'; const seo = createEntitySeo('universes', undefined, isZh ? '宇宙列表' : 'Universes', isZh ? '浏览英雄联盟 PBE 宇宙与皮肤系列。' : 'Browse League of Legends PBE universes and skinlines.', locale);
const kind = 'universes';
---
<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} jsonLd={seo.jsonLd} {locale}><div class="pbe-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={localizedPath(locale, '/')}>{isZh ? '首页' : 'Home'}</a><span>/</span><span>{isZh ? '宇宙' : 'Universes'}</span></nav><header><p class="eyebrow">{isZh ? 'PBE 资料库' : 'PBE database'}</p><h1>{isZh ? '宇宙列表' : 'Universes'}</h1><p class="pbe-lede">{isZh ? '从宇宙进入系列，再进入所属皮肤与英雄，保持完整的资料链路。' : 'Follow a universe to its skinlines, skins, and represented champions.'}</p><PbeSourceNote locale={locale} /></header><section class="pbe-section"><div class="listing-root" data-url={localizedPath(locale, `/listing/${kind}.json`)} data-kind={kind} data-locale={locale}><p class="status" role="status">{isZh ? '加载中…' : 'Loading…'}</p></div><noscript><p>{isZh ? '请启用 JavaScript 以浏览动态列表。' : 'Please enable JavaScript to browse the dynamic listing.'}</p></noscript></section></div>
  <script>
    import { initListing } from '../../client/listing';
    const root = document.querySelector<HTMLElement>('.listing-root');
    if (root) initListing(root);
  </script>
</BaseLayout>
