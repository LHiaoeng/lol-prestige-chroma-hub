---
import ChampionPage from '../../champions/[slug].astro';
import { getCommunityDragonPbeGraph } from '../../../data/communitydragon-pbe';

export async function getStaticPaths() {
  const graph = await getCommunityDragonPbeGraph();
  return graph.champions.map((entry) => ({ params: { slug: entry.slug }, props: { id: entry.id, slug: entry.slug } }));
}

const { id, slug } = Astro.props;
---
<ChampionPage {id} {slug} locale="zh-cn" />
