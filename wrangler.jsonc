{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lol-prestige-chroma-hub",
  "compatibility_date": "2026-07-13",
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/_language/"]
  }
}
